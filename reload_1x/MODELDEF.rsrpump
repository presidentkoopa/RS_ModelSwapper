// RSR-PUMP (zscript/rsr/rsr_pump.zs, tools/gen_pump.py): V+/VR_Shotgun. The gun's own model and
// frames; pieces shown or hidden by a clear skin (every surface has its own SurfaceSkin:
// models_md3.cpp reads SurfaceSkin only when a block has no Skin).

// the gun without its pump (they are on their own layers while the hand works it)
Model MS_Shotgun
{
	Path "models/hud/Shotgun"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "WPN-GUNS-k1.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS-k1.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUH A 0 0
}

// the pump alone (main controller)
Model RSR_GunParts
{
	Path "models/hud/Shotgun"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "WPN-GUNS-k1.png"
	SurfaceSkin 0 2 "rsr_clear.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUQ A 0 0
}

// the shell alone, at the loading port
Model RSR_GunParts
{
	Path "models/hud/Shotgun"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS-k1.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUQ C 0 12
}

// the shell alone, in the off hand (off controller)
Model RSQ_Hands
{
	Path "models/hud/Shotgun"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS-k1.png"
	Scale 1.3500 1.3500 1.3500
	Offset 0.0000 0.0000 0.0
	ZOffset 0.0000
	FrameIndex RQUQ C 0 12
}

// a dropped shell (world)
Model RSP_DroppedShell
{
	Path "models/hud/Shotgun"
	Model 0 "shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "WPN-GUNS-k1.png"
	Scale 0.4682 -0.4682 0.4682
	Offset -0.4779 0.1528 0.0
	ZOffset -0.4352
	USEACTORPITCH
	USEACTORROLL
	FrameIndex RQUX A 0 12
}

// RSR-PUMP: Ermac's one-shell hold (ammo_hand frame 1) without his shell: the gun's own shell is
// drawn in it on layer 2210 (rsr/rsr_pump.zs). ammo_hand.md3 is already in the packs (models/rsq).
Model RSQ_Hands
{
	Path "models/rsq"
	Model 0 "ammo_hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQUN A 0 1
}
