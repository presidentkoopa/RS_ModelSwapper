#!/bin/bash
# The prebuilt rig (TEST ONLY): QuestZDoom 4.14.3 engine for Linux, OpenXR path, poses from cvars.
# Built in the 2026-10-26 cloud session (Ubuntu x86_64, Mesa). Runs from this directory like the
# Android app does (res/ and config/ relative to cwd). Existing relative file args are made absolute.
HERE="$(cd "$(dirname "$0")" && pwd)"
[ -e "$HERE/libGLESv3.so" ] || ln -sf "$(ls /usr/lib/x86_64-linux-gnu/libGLESv2.so.2 /usr/lib64/libGLESv2.so.2 2>/dev/null | head -1)" "$HERE/libGLESv3.so"
args=()
for a in "$@"; do
  if [[ "$a" != -* && "$a" != +* && "$a" != /* && -e "$a" ]]; then a="$(realpath "$a")"; fi
  args+=("$a")
done
cd "$HERE" && LD_LIBRARY_PATH="$HERE${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" exec ./qzdoom "${args[@]}"
