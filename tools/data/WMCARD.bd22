# THE CHARGING HANDLE, which this card never had. The surface was always in the mesh --
# BD22's export calls it `fixed`, Vanilla's card for the SAME MESH calls it
# `charginghandle` and drives it, which is why Vanilla's SMG racks and this one did not.
# Paired by geometry (239 verts, centroids 0.00 apart), so every number here is Vanilla's
# own measurement and not a new one.
#
# TWO STAGES, the Vector's folding handle: a 90-degree hinge for the first half of the
# pull, then a 5.26 slide for the second.
part charginghandle
  role    = action
  subject = slide
  surface = fixed
  grab       = 20.16, 2.81, 3.65      # the handle's front end, the part you pinch
  handseat = 20.16, 2.656, 3.672      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 2.5
  dof
    kind    = hinge
    axis    = 0, 0, 1
    degrees = 90.0
    pivot   = 9.910, -1.183, 0
  end
  dof2
    kind     = slide
    axis     = -1, 0, 0
    distance = 5.26
    split    = 0.5
  end
end

# VANILLA'S CYCLE FOR THIS MESH, verbatim. Declaring it means declaring the swap too --
# SynthesiseVerbs is all-or-nothing (card.zs:918), and one declared verb synthesises none.
#
# `auto = onshot` is kept as Vanilla has it. The engine's own comment names a
# Vector-style SMG as its example of a NON-reciprocating handle, which argues the other
# way -- but this is Vanilla's measured, shipped card for this exact mesh, and the rule is
# to copy what is known right rather than redesign it. If the headset says otherwise it is
# one word, and it must change on BOTH cards together or they will disagree about one gun.
cycle rack
  part     = charginghandle
  outat    = 0.85
  apex     = 0.95
  onout    = eject
  from     = chamber
  onhome   = feed
  feed     = mag
  into     = chamber
  return   = spring
  holdopen = whenempty
  auto     = onshot
end

swap magwell
  part     = magazine
  store    = mag
  detachat = 0.9
  pullout  = 0.97
  button   = yes
  handtake = no
end

weapon "BD_Flamethrower"
  hand      = main
  type      = flamethrower
  prop      = "BD_PropFlamethrower"
  model     = "models/bd22" "flamethrower_wm.md3"
  skin      = "models/bd22" "flamethrower.png"
  # FIRES FROM THE MAGAZINE, not through a chamber (owner, 2026-10-02).
  # This gun has a feed part, so it gets a SWAP and the magazine can be changed -- but
  # it has no role = action part, so it gets no CYCLE. Unstated, firesfrom defaults to
  # firing through a CHAMBER (card.zs:916-926) that nothing can ever refill: one shot
  # per magazine. Saying magazine takes the chamber out of the path.
  firesfrom = magazine
  capacity  = 200
  magfamily = "bd_fuel"
  # NO CASE LEAVES THIS GUN (2026-10-02): a flame gun: nothing is chambered and nothing comes out. Unstated, a card MEANS
  # yes (parser.zs:1776-1781), so this gun threw brass out of the ejectport below --
  # which on a gun with no port at all is just the emptier wall of the receiver, so the
  # brass appeared beside the gun rather than from it. The port stays: rig.zs:3122
  # throws LIVE rounds from that same point when a breech opens.
  casing    = none

  muzzle    = 56.609, 3.531, 2.328
  barrel    = 1, 0, 0
  # side measured (1458 vertices on -y against 1231 on +y), the emptier wall of the receiver; the point and the direction are estimates
  ejectport = 3.781, 6.234, -1.630
  ejectdir  = -0.2914, 0.8742, 0.3885

  magmodel  = "models/bd22" "flamethrower_canister.md3"
  magskin   = "models/bd22" "flamethrower.png"
  magscale  = 0.34
  magcenter = -0.460, -0.456, -1.811

  magoutsound    = "bd22/generic/magout"
  maginsound     = "bd22/generic/magin"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# 2026-10-01: this gun's own handle on the M4A3's grip (set.py FIRING_LINE "hand").
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  # PLACED BY THE OWNER, 2026-10-03, on a shaded render of this gun's own mesh.
  palm       = -30.186, -0.483, 5.836
  rake      = 75.2
  supportat  = 0.478, -0.453, -6.470
  triggerat  = -27.972, -0.458, 0.118

  seat = -23.354, -0.469, 18.948
end
# WHERE THE OFF HAND GOES. The height is measured -- the underside of the
# body there. The length along the gun is an ESTIMATE: the middle of the
# body's thick run forward of the magazine, since a handguard is thick and
# a barrel is thin. Check it in the headset.
part support
  role    = support
  subject = support
  grab       = 15.605, 0.000, -6.016
  grabradius = 3.0
end

part canister
  role    = feed
  subject = magazine
  take    = no
  surface = canister
  grab       = 0.326, -0.458, -7.697
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.000, 0.000, -1.000
    distance = 13.406
    detach   = 0.9
  end
end

part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = hinge
    axis     = -0.000, 1.000, -0.000
    degrees  = 14.98
    pivot    = -21.910, 0.000, 1.344
  end
end

