  surface = charginghandle
  surface = charginghandle2
  grab       = -16.481, 0.969, 2.587
  handseat = -16.481, 0.18, 2.602      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
