  palm       = -14.769, 0.022, -2.299
  rake      = 71.8
  supportat  = 16.535, 0.047, -1.403
  triggerat  = -8.699, 0.114, -4.988
  seat = -10.354, 0.114, 6.948
end
store chambers
  kind     = slotted
