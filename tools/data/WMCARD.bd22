# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# 2026-10-01: this gun's own handle on the M4A3's grip (set.py FIRING_LINE "hand").
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  # PALM AND SUPPORTAT ARE THE SAME POINT ON PURPOSE. Two hands on a pistol cup each
  # other on the handle's axis -- his words were "taking aim with a pistol, two handed,
  # FREEZE, POLICE" -- so he clicked both sides of the centreline and this is the midpoint
  # of the two. The separation between the hands is the engine's job, not the card's.
  # Do not "fix" these to differ.
  palm       = -11.190, -0.104, -7.209
  rake      = 23.7
  supportat  = -8.626, -0.104, -8.734
  triggerat  = -2.827, 0.039, -5.580
  seat = -7.254, 0.039, 1.548
end
# INDEXED, AND IT TURNS ON THE SHOT (2026-10-02). Six slots alone are not a revolver.
# With no `indexed` a slotted store has no SELECTED position -- WM_Store.SelectedSlot
# always answers 0 (store.zs:269-273) -- so every trigger pull fired chamber 0 and this
# gun took ONE SHOT PER LOAD. `advance = onshot` turns the cylinder a chamber on each
# pull, a click included, which is the half that makes it a revolver rather than a
# magazine with six holes in it.
#
# NOT EVERY SLOTTED STORE WANTS THIS: BD_SSG's and BD_M79's chambers are slotted and
# stay un-indexed on purpose, because a pull on a break-action fires every live one and
# there is no "selected" barrel to turn to (WMCARD.06_breakaction).
store cylinder
  kind     = slotted
  slots    = 6
  indexed  = yes
  advance  = onshot
end

# WHERE A ROUND GOES IN. The face is the set file's choice (breech);
# the point is the body's own surface on that face at the breech, and the
# direction is into the gun.
load cylinder
  into = cylinder
  slot = next
  at   = -9.335, 0.174, -5.238
  dir  = 1.0000, -0.0000, -0.0000
end

# WHERE THE OFF HAND GOES. The height is measured -- the underside of the
# body there. The length along the gun is an ESTIMATE: the middle of the
# body's thick run forward of the magazine, since a handguard is thick and
# a barrel is thin. Check it in the headset.
part support
  role    = support
  subject = support
  grab       = -4.519, 0.000, -7.391
  grabradius = 3.0
end

part crane
  subject = cylinder
  surface = crane
  surface = crane2
  grab       = 10.847, -0.046, 1.012
  grabradius = 3.0
  dof
    kind     = hinge
    axis     = -1.000, -0.000, 0.000
    degrees  = 90.01
    pivot    = 0.000, -0.014, -2.522
  end
end

weapon "BD_Shotgun"
  hand      = main
  # NOT "pump" (2026-10-02). `type` is this card's HAND-SEAT PROFILE, and
  # WM_HandProfile.TypeAt has no "pump" in it -- so this gun read wm_hs_default_* for
  # every seat, and wm_feel_default_home (0.0) rather than wm_feel_shotgun_home (0.25),
  # which is the threshold added on 2026-09-13 for "a pump moved a hair would not fire".
  # DefaultGripClass already treats pump and shotgun as one thing. The word for how this
  # gun works is `mechanism = pump`, below, where it already is.
  type      = shotgun
  prop      = "BD_PropShotgun"
  model     = "models/bd22" "shotgun_wm.md3"
  skin      = "models/bd22" "shotgun.png"
  capacity  = 9     # BD's own: ShotgunAmmo Inventory.MaxAmount 9
