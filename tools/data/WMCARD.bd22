# ================================================================ BD_Machinegun
# THE MG42 / GENERAL PURPOSE MACHINE GUN (owner, 2026-10-02), belt-fed, with an
# underslung grenade launcher. Its mesh is Vanilla WM_MachineGun's, and every number
# below is Vanilla's measurement against this set's own copy -- the surfaces were paired
# by GEOMETRY and match within 0.04 units, so nothing had to be re-measured or converted.
#
# IT WAS A BOX-MAG RIFLE UNTIL NOW, and that was my error this morning: firesfrom =
# magazine with a magazine swap, because the mesh carries a carved magazine. Three things
# say belt feed instead. BD's own Machinegun.txt has NO BULLET RELOAD -- its Reload state
# jumps to ReloadGrenade if a grenade was fired and otherwise returns straight to Ready,
# and nothing ever refills Clip2. Vanilla cards this same mesh as reserve-fed and does not
# work its magazine either. And a GPMG is belt-fed.
#
# THE MAGAZINE PART IS GONE WITH IT. Nothing works it by hand, and a `role = feed` part
# with no verb is the "a hand can take it and nothing will happen" warning the load log
# has been printing all day.
weapon "BD_Machinegun"
  hand      = main
  type      = chaingun
  prop      = "BD_PropMachinegun"
  model     = "models/bd22" "machinegun_wm.md3"
  skin      = "models/bd22" "machinegun.png"

  # THE BELT, from Weapon.AmmoType1 (Clip2). `gl` below is the launcher's own.
  firesfrom = reserve
  capacity  = 100
  # THE GRENADE IS THE ONLY THING A HAND BRINGS THIS GUN, so it gets the family. This is
  # the conflict I could not resolve this morning -- it only existed because I had given
  # the gun a magazine swap that it should never have had.
  magfamily = "bd_40mm"

  muzzle    = 43.953, -0.241, 3.902
  barrel    = 1, 0, 0
  # side measured (157 vertices on -y against 180 on +y), the side away from the action
  ejectport = -9.049, 4.938, -4.206
  ejectdir  = -0.2914, 0.8742, 0.3885

  opensound      = "bd22/machinegun/rackback"
  closesound     = "bd22/machinegun/rackfwd"
  loadsound      = "bd22/generic/magin"
end

# THE GRIP: the point of this mesh that is in the palm.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  # PLACED BY THE OWNER, 2026-10-03, on a shaded render of this gun's own mesh.
  palm       = -25.484, -0.267, -9.278
  rake      = 23.2
  supportat  = 14.585, -0.266, -7.173
  triggerat  = -19.308, -0.313, -6.156

  seat = -21.654, -0.171, 0.948
end
# THE GRENADE CHAMBER: one round, the launcher's alone. A fired round stays in it SPENT
# until the breech opens.
store gl
  kind  = slotted
  slots = 1
end

part support
  role    = support
  subject = support
  grab       = 2.957, 0.000, -11.391
  grabradius = 3.0
end

part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = slide
    axis     = -1.000, 0.000, 0.000
    distance = 0.594
  end
end

# THE TUBE slides forward to open the breech. NOT this gun's action -- the M249's own
# bolt is not a separate surface, and driving the launcher as a rack is what made
# "racking" this gun slide its grenade launcher forward.
part launchertube
  subject = foregrip
  surface = launchertube
  grab       = 39.128, -0.310, -6.667
  handseat = 39.128, -0.281, -6.68      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 1.000, -0.000, -0.000
    distance = 9.504
  end
end

# THE LATCH: press it to free the tube.
part launcherlatch
  surface = launcherlatch
  grab       = 0.860, -0.322, -9.276
  grabradius = 2.0
  dof
    kind    = hinge
    axis    = 0.000, -1.000, -0.000
    degrees = 19.09
    pivot   = 0.777, 0.000, -8.250
  end
end

# THE LAUNCHER'S OWN TRIGGER, drawn pulled while the alt button is held.
part launchertrigger
  surface = launchertrigger
  dof
    kind    = hinge
    axis    = 0.000, 1.000, 0.000
    degrees = 20.02
    pivot   = -2.193, 0.000, -7.863
  end
end

# THE BREECH. Opening it throws the spent case out of gl. It stops only the launcher, so
# the machine gun keeps firing with it open. BD's own ReloadGrenade plays GRLLO1,
# insertshell, GRLLO2 (Machinegun.txt:222-236), which is this sequence.
open breech
  part        = launchertube
  latch       = launcherlatch
  latchreturn = spring
  openat      = 0.85
  closeat     = 0.05
  rest        = stay
  onopen      = ejectall
  from        = gl
end

load grenade
  into    = gl
  slot    = next
  subject = round
  at      = 5.24, -0.27, -7.17
  size    = 2.0, 2.0, 2.0
  dir     = 1, 0, 0
  rides   = launchertube
  needs   = open:breech
end

# THE UNDERBARREL LAUNCHER: a second barrel on the alt-fire button, fed from gl. BD's own
# AltFire fires ShortGrenade off AmmoRocket, one at a time, gated by a FiredMGGrenade
# token until ReloadGrenade clears it -- which is this store of one.
barrel launcher
  input     = altfire
  trigger   = launchertrigger
  from      = gl
  shotclass = "ShortGrenade"
  ammo      = "AmmoRocket"
  muzzle    = 39.16, -0.27, -7.17
  barrel    = 1, 0, 0
  needs     = shut:breech
end

weapon "BD_Minigun"
  hand      = main
  type      = chaingun
  prop      = "BD_PropMinigun"
  model     = "models/bd22" "minigun_wm.md3"
  skin      = "models/bd22" "minigun.png"
  # FIRES FROM THE RESERVE, as Brutal Doom does (owner, 2026-10-02).
  # Without this the gun fires ONCE and stops. "It has no magazine" is the wrong
  # explanation: with no store and no firesfrom, SynthesiseStores (card.zs:715-730)
  # gives it a counted magazine at its capacity plus a live chamber. The magazine is
  # not absent, it is UNREACHABLE -- SynthesiseVerbs (card.zs:917-926) makes a SWAP
  # only on a role = feed part and a CYCLE only on role = action, and this gun has
  # neither, so nothing can refill either store. BD agrees: FlameCannon.dec and
  # HellishMissile.dec have no A_ReFire and just spend from the pool.
  firesfrom = reserve
  capacity  = 200
  magfamily = "bd_762"

  muzzle    = 54.015, -0.174, 0.673
  barrel    = 1, 0, 0
  # side measured (258 vertices on -y against 274 on +y), the emptier wall of the receiver; the point and the direction are estimates
  ejectport = -15.380, -9.578, -5.873
  ejectdir  = -0.2914, -0.8742, 0.3885

  spinupsound    = "bd22/minigun/spinup"
  spinsound      = "bd22/minigun/spin"
  spindownsound  = "bd22/minigun/spindown"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# 2026-10-01: this gun's own handle on the M4A3's grip (set.py FIRING_LINE "hand").
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  # PLACED BY THE OWNER, 2026-10-03, on a shaded render of this gun's own mesh.
  palm       = -43.264, -0.498, 1.522
  rake      = 25.9
  # THE LEFT-SIDE HANDLE, recovered 2026-10-03. His click was held back as 11.25 units off
  # the mesh, and he was right about the gun and the page was wrong about the depth:
  #
  #     his click      -7.311   21.548   -9.530
  #     the forend     -7.241   24.373    5.404
  #
  # x out by 0.07 and z out by 14.9. He picked the handle correctly in the view he had; an
  # orthographic page cannot say how far THROUGH a part a click lands, so the depth axis is
  # the one it gets wrong. `forend` is a real 111-vertex surface running y 9.4 to 27.0 at
  # x -9.3 to -5.3 -- a grip standing off to the left, 24.4 units from the trigger, which is
  # exactly the handle he described from memory. This is its centre, 2.15 units inside the
  # surface, which is where a hand wrapped round a bar sits.
  supportat  = -7.266, 24.373, 5.404
  triggerat  = -37.098, -0.484, 4.002
  seat = -38.854, -0.103, 12.948
end
# WHERE THE OFF HAND GOES. The height is measured -- the underside of the
# body there. The length along the gun is an ESTIMATE: the middle of the
# body's thick run forward of the magazine, since a handguard is thick and
# a barrel is thin. Check it in the headset.
part support
  role    = support
  subject = support
  grab       = -26.269, 0.000, -10.688
  grabradius = 3.0
end

part barrels
  spin    = trigger
  spinrate = 20.0
  spinup   = 14
  spindown = 25
  surface = barrels
  dof
    kind     = hinge
    axis     = 1.000, 0.000, -0.000
    degrees  = 120.0
    pivot    = 0.000, -0.151, 0.678
  end
end

part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = hinge
    axis     = 0.001, 1.000, 0.001
    degrees  = 20.01
    pivot    = -35.631, 0.000, 6.617
  end
end

part forend
  subject = forend
  surface = forend
  grab       = -7.429, 26.274, 4.666
  handseat = -7.429, 26.297, 5.461      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  handaxis = 0, 1, 0      # the line the hand closes round, index to little finger, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.325, 0.106, -0.940
    distance = 0.002
  end
end

