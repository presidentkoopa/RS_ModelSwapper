# THE TRIGGER, which this card never drove although the mesh has always had it. The
# surface is called `fixed` in this set's export and `trigger` in Vanilla's -- the same
# geometry under a name that says nothing -- so it was found by matching 88 verts, centroid 0.00 apart
# against Vanilla's, not by reading the name. The hinge is Vanilla's measurement for this
# mesh, unchanged.
part trigger
  role    = trigger
  surface = fixed
  dof
    kind    = hinge
    axis    = 0, 1, 0
    degrees = 19.96
    pivot   = -27.838, 0, -2.315
  end
end
weapon "BD_RPG"
  hand      = main
  type      = launcher
  prop      = "BD_PropRPG"
  model     = "models/bd22" "rpg_wm.md3"
  skin      = "models/bd22" "rpg.png"
  # FIRES FROM THE MAGAZINE, not through a chamber (owner, 2026-10-02).
  # This gun has a feed part, so it gets a SWAP and the magazine can be changed -- but
  # it has no role = action part, so it gets no CYCLE. Unstated, firesfrom defaults to
  # firing through a CHAMBER (card.zs:916-926) that nothing can ever refill: one shot
  # per magazine. Saying magazine takes the chamber out of the path.
  firesfrom = magazine
  # SIX, NOT ONE (2026-10-02). BD's own RocketLauncher.txt states it twice: RocketRounds
  # is Inventory.MaxAmount 6 (line 395-401) and the reload loop stops at
  # A_JumpIfInventory("RocketRounds", 6, "NoNeedToReload") (lines 264, 287). The drum has
  # SEVEN chambers and the seventh is never loaded, which is why the two numbers differ.
  capacity  = 6
  magfamily = "bd_rocket"
  # NO CASE LEAVES THIS GUN (2026-10-02): rockets leave by the bore; nothing is thrown out. Unstated, a card MEANS
  # yes (parser.zs:1776-1781), so this gun threw brass out of the ejectport below --
  # which on a gun with no port at all is just the emptier wall of the receiver, so the
  # brass appeared beside the gun rather than from it. The port stays: rig.zs:3122
  # throws LIVE rounds from that same point when a breech opens.
  casing    = none

  muzzle    = 65.789, 3.235, -1.433
  barrel    = 1, 0, 0
  # side measured (62 vertices on -y against 685 on +y), the emptier wall of the receiver; the point and the direction are estimates
  ejectport = -5.203, -2.156, -2.027
  ejectdir  = -0.2914, -0.8742, 0.3885

