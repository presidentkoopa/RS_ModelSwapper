  # BD22, measured from Brutal Doom's own DECORATE 2026-10-02: the 4-tic contact loop, Saw.dec:318 -- already correct
  fullauto             = yes
  # STATED, NOT LEFT OUT. RSBDEFS' own rule: "ABSENCE IS NOT A STATEMENT" -- a missing key is
  # the house default and reads identically to a forgotten one, so a gun that genuinely wants
  # nothing says `none`. A saw has no muzzle at all (weapon.zs ShotSaw: "No muzzle flash"), and
  # its shake belongs to the motor, which `recoil chainsaw` is.
  recoilprofile        = "chainsaw"
  flashprofile         = "none"
end

