gun "BD_Flamethrower"
  class
    slot               = 6
    selectionorder     = 9617
    ammo               = "Cell"
    hand               = main
    name               = "Flamethrower"
    pickupmessage      = "Flamethrower"
  end
  capacity             = 200
  # A FLAME IS NOT A BULLET, so there is no roundprofile: `napalm` and `ww2_flame` are
  # `flame` profiles, a kind the sheet reader has no key for, and the fire is drawn by
  # whatever throws it. THE FLASH IS NOW STATED RATHER THAN OMITTED. `flash none` exists
  # for precisely this gun -- RSBDEFS calls it "a gun whose own effect is the muzzle (the
  # flamers)" -- and leaving the key out instead gave it the house default muzzle flash,
  # a rifle's bang in front of a flame jet.
  flashprofile         = "none"
  recoilprofile        = "ww2_flame"
  firetics             = 1
  # BD22, measured from Brutal Doom's own DECORATE 2026-10-02: one flame per tic, Hold: loop -- already correct
  fullauto             = yes
  firesound            = "Flamer/loop"       # the parent mod's own (Flamer2.ogg)
  # BD'S OWN FIRE WORK, WHICH IS THE WHOLE POINT OF THIS GUN. Flamethrower2's Hold is a strict
  # three-gout rotation (Flamethrower.dec:166-187: New, New2, New3, repeating, one a tic), and the
  # three are NOT interchangeable:
  #
  #   FlamethrowerProjectileNew    scale 0.15  the plain gout: sparks, one ember burst
  #   FlamethrowerProjectileNew2   scale 0.20  THE RICH ONE -- rolling smoke, fire particles,
  #                                            burning debris on death, and A_Explode(16, 128)
  #   FlamethrowerProjectileNew3   scale 0.17  the plain gout again, a size between the two
  #
  # Firing any single one of them every tic is wrong in both directions: New alone is a thin,
  # even, smokeless jet, and New2 alone is a 128-unit splash sixteen times a second. The roil
  # comes from the three sizes overlapping, and the smoke and embers from every third one.
  shotclasses          = "FlamethrowerProjectileNew, FlamethrowerProjectileNew2, FlamethrowerProjectileNew3"
  # BD jitters the gout +/-1 degree of yaw between gouts (A_SetAngle(random(1, -1) + angle),
  # :171). Its companion A_SetPitch climb is NOT copied: nothing moves the VR camera.
  shotspread           = 1.0, 0
end

