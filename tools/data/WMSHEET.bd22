gun "BD_FlameCannon"
  class
    slot               = 6
    selectionorder     = 9607
    ammo               = "Cell"
    hand               = main
    name               = "Flame Cannon"
    pickupmessage      = "Flame Cannon"
  end
  capacity             = 100
  # A FLAME IS NOT A BULLET, so there is no roundprofile: `napalm` and `ww2_flame` are
  # `flame` profiles, a kind the sheet reader has no key for, and the fire is drawn by
  # whatever throws it. THE FLASH IS NOW STATED RATHER THAN OMITTED. `flash none` exists
  # for precisely this gun -- RSBDEFS calls it "a gun whose own effect is the muzzle (the
  # flamers)" -- and leaving the key out instead gave it the house default muzzle flash,
  # a rifle's bang in front of a flame jet.
  flashprofile         = "none"
  recoilprofile        = "flamer_heavy"
  firetics             = 10
  # BD22, measured from Brutal Doom's own DECORATE 2026-10-02: Fireball path FlameCannon.dec:152
  fullauto             = yes
  firesound            = "Flamer/loop"       # the parent mod's own (Flamer2.ogg)
  shotclass            = "BigFireBallWithGravity"  # FlameCannon Fire
  # THE MUZZLE SPRAY, counted off BD's own Fireball state (FlameCannon.dec): ELEVEN
  # Shotgunparticles2 go out with every ball, not the four an earlier note here guessed at.
  # BD scatters them random(-12, 12) yaw and random(-9, 9) pitch; muzzlethrow has no spread of
  # its own yet, so they all go down the shot's line -- a tighter jet than BD's, and the gap
  # worth closing first if this one wants more work.
  muzzlethrow          = "Shotgunparticles2 x11"
end

