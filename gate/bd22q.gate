# bd22q -- the flagship. Run it with:  sh gate/run_set.sh gate/bd22q.gate [pk3]
#
# A .gate file is sourced by run_set.sh, so it is plain shell. Copy this for a new set and
# change the paths, the parent files, the guns and their ammo. Nothing else should need touching.

# ---- the machine -----------------------------------------------------------------------
QZD=/e/DOOMWork/QZD17-engine/build/Release
# NOT Freedoom: BD_VoxelPack's voxeldef names Doom 2's own sprites and Freedoom fails on it.
IWAD=/e/DOOMWork/QZD17-engine/build/Release/doom2.wad

# ---- the load order, parents first, the set under test last ------------------------------
FILES=(
	/e/DOOMWork/brutal22test6.pk3
	"/d/SteamLibrary/steamapps/Common/DooM VR/__Games/BrutalDoom/BD_VoxelPack.pk3"
)
PK3=dist/BD22Q_199c.pk3

# ---- what to fire ------------------------------------------------------------------------
# CLASS NAMES, not display names. Get them from the mod's own DECORATE: `ACTOR Shot_Gun :
# BrutalWeapon`, not "Shotgun". A name the engine does not know is given silently and the gun
# is simply never there -- which is why run_set.sh prints a marker per gun.
GUNS=(
	IncendiaryLauncher
	Machinegun
	MG42
	Flamethrower2
	Unmaker
	Shot_Gun
	SSG
	Revolver
)

# AMMO IS THE EASIEST WAY TO PASS WHILE TESTING NOTHING. An empty gun fires no shot, so it
# makes no casing, no muzzle flash, no tail and no impact -- and the run still reaches the end
# and still exits 0. This leg gave `Shell` for a day; BD22's Shotgun, SSG and Revolver all take
# Weapon.AmmoType1 "AmmoShell". Read each gun's AmmoType1 out of its DECORATE and give THAT.
AMMO="give Clip2 400; give AmmoM202 12; give AmmoShell 80; give RevolverAmmo 24; give Gas 200; give SoulAmmo 60; give AmmoRocket 10;"

# ---- timing --------------------------------------------------------------------------------
# RAISE was 10 and that was too short: BD22's weapons have long select animations, so +attack
# landed during the raise and the gun never fired. 40 works for this mod. If a gun shows a
# marker but produces no effect, suspect this before you suspect your code.
RAISE=40
FIRE=25
SETTLE=20

# faults in the parent mod and the voxel pack that are not ours and never will be
IGNORE="voxeldef|DeathSphereHealth|REGT value|limbs.dec|aaliens|eeevilll"
