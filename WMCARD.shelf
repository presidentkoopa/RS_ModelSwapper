# ============================================================================
# WMCARD.shelf.raw5 -- written from our OWN measurements.
#
# Every number here came out of the gun's own reload animation, measured by
# md3label on the ANIMATED mesh this mod ships. No static _wm world model was
# read at any point, and nothing was carried over from another gun's card.
# ============================================================================

weapon "MS_Pistol2"
  type      = pistol
  model     = "models/hud/Pistol" "pistolet.md3"
  skin      = "models/hud/Pistol" "WPN-9mm2.png"
  capacity  = 12
  muzzle    = 12.19, 0.67, 4.06
  barrel    = 1, 0, 0
  ejectport = 1.66, 1.77, -0.65
  ejectdir  = 0.0, 1.0, 0.0
  magmodel  = "models/hud/Pistol" "MS_Pistol2_mag.md3"
  magskin   = "models/hud/Pistol" "WPN-9mm2.png"
  magscale  = 1.0
  magcenter = -3.27, -0.11, -5.65
end

grip
  palm = -9.22, 1.16, 0.47
  seat = -5.81, -0.11, 3.92
  supportat = 2.31, -0.09, 2.94
  rake = 0
end

# the magazine, measured from the gun's own reload animation  # stroke taken from the insertion frames; travel_clear said 16.82, which is the part's whole journey from wherever it is parked
part magazine
  role    = feed
  surface = mag
  grab       = -3.27, -0.11, -5.65
  grabradius = 2.5
  dof
    kind     = slide
    axis     = -1.000, -0.000, 0.001
    distance = 3.86
  end
end

