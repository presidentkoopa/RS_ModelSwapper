# ============================================================================
# WMCARD.shelf -- written from our OWN measurements.
#
# Every number here came out of the gun's own reload animation, measured by
# md3label on the ANIMATED mesh this mod ships. No static _wm world model was
# read at any point, and nothing was carried over from another gun's card.
# ============================================================================

weapon "MS_BD_BrutalSMG"
  type      = smg
  model     = "models/hud/SMG" "BrutalSMG.md3"
  skin      = "models/hud/SMG" "BrutalSMG.png"
  capacity  = 32
  muzzle    = 25.36, -0.92, 2.0
  barrel    = 1, 0, 0
end

grip
  triggerat = -6.46, -0.16, 1.34
  palm = -7.17, 1.73, -9.92
  seat = -8.58, -1.86, 2.16
  supportat = 3.25, -0.0, 1.18
  rake = 0
end

# the magazine, measured from the gun's own reload animation
part magazine
  role    = feed
  surface = mag
  grab       = 4.01, -0.18, -8.22
  grabradius = 2.5
  dof
    kind     = slide
    axis     = -0.298, 0.0, -0.954
    distance = 16.76
  end
end

