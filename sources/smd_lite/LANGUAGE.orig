[enu default]

QUITMSG1 = "please don't leave, there's more\nkoopas to stomp!";
QUITMSG2 = "i'd say he's hot on our tail!";
QUITMSG3 = "i wish luigi were here,\ni could blame him!";
QUITMSG4 = "you're trying to say you like sega\nbetter than me, right?";
QUITMSG5 = "thank you mario!\nbut our princess is in another castle!";
QUITMSG6 = "step right up, if you're ready\nto get... toasted!";
QUITMSG7 = "i'd insult you if I were smart enough.";

QUITMSG8 = "hey, are you a man or\na mouser?";
QUITMSG9 = "what are we supposed to do? wave\na magic wand and make it all go away?";
QUITMSG10 = "looks like you're plumber out of luck!";
QUITMSG11 = "don't question my orders,\nyou rotten rodent! just do it!";
QUITMSG12 = "brave men die a single death;\ncowards marry fish-head mermaids!";
QUITMSG13 = "sounds good to me! let's just\nforget about these koopa guys!";
QUITMSG14 = "you don't scare me,\nyou linguini-lickin' loser!";

