# WM_RotaryLauncher, carried from WMCARD.10_launcher onto the ANIMATED mesh.
# source card measured against the static _wm copy;
#   rotation 0.0 deg, translation [54.94, 0.12, -7.33], fit residual 0.0
# points rotated and shifted; directions rotated only; lengths untouched.
weapon "WM_RotaryLauncher"
  hand      = off
  type      = launcher
  prop      = "WM_PropRotaryLauncher"
  model     = "models/meat/RPG" "RPG.md3"
  skin      = "models/vanilla/launchers/RotaryLauncher" "RPG.png"

  firesfrom = reserve
  casing    = none
  hands     = 1

  # ESTIMATE, WHICH TUBE: the top one, 11.1 above the cluster's axis (y -0.35, z -1.68), at its front
  # (x 42.68). The rockets' noses point +x.
  muzzle    = 97.618, -0.195, 2.112
  barrel    = 1.000, 0.000, 0.000

  # This package's launcher sounds (SNDINFO wm/rocket/*).
  firesound = "wm/rocket/fire"
  drysound  = "wm/dry"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropRotaryLauncher is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = 31.024, -0.227, -0.010
  supportat = 48.742, 9.761, 1.818
  palm = 28.748, -0.247, -5.175
  rake = 52.8
  seat = 28.363, 0.250, 5.284
end

# 15.05 degrees about the pin at -20.125, 4.086 (source frame 6, fit 0.010). Sign checked: +15.05 lands the
# rest centroid 0.001 off frame 6; -15.05 misses by 1.583.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0.000, 1.000, 0.000
    degrees = 15.05
    pivot   = 34.812, 0.125, -3.242
  end
end

# THE OTHER HAND ON THE ANGLED FRONT HANDLE: its centroid, as the rotary gun's. ESTIMATE: where on it the
# hand goes.
part support
  role    = support
  subject = support
  grab       = 47.038, 4.045, -1.878
  grabradius = 3.0
end

# THE TUBES TURN AS IT FIRES: the donor turns every tube surface 45.0 degrees about +x over source frames
# 1-3 (fit 0.014 or better), about the cluster's axis through (y -0.35, z -1.68). Six tubes, so one period
# is 60 degrees. `spin = fire` turns it for one fire cycle after each shot; 3 degrees a tic over a vanilla
# rocket cycle of about 20 tics steps it about one tube a rocket. Rate ESTIMATE. Looks only.
part tubes
  surface  = tubes
  spin     = fire
  spinrate = 3
  spinup   = 0
  spindown = 0
  dof
    kind    = hinge
    axis    = 1.000, 0.000, 0.000
    pivot   = 54.938, -0.225, -9.008
    degrees = 60
  end
end
