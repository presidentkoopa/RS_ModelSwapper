# WM_Chaingun, carried from WMCARD.09_chaingun onto the ANIMATED mesh.
# source card measured against the static _wm copy;
#   rotation 30.0 deg, translation [55.80, 0.48, -42.00], fit residual 0.0382
# points rotated and shifted; directions rotated only; lengths untouched.
weapon "WM_Chaingun"
  type      = chaingun     # its hand-seat profile (the key landed in c688186)
  hand      = main
  prop      = "WM_PropChaingun"
  model     = "models/bd/Minigun" "minigun.md3"
  skin      = "models/vanilla/chainguns/ChaingunGH" "Minigun.png"

  # FIRES FROM THE RESERVE, as WM_MachineGun and WM_RotaryGun: nothing on the mesh holds rounds.
  # No capacity, no magazine part, no chamber, no cycle verb.
  firesfrom = reserve
  # ONE HAND FIRES, ALWAYS (the owner, 2026-09-26). The support part below stays:
  # the other hand may steady it, but it is never required to shoot.
  hands     = 1

  # THE CLUSTER'S AXIS AT THE BARRELS' FRONT FACE (donor x 123.45). Six tubes turn about it at
  # radius 8.1 and none stands at twelve o'clock (the top two are 30 degrees either side), so the
  # shot leaves on the axis.
  muzzle    = 103.009, 0.332, -68.472
  barrel    = 0.866, -0.000, -0.500

  # ESTIMATE: the receiver's -y wall behind the barrels (donor x 56..66, z -14..-4), the side
  # away from the handle, as WM_RotaryGun's. ejectdir ESTIMATE, the rifles'.
  ejectport = 48.947, -13.414, -39.490
  ejectdir  = -0.060, -0.900, 0.496

  # This package's chaingun sounds (SNDINFO wm/chaingun/*). The last three are the barrels'
  # wind-up, loop and wind-down (part barrels' spin).
  firesound     = "wm/chaingun/fire"
  drysound      = "wm/dry"
  spinupsound   = "wm/chaingun/spinup"
  spinsound     = "wm/chaingun/spin"
  spindownsound = "wm/chaingun/spindown"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropChaingun is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = 25.676, -0.003, -19.983
  supportat = 52.236, 23.079, -33.676
  palm = 19.096, -0.014, -19.047
  rake = 25.9
  seat = 26.810, 0.005, -14.354
end

# 20.01 degrees about the pin at -35.631, 6.618 (donor frames 8-11 against the body, fit 0.007).
# Sign checked: +20.01 lands its rest centroid 0.000 off frame 8; -20.01 misses by 2.05. Follows
# your finger.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0.001, 1.000, 0.001
    degrees = 20.01
    pivot   = 28.254, 0.478, -18.450
  end
end

# THE OTHER HAND ON THE SIDE HANDLE: the bar standing out of the receiver's +y side (y 9.88..26.75
# in the donor, radius 2.0), its middle. The only handle ahead of the grip.
part support
  role    = support
  subject = support
  grab       = 52.220, 18.309, -33.603
  grabradius = 3.0
end

# THE BARRELS SPIN while the trigger is held, about the cluster's axis (1, 0, 0) through
# (y -0.151, z 0.678). The donor's frames 4-7 turn its barrels 0 / 25.60 / 80.39 / 106.00 degrees
# about +x (fit 0.012-0.014) and wrap. Its clamps repeat every 120 degrees (turned 120 the
# barrels land on themselves, median miss 0.017; turned 60 they do not), so one period is 120,
# which the donor turns in 4 tics: 30 degrees a tic at full speed. spinup 4 and spindown 20 are
# kept from before, ESTIMATE. Looks only -- it never holds off the shot.
part barrels
  surface  = barrels
  spin     = trigger
  spinrate = 30
  spinup   = 4
  spindown = 20
  dof
    kind    = hinge
    axis    = 0.866, -0.000, -0.500
    pivot   = 56.140, 0.333, -41.412
    degrees = 120
  end
end

# ==========================================================================
# LIVE: the machinegun family (WM_MachineGun).
# Measured and drafted in _pending/MACHINEGUN_UBL.md.
# ==========================================================================

# ======================================================== MACHINE GUN -- OFF HAND
# RS_ModelSwapper's belt-fed machine gun as machinegun_wm.md3. THE BULLETS COME FROM THE
# RESERVE; THE RELOAD IS THE UNDERBARREL GRENADE LAUNCHER. _pending/MACHINEGUN_UBL.md.
