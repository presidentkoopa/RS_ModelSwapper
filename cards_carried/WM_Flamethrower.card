# WM_Flamethrower, carried from WMCARD.13_flamethrower onto the ANIMATED mesh.
# source card measured against the static _wm copy;
#   rotation 0.0 deg, translation [57.03, 0.47, -8.36], fit residual 0.0
# points rotated and shifted; directions rotated only; lengths untouched.
weapon "WM_Flamethrower"
  type      = flamethrower     # its hand-seat profile (the key landed in c688186)
  hand      = off
  prop      = "WM_PropFlamethrower"
  model     = "models/bd/Flamethrower2" "Flamethrower2.md3"
  skin      = "models/vanilla/flamers/Flamethrower2" "Flamethrower2.png"
  # fires straight from the canister's store.
  firesfrom = magazine
  casing    = none
  # ONE DOOM CELL PACK, as the Flamer's: 100 cells, 5.7 seconds at FireTics 2. ESTIMATE.
  capacity  = 100
  magfamily = "flamethrower"
  # THE MAIN NOZZLE: the shroud's mouth ring at x 53.28 (y -4.70..3.80, z 3.83..7.22), its centre. Level.
  muzzle    = 110.311, 0.019, -2.839
  barrel    = 1.000, 0.000, 0.000
  # The loose canister: this gun's own canister surface lifted out and re-origined on its centroid (md3_write.extract).
  # It lies as it lies in the gun, along x; its pull axis is -z. magscale 0.34 = 1.0 x 0.34.
  magmodel  = "models/vanilla/flamers/Flamethrower2" "wm_flamethrower2_can.md3"
  magskin   = "models/vanilla/flamers/Flamethrower2" "Flamethrower2.png"
  magscale  = 0.34
  magcenter = 56.571, 0.013, -10.170
  # As the Flamer's: the flame is RS_Ballistics'; the canister takes the plasma cell foley. ESTIMATE.
  magoutsound  = "wm/plasma/magout"
  maginsound   = "wm/plasma/magin"
  drysound     = "wm/dry"
  magdropsound = "wm/magdrop"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropFlamethrower is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = 28.601, 0.011, -7.914
  supportat = 57.182, 0.010, -14.546
  palm = 26.845, -0.014, -2.523
  rake = 75.2
  seat = 32.241, 0.009, -1.267
end

# THE CANISTER, STRAIGHT DOWN. The tank (a body island of 496 vertices) and its two end caps, ringed by two straps and
# sitting over a valve pipe at its rear underside. No line out of it is clear of the gun -- back is the grip and hose,
# forward the heat shield, up the barrel -- so it drops straight down, the least in the way: it passes through the
# straps' lower loops and the top of the rear valve pipe (z -3.25, x -12.6..-10.2) as it goes. Distance: its top (z 4.67)
# down past the straps' bottoms (z -8.55), plus 0.4.
part canister
  role    = feed
  subject = magazine
  take    = no          # out by its button, in by the hand carrying one
  surface = canister
  # Its underside, the lowest half unit of it: the hand takes it from below.
  grab       = 57.411, 0.009, -16.879
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.000, 0.000, -1.000
    distance = 13.62
    detach   = 0.9
  end
end

# THE TRIGGER: a hinge in the donor, 14.98 degrees about (0, 1, 0) through its pin, fit 0.009 (tools/card_skeleton.py at
# frame 3; +14.98 lands it, -14.98 misses by 1.949). The pin as the re-origin moved it.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0.000, 1.000, 0.000
    degrees = 14.98
    pivot   = 35.121, -0.001, -7.019
  end
end

# THE DONOR'S PILOT FLAME: an untextured cone on the side igniter's tip (centroid 55.50, 3.53, 0.19). Hidden, as the
# Flamer's, while RS_Ballistics draws the live one.
part pilotflame
  role    = hidden
  surface = pilotflame
end

# THE OTHER HAND ON THE BARREL: the top tube's underside just ahead of the heat shield (x 25.55..27.44, z 6.02), before
# the tube bends down to the shroud. The point is MEASURED; that the hand goes there is an ESTIMATE.
part support
  role    = support
  subject = support
  grab       = 83.711, -0.001, -2.339
  grabradius = 3.0
end
