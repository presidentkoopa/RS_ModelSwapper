	// the action locks open on an empty gun (card holdopen, or genpack's default rule)
	clearscope static bool SlideLock(int i)
	{
		static const bool v[] = { false, true, true, true, false, false, false, false, false, false };
		return i > 0 && i < v.Size() && v[i];
	}
}

// every sprite the reload shows (MODELDEF.rsr), so the engine knows the names; never spawned
class RSR_GunSprites : Actor
{
	States
	{
	Spawn:
		Q01M AB 0;	// WM_BreachGlock
		Q01P AB 0;
		Q01W A 0;
		Q02M AB 0;	// WM_BreachGlockS
		Q02P AB 0;
		Q02W A 0;
		Q03M AB 0;	// WM_BreachKimber
		Q03P AB 0;
		Q03W A 0;
		Q04M AB 0;	// WM_BreachMK18
		Q04P AB 0;
		Q04W A 0;
		Q05M AB 0;	// WM_BreachMK18S
		Q05P AB 0;
		Q05W A 0;
		Q06M AB 0;	// WM_BreachHK416S
		Q06P AB 0;
		Q06W A 0;
		Q07M AB 0;	// WM_BreachMCX
		Q07P AB 0;
		Q07W A 0;
		Q08M A 0;	// WM_BreachG36C
		Q08P A 0;
		Q08W A 0;
		Q09M AB 0;	// WM_BreachMP5
		Q09P AB 0;
		Q09W A 0;
		Stop;
	}
}

// the rounds of a magazine that was dropped, held until a magazine is home (the sets top up,
// so nothing is lost and the reserve's cap cannot eat them)
