// generated by team/reload/tools/gen_rsr.py -- do not edit by hand
// Real VR reload: per gun. Positions cm in the weapon controller's frame (F, L, U);
// hooks are ModifyBobLayer3D translations for the gun's own MODELDEF placement.

class RSR_Guns abstract
{
	clearscope static int Count() { return 9; }

	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		Name n = w.GetClassName();
		if (n == 'WM_BreachGlock')	return 1;
		if (n == 'WM_BreachGlockS')	return 2;
		if (n == 'WM_BreachKimber')	return 3;
		if (n == 'WM_BreachMK18')	return 4;
		if (n == 'WM_BreachMK18S')	return 5;
		if (n == 'WM_BreachHK416S')	return 6;
		if (n == 'WM_BreachMCX')	return 7;
		if (n == 'WM_BreachG36C')	return 8;
		if (n == 'WM_BreachMP5')	return 9;
		return 0;
	}

