// generated by c2q/handfit_cards.py from the set's cards -- do not edit by hand
// Per gun: gun-hand frame (one hand, two hands), its hook and rotation, support frame, its hook
// and rotation (ModifyBobLayer3D units), and where the support hand holds the gun
// (metres in the gun hand's frame: forward, left, up). Ermac's poses, moved onto each gun
// by the kit's ICP anchored on the card's palm / supportat.
class RSQ_HandTable abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		if (w is 'DoomPistol')	return 1;
		if (w is 'DoomShotgun')	return 2;
		if (w is 'DoomSuperShotgun')	return 3;
		if (w is 'DoomChaingun')	return 4;
		if (w is 'DoomRocketLauncher')	return 5;
		if (w is 'DoomPlasmaRifle')	return 6;
		if (w is 'DoomBFG9000')	return 7;
		if (w is 'DoomChainsaw')	return 8;
		return 0;
	}

