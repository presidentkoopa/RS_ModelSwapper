		case 9:	return "weapons/barrelpain";
		case 10:	return "";
		case 11:	return "";
		case 12:	return "";
		}
		return "";
	}

	clearscope static String Reserve(int i)
	{
		switch (i)
		{
		case 1:	return "Clip2";
		case 2:	return "Clip1";
		case 3:	return "Clip1";
		case 4:	return "Mauser9mm";
		case 5:	return "AmmoShell";
		case 6:	return "AmmoCell";
