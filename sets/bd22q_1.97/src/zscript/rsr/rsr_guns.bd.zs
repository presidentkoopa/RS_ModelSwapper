// generated by team/reload/tools/gen_rsr.py -- do not edit by hand
// Real VR reload: per gun. Positions cm in the weapon controller's frame (F, L, U);
// hooks are ModifyBobLayer3D translations for the gun's own MODELDEF placement.

class RSR_Guns abstract
{
	// 1.93: the Ruger Mini-14 Ranch, measured from models/bd/XM21/XM21.md3 through rgeo.py
	// (index 8). Every other index is still the generator's. Re-run gen_rsr.py when the
	// gun goes through the real reload survey and these are what it should reproduce.

	clearscope static int Count() { return 12; }

	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		Name n = w.GetClassName();
		if (n == 'Rifle')	return 1;
		if (n == 'BrutalPistol')	return 2;
		if (n == 'BrutalSMG')	return 3;
		if (n == 'MP40')	return 4;
		if (n == 'AssaultShotgun')	return 5;
		if (n == 'RailGun')	return 6;
		if (n == 'Plasma_Gun')	return 7;
		if (n == 'Sniper')	return 8;
		if (n == 'Rocket_Launcher')	return 9;
		if (n == 'MG42')	return 10;
		if (n == 'Flamethrower2')	return 11;
		if (n == 'Unmaker')	return 12;
		return 0;
	}

	// the magazine's top, seated
	clearscope static Vector3 Well(int i)
	{
		switch (i)
		{
		case 1:	return (12.000, 0.400, 1.000);
		case 2:	return (-3.000, -0.000, -2.200);
		case 3:	return (17.800, -0.000, -4.800);
		case 4:	return (31.400, -0.000, 1.800);
		case 5:	return (15.600, 0.000, -4.200);
		case 6:	return (22.100, 0.000, -3.500);
		case 7:	return (12.600, 0.000, -10.000);
		case 8:	return (13.094, 0.244, 4.909);	// 1.93 Ruger (was (11.600, 0.600, 3.200))
		case 9:	return (-12.200, 2.200, 6.700);
		case 10:	return (13.926, 3.115, 11.593);
		case 11:	return (28.489, 0.010, 0.460);
		case 12:	return (11.814, 1.253, 12.280);
		}
		return (0, 0, 0);
	}

