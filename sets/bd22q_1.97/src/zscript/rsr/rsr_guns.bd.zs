// every sprite the reload shows (MODELDEF.rsr), so the engine knows the names; never spawned
class RSR_GunSprites : Actor
{
	States
	{
	Spawn:
		RQRM ABC 0;	// BD22/Rifle
		RQRP ABC 0;
		RQRW A 0;
		RQPM ABC 0;	// BD22/BrutalPistol
		RQPP AB 0;
		RQPW A 0;
		RQBM ABC 0;	// BD22/BrutalSMG
		RQBP AB 0;
		RQBW A 0;
		RQMM AB 0;	// BD22/MP40
		RQMP AB 0;
		RQMW A 0;
		RQAM ABC 0;	// BD22/AssaultShotgun
		RQAP AB 0;
		RQAW A 0;
		RQLM A 0;	// BD22/RailGun
		RQLP A 0;
		RQLW A 0;
		RQZM A 0;	// BD22/Plasma_Gun
		RQZP A 0;
		RQZW A 0;
		RQKM AB 0;	// BD22/Sniper
		RQKP ABC 0;	// 1.93: C is the bolt, which the Ruger has and the old mesh did not
		RQKW A 0;
		RQDM A 0;	// BD22/Rocket_Launcher
		RQDP A 0;
		RQDW A 0;
		Stop;
	}
}

// the rounds of a magazine that was dropped, held until a magazine is home (the sets top up,
// so nothing is lost and the reserve's cap cannot eat them)
class RSR_Held_Rifle : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }
class RSR_Held_BrutalPistol : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }
