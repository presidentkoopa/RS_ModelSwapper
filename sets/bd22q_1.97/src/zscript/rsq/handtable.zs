// generated by rsq_hands_gen_melee.py (rsq_hands_gen.py + axe / chainsaw) from fits_bd22_v9.json -- do not edit by hand
// Per gun: gun-hand frame (one hand, two hands), its hook and rotation, support frame, its hook
// and rotation (ModifyBobLayer3D units), and where the support hand holds the gun
// (metres in the gun hand's frame: forward, left, up).

// 1.30 (owner): the rifle (index 18) is held by the M203 tube: support pose C, fitted under the
// tube clear of the barrel (kitbash/supsearch3.py, supview.py).
class RSQ_HandTable abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		if (w is 'AssaultShotgun')	return 1;
		if (w is 'BFG10k')	return 2;
		if (w is 'BIG_FUCKING_GUN')	return 3;
		if (w is 'BrutalPistol')	return 4;
		if (w is 'BrutalSMG')	return 5;
		if (w is 'Devastator')	return 6;
		if (w is 'Flamethrower2')	return 7;
		if (w is 'GrenadeLauncher')	return 8;
		if (w is 'HellishMissileLauncher')	return 9;
		if (w is 'IncendiaryLauncher')	return 10;
		if (w is 'MG42')	return 11;
		if (w is 'MP40')	return 12;
		if (w is 'Minigun')	return 13;
		if (w is 'NukeLauncher')	return 14;
		if (w is 'Plasma_Gun')	return 15;
		if (w is 'RailGun')	return 16;
		if (w is 'Revolver')	return 17;
		if (w is 'Revolver2')	return 17;	// 1.97: the Shotvolver draws sprite REVO on this same mesh and has no MODELDEF of its own, so it is the Revolver's fit. Without this line it fell through to 0, the unfitted default.
		if (w is 'Rifle')	return 18;
		if (w is 'Rocket_Launcher')	return 19;
		if (w is 'SSG')	return 20;
		if (w is 'Shot_Gun')	return 21;
		if (w is 'Sniper')	return 22;
		if (w is 'Unmaker')	return 23;
		if (w is 'BrutalAxe')	return 24;
		if (w is 'Chain_saw')	return 25;
		if (w is 'DSweap')	return 26;
		if (w is 'Machinegun')	return 27;	// 1.97: the BD21 Machinegun (c2q/bd22_mg.py: kit ICP on the REMA card's palm / supportat)	// 2026-10-23: the Dragonslayer, two-handed (work/ds_fit.py)
		return 0;
	}

