// RS VR scopes: the per-gun table and the collimated DOT (scope.zs, shared), then the
// magnified see-through REAL mode that renders into the glass (scope_real.zs). scope.zs
// must come first -- scope_real.zs reads RSQ_ScopeTable. If another lane also lists
// scope.zs the duplicate is harmless: the parser keeps one entry per include path
// (zcc_parser.cpp AddInclude).
#include "zscript/rsq/scope.zs"
#include "zscript/rsq/scope_real.zs"
#include "zscript/rsq/alts.zs"
#include "zscript/rsq/casemodels.zs"
#include "zscript/rsq/casings.zs"
#include "zscript/rsq/dualtable.zs"
#include "zscript/rsq/dual.zs"
#include "zscript/rsq/voxtable.zs"
#include "zscript/rsq/voxels.zs"

// RS real VR reload (zscript/rsr, from the reload release)
#include "zscript/rsr/rsr_assist.zs"
#include "zscript/rsr/vreload.zs"
#include "zscript/rsr/rsb_guns.zs"
