rsb/impact/concrete2         sounds/rsb/impact_concrete/bulletimpact2.ogg
rsb/impact/concrete3         sounds/rsb/impact_concrete/bulletimpact3.ogg
rsb/impact/concrete4         sounds/rsb/impact_concrete/bulletimpact4.ogg
rsb/impact/concrete5         sounds/rsb/impact_concrete/bulletimpact5.ogg
rsb/impact/concrete6         sounds/rsb/impact_concrete/bulletimpact6.ogg
rsb/impact/concrete7         sounds/rsb/impact_concrete/bulletimpact7.ogg
rsb/impact/concrete8         sounds/rsb/impact_concrete/bulletimpact8.ogg
rsb/impact/concrete9         sounds/rsb/impact_concrete/bulletimpact9.ogg
rsb/impact/concrete10        sounds/rsb/impact_concrete/bulletimpact10.ogg
rsb/impact/concrete11        sounds/rsb/impact_concrete/bulletimpact11.ogg
$random rsb/impact/concrete { rsb/impact/concrete1 rsb/impact/concrete2 rsb/impact/concrete3 rsb/impact/concrete4 rsb/impact/concrete5 rsb/impact/concrete6 rsb/impact/concrete7 rsb/impact/concrete8 rsb/impact/concrete9 rsb/impact/concrete10 rsb/impact/concrete11 }
