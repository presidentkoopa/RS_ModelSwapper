// are alpha-tested at gl_mask_threshold, so a clear surface is not drawn).

// the gun without its magazine (ready frame)
Model RailGun
{
	Path "models/bd/RailGun"
	Model 0 "RailGun.md3"
	SurfaceSkin 0 0 "RailGun.png"
	// The lens wears its own glass tile, not the gun atlas: both scope lenses were
	// reprojected to 0..1 (tool/md3_carve_surface.py --project-only) so REAL mode can
	// render a camera texture through them, which means they no longer sample the
	// authored skin at all. scope_real.zs swaps this for the camera texture when REAL.
	SurfaceSkin 0 1 "scope_glass.png"
	SurfaceSkin 0 2 "RailGun.png"
	SurfaceSkin 0 3 "RailGun.png"
	SurfaceSkin 0 4 "rsr_clear.png"
	Scale -1.0000 1.0000 1.0000
	Offset 0.0000 0.0000 0.0
	ZOffset -5.0000
	NoInterpolation
	FrameIndex RQLM A 0 3
}

