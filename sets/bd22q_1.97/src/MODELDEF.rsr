// RS real VR reload: BD22/Sniper drawn as the Ruger Mini-14 Ranch (1.93).
// The sniper is a weapon again (zscript/nosniper/nosniper.zs). Placement solved through
// team/reload_merged/tools/rgeo.py: Scale for a 95.25 cm rifle, Offset / ZOffset to sit
// where BD22/Rifle's body sits. Pieces shown or hidden by a clear skin, as every other gun.
// Surfaces: 0 round 1 bolt 2 charging handle 3 scope 4 mag release 5 magazine 6 safety
//           7 scope rings 8 trigger 9 body

// the whole gun, on BD22's own sprite runs
Model Sniper
{
	Path "models/bd/XM21"
	Model 0 "XM21.md3"
	SurfaceSkin 0 0 "223_rem.png"
	SurfaceSkin 0 1 "mini14.png"
	SurfaceSkin 0 2 "mini14.png"
	SurfaceSkin 0 3 "leupold_vx1.png"
	SurfaceSkin 0 4 "mini14.png"
	SurfaceSkin 0 5 "mini14.png"
	SurfaceSkin 0 6 "mini14.png"
	SurfaceSkin 0 7 "leupold_vx1.png"
	SurfaceSkin 0 8 "mini14.png"
	SurfaceSkin 0 9 "mini14.png"
	// The lens wears its own glass tile, not the gun atlas: both scope lenses were
	// reprojected to 0..1 (tool/md3_carve_surface.py --project-only) so REAL mode can
	// render a camera texture through them, which means they no longer sample the
	// authored skin at all. scope_real.zs swaps this for the camera texture when REAL.
	SurfaceSkin 0 10 "scope_glass.png"
	Scale -10.4850 10.4850 10.4850
	Offset -0.2816 -44.5467 0.0
	ZOffset -6.3157
	NoInterpolation
	FrameIndex X21G A 0 0
	// X21F / P21F: the FIRING pose, same single mesh frame as the ready pose. Without
	// these the model silently stops drawing the instant the gun fires and the 2D sprite
	// shows for the whole rest of the sequence, because every state after it is "####"
	// and inherits X21F. gen_rsr.py knows ready_sprites only; it needs the fire sprites
	// too or a regenerate drops this.
	FrameIndex	X21F	A	0	0
	FrameIndex	P21F	A	0	0
	// F11: Fire's "####" B 1 and "####" C 2 inherit X21F (and P21F zoomed), so B and C too.
	FrameIndex	X21F	B	0	0
	FrameIndex	X21F	C	0	0
	FrameIndex	P21F	B	0	0
	FrameIndex	P21F	C	0	0
	FrameIndex X21G B 0 0
	FrameIndex X21G C 0 0
	FrameIndex X21G D 0 0
	FrameIndex X21G E 0 0
	FrameIndex X21G F 0 0
	FrameIndex X21R A 0 0
	FrameIndex X21R B 0 0
	FrameIndex X21R C 0 0
	FrameIndex X21R D 0 0
	FrameIndex X21R E 0 0
	FrameIndex X21R F 0 0
	FrameIndex X21R G 0 0
	FrameIndex X21R H 0 0
	FrameIndex X21R I 0 0
	FrameIndex X21R J 0 0
	FrameIndex X21R K 0 0
	FrameIndex X21R L 0 0
	FrameIndex X21R M 0 0
	FrameIndex X21R N 0 0
	FrameIndex X21R O 0 0
	FrameIndex X21R P 0 0
	FrameIndex X21R Q 0 0
	FrameIndex X21R R 0 0
	FrameIndex X21R S 0 0
	FrameIndex X21R T 0 0
	FrameIndex X21R U 0 0
	FrameIndex X21R V 0 0
	FrameIndex X21R W 0 0
	FrameIndex X22R A 0 0
	FrameIndex X22R B 0 0
	FrameIndex X22R C 0 0
	FrameIndex X22R D 0 0
	FrameIndex X22R E 0 0
	FrameIndex X22R F 0 0
	FrameIndex X22R G 0 0
	FrameIndex X22R H 0 0
	FrameIndex X22R I 0 0
	FrameIndex X22R J 0 0
	FrameIndex X22R K 0 0
	FrameIndex X22R L 0 0
	FrameIndex X22R M 0 0
	FrameIndex X22R N 0 0
	FrameIndex X22R O 0 0
	FrameIndex X22R P 0 0
	FrameIndex X22R Q 0 0
	FrameIndex X22R R 0 0
	FrameIndex X22R S 0 0
	FrameIndex X23R A 0 0
	FrameIndex X23R B 0 0
	FrameIndex X23R C 0 0
	FrameIndex X23R D 0 0
	FrameIndex X23R E 0 0
	FrameIndex X23R F 0 0
	FrameIndex X23R G 0 0
	FrameIndex X23R H 0 0
	FrameIndex X23R I 0 0
	FrameIndex X23R J 0 0
	FrameIndex X23R K 0 0
	FrameIndex X23R L 0 0
	FrameIndex X23R M 0 0
	FrameIndex X21S A 0 0
	FrameIndex X21S B 0 0
	FrameIndex X21S C 0 0
	FrameIndex X21S D 0 0
	FrameIndex X21S E 0 0
	FrameIndex X21S F 0 0
	FrameIndex X21S G 0 0
	FrameIndex X21S H 0 0
	FrameIndex X21A A 0 0
	FrameIndex X21A B 0 0
	FrameIndex X21A C 0 0
	FrameIndex P21G A 0 0
}

