		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWG A 0
		"####" JIH 1
		goto ReadyToFire
	
	DM4:
		"####" WXYZ 1 A_CustomPunch(7,true,0,"SSawPuff2")
		goto FireContinue+17

	AltFire:
		"####" A 0 A_AlertMonsters
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)
		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWG A 0
		"####" NOPPQ 1
	AltFireLoop:
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,3)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,2)
		SAWG A 0
		"####" A 0
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		"####" "#" 0 A_Quake(1,5,0,12,"")
		"####" A 0 A_PlaySoundEx("Chainsaw/Loop","Weapon",0)
		"####" R 1
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DMAlt")
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" S 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
	AltFireLoop2:
		"####" T 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" U 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" A 0 A_ReFire("AltFireLoop")
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		"####" VWON 1
		goto ReadyToFire
	
	DMAlt:
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3DM")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" S 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3DM")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
	AltFireLoop2:
		"####" T 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3DM")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" U 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3DM")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" A 0 A_ReFire("AltFireLoop")
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		"####" VWON 1
		goto ReadyToFire

	AltContinueRed:
		1AWG A 0
		//"####" A 0 ACS_Execute(680, 0, 0, 0, 0)
		"####" A 0 ACS_NamedExecuteAlways("BloodSplashRed", 0, 0, 0, 0)
		"####" A 0 A_TakeInventory("PowerBlueBloodOnVisor",1)
		"####" A 0 A_TakeInventory("PowerGreenBloodOnVisor",1)
		Goto AltContinue

	AltContinueBlue:
		2AWG A 0
		//"####" A 0 ACS_Execute(683, 0, 0, 0, 0)
		"####" A 0 ACS_NamedExecuteAlways("BloodSplashBlue", 0, 0, 0, 0)
		"####" A 0 A_TakeInventory("PowerBloodOnVisor",1)
		"####" A 0 A_TakeInventory("PowerGreenBloodOnVisor",1)
		Goto AltContinue

	AltContinueGreen:
		3AWG A 0
		//"####" A 0 ACS_Execute(682, 0, 0, 0, 0)
		"####" A 0 ACS_NamedExecuteAlways("BloodSplashGreen", 0, 0, 0, 0)
		"####" A 0 A_TakeInventory("PowerBlueBloodOnVisor",1)
		"####" A 0 A_TakeInventory("PowerBloodOnVisor",1)
		Goto AltContinue

	AltContinue:
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,3)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,2)
		SAWG A 0
		"####" "#" 0 A_Quake(1,5,0,12,"")
		"####" A 0 A_PlaySoundEx("Chainsaw/Loop","Weapon",0)
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		"####" XY 1
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DMAlt2")
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 5)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, 4)
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, 3)
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, 2)
		"####" A 0
		Goto AltFireLoop2
		"####" Z 1
		"####" "[" 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		"####" A 0 A_ReFire("AltFireLoop")
		"####" VWON 1
		goto ReadyToFire
	
	DMAlt2:
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3DM")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 5)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, 4)
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, 3)
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, 2)
		"####" A 0
		Goto AltFireLoop2
		"####" Z 1
		"####" "[" 1
		"####" A 0 A_CustomPunch(7,true,0,"SSawPuff3DM")
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 4)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed", 1, "AltContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue", 1, "AltContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen", 1, "AltContinueGreen")
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		"####" A 0 A_ReFire("AltFireLoop")
		"####" VWON 1
		goto ReadyToFire

	StartSprint:
		SAWG A 1 A_WeaponReady(WRF_NOFIRE)
		SAWG A 0 A_Takeinventory("Zoomed",1)
		SAWG A 0 A_Takeinventory("ADSmode",1)
		SAWG A 0 A_ZoomFactor(1.0)
		SAWG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWS A 0
		"####" VWXY 1
	Sprinting:
		"####" A 0 offset(-9,32)
		//SAWG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		"####" A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprintTired")
		"####" A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		"####" A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		"####" A 0 offset(-9,32)
		"####" "[" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		"####" "[" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		"####" "[" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		"####" "[" 1 offset(0,38) A_SetPitch(pitch -0.5)
		"####" Z 1 offset(3,36) A_SetPitch(pitch -0.5)
		"####" Z 1 offset(6,34) A_SetPitch(pitch -0.5)
		"####" Z 1 offset(9,32) A_SetPitch(pitch -0.5)
		"####" A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		"####" A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		"####" Z 1 offset(9,34) A_SetPitch(pitch +0.5)
		"####" "[" 1 offset(6,36) A_SetPitch(pitch +0.5)
		"####" "[" 1 offset(3,38) A_SetPitch(pitch +0.5)
		"####" "[" 1 offset(0,38) A_SetPitch(pitch +0.5)
		"####" Z 1 offset(-3,36) A_SetPitch(pitch +0.5)
		"####" Z 1 offset(-6,34) A_SetPitch(pitch +0.5)
		"####" Z 1 offset(-9,32) A_SetPitch(pitch +0.5)
		"####" A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		"####" A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint


	StopSprint:
		//SAWG A 1
		"####" YXWV  1
		"####" A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3
	}
}

ACTOR SawDamageHorizontal: FastProjectile
{
	Radius 22
	Height 2
	DamageType Cut
	Projectile
	+FORCEXYBILLBOARD
	+EXTREMEDEATH
	+BLOODSPLATTER
	RenderStyle "None"
	Damage (random(5,6))
	Speed 45
	SeeSound "dsempty"
	DeathSound "dsempty"
	decal "AxeScrape2"
	States
	{
	Spawn:
		SAWG A 0 BRIGHT
		TNT1 A 1
		Stop

	Death:
		SAWG A 0
		TNT1 A 1 Radius_Quake(2, 3, 0, 4, 0)
		TNT1 A 10
		Stop

	XDeath:
		SAWG A 0
		TNT1 A 1 Radius_Quake(2, 3, 0, 4, 0)
		SAWG A 0 A_PlaySound("Chainsaw/Flesh", 1)
		TNT1 A 10
		Stop
	}
}

ACTOR SawDamageHorizontal2: SawDamageHorizontal
{
	-BLOODSPLATTER
	+BLOODLESSIMPACT
	+NODECAL
	decal "none"
}

ACTOR SawDamageHorizontal3: SawDamageHorizontal
{
	decal "AxeScrape3"
}

ACTOR SawDamageVertical: SawDamageHorizontal
{
	DamageType Saw
	Damage (random(7,8))
	decal "SawVertical"
}


ACTOR SawDamageVertical2: SawDamageVertical
{
	-BLOODSPLATTER
	+BLOODLESSIMPACT
}