// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire).
Actor Chain_saw : BrutalWeapon
{
	weapon.selectionorder 2200
	Weapon.KickBack 0
	+WEAPON.AXEBLOOD
	+WEAPON.MELEEWEAPON
	-WEAPON.NOAUTOFIRE
	-WEAPON.NOALERT
	-INVENTORY.UNDROPPABLE
	inventory.pickupsound "Chainsaw/Draw"
	Inventory.Pickupmessage "$BDGOTCHAINSAW"
	Tag "$TAGBD_SAW"
	Obituary "$OBBD_CHAINSAW"
	states
	{
	KickFlash: 
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWS A 0
		"####" VWXY 1
		"####" "[[ZZ[" 2//Z 10
		"####" YXWV 1
		stop
	SlideFlash: 
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWS A 0
		"####" VWXY 1
		"####" "[Z[Z[Z[Z[Z[Z[Z[Z[Z[Z[Z[Z[Z[Z[Z" 4
		stop
	SlideFlashEnd: 
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWS A 0
		"####" "[ZZ[[YXWV" 1
		stop
	SlideFlashEndEarly: 
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWS A 0
		"####" "[[YXWV" 1
		stop

	Spawn:
		CSAW A 1
		CSAW A -1
		Stop

	Reload: //or inspect
		"####" A 0 A_TakeInventory("Reloading",1)
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarningManual")
		"####" A 0 A_JumpIfInventory("DoInspect",1,"HoldReload")
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWS A 0
		"####" LKJII 1 A_WeaponReady(WRF_NOFIRE) 
		"####" A 0 A_PlaySound("Chainsaw/Zip", 1)
		"####" A 0 A_GiveInventory("DoInspect",1)
		"####" H 3 A_WeaponReady(WRF_NOFIRE)
		"####" GCC 1 A_WeaponReady(WRF_NOFIRE)
	HoldReload:
		"####" D 2 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWRELOAD)
		"####" EFG 1 A_WeaponReady(WRF_NOFIRE)
		"####" H 1 A_playsound("Chainsaw/Draw", 5)
		"####" IJKLM 1 A_WeaponReady(WRF_NOFIRE)
		"####" A 0 A_TakeInventory("DoInspect",1)
		"####" A 0 A_TakeInventory("Reloading",1)
		Goto Ready


	Deselect:
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		1AWS A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
		2AWS A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		3AWS A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,2)
		SAWS A 0
		"####" RSTU 1
		TNT1 A 0 A_SetCrosshair(0)
		SAWG A 0 A_StopSound(6)
		AXEG A 0 A_TakeInventory("PowerBloodOnVisor",1)
		AXEG A 0 A_TakeInventory("PowerBlueBloodOnVisor",1)
		AXEG A 0 A_TakeInventory("PowerGreenBloodOnVisor",1)
		SAWG A 0 A_TakeInventory("HasCutingWeapon",1)
		SAWG A 0 A_StopsoundEx("Weapon")
		SAWG AAAAAAAAAAAAAAAAAAAAAAAA 0 A_Lower
		Wait

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		SAWG A 0 A_Giveinventory("HasCutingWeapon",1)
		TNT1 A 0 A_SetCrosshair(41)
		SAWG A 0 A_Giveinventory("SawSelected",1)
		TNT1 A 1
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
		Goto SelectAnimation

	SelectAnimation:
		SAWS NOPQ 1 A_WeaponReady(WRF_NOFIRE) 
		SAWG A 0 A_PlaySound("Chainsaw/Zip", 1)
		SAWS A 3 A_WeaponReady(WRF_NOFIRE)
		SAWS BCCDDEFG 1 A_WeaponReady(WRF_NOFIRE)
		SAWS H 1 A_playsound("Chainsaw/Draw", 5)
		SAWS IJKLM 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
	ReadyToFire:
		TNT1 A 0 A_Giveinventory("HasCutingWeapon",1)
		TNT1 A 0 A_StopSound(4)
		TNT1 A 0 A_StopSound(1)
		TNT1 A 0 A_playsoundex("Chainsaw/Idle", 6)
		TNT1 A 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)
		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWG A 0
		"####" ABCDEFGG 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		//"####" A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"Ready")		
		3AWB A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,"Ready.BloodDrip")
		2AWB A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,"Ready.BloodDrip")
		1AWB A 0 A_JumpIfInventory("PowerBloodOnVisor",1,"Ready.BloodDrip")
		Goto Ready

	Ready.BloodDrip:
		"####" A 0 A_playsoundex("Chainsaw/Idle", 6)
		"####" A 0 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		"####" ABCDEFGG 1 A_WeaponReady(WRF_ALLOWRELOAD)
		//"####" A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_playsoundex("Chainsaw/Idle", 6)
		"####" HIJKLMNN 1 A_WeaponReady(WRF_ALLOWRELOAD)
		//"####" A 0 A_JumpIfInventory("StartDualWield",1,"DualWield")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_WeaponReady(WRF_ALLOWRELOAD)
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		Goto Ready

	Steady:
		TNT1 A 1
		Goto Ready

	Fire:
		"####" A 0 A_AlertMonsters
		"####" A 0 A_StopSound(6)
		"####" A 0 A_TakeInventory("ChainsawHitRed", 1)
		"####" A 0 A_TakeInventory("ChainsawHitBlue", 1)
		"####" A 0 A_TakeInventory("ChainsawHitGreen", 1)
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)
		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWG A 0
		"####" A 0 A_JumpIfInventory("RevenantRocketFire1823",1,"Fire2")
		"####" HIJ 1
		"####" "#" 2	// posefix: was TNT1 A 2
	FireNoStartup:
		PAWF A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)	
		1AWF A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
		3AWF A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,3)
		2AWF A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,2)
		SAWF A 0
		"####" A 0 A_Giveinventory("HasCutingWeapon",1)
		"####" A 0 A_PlaySoundEx("Chainsaw/Loop","Weapon",0)
		"####" A 0 A_GiveInventory("RevenantRocketFire1823", 1)
		"####" AB 1
		"####" "#" 0 A_Quake(2,5,0,12,"")
		"####" A 0 A_PlaySound("Chainsaw/Draw", 5)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" AAA 0 A_Saw("", "", 1, "SSawPuff2", 0, 120, 28,0)
		"####" C 1 A_FireCustomMissile("SawDamageHorizontal2", 0, 0, 0, 2)
		"####" A 0
		"####" A 0 A_JumpIfInventory("ChainsawHitRed",1,"FireContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue",1,"FireContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen",1,"FireContinueGreen")
		"####" D 1 A_FireCustomMissile("SawDamageHorizontal", 0, 0, 0, 2)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed",1,"FireContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue",1,"FireContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen",1,"FireContinueGreen")
		"####" E 1 A_FireCustomMissile("SawDamageHorizontal2", 0, 0, 0, 2)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed",1,"FireContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue",1,"FireContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen",1,"FireContinueGreen")		
		"####" F 1 A_FireCustomMissile("SawDamageHorizontal2", 0, 0, 0, 2)
		"####" A 0 A_JumpIfInventory("ChainsawHitRed",1,"FireContinueRed")
		"####" A 0 A_JumpIfInventory("ChainsawHitBlue",1,"FireContinueBlue")
		"####" A 0 A_JumpIfInventory("ChainsawHitGreen",1,"FireContinueGreen")
		"####" GHI 1
		//"####" A 0 {A_GiveInventory("QuickSwitchSSG",1); A_GiveInventory("SawDirection",1);}
		"####" "#" 8 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)	// posefix: was "####" "[" 8 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		"####" A 0 A_ReFire("Fire2NoStartup")
		//"####" A 0 A_TakeInventory("QuickSwitchSSG",1)
		PAWG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)
		3AWG A 0 A_JumpIfInventory("PowerGreenBloodOnVisor",1,4)
		2AWG A 0 A_JumpIfInventory("PowerBlueBloodOnVisor",1,3)
		1AWG A 0 A_JumpIfInventory("PowerBloodOnVisor",1,2)
		SAWG A 0
		"####" MLK 1
		Goto Ready
	
	DM:
		"####" AAA 0 A_Saw("", "", 1, "SSawPuff2DM", 0, 120, 28,0)
		"####" C 1 A_FireCustomMissile("SawDamageHorizontal2", 0, 0, 0, 2)
		Goto FireNoStartup+18

	Fire2:
		"####" KLM 1
		"####" "#" 2	// posefix: was TNT1 A 2
	Fire2NoStartup:
		PAWF A 0 A_JumpIfInventory("IsPlayingAsPurist",1,5)		
		1AWF A 0 A_JumpIfInventory("PowerBloodOnVisor",1,4)
