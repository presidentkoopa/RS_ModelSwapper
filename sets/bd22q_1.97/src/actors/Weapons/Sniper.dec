// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire; "rsr": real VR reload (no gates on this gun)).
ACTOR Sniper : BrutalWeapon
{
	Weapon.AmmoType1 "SniperAmmo"
	Weapon.AmmoType2 "xm21Ammo"
	weapon.selectionorder 900
	// 2026-10-23 (owner: "it fires 100000 times a second"). The Mini-14 Ranch is
	// SEMI-AUTO. Only the first cooldown state carries WRF_NOFIRE; every A_WeaponReady
	// after it allows firing, so a held trigger re-entered Fire on the next tic. BD22
	// never showed it: its sniper was played scoped, and Fire jumps to Fire2 when Zoomed.
	+WEAPON.NOAUTOFIRE
	-INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "$GOTSNIPER"
	Obituary "$OBBD_SNIPER"
	Tag "$TAGBD_SNIPER"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		X21G A 0 A_TakeInventory("RSR_Go", 1)
		X21G A 0 A_GiveInventory("RSR_Start", 1)
		X21G A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		X21G A 0 A_TakeInventory("RSR_Go", 1)
		X21G A 0 A_JumpIfInventory("HasUnloadedSniper", 1, "RSR_Wait")	// no magazine in the gun
		X21G A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		X21G A 0 A_JumpIfInventory("xm21Ammo", 2, "RSR_Unload1")
		X21G A 0 A_GiveInventory("HasUnloadedSniper", 1)
		Goto RSR_Wait
	RSR_Unload1:
		X21G A 0 A_TakeInventory("xm21Ammo", 1)
		X21G A 0 A_GiveInventory("RSR_Held_Sniper", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		X21G A 0 A_TakeInventory("RSR_Seated", 1)
		X21G A 0 A_TakeInventory("HasUnloadedSniper", 1)
	RSR_Return:		// the held rounds first
		X21G A 0 A_JumpIfInventory("RSR_Held_Sniper", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		X21G A 0 A_TakeInventory("RSR_Held_Sniper", 1)
		X21G A 0 A_GiveInventory("xm21Ammo", 1)
		Goto RSR_Return
	RSR_FillGo:
		X21G A 0 A_JumpIfInventory("xm21Ammo", 1, "RSR_FillB")	// a round chambered: BD22's second loop, to the maximum
		X21G A 0 A_GiveInventory("SniperReloadToken", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		X21G A 0 A_JumpIfInventory("xm21Ammo", 10, "RSR_Filled")
		X21G A 0 A_JumpIfInventory("SniperAmmo", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		X21G A 0 A_GiveInventory("xm21Ammo", 1)
		X21G A 0 A_TakeInventory("SniperAmmo", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		X21G A 0 A_JumpIfInventory("xm21Ammo", 0, "RSR_Filled")
		X21G A 0 A_JumpIfInventory("SniperAmmo", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		X21G A 0 A_GiveInventory("xm21Ammo", 1)
		X21G A 0 A_TakeInventory("SniperAmmo", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		X21G A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		X21G A 0 A_TakeInventory("RSR_Done", 1)
		X21G A 0 A_TakeInventory("SniperReloadToken", 1)
		X21G A 0 A_TakeInventory("Reloading", 1)
		Goto ReloadConcluded
	Spawn:
		WM14 b -1
		Stop

	KickFlash:
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		X21G BCDE 1
		X21G F 10
		X21G EDCB 1
		Stop
	SlideFlash:
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		X21G BCDE 1
		X21G F 35
		stop
	SlideFlashEnd: 
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		X21G F 5
		X21G EDCB 1
		stop
	SlideFlashEndEarly: 
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		X21G FFEDCB 1
		stop

	FirstSelectAnimation:
		X21G A 0 A_Takeinventory("NeverSelectedSniper",1)
		X21G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")	
		X23R GHIJKLM 1 A_WEAPONREADY(WRF_ALLOWZOOM)		
		X21R MNOPPQQQQQQQQRSTU 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Sniper/MagIn",5)
		X21R UUVVW 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		X21R "XXYZ[[[[[\]" 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		X22R ABC 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		X21R B 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		X22R DEFGHIJ 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		X22R K 3 A_WEAPONREADY(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Sniper/BoltBack",5)
		X22R LMMM 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Sniper/BoltForward",5)		
		X22R NNOPQRS 1 A_WEAPONREADY(WRF_ALLOWZOOM)		
		Goto Ready3

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 19) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1		
		TNT1 A 0 A_TakeInventory("NeverSelectedSniper", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedSniper",1,"FirstSelectAnimation")
		TNT1 A 0 A_PlaySound("Sniper/Draw", 5)
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
		Goto SelectAnimation

	SelectAnimation:
		X21S ABCD 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 19) )
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SNIP D 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist",1,2)
		X21G A 0		
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
	RSQ_SemiWait:	// posefix F11: semi-auto -- the trigger is still held from the last shot
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		X21G A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		X21G A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SNIP D 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		TNT1 AAA 0
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	StartSprint:
		X21G A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		X21G a 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		X21G BCD 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		PISP A 0 offset(-9,32)
		//DEAG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		DEAG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprintTired")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		DEAG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		DEAG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		DEAG A 0 offset(-9,32)
		X21G F 1 offset(-9,34) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		X21G F 1 offset(-6,36) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		X21G F 1 offset(-3,38) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		X21G F 1 offset(0,38) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		X21G F 1 offset(3,36) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		X21G F 1 offset(6,34) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		X21G F 1 offset(9,32) A_SetPitch(pitch -0.5, SPF_INTERPOLATE)
		DEAG A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		DEAG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		DEAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		DEAG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		DEAG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		DEAG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		X21G F 1 offset(9,34) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		X21G F 1 offset(6,36) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		X21G F 1 offset(3,38) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		X21G F 1 offset(0,38) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		X21G F 1 offset(-3,36) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		X21G F 1 offset(-6,34) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		X21G F 1 offset(-9,32) A_SetPitch(pitch +0.5, SPF_INTERPOLATE)
		DEAG A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		DEAG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		X21G DCB 1 A_WeaponReady(WRF_NOFIRE)
		X21G A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		X21G A 0
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 19) )
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_ZoomFactor(1.0)
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		X21S EFGH 1
		TNT1 A 0 A_Lower
		Wait

	Fire:
		"####" "#" 0 A_JumpIfInventory("RSQ_SemiLock", 1, "RSQ_SemiWait")	// posefix F11: semi-auto -- not until the trigger is let go
		SNIP D 0 A_JumpIfInventory("Zoomed",1,6)
		X21G A 0
		P21G A 0 A_JumpIFInventory("IsPlayingAsPurist",1,"NoReload")
		"####" "#" 0 a_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("xm21Ammo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("xm21Ammo",1)
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("xm21Ammo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4	// posefix rsr: still lands on BD22's own state (was 3)
	NoReload:
		"####" A 0 A_JumpIfInventory("SniperAmmo",1,1)
		Goto NoAmmo
		"####" A 0 A_Takeinventory("SniperAmmo",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" AA 0
		"####" A 0 A_AlertMonsters
		"####" A 0 A_PlaySound("Sniper/Fire", 1)
		"####" A 0 A_PlaySound("FARM14", 6)
		P21F A 0 A_JumpIfInventory("IsPlayingAsPurist",1,2)
		X21F A 0
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 0 BRIGHT A_FireBullets (0, 0, -1, 50, "ShotgunPuff", FBF_NORANDOM, 500)//point blank damage extra
		"####" A 0 A_GiveInventory("RSQ_SemiLock", 1)	// posefix F11: semi-auto -- one shot per pull (zscript/rsq/semiauto.zs)
		"####" A 0 BRIGHT A_FireBullets (0, 0, -1, 50, "sniperpuff", FBF_NORANDOM, 15000)//penetration 1
		"####" A 0 BRIGHT A_FireBullets (0, 0, -1, 50, "sniperpuff", FBF_NORANDOM, 15000)//penetration 2
		"####" A 0 BRIGHT A_RailAttack (0, 0, 0, "none", "Gray", RGF_SILENT, 0, "None", 0, 0, 14000, 15, 1)//Trail effect only
		"####" A 0 BRIGHT A_RailAttack (30, 0, 0, "none", "None", RGF_SILENT, 0, "sniperpuff", 0, 0, 500, 15, 1)//Heavy penetration
		"####" A 0 A_JumpIFInventory("Zoomed", 1, "Fire2")
		"####" A 1 BRIGHT
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" A 0 A_ZoomFactor(0.96)
		"####" A 0 A_SetPitch(pitch-1.3)
		"####" A 0 A_SetANgle(angle-1.4)
		"####" B 1 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" C 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		P21G A 0 A_JumpIfInventory("IsPlayingAsPurist",1,2)
		X21G A 0 A_ClearReFire
		"####" A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_SetANgle(angle+0.1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		"####" A 0 A_Refire
		Goto Ready3
	
	DM:
		"####" A 0 BRIGHT A_FireBullets (0, 0, -1, 50, "ShotgunPuffDM", FBF_NORANDOM, 500)//point blank damage extra
		"####" A 0 BRIGHT A_FireBullets (0, 0, -1, 50, "sniperpuffDM", FBF_NORANDOM, 15000)//penetration 1
		"####" A 0 BRIGHT A_FireBullets (0, 0, -1, 50, "sniperpuffDM", FBF_NORANDOM, 15000)//penetration 2
		"####" A 0 BRIGHT A_RailAttack (0, 0, 0, "none", "Gray", RGF_SILENT, 0, "None", 0, 0, 14000, 15, 1)//Trail effect only
		"####" A 0 BRIGHT A_RailAttack (30, 0, 0, "none", "None", RGF_SILENT, 0, "sniperpuffDM", 0, 0, 500, 15, 1)//Heavy penetration
		Goto ResumeFireFrame+15	// posefix rsr: still lands on BD22's own state (was 14)

	IsHolding:
		SNIP D 0 A_JumpIfInventory("ZoomHold", 1, 4)
		SNIP D 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+9
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("xm21Ammo",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim

	Fire2:
		SNIP D 0
		X21G A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		X21G A 0 A_ZoomFactor(5.96)
		SNIP D 0 A_SetPitch(pitch-1.3)
		SNIP D 0 A_SetANgle(angle-1.4)
		SNIP D 1 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		SNIP D 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SNIP D 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SNIP D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SNIP DDD 0
		SNIP D 0 A_ZoomFactor(6.0)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP B 1 A_WeaponReady(WRF_NOFIRE | WRF_ALLOWRELOAD)
		SNIP D 0 A_ClearReFire//Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP C 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD)
		SNIP D 0 //Nope
		SNIP D 0 A_SetANgle(angle+0.1)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 1 A_WeaponReady(WRF_NOFIRE | WRF_ALLOWRELOAD)
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SNIP D 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SNIP D 0 A_Refire
		Goto Ready2

	AltFire:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		//TNT1 A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 A 0 A_ZoomFactor(6.0)
		//TNT1 A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		X21A ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		TNT1 A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		SNIP D 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		SNIP D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		SNIP D 4
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		X21A ABC 1
		SINP D 5 A_WeaponReady(1)
		Goto Ready2

	HoldAim:
		TNT1 A 0
		TNT1 A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SNIP D 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		TNT1 AA 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 19) )
		TNT1 A 0
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		TNT1 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		X21A CBA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		X21G A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		X21A CBA 1
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		X21G A 5 A_WeaponReady(1)
		Goto Ready3

	Inspect:
		X21G A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		X21G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		X21G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		X21G A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		X21G A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		X21G A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		X21G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		X21G A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		X21G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		X21G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		X21G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		X21G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		X21G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		X21G A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		X21G A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		X21G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		X21G A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		X21G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		X21G A 6 A_WeaponReady(WRF_ALLOWZOOM)
		X21G A 0 A_GiveInventory("DoInspect",1)
		X21G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		X21G A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		X21G A 0 A_TakeInventory("DoInspect",1)
		X22R SRE 1 A_WeaponReady(WRF_ALLOWZOOM)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 19) )
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		X22R FGHIJ 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		X22R K 5 A_WeaponReady(WRF_ALLOWZOOM)
		X22R A 0 A_PlaySound("Sniper/BoltBack", 5)
		"####" "#" 0 A_TakeInventory("SniperReloadToken",1)
		X22R LLMM 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		X22R M 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		X22R A 0 A_PlaySound("Sniper/BoltForward", 5)
		X22R NNOP 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		X22R Q 4 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("SniperReloadToken",1)
		X22R QRS 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("SniperReloadToken",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	ReloadEmpty:
		X23R ABCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ContinueReload

	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("RSR_Held_Sniper", 1, 4)	// posefix rsr F11 R3 (RSR_HeldGo): held rounds reload even on an empty reserve; lands where the next line does
		"####" "#" 0 A_JumpIfInventory("SniperAmmo",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready3//FinishReloading
		TNT1 AAA 0
		"####" "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		"####" "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")		
		X21G A 0 A_JumpIfInventory("xm21Ammo",0,"Inspect")
		X21G A 0 A_JumpIfInventory("SniperReloadToken",1,"Inspect")		
		X21G A 0 A_Takeinventory("Zoomed",1)
		X21G A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_TakeInventory("SniperAim", 1)
		X21G A 0 A_GiveInventory("Pumping", 1)
		X21G A 0 A_Takeinventory("Reloading",1)
		X21G A 0 A_ZoomFactor(1.0)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		X21G A 0
		X21R AB 1
		X21G A 0 A_JumpIfInventory("HasUnloadedSniper",1,"ReloadEmpty")
		X21R CDEFGHHII 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21G A 0 A_PlaySound("Sniper/MagOut",5)
		X21R IIJKLM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21G A 0 A_FireCustomMissile("EmptySniperAmmoSpawn",-5,0,8,-4)
	ContinueReload:	
		X21R NOPPQQQQQQQQQQ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21R RSTU 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Sniper/MagIn",5)
		X21R UUVVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21G A 0 A_JumpIfInventory("XM21Ammo",1,"InsertBullets2")
		Goto InsertBullets

	InsertBullets:
		TNT1 AAAA 0
		X21G A 0 A_JumpIfInventory("xm21Ammo",10,15)
		X21G A 0 A_JumpIfInventory("SniperAmmo",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		X21G A 0 A_Giveinventory("xm21Ammo",1)
		X21G A 0 A_GiveInventory("SniperReloadToken",1)
		X21G A 0 A_Takeinventory("SniperAmmo",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		X21G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload
		TNT1 AAAA 0
		X21G A 0 A_Takeinventory("Reloading",1)
		Goto FinishReload

	InsertBullets2:
		TNT1 AAAA 0
		X21G A 0 A_JumpIfInventory("xm21Ammo",0,15)
		X21G A 0 A_JumpIfInventory("SniperAmmo",1,3)
		Goto FullReload
		TNT1 AAAAAA 0
		X21G A 0 A_Giveinventory("xm21Ammo",1)
		X21G A 0 A_Takeinventory("SniperAmmo",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2

		TNT1 AAAAAAAAAA 0
		X21G A 0 A_Takeinventory("Reloading",1)
		Goto FullReload
		TNT1 AAAA 0
		X21G A 0 A_Takeinventory("Reloading",1)
		Goto FullReload

	FinishReload:
		X21R "XXYZ[[[[[\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X22R ABC 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21R B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X22R DEFGHIJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X22R K 5 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Sniper/BoltBack",5)
		X22R LMMMMM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Sniper/BoltForward",5)		
		X22R NNOPQRS 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	FullReload:
		X21R "XXYZ[[[[[" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21G A 0 A_Takeinventory("HasUnloadedSniper",1)
		X21G A 0 A_TakeInventory("SniperReloadToken",1)
		X21R "\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X22R ABC 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21R BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded
	
	ReloadConcluded:
		X21G A 0 //A_ClearReFire
		X21G A 0 A_Takeinventory("HasUnloadedSniper",1)
		"####" "#" 0 A_TakeInventory("SniperReloadToken",1)
		X21G A 0 //A_Refire
		Goto Ready3

	User2:
	Unload:
		X21G A 1 // A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		X21G A 0 A_ZoomFactor(1.0)
		X21G A 0 A_Takeinventory("Unloading",1)
		X21G A 0 A_Takeinventory("ADSmode",1)
		X21G A 0 A_Takeinventory("Zoomed",1)
		X21G A 0 A_JumpIfInventory("NoReloading",1,"Ready3")
		X21G A 0 A_JumpIfInventory("xm21Ammo",1,3)
		Goto NoAmmo
		TNT1 AAA 0
		X21G A 0 A_Takeinventory("Zoomed",1)
		X21R ABCDEFGHHIIJJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21G A 0 A_PlaySound("Sniper/MagOut",5)

		X21G A 0 A_GiveInventory ("Pumping", 1)
		X21G A 0 A_Takeinventory("Unloading",1)

	RemoveBullets:
		TNT1 AAAA 0
		X21G A 0 A_JumpIfInventory("xm21Ammo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		X21G A 0 A_Takeinventory("xm21Ammo",1)
		X21G A 0 A_Giveinventory("SniperAmmo",1)
		Goto RemoveBullets

	FInishUnload:
		X21R JJKLMMMMMM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X23R FEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		X21G A 0 A_GiveInventory("HasUnloadedSniper", 1)
		X21G A 0 A_Takeinventory("Unloading",1)
		X21R BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto Ready3
	}
}

ACTOR PuristSniper : Sniper { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }

ACTOR xm21Ammo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 11
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 11
	Inventory.Icon "WM14b0"
}