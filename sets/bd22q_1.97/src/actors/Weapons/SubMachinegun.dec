// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire; "rsr": real VR reload (no gates on this gun)).
ACTOR BrutalSMG : BrutalWeapon
{
	Weapon.AmmoType1 "Clip1"
	Weapon.AmmoType2 "BDSMGAmmo"
	weapon.selectionorder 1800
	-INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "$GOTSMG"
	Obituary "$OBBD_SMG"
	Tag "$TAGBD_SMG"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		SMGR A 0 A_TakeInventory("RSR_Go", 1)
		SMGR A 0 A_GiveInventory("RSR_Start", 1)
		SMGR A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		SMGR A 0 A_TakeInventory("RSR_Go", 1)
		SMGR A 0 A_JumpIfInventory("HasUnloadedSMG", 1, "RSR_Wait")	// no magazine in the gun
		// 2026-10-23 (owner: ran dry, then no reload would put a magazine in the hand
		// again). An EMPTY magazine must be CHANGED, not racked. Reloading with the
		// reserve at zero still hands out RSR_Charge (RSR_FillGo gives it before the
		// fill is known to have added anything, and RSR_FillA then falls through having
		// added nothing), and the token is kept when the gun is put away -- so the line
		// below would skip this magazine step for every reload from then on.
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo", 1, 2)	// rounds in the gun: the charge shortcut is honest
		SMGR A 0 A_TakeInventory("RSR_Charge", 1)
		SMGR A 0 A_JumpIfInventory("RSR_Charge", 1, "RSR_Filled")	// a magazine in, the handle still to pull
		SMGR A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo", 2, "RSR_Unload1")
		SMGR A 0 A_GiveInventory("HasUnloadedSMG", 1)
		SMGR A 0 A_GiveInventory("HasUnloadedDualSMG", 1)
		Goto RSR_Wait
	RSR_Unload1:
		SMGR A 0 A_TakeInventory("BDSMGAmmo", 1)
		SMGR A 0 A_TakeInventory("BDDualSMGAmmo", 1)
		SMGR A 0 A_GiveInventory("RSR_Held_BrutalSMG", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		SMGR A 0 A_TakeInventory("RSR_Seated", 1)
		SMGR A 0 A_TakeInventory("HasUnloadedSMG", 1)
		SMGR A 0 A_TakeInventory("HasUnloadedDualSMG", 1)
	RSR_Return:		// the held rounds first
		SMGR A 0 A_JumpIfInventory("RSR_Held_BrutalSMG", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		SMGR A 0 A_TakeInventory("RSR_Held_BrutalSMG", 1)
		SMGR A 0 A_GiveInventory("BDSMGAmmo", 1)
		SMGR A 0 A_GiveInventory("BDDualSMGAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo", 1, "RSR_FillB")	// a round chambered: BD22's second loop, to the maximum
		SMGR A 0 A_GiveInventory("RSR_Charge", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		// 2026-10-23 (owner: "only rack if I reload when the gun was totally empty"). A round
		// is still chambered on this branch, so a tactical reload owes no rack -- which is how
		// the pistol already behaves, and vreload.zs gives the SMG the same real bolt lock
		// (the MP40 is the open-bolt one). The token is also persistent, so handing it out
		// where nothing was owed sent the NEXT reload straight to the handle (RSR_Out) with
		// no magazine ever offered.
		Goto RSR_FillB1
	RSR_FillA:
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo", 40, "RSR_Filled")
		SMGR A 0 A_JumpIfInventory("Clip1", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		SMGR A 0 A_GiveInventory("BDSMGAmmo", 1)
		SMGR A 0 A_GiveInventory("BDDualSMGAmmo", 1)
		SMGR A 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo", 0, "RSR_Filled")
		SMGR A 0 A_JumpIfInventory("Clip1", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		SMGR A 0 A_GiveInventory("BDSMGAmmo", 1)
		SMGR A 0 A_GiveInventory("BDDualSMGAmmo", 1)
		SMGR A 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		SMGR A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		SMGR A 0 A_TakeInventory("RSR_Done", 1)
		SMGR A 0 A_TakeInventory("RSR_Charge", 1)
		SMGR A 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	KickFlash: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		SMGF DEFGH 1
		SMGF H 8
		SMGF HGFED 1
		stop
	SlideFlash: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		SMGF DEFGH 1
		SMGF H 35
		stop
	SlideFlashEnd: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		SMGF H 4
		SMGF HGFED 1
		stop
	SlideFlashEndEarly: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		SMGF H 1
		SMGF HGFED 1
		stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")	
		SMGG A 0 A_TakeInventory("DualSMG",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_GunFlash
		TNT1 A 0 A_GiveInventory("SMGSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")	
		TNT1 A 1
		SMGR A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_TakeInventory("NeverSelectedSMG", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedSMG", 1, "FirstSelectAnimation")
		SMGR A 0 A_PlaySound("Rifle/Select", 5)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "SelectPurist")
		Goto SelectAnimation

	SelectDual:
		TNT1 A 0 A_TakeInventory("SwitchDuals",1)
		TNT1 A 0 A_JumpIfInventory("HasUnloadedSMG", 1, "SelectDualUnloaded")
		SM2S QPON 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		SM2S MLKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready
	SelectDualUnloaded:
		SM2S WVUT 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		SM2S SRKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready

	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedSMG",1)
		SMGR A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		3MGR KJIHGF 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR OOPPPQRSTUUUUV 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR A 0 A_PlaySound("SMG/Reload2", 5)
		SMGR XWXYZZ 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR "[\]" 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR DCB 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimation:
		SMGS HGFE 1  A_WeaponReady(WRF_NOFIRE)
		SMGR A 0 A_Takeinventory("StartDualWield",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		TNT1 A 0 //ACS_NamedExecuteAlways("AimMode")
		SMGR A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SMGR A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGR A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGR A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGR A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SMGR A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SMGR A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGR A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SMGR A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGR A 0 A_JumpIf(0, "DualWield")
		SMGZ F 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGR A 0
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Ready2:
		SMGZ F 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SMGZ F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGZ F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGZ F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SMGZ F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SMGZ F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGZ F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SMGZ F 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGZ F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SMGZ F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGZ F 0 A_JumpIf(0, "DualWield")
		SMGZ F 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		SMGZ F 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SMGZ F 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		TNT1 AAA 0
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	AltFire:
		"####" "#" 0 A_Jump(256, "RSA_SMGToggle")	// 1.39 rsa (owner): secondary toggles full auto / 3-round burst (was BD22's zoom)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_SetCrosshair(41)
		SMGR A 0 A_Giveinventory("GoSpecial",1)
		SMGR A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		SMGR A 0 A_Giveinventory("Zoomed",1)
		SMGR A 0 A_ZoomFactor(1.3)
		SMGR A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		SMGZ CDE 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SMGR A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SMGR A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		SMGZ F 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready2
		TNT1 AAA 0
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		SMGZ F 4
		SMGR A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		SMGZ CDE 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		SMGZ F 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready2

	HoldAim:
		SMGZ F 0
		SMGZ F 0 A_Giveinventory("ZoomHold",1)
		SMGZ F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGZ F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGZ F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SMGZ F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SMGZ F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGZ F 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGZ F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SMGZ F 0 A_JumpIf(0, "DualWield")
		SMGZ F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ FF 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_Giveinventory("GoSpecial",1)
		SMGR A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		SMGZ EDC 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGR A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		SMGZ EDC 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGR A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedSMG",1)
		SMGR A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		SMGR A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		SMGF DEF 1 A_WeaponReady(WRF_NOFIRE)		
	Sprinting:
		SMSP A 0 offset(-9,32)
		//SMGR A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		SMGR A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		SMGR A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		SMGR A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		SMGR A 0 offset(-9,32)
		SMGF G 1 offset(-9,34) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(-6,36) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(-3,38) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(0,38) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(3,36) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(6,34) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(9,32) A_SetPitch(pitch -0.5)
		SMGR A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		SMGR A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGR A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGR A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGR A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		SMGR A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		SMGF G 1 offset(9,34) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(6,36) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(3,38) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(0,38) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(-3,36) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(-6,34) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(-9,32) A_SetPitch(pitch +0.5)
		SMGR A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		SMGR A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		SMGF FED 1
		SMGR A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		SMGR A 0 A_TakeInventory("TossGrenade", 1)
		SMGR A 0 A_TakeInventory("Zoomed", 1)
		SMGR A 0 A_TakeInventory("ADSMode", 1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		SMGS ABCD 1
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		SMGZ F 0 A_JumpIfInventory("Zoomed",1,16)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGR A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("BDSMGAmmo",1)
		"####" "#" 0 A_Takeinventory("BDDualSMGAmmo",1)
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmo",9,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFire
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4
	NoReload:
		"####" "#" 0 A_JumpIfInventory("Clip1",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		"####" "###" 0
	ResumeFire:
		"####" "####" 0
		"####" "#" 0 A_ALertMonsters
		"####" "#" 0 A_Quake(1,3,0,4,"")	
		2MGF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGF A 0
		"####" A 0 A_PlaySound("FARSHT", 6)
		"####" A 0 A_PlaySound("SMG/Fire", 1)
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")		
		"####" A 0 A_ZoomFactor(0.99)
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)			
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 1 BRIGHT A_FireBullets (6, 3, 1, 12, "WeakPuff", FBF_NORANDOM)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		"####" A 0 A_SetPitch(pitch-1.0)
		"####" B 1 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" C 1
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGR A 0 //needed for new NoAmmo stuff
		"####" A 0 A_JumpIfInventory("RSA_BurstSMG", 1, "RSA_BurstStep")	// 1.37 rsa: 3-round burst
		"####" A 0 A_ReFire
		Goto Ready3
	// 1.37 rsa (owner): the SMG's burst. Three rounds a pull (the trigger need not be held), then
	// it waits for the trigger to be let go. Each hand counts its own.
	RSA_BurstStep:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, "RSA_BurstStepOff")
		"####" A 0 A_GiveInventory("RSA_BurstCnt", 1)
		"####" A 0 A_JumpIfInventory("RSA_BurstCnt", 3, "RSA_BurstEnd")
		"####" A 0 A_JumpIfInventory("BDSMGAmmo", 1, "Fire")
		Goto RSA_BurstEnd
	RSA_BurstStepOff:
		"####" A 0 A_GiveInventory("RSA_BurstCntOff", 1)
		"####" A 0 A_JumpIfInventory("RSA_BurstCntOff", 3, "RSA_BurstEnd")
		"####" A 0 A_JumpIfInventory("BDSMGAmmoOff", 1, "Fire")
	RSA_BurstEnd:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_BurstCnt", 99)
		"####" A 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_BurstCntOff", 99)
	RSA_BurstWait:
		"####" A 1
		"####" A 0 A_JumpIf((OverlayID() != 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 1) != 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "RSA_BurstWait")
		Goto Ready3
	RSA_SMGToggle:
		"####" "#" 0 A_StartSound("Weapon/Empty", CHAN_AUTO)
		"####" "#" 0 A_JumpIfInventory("RSA_BurstSMG", 1, 3)
		"####" "#" 0 A_GiveInventory("RSA_BurstSMG", 1)
		"####" "#" 0 A_Print("SMG: 3-round burst", 0.8)
		Goto RSA_AltWait
		"####" "#" 0 A_TakeInventory("RSA_BurstSMG", 1)
		"####" "#" 0 A_Print("SMG: full auto", 0.8)
	RSA_AltWait:
		"####" "#" 1
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && ((GetPlayerInput(INPUT_BUTTONS) & 32) != 0 || CountInv("FiredSecondary") > 0)) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "RSA_AltWait")
		Goto Ready3
	
	DM:
		"####" "#" 0 A_JumpIfInventory("FireFrameCount", 1, 2)
		"####" "#" 1 BRIGHT A_FireBullets (6, 3, 1, 12, "WeakPuffDM", FBF_NORANDOM)
		Goto ResumeFire+17
		"####" "#" 1 BRIGHT A_FireBullets (3, 2, -1, 12, "WeakPuffDM", FBF_NORANDOM)
		Goto Fire2+7

	FiredZoom:
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		SMGZ G 1 BRIGHT A_FireBullets (3, 2, -1, 12, "WeakPuff", FBF_NORANDOM)
		Goto Fire2+7
	IsHolding:
		SMGZ F 0 A_JumpIfInventory("ZoomHold", 1, 4)
		SMGZ F 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+16
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmo",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim
	Fire2:
		SMGR A 0
		SMGR A 0 A_ZoomFactor(1.33)
		SMGZ A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)		
		SMGZ A 0 A_JumpIfInventory("FireFrameCount", 1, "FiredZoom")
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		SMGZ G 1 BRIGHT A_FireBullets (3, 2, 1, 12, "WeakPuff", FBF_NORANDOM)
		SMGR A 0 A_ZoomFactor(1.3)
		RIFF A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		RIFG A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		RIFG A 0 A_SetPitch(pitch-0.5)
		SMGZ H 1 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SMGR A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SMGR A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SMGR AAA 0
		SMGR A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		SMGZ I 1
		SMGZ F 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		SMGZ F 0 A_GiveInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		SMGZ F 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		SMGZ F 0 A_ReFire
		SMGZ F 7 A_WeaponReady(1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SMGZ F 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2
	
	DM2:
		SMGZ G 1 BRIGHT A_FireBullets (3, 2, 1, 12, "WeakPuffDM", FBF_NORANDOM)
		Goto Fire2+7

	ReloadEmpty:
		SMGR B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2MGR EDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ContinueReload
	Reload:
		"####" "#" 0 
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("RSR_Held_BrutalSMG", 1, 4)	// posefix rsr F11 R3 (RSR_HeldGo): held rounds reload even on an empty reserve; lands where the next line does
		"####" "#" 0 A_JumpIfInventory("Clip1",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		TNT1 AAA 0
		SMGR A 0 A_Takeinventory("ADSmode",1)
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_Takeinventory("ZoomHold",1)
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo",0,"Ready")
		SMGR A 0 A_Takeinventory("ADSmode",1)
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_Takeinventory("ZoomHold",1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_GiveInventory ("Pumping", 1)
		SMGR A 0 A_Takeinventory("Reloading",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		SMGR A 0 A_JumpIfInventory("HasUnloadedSMG", 1, "ReloadEmpty")
		SMGR BCDEFGGHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_PlaySound("SMG/Reload1", 5)
		SMGR IJKLMNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR O 1 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
	ContinueReload:
		SMGR PPPQRSTUUUUV 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo",1,"InsertBullets2")//40+1 effect

	InsertBullets:
		TNT1 AAAA 0
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo",40,15)
		SMGR A 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		SMGR A 0 A_Giveinventory("BDSMGAmmo",1)
		SMGR A 0 A_Giveinventory("BDDualSMGAmmo",1)
		SMGR A 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets

		TNT1 AAAAAAAAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)

		SMGR A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReload
		TNT1 AAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)

		SMGR A 0 //A_Refire
		Goto FinishReload

	FinishReload:
		SMGR A 0 A_PlaySound("SMG/Reload2", 5)
		SMGR XWXYZZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR "[\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR DCB 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_Takeinventory("HasUnloadedSMG",1)
		SMGR A 0 A_Takeinventory("HasUnloadedDualSMG",1)	
		"####" "#" 0 A_ReFire	
		Goto Ready

	InsertBullets2:
		TNT1 AAAA 0
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo",0,15)
		SMGR A 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		SMGR A 0 A_Giveinventory("BDSMGAmmo",1)
		SMGR A 0 A_Giveinventory("BDDualSMGAmmo",1)
		SMGR A 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2

		TNT1 AAAAAAAAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR A 0 //A_Refire
		Goto FinishReload
		TNT1 AAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)

		SMGR A 0 //A_Refire
		Goto FinishReload

	User2:
	Unload:
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmo",1,3)
		Goto Ready
		TNT1 AAA 0
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_GiveInventory ("Pumping", 1)
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR BCDEFGGHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_PlaySound("SMG/Reload1", 5)

	RemoveBullets:
		TNT1 AAAA 0
		SMGR A 0 A_JumpIfInventory("BDSMGAmmo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		SMGR A 0 A_Takeinventory("BDSMGAmmo",1)
		SMGR A 0 A_Takeinventory("BDDualSMGAmmo",1)
		SMGR A 0 A_Giveinventory("HasUnloadedSMG",1)
		SMGR A 0 A_Giveinventory("HasUnloadedDualSMG",1)		
		SMGR A 0 A_Giveinventory("Clip1",1)
		Goto RemoveBullets
		TNT1 AAAAAAAAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR A 0 //A_Refire
		Goto FinishUnload
		TNT1 AAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR A 0 //A_Refire
		Goto FinishUnload
	FinishUnload:
		SMGR IJKLMNOO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2MGR ABCDE 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto Ready

	Spawn:
		SMGZ A -1
		Stop

	Steady:
		TNT1 A 1
		Goto Ready

	User3:
	DualWield:
		SMGR A 0 A_Takeinventory("StartDualWield",1)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SMGR A 0 A_JumpIfInventory("IsTacticalClass", 1, "NoDual")
		SMGR A 0 A_JumpIfInventory("HasDualSMG", 1, "GetDual")
		SMGR A 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_Takeinventory("ADSmode",1)
		SMGR A 0 A_TakeInventory("TossGrenade", 1)
		SMGR A 0 A_TakeInventory("Kicking",1)
		SMGR A 0 A_TakeInventory("Taunting",1)
		SMGR A 0 A_TakeInventory("Reloading",1)
		SMGR A 0 A_TakeInventory("Unloading",1)
		SMGR A 0 A_TakeInventory("Salute1", 1)
		SMGR A 0 A_TakeInventory("Salute2", 1)
		SMGR A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("SwitchDuals", 1)
		SMGG A 0 A_GiveInventory("DualSMG",1)
		SMGR A 0 A_SelectWEapon("DualSMG")
		Goto Ready
	}
}

ACTOR PuristSMG : BrutalSMG { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }
