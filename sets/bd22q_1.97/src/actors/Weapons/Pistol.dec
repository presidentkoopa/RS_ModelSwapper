// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire; "rsr": real VR reload (no gates on this gun)).
ACTOR BrutalPistol : BrutalWeapon
{
	Weapon.AmmoType1 "Clip1"
	Weapon.AmmoType2 "BDPistolAmmo"
	weapon.selectionorder 1900
	+WEAPON.WIMPY_WEAPON
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Pistol/Draw"
	Inventory.PickupMessage "$GOTPISTOL"
	Obituary "$OBBD_PISTOL"
	Tag "$TAGBD_PISTOL"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		PIST E 0 A_TakeInventory("RSR_Go", 1)
		PIST E 0 A_GiveInventory("RSR_Start", 1)
		PIST E 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		PIST E 0 A_TakeInventory("RSR_Go", 1)
		PIST E 0 A_JumpIfInventory("HasUnloadedPistol", 1, "RSR_Wait")	// no magazine in the gun
		// 2026-10-23 (owner: ran dry, then no reload would put a magazine in the hand
		// again). An EMPTY magazine must be CHANGED, not racked. Reloading with the
		// reserve at zero still hands out RSR_Charge (RSR_FillGo gives it before the
		// fill is known to have added anything, and RSR_FillA then falls through having
		// added nothing), and the token is kept when the gun is put away -- so the line
		// below would skip this magazine step for every reload from then on.
		PIST E 0 A_JumpIfInventory("BDPistolAmmo", 1, 2)	// rounds in the gun: the charge shortcut is honest
		PIST E 0 A_TakeInventory("RSR_Charge", 1)
		PIST E 0 A_JumpIfInventory("RSR_Charge", 1, "RSR_Filled")	// a magazine in, the handle still to pull
		PIST E 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		PIST E 0 A_JumpIfInventory("BDPistolAmmo", 2, "RSR_Unload1")
		PIST E 0 A_GiveInventory("HasUnloadedPistol", 1)
		PIST E 0 A_GiveInventory("HasUnloadedDualPistols", 1)
		Goto RSR_Wait
	RSR_Unload1:
		PIST E 0 A_TakeInventory("BDPistolAmmo", 1)
		PIST E 0 A_TakeInventory("BDDualPistolAmmo", 1)
		PIST E 0 A_GiveInventory("RSR_Held_BrutalPistol", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		PIST E 0 A_TakeInventory("RSR_Seated", 1)
		PIST E 0 A_TakeInventory("HasUnloadedPistol", 1)
		PIST E 0 A_TakeInventory("HasUnloadedDualPistols", 1)
	RSR_Return:		// the held rounds first
		PIST E 0 A_JumpIfInventory("RSR_Held_BrutalPistol", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		PIST E 0 A_TakeInventory("RSR_Held_BrutalPistol", 1)
		PIST E 0 A_GiveInventory("BDPistolAmmo", 1)
		PIST E 0 A_GiveInventory("BDDualPistolAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		PIST E 0 A_JumpIfInventory("BDPistolAmmo", 1, "RSR_FillB")	// a round chambered: BD22's second loop, to the maximum
		PIST E 0 A_GiveInventory("RSR_Charge", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		PIST E 0 A_JumpIfInventory("BDPistolAmmo", 15, "RSR_Filled")
		PIST E 0 A_JumpIfInventory("Clip1", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		PIST E 0 A_GiveInventory("BDPistolAmmo", 1)
		PIST E 0 A_GiveInventory("BDDualPistolAmmo", 1)
		PIST E 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		PIST E 0 A_JumpIfInventory("BDPistolAmmo", 0, "RSR_Filled")
		PIST E 0 A_JumpIfInventory("Clip1", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		PIST E 0 A_GiveInventory("BDPistolAmmo", 1)
		PIST E 0 A_GiveInventory("BDDualPistolAmmo", 1)
		PIST E 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		PIST E 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		PIST E 0 A_TakeInventory("RSR_Done", 1)
		PIST E 0 A_TakeInventory("RSR_Charge", 1)
		PIST E 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	KickFlash: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		PIST J 0 A_JumpIfInventory("BDPistolAmmo", 1,"KickFlashLoaded")
		PIST OPQR 1
		PIST S 10
		PIST RQPO 1
		stop
	SlideFlash: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		PIST J 0 A_JumpIfInventory("BDPistolAmmo", 1,"SlideFlashLoaded")
		PIST OPQR 1
		PIST S 36
		stop
	SlideFlashEnd: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		PIST J 0 A_JumpIfInventory("BDPistolAmmo", 1,"SlideFlashEndLoaded")
		PIST S 5
		PIST RQPO 1
		stop
	SlideFlashEndEarly: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		PIST J 0 A_JumpIfInventory("BDPistolAmmo", 1,"SlideFlashEndEarlyLoaded")
		PIST S 2
		PIST RQPO 1
		stop
	KickFlashLoaded: 
		PIST JKLM 1
		PIST N 10
		PIST MLKJ 1
		stop
	SlideFlashLoaded:
		PIST JKLM 1
		PIST N 36
		stop
	SlideFlashEndLoaded: 
		PIST N 5
		PIST MLKJ 1
		stop
	SlideFlashEndEarlyLoaded: 
		PIST N 2
		PIST MLKJ 1
		stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		PIST F 0 A_Takeinventory("DualPistols",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 1) )
		PIST E 0 A_GunFlash
		TNT1 A 0 A_GiveInventory("PistolSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		PIST E 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"selectAnimation")
		Goto FirstSelectAnimation
	
	SelectDual:
		TNT1 A 0 A_Takeinventory("SwitchDuals",1)
		TNT1 A 0 A_JumpIfInventory("BDPistolAmmo", 1, 1)
		Goto SelectDualEmpty
		PI2G LKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_PlaySound("Pistol/Draw",5)
		PI2G IHG 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("SwitchDuals",1)
		Goto Ready
		
	SelectDualEmpty:
		PI2G XWV 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_PlaySound("Pistol/Draw",5)
		PI2G UTS 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready		

	FirstSelectAnimation:
		TNT1 A 1
		TNT1 A 0 A_TakeInventory("NeverSelectedPistol", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedPistol", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 0 A_TakeInventory("NeverSelectedPistol",1)
		PIST E 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 3
		PISS ABC 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR ABCDEFGG 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR HIJKKLLL 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR MNO 1 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_PlaySound("Pistol/Reload2", 5)
		PISR PQRSTTT 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI QRSTUU 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI EE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Pistol/slide", 5)
		PISI FG 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI H 4 A_WeaponReady(WRF_ALLOWZOOM)
		PISI H 0 A_PlaySound("pistol/slide2", 5)
		PISI IJKLLL 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI MMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR BA 1 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectAnimation:
		PIST E 0 A_PlaySound("Pistol/Draw", 5)
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")		
		PISS A 0 A_JumpIfInventory("BDPistolAmmo", 1, 2)
		Goto SelectAnimationEmpty
		TNT1 AA 0
		PISS ABC 1 A_WeaponReady(WRF_NOFIRE)
		PIST E 0 A_Takeinventory("StartDualWield",1)
		Goto Ready
	
	/*SelectPurist:
        "####" "#" 0 A_JumpIfInventory("PuristPistol", 1,3)    
        "####" "#" 0 A_Giveinventory("PuristPistol",1)
        "####" "#" 0 A_SelectWeapon("PuristPistol")
        "####" "####" 0 A_Raise
        "####" "#" 1 A_Raise
        "####" "#" 0 A_Takeinventory("BrutalPistol",1)
        Goto SelectPurist+1*/

	SelectAnimationEmpty:
		PISS GHI 1 A_WeaponReady(WRF_NOFIRE)
		PIST E 0 A_Takeinventory("StartDualWield",1)
	Ready3:
	Ready:
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,3)
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",1,2)
		PIST I 0	
		"####" "#" 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" "#" 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" "#" 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_Takeinventory("PistolFireAnimation1",1)
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(0, "DualWield")
		Loop

	StartSprint:
		"####" "#" 0 A_TakeInventory("NeverSelectedPistol",1)
		"####" "#" 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		PIST J 0 A_JumpIfInventory("BDPistolAmmo", 1,"StartSprintLoaded")
		PIST OPQ 1 A_WeaponReady(WRF_NOFIRE)
		Goto Sprinting
	StartSprintLoaded:
		PIST JKL 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		PISP A 0 offset(-9,32)
		//PIST E 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		PIST E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		PIST E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		PIST E 0 offset(-9,32) A_GiveInventory("UsedStamina", 2)
		PIST E 0 offset(-9,32)
		PIST N 0 A_JumpIfInventory("BDPistolAmmo", 1,2)
		PIST S 0
		PIST "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		PIST "#" 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		PIST "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PIST "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PIST "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PIST "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 3)
		PIST "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		PIST "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		PIST "#" 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		PIST "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
		
	StopSprint:
		PIST J 0 A_JumpIfInventory("BDPistolAmmo", 1,"StopSprintLoaded")
		PIST QPO 1
		PIST E 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	StopSprintLoaded:
		PIST LKJ 1
		PIST E 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		PIST E 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		PISS E 0 A_JumpIfInventory("BDPistolAmmo", 1, 1)
		Goto DeselectEmpty
		PISS E 0
	DeselectContinue:
		"####" DEF 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	DeselectEmpty:
		PISS JKL 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("BDPistolAmmo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("BDPistolAmmo",1)
		"####" "#" 0 A_Takeinventory("BDDualPistolAmmo",1)
		"####" "#" 0 A_JumpIfInventory("BDPistolAmmo",6,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame

	NoReload:
		"####" "#" 0 A_JumpIfInventory("Clip1",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		"####" "###" 0
	ResumeFireFrame:
		"####" A 0
		2IST A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		PIST E 0
		"####" E 0 A_AlertMonsters
		"####" E 0 A_PlaySound("FARSHT", 6)
		"####" E 0 A_PlaySound("Pistol/Fire", 1)
		"####" E 0 A_ZoomFactor(0.98)
		"####" E 0 A_SpawnItemEx("PlayerMuzzle1",35,5,50)		
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 1 BRIGHT A_FireBullets (1, 1, -1, 14, "WeakPuff", FBF_NORANDOM)
		"####" E 0 A_ZoomFactor(1.0)
		"####" E 0 A_JumpIFInventory("PistolBurstFire", 1, "Fire2")			
		"####" "#" 0 A_Quake(1,2,0,12,"")
		"####" B 1 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		"####" C 1
		"####" I 0 A_JumpIfInventory("BDPistolAmmo",1,1)
		Goto NoAmmo+2
		"####" EF 0
		"####" E 0 A_JumpIfInventory("RSA_Opt_Semi", 1, "RSA_SemiEnd")	// 1.41 option: semi auto
		"####" E 0 A_JumpIfInventory("IsTacticalClass", 1, "FireEndTactical")
		"####" D 1
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 3 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 3 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_REfire
		Goto Ready
	
	RSA_SemiEnd:	// 1.41 "Pistol Semi Auto": one shot per pull, each hand its own trigger
		"####" D 1
	RSA_SemiHold:
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_JumpIf((OverlayID() != 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 1) != 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "RSA_SemiHold")
		Goto Ready

	DM:
		"####" A 1 BRIGHT A_FireBullets (1, 1, -1, 14, "WeakPuffDM", FBF_NORANDOM)
		Goto ResumeFireFrame+12

	Fire2:
		"####" A 0
		"####" E 0 A_GiveInventory("BurstCounter",1)
		"####" B 1
		"####" E 0 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		"####" I 0 A_JumpIfInventory("BDPistolAmmo",1,1)
		Goto NoAmmo+2
		"####" E 0 A_JumpIfInventory("BurstCounter",3,2)
		Goto Fire
		"####" AAA 0
		"####" EF 0
		"####" C 1 A_TakeInventory("BurstCounter",0)
		"####" DE 1	
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 2 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		Goto Ready

	FireEndTactical:
		PIST E 0
		PIST E 0 A_JumpIfInventory("IsRunning", 1, "FireEndTactical2")
		PIST E 1 A_WeaponReady(1)
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		PIST E 7 A_WeaponReady(1)
		Goto Ready

	FireEndTactical2:
		PLAY A 0 ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		PIST E 0 A_GiveInventory("UsedStamina", 4)
		PIST E 1 A_WeaponReady(1)
		PIST E 5 A_WeaponReady(1)
		Goto Sprinting

	Inspect:
		PIST E 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		PIST E 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		PIST E 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		PIST E 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PIST E 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PIST E 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PIST E 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PIST E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PIST E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PIST E 0 A_JumpIfInventory("Unloading",1,"Unload")
		PIST E 0 A_Takeinventory("PistolFireAnimation1",1)
		PIST E 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PIST E 0 A_JumpIf(0, "DualWield")
		PIST E 6 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_GiveInventory("DoInspect",1)
		PIST E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PIST E 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		PIST E 0 A_TakeInventory("DoInspect",1)
		PISR AB 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI ABCDEEEEE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Pistol/slide", 5)
		PISI FGHH 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		PISI H 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		PISI H 0 A_PlaySound("pistol/slide2", 5)
		PISI IJKLLL 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI MMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR BA 1 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("Reloading",1)
		Goto Ready

	Reload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",0,"Inspect")
		PIST E 0 A_JumpIfInventory("Clip1",1,3)
		Goto Ready
		TNT1 AAA 0
		PIST E 0 A_Takeinventory("Zoomed",1)
		PIST E 0 A_ZoomFactor(1.0)
		PIST E 0 A_GiveInventory ("Pumping", 1)
		PIST E 0 A_Takeinventory("Reloading",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		PIST E 0 A_JumpIfInventory("HasUnloadedPistol", 1, 3)
		RIFR C 0 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
		PIST E 0 A_PlaySound("Pistol/Reload1", 5)
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",1,"Reload2")//15+1 effect
		TNT1 AA 0
		2ISR ABCDEFGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR HIJKKLLL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR MNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR F 0 A_PlaySound("Pistol/Reload2", 5)
	InsertBullets:
		TNT1 AAAA 0		
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",15,15)
		PIST E 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		PIST E 0 A_Giveinventory("BDPistolAmmo",1)
		PIST E 0 A_Giveinventory("BDDualPistolAmmo",1)
		PIST E 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload
		TNT1 AAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload

	FinishReload:
		2ISR PQRSS 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR T 1 A_PlaySound("pistol/slide2", 5)
		2ISR UV 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR TTUVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR DCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("HasUnloadedPistol",1)
		PIST E 0 A_Takeinventory("HasUnloadedDualPistols",1)
		Goto Ready

	Reload2: //empty
		TNT1 AA 0
		PISR ABCDEFGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR HIJKKLLL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR MNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PIST E 0 A_PlaySound("Pistol/Reload2", 5)
	InsertBullets2:
		TNT1 AAAA 0
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",0,15)
		PIST E 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload2
		TNT1 AAAAAA 0
		PIST E 0 A_Giveinventory("BDPistolAmmo",1)
		PIST E 0 A_Giveinventory("BDDualPistolAmmo",1)
		PIST E 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload2
		TNT1 AAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload2

	FinishReload2:
		PISR PQRSTT 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR UVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR DCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("HasUnloadedPistol",1)
		PIST E 0 A_Takeinventory("HasUnloadedDualPistols",1)
		"####" "#" 0 A_ReFire
		Goto Ready

	Spawn:
		PIST A 0
		P3ST K -1
		Stop

	AltFire:
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		TNT1 A 0 A_JumpIFInventory("PistolBurstFire", 1, 3)
		TNT1 A 0 A_GiveInventory("PistolBurstFire", 1)
		TNT1 A 0 A_Print("$BD_PISTOL_BURST_MODE",0.5)
		Goto Altfire+7
		TNT1 A 0 A_TakeInventory("PistolBurstFire", 1)
		TNT1 A 0 A_Print("$BD_PISTOL_SINGLE_MODE",0.5)
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",1,2)
		PIST I 0
		PIST "#" 1 offset(0,34)
		PIST "#" 1 offset(0,33)
		Goto Ready3

	Steady:
		TNT1 A 1
		Goto Ready

	User2:
	Unload:
		"####" "#" 1 A_WeaponReady
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("BDPistolAmmo",1,3)
		Goto Ready
		TNT1 AAA 0
		PIST E 0 A_Takeinventory("Zoomed",1)
		PIST E 0 A_ZoomFactor(1.0)
		PIST E 0 A_GiveInventory ("Pumping", 1)
		PIST E 0 A_Takeinventory("Reloading",1)
		PISR ABCDWVUTSS 1
		PIST E 0 A_PlaySound("Pistol/Reload1", 5)
		2ISR SONMKJIIHG 1
		2ISR FEDCBA 1
		PIST E 0 A_Giveinventory("HasUnloadedPistol",1)
		PIST E 0 A_Giveinventory("HasUnloadedDualPistols",1)
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",1,"RemoveBullets")
	RemoveBullets:
		TNT1 AAAA 0
		PIST E 0 A_JumpIfInventory("BDPistolAmmo",1,3)
		Goto Ready
		TNT1 AAAAAA 0
		PIST E 0 A_Takeinventory("BDPistolAmmo",1)
		PIST E 0 A_Takeinventory("BDDualPistolAmmo",1)
		PIST E 0 A_Giveinventory("Clip1",1)
		Goto RemoveBullets
		TNT1 AAAAAAAAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto Ready
		TNT1 AAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto Ready

	User3:
	DualWield:
		"####" "#" 0 A_Takeinventory("StartDualWield",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		PIST "#" 0 A_JumpIfInventory("HasDualPistol", 1, "GetDual")
		PIST "#" 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		PIST E 0
		PIST E 0 A_Takeinventory("Zoomed",1)
		PIST E 0 A_Takeinventory("ADSmode",1)
		PIST E 0 A_TakeInventory("TossGrenade", 1)
		PIST E 0 A_TakeInventory("Kicking",1)
		PIST E 0 A_TakeInventory("Taunting",1)
		PIST E 0 A_TakeInventory("Reloading",1)
		PIST E 0 A_TakeInventory("Unloading",1)
		PIST E 0 A_TakeInventory("Salute1", 1)
		PIST E 0 A_TakeInventory("Salute2", 1)
		PIST E 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("SwitchDuals",1)
		PIST F 0 A_GiveInventory("DualPistols",1)
		PIST E 0 A_SelectWEapon("DualPistols")
		Goto Ready
	}
}

ACTOR PuristPistol : BrutalPistol { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }
