// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes ("rsr": real VR reload).
ACTOR Devastator : BrutalWeapon// 7458
{
	//$category "Weapons"
	Scale 0.7
	Weapon.AmmoUse 1
	Weapon.AmmoType "DevastatorAmmo"
	Weapon.SelectionOrder 2400
	+WEAPON.BFG
	-WEAPON.NOAUTOFIRE
	+WEAPON.NOALERT
	+WEAPON.ALT_USES_BOTH
	-WEAPON.AMMO_CHECKBOTH
	-INVENTORY.UNDROPPABLE
	Tag "$TAGBD_DEVASTATOR"
	Inventory.PickupSound "Devastator/select"
	Inventory.PickupMessage "$GOTDEVASTATOR"
	Obituary "$OBBD_DEVASTATOR"
	States
	{
	// posefix rsr (1.97): real VR reload (zscript/rsr/vreload.zs) on a gun Brutal Doom never reloads.
	// The magazine is a COUNTER over BD22's own ammo (zscript/rsq/counters.zs, capacity 50 -- the owner's
	// REMA number; BD22 has none): firing and the reserve are BD22's, untouched. With VR reloading
	// off (rsr_reload 0, or not in VR) the counter is idle and nothing below changes the gun.
	Reload:
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_Mag_Devastator", 0, "Ready")	// full
		"####" "#" 0 A_JumpIfInventory("DevastatorAmmo", 1, "RSR_Start")
		Goto Ready	// nothing in the reserve
	RSR_Start:
		"####" "#" 0 A_TakeInventory("RSR_Go", 1)
		"####" "#" 0 A_GiveInventory("RSR_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto Ready	// RSR_Stock: BD22 has no reload for this gun
	RSR_Out:
		"####" "#" 0 A_TakeInventory("RSR_Go", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_NoMag_Devastator", 1, "RSR_Wait")	// already out
		"####" "#" 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine comes off (its own sound)
		"####" "#" 0 A_TakeInventory("RSQ_Mag_Devastator", 0)	// its rounds go with it; the reserve is BD22's pool and loses none
		"####" "#" 0 A_GiveInventory("RSQ_NoMag_Devastator", 1)
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// seated: the counter takes the reserve's count, up to its capacity (counters.zs)
		"####" "#" 0 A_TakeInventory("RSR_Seated", 1)
		"####" "#" 0 A_TakeInventory("RSQ_NoMag_Devastator", 1)
		"####" "#" 0 A_GiveInventory("RSQ_Fill_Devastator", 1)
		"####" "#" 0 A_GiveInventory("RSR_Filled", 1)
		Goto RSR_Wait
	RSR_Done:
		"####" "#" 0 A_TakeInventory("RSR_Done", 1)
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	KickFlash:
		DEVA RSTU 1
		DEVA V 10
		DEVA UTSR 1
		Stop
	SlideFlash:
		DEVA RSTU 1
		DEVA V 36
		Stop
	SlideFlashEnd:
		DEVA V 5
		DEVA UTSR 1
		Stop
	SlideFlashEndEarly:
		DEVA V 2
		DEVA UTSR 1
		Stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair(CallACS("GetCrosshair", 23))
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_PlaySound("Devastator/select",5)
        DEVA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "SelectPurist")
	SelectAnimation:
		DEVA ZYXW 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair(CallACS("GetCrosshair", 23))	
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		DEVA A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		DEVA A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		DEVA A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		DEVA A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		DEVA A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		DEVA A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")	
		DEVA A 1 A_WeaponReady
		"####" "#" 0 A_JumpIfInventory("Reloading", 1, "Reload")	// posefix rsr: the reload key
		Goto Ready3
	
	/*SelectPurist:
        "####" "#" 0 A_JumpIfInventory("PuristDevastator", 1,3)    
        "####" "#" 0 A_Giveinventory("PuristDevastator",1)
        "####" "#" 0 A_SelectWeapon("PuristDevastator")
        "####" "####" 0 A_Raise
        "####" "#" 1 A_Raise
        "####" "#" 0 A_Takeinventory("Devastator",1)
        Goto SelectPurist+1*/

	StartSprint:
		TNT1 A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		DEVA RST 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_ZoomFactor(1.0)
	Sprinting:
		TNT1 A 0 offset(-9,32)
		TNT1 A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		TNT1 A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		TNT1 A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		TNT1 O 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		TNT1 O 0 offset(-9,32) A_GiveInventory("UsedStamina", 15)
		TNT1 O 0 offset(-9,32)
		DEVA U 1 offset(-9,34) A_SetPitch(pitch -0.5)
		DEVA U 1 offset(-6,36) A_SetPitch(pitch -0.5)
		DEVA U 1 offset(-3,38) A_SetPitch(pitch -0.5)
		DEVA U 1 offset(0,38) A_SetPitch(pitch -0.5)
		DEVA U 1 offset(3,36) A_SetPitch(pitch -0.5)
		DEVA U 1 offset(6,34) A_SetPitch(pitch -0.5)
		DEVA U 1 offset(9,32) A_SetPitch(pitch -0.5)
		TNT1 A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 offset(-9,32) A_GiveInventory("UsedStamina", 8)
		TNT1 A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		DEVA U 1 offset(9,34) A_SetPitch(pitch +0.5)
		DEVA U 1 offset(6,36) A_SetPitch(pitch +0.5)
		DEVA U 1 offset(3,38) A_SetPitch(pitch +0.5)
		DEVA U 1 offset(0,38) A_SetPitch(pitch +0.5)
		DEVA U 1 offset(-3,36) A_SetPitch(pitch +0.5)
		DEVA U 1 offset(-6,34) A_SetPitch(pitch +0.5)
		DEVA U 1 offset(-9,32) A_SetPitch(pitch +0.5)
		TNT1 A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		DEVA TSR 1
		TNT1 A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		TNT1 A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		DEVA A 0
		TNT1 A 0 A_SetCrosshair(CallACS("GetCrosshair", 23))
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		DEVA WXYZ 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Spawn:
		DEVA Z 1
		Loop

	NoAmmo:
		"####" A 5
		Goto Ready3


	AltFire:
	Fire:
		DEVA A 0 A_JumpIfNoAmmo("NoAmmo")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Devastator", 1, "Reload")	// posefix rsr: the magazine is empty
		DEVA A 0 A_PlaySOund("Devastator/fire", 1)
		DEVA A 0 A_ZoomFactor(0.99)
		DEVA A 0 A_JumpIfInventory("RevenantRocketFire1823", 1, "OpenFire2")
		DEVA A 0 A_GiveInventory("RevenantRocketFire1823", 1)
		DEVA A 0 A_SetAngle(Angle-0.9)
		DEVA A 0 A_SetPitch(Pitch+0.4)
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Devastator", 1, "Reload")	// posefix rsr: the magazine is empty
		DEVA B 1 BRIGHT A_FireCustomMissile("DEvastatorMissile", 1.5, -1, 15, -4)
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Devastator", 1, "Reload")	// posefix rsr: the magazine is empty
		DEVA C 1 BRIGHT A_FireCustomMissile("DEvastatorMissile", frandom(1.1,1.9), -1, 15, random(-5,-3))
		DEVA A 0 A_ZoomFactor(1.0)
		DEVA A 0 A_SetPitch(Pitch-0.4)
		DEVA DEE 1 A_SetAngle(Angle+0.3)
		DEVA FGHI 1
		Goto Ready+6

	OpenFire2:
		DEVA A 0 A_TakeInventory("RevenantRocketFire1823", 1)
		DEVA A 0 A_SetAngle(Angle+0.9)
		DEVA A 0 A_SetPitch(Pitch+0.4)
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Devastator", 1, "Reload")	// posefix rsr: the magazine is empty
		DEVA J 1 BRIGHT A_FireCustomMissile("DEvastatorMissile", -1.5, -1, -15, -4)
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Devastator", 1, "Reload")	// posefix rsr: the magazine is empty
		DEVA K 1 BRIGHT A_FireCustomMissile("DEvastatorMissile", frandom(-1.1,-1.9), -1, -15, random(-5,-3))
		DEVA A 0 A_ZoomFactor(1.0)
		DEVA A 0 A_SetPitch(pitch-0.4)
		DEVA LMM 1 A_SetAngle(Angle-0.3)
		DEVA NOPQ 1
		Goto Ready+6
	}
}

ACTOR PuristDevastator : Devastator { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }

ACTOR DEvastatorMissile: revenantseekermissiles
{
	DeathSound "Devastator/explode"
	SeeSound "dsempty"
	+EXTREMEDEATH
	Speed 60
	Damage 20
	States
	{
	Spawn:
		RCKT A 1 BRIGHT
		TNT1 A 0 A_CustomMissile ("ImpFireBallTrail1", 0, 0, random (175, 185), 2, random (-5, 5))
		TNT1 A 0 A_CustomMissile ("ImpFireBallTrail2", 0, 0, random (175, 185), 2, random (-5, 5))
		RCKT B 1 BRIGHT
		TNT1 A 0 A_CustomMissile ("ImpFireBallTrail1", 0, 0, random (175, 185), 2, random (-5, 5))
		TNT1 A 0 A_CustomMissile ("ImpFireBallTrail2", 0, 0, random (175, 185), 2, random (-5, 5))
		TNT1 A 0 A_SpawnItem("RocketSmokeTrail52")
		Loop
	}
}