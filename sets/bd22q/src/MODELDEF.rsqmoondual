// 2026-10-27 (lane rev-unmaker, owner 19:40): dual Moonlight. MODELDEF blocks are per class, so the off-hand
// copy RSQ_Off_BrutalRevolver needs its own. Block 1 is MODELDEF.rsqmoon's first `Model BrutalRevolver`
// block COPIED BYTE FOR BYTE with the class renamed (the engine mirrors the off hand itself, as for the
// generated RSQ_Off_* blocks in MODELDEF.rsqoff): RE-COPY IT whenever that block's placement is refitted.
// Blocks 2-3: the dual-wield gun hand (dualhands.zs labels DFbxTrgBru / DFbxSqzBru, sprite RQFL), which the
// gun itself calls, so each class needs it: the same FBX hand as MODELDEF.rsq's BrutalRevolver rows.
Model RSQ_Off_BrutalRevolver
{
	Path "models/bd/Moonlight"
	Model 0 "rev.md3"
	Skin 0 "WPN-REV.png"
	Scale 1.35 1.35 1.35
	Offset 0.843 -7.091 0.0
	ZOffset 1.059
	AngleOffset -3.854
	PitchOffset 3.363
	RollOffset -10.974	// batch 4 (lane B): gun to the FBX hand fitted from 1.92
	NoInterpolation
	FrameIndex RVMA A 0 0
	FrameIndex RVMA B 0 1
	FrameIndex RVMA C 0 2
	FrameIndex RVMA D 0 3
	FrameIndex RVMA E 0 4
	FrameIndex RVMA F 0 5
	FrameIndex RVMA G 0 6
