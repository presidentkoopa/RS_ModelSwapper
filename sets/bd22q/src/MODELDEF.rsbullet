// 1.97 F6: the round in flight (tools/bd22_plus.py bullet). RS_Ballistics' btracer.obj,
// one tube at eight sizes. RSBM is a 1x1 transparent lump -- a mount point that draws
// nothing, because GZDoom has to hang a model on a sprite frame.

Model RSQ_Bullet	// pistol -- a 9mm, .45 or .38 in flight: a short thin dart
{
	Path "models/rsb"
	Model 0 "btracer.obj"
	SurfaceSkin 0 0 "btracer.png"
	Scale 0.2500 0.2286 0.2286
	DontCullBackfaces
	USEACTORPITCH
	USEACTORROLL
	FrameIndex RSBM A 0 0
}

Model RSQ_Bullet	// smg -- the same round out of a submachine gun
{
	Path "models/rsb"
	Model 0 "btracer.obj"
	SurfaceSkin 0 0 "btracer.png"
	Scale 0.3250 0.2714 0.2714
	DontCullBackfaces
	USEACTORPITCH
	USEACTORROLL
	FrameIndex RSBM B 0 0
}

