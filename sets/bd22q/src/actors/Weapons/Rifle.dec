// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire; "rsr": real VR reload (no gates on this gun)).
ACTOR Rifle : BrutalWeapon
{
	Weapon.AmmoType1 "Clip2"
	Weapon.AmmoType2 "RifleAmmo"
	Weapon.SelectionOrder 800
	-INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "$GOTRIFLE"
	Obituary "$OBBD_RIFLE"
	Tag "$TAGBD_RIFLE"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		RIFG A 0 A_TakeInventory("RSR_Go", 1)
		RIFG A 0 A_GiveInventory("RSR_Start", 1)
		RIFG A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		RIFG A 0 A_TakeInventory("RSR_Go", 1)
		RIFG A 0 A_Takeinventory("Reloading", 1)
		RIFG A 0 A_GiveInventory("Pumping", 1)		// BD22: the player sprite's reload
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle", 1, "RSR_Wait")	// no magazine in the gun
		RIFG A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (Rifle/Reload1)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends (30 + 1), and the reserve's cap loses none
		RIFG A 0 A_JumpIfInventory("RifleAmmo", 2, "RSR_Unload1")
		RIFG A 0 A_GiveInventory("HasUnloadedRifle", 1)
		RIFG A 0 A_GiveInventory("HasUnloadedDualRifles", 1)
		Goto RSR_Wait
	RSR_Unload1:
		RIFG A 0 A_TakeInventory("RifleAmmo", 1)
		RIFG A 0 A_TakeInventory("DoubleRifleAmmo", 1)
		RIFG A 0 A_GiveInventory("RSR_Held_Rifle", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own InsertBullets / InsertBullets2
		RIFG A 0 A_TakeInventory("RSR_Seated", 1)
		RIFG A 0 A_TakeInventory("HasUnloadedRifle", 1)
		RIFG A 0 A_TakeInventory("HasUnloadedDualRifles", 1)
	RSR_Return:		// the held rounds first
		RIFG A 0 A_JumpIfInventory("RSR_Held_Rifle", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		RIFG A 0 A_TakeInventory("RSR_Held_Rifle", 1)
		RIFG A 0 A_GiveInventory("RifleAmmo", 1)
		RIFG A 0 A_GiveInventory("DoubleRifleAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		RIFG A 0 A_JumpIfInventory("RifleAmmo", 1, "RSR_Fill31")
		RIFG A 0 A_GiveInventory("RifleReloadToken", 1)	// no round chambered: the handle (BD22: FinishReloading)
	RSR_Fill30:
		RIFG A 0 A_JumpIfInventory("RifleAmmo", 30, "RSR_Filled")
		RIFG A 0 A_JumpIfInventory("Clip2", 1, "RSR_Fill30a")
		Goto RSR_Filled
	RSR_Fill30a:
		RIFG A 0 A_GiveInventory("RifleAmmo", 1)
		RIFG A 0 A_GiveInventory("DoubleRifleAmmo", 1)
		RIFG A 0 A_TakeInventory("Clip2", 1, TIF_NOTAKEINFINITE)
		Goto RSR_Fill30
	RSR_Fill31:
		RIFG A 0 A_JumpIfInventory("RifleAmmo", 0, "RSR_Filled")
		RIFG A 0 A_JumpIfInventory("Clip2", 1, "RSR_Fill31a")
		Goto RSR_Filled
	RSR_Fill31a:
		RIFG A 0 A_GiveInventory("RifleAmmo", 1)
		RIFG A 0 A_GiveInventory("DoubleRifleAmmo", 1)
		RIFG A 0 A_TakeInventory("Clip2", 1, TIF_NOTAKEINFINITE)
		Goto RSR_Fill31
	RSR_Filled:
		RIFG A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if RifleReloadToken, else done
		Goto RSR_Wait
	RSR_Done:
		RIFG A 0 A_TakeInventory("RSR_Done", 1)
		RIFG A 0 A_TakeInventory("RifleReloadToken", 1)
		RIFG A 0 A_Takeinventory("Reloading", 1)
		Goto ReloadConcluded		// BD22's own end of a reload
	KickFlash: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		RIFG JKLM 1
		RIFG N 10
		RIFG MLKJ 1
		stop
	SlideFlash: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		RIFG JKLM 1
		RIFG N 35
		stop
	SlideFlashEnd: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		RIFG N 5
		RIFG MLKJ 1
		stop
	SlideFlashEndEarly: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		RIFG N 2
		RIFG MLKJ 1
		stop

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedRifle",1)
		RIFG A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		RIFG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		RIFG JKL 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		RIFG A 0
		RISP A 0 offset(-9,32)
		//RIFG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		RIFG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		RIFG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		RIFG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RIFG A 0 offset(-9,32)
		RIFG M 1 offset(-9,34) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(-6,36) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(-3,38) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(0,38) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(3,36) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(6,34) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(9,32) A_SetPitch(pitch -0.5)
		RIFG A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RIFG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		RIFG M 1 offset(9,34) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(6,36) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(3,38) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(0,38) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(-3,36) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(-6,34) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(-9,32) A_SetPitch(pitch +0.5)
		RIFG A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		RIFG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		RIFG LKJ 1
		RIFG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	Select:
		TNT1 A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_TakeInventory("DualRifles", 1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 A_GunFlash
		TNT1 A 0 A_Giveinventory("RifleSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		Goto FirstSelectAnimation

	SelectDual:
		TNT1 A 0 A_Takeinventory("SwitchDuals",1)
		DURR QPON 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		DURR MLKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready3

	SelectAnimation:
		/*TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		TNT1 A 0 A_Takeinventory("BDWeaponAction",1)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")*/
		RIFG IHGF 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 a_jumpifinventory("RifleReloadToken",1,"SelectRechamber")
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		Goto Ready3

	WarmUp:
		RIFG A 0 A_TakeInventory("JustStartedGame", 1)
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 5 A_WeaponReady(WRF_ALLOWZOOM)
		PUNS ABCD 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFG A 0 A_PlaySound("Melee/Reload", 5)
		PUNS E 7 A_WeaponReady(WRF_ALLOWZOOM)
		PUNS FGFE 3 A_WeaponReady(WRF_ALLOWZOOM)
		PUNS DCB 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto TacticalSelect

	FirstSelectAnimation:
		// A 0 A_TakeInventory("NeverSelectedRifle",1)
		TNT1 A 0 A_TakeInventory("JustStartedGame", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		TNT1 A 0 A_Takeinventory("BDWeaponAction",1)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("JustStartedGame", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("JustStartedGame", 1,"warmUp")
		TNT1 A 0 A_TakeInventory("NeverSelectedRifle", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedRifle", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 4 A_WeaponReady(WRF_ALLOWZOOM)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedRifle",1)
		TNT1 A 5 A_WeaponReady(WRF_ALLOWZOOM)
		3IFR ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR GG 1  A_WeaponReady(WRF_ALLOWZOOM)
		RIFR H 2 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR IJKLMNNO 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		RIFR OONPQRSTUU 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR VVVWXYZ 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR "[" 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR B 1 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR ABCDEFG 1 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR H 3 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		2IFR IJJJ 1 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		2IFR KKLMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 //ACS_NamedExecuteAlways("AimMode")
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIf(0, "DualWield")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFG A 0
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_TakeInventory("RFGrenade",1)
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIf(0, "DualWield")
		//RI2G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		TNT1 AAA 0
		//RIFG A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//RIFG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	Deselect:
		RIFG A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_TakeInventory("TossGrenade", 1)
		RIFG A 0 A_TakeInventory("Kicking",1)
		RIFG A 0 A_TakeInventory("Taunting",1)
		RIFG A 0 A_TakeInventory("Reloading",1)
		RIFG A 0 A_TakeInventory("Unloading",1)
		RIFG A 0 A_TakeInventory("Salute1", 1)
		RIFG A 0 A_TakeInventory("Salute2", 1)
		RIFG A 0 A_Takeinventory("RifleSelected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		RIFG EDCB 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		RI2G A 0 A_JumpIfInventory("Zoomed",1,16)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFG A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("RifleAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("RifleAmmo",1)
		"####" "#" 0 A_Takeinventory("DoubleRifleAmmo",1)
		"####" "#" 0 A_JumpIfInventory("RifleAmmo",9,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("RifleAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("Clip2",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("Clip2",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" AAAA 0
		2IFF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFF A 0
		"####" A 0 A_AlertMonsters
		"####" A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_PlaySound("Rifle/Fire", 1)
		"####" "#" 0 A_Quake(1,3,0,4,"")
		"####" A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" "#" 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant")
		"####" A 0 A_GiveInventory("PSeq3",1)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuff", FBF_NORANDOM)
		Goto FinishFire
	SpriteVariant:
		"####" D 0 A_TakeInventory("PSeq3",1)
		"####" D 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuff", FBF_NORANDOM)
	FinishFire:
		"####" B 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		"####" B 0 A_ZoomFactor(0.98)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		"####" A 0 A_SetPitch(pitch-2.0)
		"####" B 1 
		"####" C 1 A_ZoomFactor(1.0)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFG A 0
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, "Ready")//Tactical mode skips a frame, fires faster
		"####" A 1 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		"####" A 0 A_Refire
		Goto Ready
	
	DM:
		"####" A 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuffDM", FBF_NORANDOM)
		Goto FinishFire
	SpriteVariant:
		"####" D 0 A_TakeInventory("PSeq3",1)
		"####" D 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuffDM", FBF_NORANDOM)
		Goto FinishFire

	IsHolding:
		RI2G A 0 A_JumpIfInventory("ZoomHold", 1, 4)
		RIFG A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+15
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RifleAmmo",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim
		
	Fire2:
		RIFG A 0
		//RIFF A 0 A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0)
		RIFG A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		RI2F A 0 BRIGHT A_FireCustomMissile("DecorativeTracer", 0, 0, 0, 0)
		RI2F A 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant2")
		RI2F A 0 A_GiveInventory("PSeq3",1)		
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		RI2F A 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuff", FBF_NORANDOM)
		Goto FinishFire2
	SpriteVariant2:
		RI2F D 0 A_TakeInventory("PSeq3",1)		
		RI2F D 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuff", FBF_NORANDOM)	
	FinishFire2:	
		RIFG A 0 A_ZoomFactor(1.9)
		RIFG A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)
		RIFG A 0 A_SetPitch(pitch-1.0)
		RI2F B 1 A_FireCustomMissile("RifleCaseSpawn",1,0,8,0)
		RI2F C 1 A_ZoomFactor(2.0)
		RIFG A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		RI2G A 1
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")//This allows for more responsiveness when AimMode is set to "both"
		RIFG AAA 0
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RI2F A 0 A_GiveInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		TNT1 AAA 0
		RI2G A 0 A_ReFire
		RI2G A 10 A_WeaponReady(1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RI2G A 0
		Goto Ready2
	
	DM2:
		RI2F A 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuffDM", FBF_NORANDOM)
		Goto FinishFire2
	SpriteVariant2:
		RI2F D 0 A_TakeInventory("PSeq3",1)		
		RI2F D 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuffDM", FBF_NORANDOM)	
		Goto FinishFire2



	FireGrenade:
		TNT1 A 0 A_JumpIf(OverlayID() == 1000000, "RSM_FireOff")	// 1.30 rsm: the off hand's launcher
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_JumpIfInventory("RFGLoaded", 1, 1)
		Goto RSM_NotLoaded
		TNT1 A 0
		//RIFG A 0 A_JumpIfInventory("AmmoRocket", 1, 1)//check for reserve rocketammo
		//Goto NoAmmoGrenade
		//TNT1 A 0
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_GiveInventory("FiredMGGrenade",1)
		//RIFG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")//check for a spent grenade in chamber
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		TNT1 A 0 A_AlertMonsters
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"FireGrenade2")
		RIFG A 0 A_ZoomFactor(0.98)
		GLAN A 0 A_PlaySound("GrenadeLauncher/Fire", 1)
		//RIFG A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		RIFG A 0 BRIGHT A_FireCustomMissile("ShortGrenade", 0, 0, 0, 0)
		TNT1 A 0 A_GiveInventory("FiredMGGrenade",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFF E 1 BRIGHT
		RIFF FGHI 1
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		//RIFG A 0 A_JumpIfInventory("NoAutoReload",1,"Ready3")
		Goto Ready3//ReloadGrenade

	FireGrenade2:
		TNT1 A 0
		RIFG A 0 A_ZoomFactor(1.98)
		GLAN A 0 A_PlaySound("GrenadeLauncher/Fire", 1)
		//RI2G A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		RI2F A 0 BRIGHT A_FireCustomMissile("ShortGrenade", 0, 0, 0, 0)
		RIFG A 0 A_GiveInventory("FiredMGGrenade", 1)
		RIFG A 0 A_ZoomFactor(2.0)
		RI2F E 1 BRIGHT
		RI2F FGH 1
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_TakeInventory("TossGrenade",1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		//RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,"Ready2")
		//RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		//RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		RIFG A 0 A_JumpIfInventory("NoAutoReload",1,"HoldAim")
		RIFG AA 0 
		Goto Ready2//ReloadGrenade

	// 1.30 rsm (zscript/rsr/rsr_m203.zs): in VR with real reload the launcher is loaded by hand
	// (the tube slid forward, a round put in, the tube pulled back); empty, its trigger only clicks.
	// The off hand's launcher (dual) fires from its own round (RSM_LoadedOff).
	RSM_NotLoaded:
		TNT1 A 0 A_JumpIfInventory("RSM_VR", 1, "RSM_Dry")
		Goto ReloadGrenade
	RSM_Dry:
		RIFG A 0 A_TakeInventory("RFGrenade", 1)
		RIFG A 0 A_StartSound("Weapon/Empty", CHAN_AUTO)
	RSM_DryHold:	// one click a press: wait for secondary fire to be let go
		RIFG A 1
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("FiredSecondary") > 0, "RSM_DryHold")
		Goto Ready3
	RSM_AltGrenade:
		RIFG A 0 A_JumpIf(OverlayID() == 1000000, "RSM_FireOff")
		RIFG A 0 A_JumpIfInventory("RFGLoaded", 1, "FireGrenade")
		Goto RSM_NotLoaded
	RSM_FireOff:
		TNT1 A 0 A_TakeInventory("RFGrenadeOff", 1)
		TNT1 A 0 A_JumpIfInventory("RSM_LoadedOff", 1, 1)
		Goto RSM_DryOff
		TNT1 A 0 A_TakeInventory("RSM_LoadedOff", 1)
		TNT1 A 0 A_GiveInventory("RSM_FiredOff", 1)
		TNT1 A 0 A_AlertMonsters
		GLAN A 0 A_StartSound("GrenadeLauncher/Fire", CHAN_AUTO)
		RIFG A 0 BRIGHT A_FireCustomMissile("ShortGrenade", 0, 0, 0, 0)
		RIFF E 1 BRIGHT
		RIFF FGHI 1
		Goto Ready3
	RSM_DryOff:
		RIFG A 0 A_StartSound("Weapon/Empty", CHAN_AUTO)
	RSM_DryOffHold:
		RIFG A 1
		RIFG A 0 A_JumpIf(OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0, "RSM_DryOffHold")
		Goto Ready3

	ReloadGrenadeSelect:
		TNT1 A 0
		//TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		RIFG A 0 A_JumpIfInventory("AmmoRocket", 1, 2)//check for reserve rocketammo
		Goto NoAmmoGrenade+2
	ReloadGrenade:
		TNT1 AA 0
		//TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		RIFG A 0 A_JumpIfInventory("AmmoRocket", 1, 1)//check for reserve rocketammo
		Goto NoAmmoGrenade
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIGL ABC 1
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle",1,"ReloadGrenadeUnloaded")
		RIGL DEFGGHH 1
		HBUS A 0 A_PlaySound("Rifle/Grenade1", 5)
		TNT1 A 0 A_SpawnItemEX("GrenadeCasing",2,0,40,0,0,-4,0)//A_CustomMissile("GrenadeCasing",0,30,random(-3,3), 2 ,random(-80,-90))
		RIGL IJJJJKLMNO 1
		RIGL P 4
		RIGL QRSTUUVVV 1
		HBUS A 0 A_PlaySound("GrenadeLauncher/Load", 5)
		TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		RIGL WXYYYYZZ 1
		RIG2 ABCDEE 1
		TNT1 A 0 A_GiveInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		HBUS A 0 A_PlaySound("Rifle/Grenade2", 5)
		RIGL IHHHHGGFEDCBA 1 A_WEaponReady(WRF_NOFIRE)
		RIFG A 0 A_ZoomFactor(1.0)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_TakeInventory("TossGrenade",1)
		Goto Ready3

	ReloadGrenadeUnloaded:
		TNT1 A 0
		1IGL DEFGGHH 1
		HBUS A 0 A_PlaySound("Rifle/Grenade1", 5)
		TNT1 A 0 A_SpawnItemEX("GrenadeCasing",2,0,40,0,0,-4,0)//A_CustomMissile("GrenadeCasing",0,30,random(-3,3), 2 ,random(-80,-90))
		1IGL IJJJJKLMNO 1
		1IGL P 4
		1IGL QRSTUUVVV 1
		HBUS A 0 A_PlaySound("GrenadeLauncher/Load", 5)
		TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		1IGL WXYYYYZZ 1
		1IG2 ABCDEE 1
		TNT1 A 0 A_GiveInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		HBUS A 0 A_PlaySound("Rifle/Grenade2", 5)
		1IGL IHHHHGGFED 1 A_WEaponReady(WRF_NOFIRE)
		RIGL CBA 1 A_WEaponReady(WRF_NOFIRE)
		RIFG A 0 A_ZoomFactor(1.0)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_TakeInventory("TossGrenade",1)
		Goto Ready3

	NoAmmoGrenade:
		RIFG A 1
		RIFG A 0 A_Print("Out of explosive ammo.")
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		//TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 1
		Goto Ready3

	AltFire:
		RIFG A 0
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")	// F11: before the M203, purist has none
		RIFG A 0 A_Jump(256, "RSM_AltGrenade")	// 1.33 rsm (owner): the rifle's secondary fire launches the underbarrel
		RIFG A 0 A_TakeInventory("FiredMGGrenade",1)
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		RIFG A 0 A_Giveinventory("GoSpecial",1)
		RIFG A 0 A_Giveinventory("Zoomed",1)
		//RIFG A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(41)
		RIFG A 0 A_ZoomFactor(2.0)
		RIFG A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		RIFZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weapons/rifle/move")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		RI2G A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		RI2G A 4
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		RIFZ ABC 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		RI2G A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		RIFG A 0
		RIFG A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		RI2G A 0 A_JumpIf(0, "DualWield")
		//TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//RIFG A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//RIFG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		RIFG AA 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 0
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		RIFZ BA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		RIFZ BA 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	//Inspecting anim (also repurposed as rechambering)
	Inspect:
		RIFG A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIf(0, "DualWield")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		RIFG A 6 A_WeaponReady(WRF_ALLOWZOOM)
		RIFG A 0 A_GiveInventory("DoInspect",1)
		RIFG A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RIFG A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		RIFG A 0 A_TakeInventory("DoInspect",1)
		2IFR POB 1 A_WeaponReady(WRF_ALLOWZOOM)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		2IFR CDEFG 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		2IFR H 5 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR IIJJ 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		2IFR J 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		2IFR KKLM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR N 4 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR NOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		RIFG A 0 A_TakeInventory("DoInspect",1)
		2IFR POB 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		2IFR CDEFG 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		2IFR H 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR IIJJ 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		2IFR J 2 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		2IFR KKLM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR N 4 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR NOP 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		RIFG A 0 A_ClearReFire
		RIFR STUU 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_Takeinventory("HasUnloadedRifle",1)
		RIFG A 0 A_Takeinventory("HasUnloadedDualRifles",1)
		RIFR VVVWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR "[" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		"####" "#" 0 A_TakeInventory("RifleSpread", 10)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("RSR_Held_Rifle", 1, 4)	// posefix rsr F11 R3 (RSR_HeldGo): held rounds reload even on an empty reserve; lands where the next line does
		"####" "#" 0 A_JumpIfInventory("Clip2",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		TNT1 AAA 0
		"####" "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		"####" "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		RIFG A 0 A_JumpIfInventory("RifleAmmo",0,"Inspect")
		RIFG A 0 A_JumpIfInventory("RifleReloadToken",1,"Inspect")
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		//RIFG A 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle", 1, 2)
		RIFG A 0 A_PlaySound("Rifle/Reload1", 5)
		RIFG A 0 A_GiveInventory ("Pumping", 1)
		RIFG A 0 A_Takeinventory("Reloading",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFR ABCDEFGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle", 1, 2)
		RIFR G 0 A_FireCustomMissile("EmptyClipSpawn",-5,0,8,-4)
		RIFR H 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR IJKLMNNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		RIFR OONPQR 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_JumpIfInventory("RifleAmmo",1,"InsertBullets2")//30+1 effect
		TNT1 A 0 A_GiveInventory("RifleReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		RIFG A 0 A_ClearReFire
		RIFR STUU 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR VVVWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR "[" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR ABCDEFG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR H 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		2IFR IJJJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		TNT1 A 0 A_TakeInventory("RifleReloadToken",1)
		2IFR KKLMNOP 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("RifleAmmo",30,15)
		RIFG A 0 A_JumpIfInventory("Clip2",1,3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		RIFG A 0 A_Giveinventory("RifleAmmo",1)
		RIFG A 0 A_Giveinventory("DoubleRifleAmmo",1)
		RIFG A 0 A_Takeinventory("HasUnloadedRifle",1)
		RIFG A 0 A_Takeinventory("HasUnloadedDualRifles",1)		
		RIFG A 0 A_Takeinventory("Clip2",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire
		Goto FinishReloading

	InsertBullets2:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("RifleAmmo",0,15)
		RIFG A 0 A_JumpIfInventory("Clip2",1,3)
		Goto FullReload
		TNT1 AAAAAA 0
		RIFG A 0 A_Giveinventory("RifleAmmo",1)
		RIFG A 0 A_Giveinventory("DoubleRifleAmmo",1)
		RIFG A 0 A_Takeinventory("Clip2",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire
		Goto FullReload
		TNT1 AAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire
		Goto FullReload

	ReloadConcluded:
		RIFG A 0
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		RIFG A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("RifleAmmo",1,3)
		Goto Ready
		TNT1 AAA 0
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 0 A_Takeinventory("Unloading",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFR AB 1
		RIFR "[" 1
		RIFR ZYXWVVV 1
		RIFG A 0 A_PlaySound("Rifle/Reload1", 5)
		RIFG A 0 A_GiveInventory ("Pumping", 1)
		RIFG A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("RifleAmmo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		RIFG A 0 A_Takeinventory("RifleAmmo",1)
		RIFG A 0 A_Takeinventory("DoubleRifleAmmo",1)
		RIFG A 0 A_GiveInventory("HasUnloadedRifle", 1)
		RIFG A 0 A_Giveinventory("HasUnloadedDualRifles",1)		
		RIFG A 0 A_Giveinventory("Clip2",1)
		Goto RemoveBullets
	FInishUnload:
		RIFR QONNMLKJIHGFEDCBA 1
		RIFG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3

	Spawn:
		RIFL A -1
		Stop

	User3:
	DualWield:
		RIFG A 0
		RIFG A 0 A_Takeinventory("StartDualWield",1)
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		RIFG A 0 A_JumpIfInventory("IsTacticalClass", 1, "FireGrenade")//Tactical mode cant dual, but firing grenade
		RIFG A 0 A_JumpIfInventory("HasDualRifle", 1, "GetDual")
		RIFG A 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_TakeInventory("TossGrenade", 1)
		RIFG A 0 A_TakeInventory("Kicking",1)
		RIFG A 0 A_TakeInventory("Taunting",1)
		RIFG A 0 A_TakeInventory("Reloading",1)
		RIFG A 0 A_TakeInventory("Unloading",1)
		RIFG A 0 A_TakeInventory("Salute1", 1)
		RIFG A 0 A_TakeInventory("Salute2", 1)
		RIFG A 0 A_Giveinventory("DualRifles",1)
		RIFG A 0 A_Giveinventory("SwitchDuals",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_SelectWEapon("DualRifles")
		Goto Ready
	}
}

// 2.0 (owner, 2026-10-28): the Purist rifle draws the Rifle's mesh with its M203 (MODELDEF.purist), but it
// has no launcher: secondary fire does nothing at all (no grenade, no dry click, no purist warning).
// Each state below holds one tic, because Ready3 / Ready2 jump straight back here while the key is held.
ACTOR PuristRifle : Rifle
{
	-WEAPON.NOAUTOAIM
	+WEAPON.CHEATNOTWEAPON
	States
	{
	AltFire:
		"####" "#" 0 A_TakeInventory("RFGrenade", 1)
		"####" "#" 1 A_WeaponReady(WRF_NOSECONDARY)
		Goto Ready3
	FireGrenade:	// BD22's launcher key while aiming (Ready2: TossGrenade)
		"####" "#" 0 A_TakeInventory("RFGrenade", 1)
		"####" "#" 1 A_TakeInventory("TossGrenade", 1)
		Goto Ready3
	}
}

ACTOR RifleAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 31
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 31
	Inventory.Icon "RIFLA0"
}

ACTOR MeatshieldGunAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 30
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 30
}

ACTOR MeatAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 100
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 100
}