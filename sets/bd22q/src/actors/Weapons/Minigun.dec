// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire).

ACTOR MiniGun : BrutalWeapon
{
	Game Doom
	SpawnID 28
	Weapon.AmmoType "RSQ_MinigunAmmo"	// 2.0 (owner 2026-10-28): the Minigun's OWN pool (was BD22's shared Clip2); RSQ_MinigunAmmo below
	Weapon.AmmoUse 1
	Weapon.AmmoGive 200	// 2.0 (owner): picking the Minigun up gives one magazine's worth (BD22 gave 0: Clip2 was shared)
	Weapon.SelectionOrder 700
	+WEAPON.ALT_USES_BOTH
	-WEAPON.AMMO_CHECKBOTH
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "CBOXPKUP"
	Inventory.PickupMessage "$BDGOTCHAINGUN"
	Obituary "$OBBD_CHAINGUN"
	Tag "$TAGBD_CHAINGUN"
	States
	{
	// posefix rsr (1.97): real VR reload (zscript/rsr/vreload.zs) on a gun Brutal Doom never reloads.
	// r6 (owner item 13): the magazine is a REAL magazine of 200 (zscript/rsq/counters.zs REAL[]): every shot comes
	// out of it, the reserve (RSQ_MinigunAmmo since 2.0, was Clip2) is what is left in the pouch, and a reload moves rounds from the pouch into it.
	// The rounds stay in the magazine while it is out (a top-up, nothing is lost). With VR reloading
	// off (rsr_reload 0, or not in VR) the counter is idle and nothing below changes the gun.
	Reload:
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_NoMag_Minigun", 1, "RSR_Start")	// posefix rsr (r6): the magazine is out, put it back
		"####" "#" 0 A_JumpIfInventory("RSQ_Mag_Minigun", 0, "Ready")	// full
		"####" "#" 0 A_JumpIfInventory("RSQ_Pouch_Minigun", 1, "RSR_Start")	// posefix rsr (r6): rounds in the pouch (counters.zs)
		Goto Ready	// nothing in the pouch
	RSR_Start:
		"####" "#" 0 A_TakeInventory("RSR_Go", 1)
		"####" "#" 0 A_GiveInventory("RSR_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto Ready	// RSR_Stock: BD22 has no reload for this gun
	RSR_Out:
		"####" "#" 0 A_TakeInventory("RSR_Go", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_NoMag_Minigun", 1, "RSR_Wait")	// already out
		"####" "#" 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine comes off (its own sound)
		"####" "#" 0 A_GiveInventory("RSQ_NoMag_Minigun", 1)
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// seated: the counter takes the reserve's count, up to its capacity (counters.zs)
		"####" "#" 0 A_TakeInventory("RSR_Seated", 1)
		"####" "#" 0 A_TakeInventory("RSQ_NoMag_Minigun", 1)
		"####" "#" 0 A_GiveInventory("RSQ_Fill_Minigun", 1)
		"####" "#" 0 A_GiveInventory("RSR_Filled", 1)
		Goto RSR_Wait
	RSR_Done:
		"####" "#" 0 A_TakeInventory("RSR_Done", 1)
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	Spawn:
		MGUN A 1
		MGUN A -1
		Stop

	KickFlash: 
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("Spin",1,"SpinKickFlash")
		"####" HIJK 1
		"####" L 10
		"####" KJIH 1
		stop
	SlideFlash: 
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("Spin",1,"SpinSlideFlash")
		"####" HIJK 1
		"####" L 35
		stop
	SlideFlashEnd: 
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("Spin",1,"SpinSlideFlashEnd")
		"####" L 5
		"####" KJIH 1
		stop
	SlideFlashEndEarly: 
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("Spin",1,"SpinSlideFlashEndEarly")
		"####" L 2
		"####" KJIH 1
		stop

	SpinKickFlash: 
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" MNOP 1
		"####" QRSTQRSTQR 1//L 10
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" PONM 1
		TNT1 A 0 A_StopSound(1)
		stop
	SpinSlideFlash: 
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" MNOP 1
		"####" L 10
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" L 25
		TNT1 A 0 A_StopSound(1)
		stop
	SpinSlideFlashEnd: 
		"####" RSTQR 1
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" PONM 1
		TNT1 A 0 A_StopSound(1)
		stop
	SpinSlideFlashEndEarly: 
		"####" QR 1
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" PONM 1
		TNT1 A 0 A_StopSound(1)
		stop

	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedMinigun",1)
		CHAE UVWX 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Chaingun/beltQuiet", 5)
		CHAS ABCDEE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Chaingun/belt", 5)
		CHAS FFFGHIJLMNOOOPQRST 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_GiveInventory("RandomHeadExploder", 1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 6) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_Giveinventory("MinigunSelected",1)
		TNT1 A 0 A_PlaySound("CHGNPKUP", 5)
		TNT1 A 0 A_TakeInventory("NeverSelectedMinigun", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedMinigun", 1,"FirstSelectAnimation")
		
	SelectAnimation:
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
		"####" UVWX 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		CHAG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		CHAG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		CHAG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		CHAG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		CHAG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		CHAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 1 A_WeaponReady
		"####" "#" 0 A_JumpIfInventory("Reloading", 1, "Reload")	// posefix rsr: the reload key
		CHAG A 0 A_JumpIfInventory("Spin",1,"Ready2")
		CHAG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		CHAG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		CHAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		CHAG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		CHAG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		CHAG A 0 A_PlaySound("Chaingun/Spin", 5)
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" ACDE 1 A_WeaponReady
		"####" "#" 0 A_JumpIfInventory("Reloading", 1, "Reload")	// posefix rsr 1.99x: the reload key while spun up (Ready2 never read it)
		CHAG A 0 A_AlertMonsters
		Loop

	StartSprint:
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		"####" HIJ 1 A_WeaponReady(WRF_NOFIRE)
		"####" A 0 A_Takeinventory("Zoomed",1)
		"####" A 0 A_Takeinventory("ADSmode",1)
		"####" A 0 A_ZoomFactor(1.0)	
	Sprinting:
		"####" K 0 offset(-9,32)
		//CHAG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		"####" A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		"####" A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		"####" A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 9)
		"####" A 0 offset(-9,32)
		"####" K 1 offset(-9,34) A_SetPitch(pitch -0.5)
		"####" K 1 offset(-6,36) A_SetPitch(pitch -0.5)
		"####" K 1 offset(-3,38) A_SetPitch(pitch -0.5)
		"####" K 1 offset(0,38) A_SetPitch(pitch -0.5)
		"####" K 1 offset(3,36) A_SetPitch(pitch -0.5)
		"####" K 1 offset(6,34) A_SetPitch(pitch -0.5)
		"####" K 1 offset(9,32) A_SetPitch(pitch -0.5)
		"####" A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 9)
		"####" A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		"####" K 1 offset(9,34) A_SetPitch(pitch +0.5)
		"####" K 1 offset(6,36) A_SetPitch(pitch +0.5)
		"####" K 1 offset(3,38) A_SetPitch(pitch +0.5)
		"####" K 1 offset(0,38) A_SetPitch(pitch +0.5)
		"####" K 1 offset(-3,36) A_SetPitch(pitch +0.5)
		"####" K 1 offset(-6,34) A_SetPitch(pitch +0.5)
		"####" K 1 offset(-9,32) A_SetPitch(pitch +0.5)
		"####" A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		"####" A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		"####" JIH 1
		"####" A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		"####" A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		CHAG A 0 A_TakeInventory ("Spin",1)
		CHAG A 0 A_TakeInventory("TossGrenade", 1)
		CHAG A 0 A_Takeinventory("HeavyAutomaticWeapon",1)
		CHAG A 0 A_TakeInventory("RandomHeadExploder", 1)
		CHAG A 0 SetPlayerProperty(0,0,0)
		CHAG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" "][" 1
		"####" ZY 1 
		"####" A 0 A_StopSound(5)
		"####" AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	HoldEmpty:
		CHAF A 0 A_JumpIfInventory("RSQ_MinigunAmmo",1,"Hold")	// 2.0: own pool (was Clip2)
		CHAF A 0 A_PlaySound("Chaingun/Spin", 5)
		CHAF R 1 A_PlaySound("Weapon/Empty", 1)
		CHAF ST 1 
		CHAF R 1 A_PlaySound("Weapon/Empty", 1)
		CHAF ST 1 
		CHAF R 1 A_PlaySound("Weapon/Empty", 1)
		CHAF ST 1
		CHAF A 0 A_ReFire("HoldEmpty")
		Goto EndSpin

	HoldSpinEmpty:
		CHAF A 0 A_JumpIfInventory("RSQ_MinigunAmmo",1,"HoldSpin")	// 2.0: own pool (was Clip2)
		CHAF A 0 A_PlaySound("Chaingun/Spin", 5)
		CHAF P 1 A_PlaySound("Weapon/Empty", 1)
		CHAF Q 1 
		CHAF P 1 A_PlaySound("Weapon/Empty", 1)
		CHAF Q 1
		CHAF P 1 A_PlaySound("Weapon/Empty", 1)
		CHAF Q 1 
		CHAF B 0 A_ReFire("HoldSpinEmpty")
		Goto Ready2

	Fire:
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0
		"####" A 0 A_JumpIfInventory("Spin",1,"HoldSpin")
		"####" A 0 A_PlaySound("Chaingun/Start", 5)
		"####" A 0 BRIGHT A_FireCustomMissile("Alerter", 0, 0, 0, 0)
		"####" A 0 A_AlertMonsters
		"####" ABDF 1
		"####" A 0 A_StopSound(5)
	Hold:
		CHAV A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		CHAF A 0
		"####" A 0 A_JumpIfInventory("Spin",1,"HoldSpin")
		"####" A 0 A_JumpIfNoAmmo("HoldEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		//Fire 1
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" G 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" HI 1
		"####" A 0
		"####" A 0 A_JumpIfNoAmmo("HoldEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		//fire 2
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" J 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" KL 1
		"####" A 0
		"####" A 0 A_JumpIfNoAmmo("HoldEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		//fire 3
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle3",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" M 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" NO 1
		"####" B 0 A_ReFire
		"####" A 0 A_JumpIfInventory("Spin",1,"Ready2")
	EndSpin:
		CHAG A 0 A_PlaySound("Chaingun/Stop", 5)
		CHAG A 0 A_TakeInventory("Spin",1)
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" DFCDEACDE 1 A_ReFire("Hold")
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 2 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCD 3 A_WeaponReady(WRF_ALLOWZOOM)
		"####" EF 4 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready
	
	DM:
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" G 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuffDM", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" HI 1
		"####" A 0
		"####" A 0 A_JumpIfNoAmmo("HoldEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		//fire 2
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" J 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuffDM", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" KL 1
		"####" A 0
		"####" A 0 A_JumpIfNoAmmo("HoldEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		//fire 3
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle3",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" M 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuffDM", FBF_NORANDOM | FBF_USEAMMO)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" NO 1
		"####" B 0 A_ReFire
		"####" A 0 A_JumpIfInventory("Spin",1,"Ready2")
		Goto EndSpin

	HoldSpin:
		//fire1
		CHAG A 0 A_JumpIfNoAmmo("HoldSpinEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
