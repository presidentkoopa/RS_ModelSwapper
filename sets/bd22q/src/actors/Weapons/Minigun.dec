		CHAF F 1
		CHAG A 0 A_JumpIfNoAmmo("HoldSpinEmpty")
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		CHAG A 0 A_ReFire("HoldSpin")
		Goto Ready2
	
	DM2:
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
