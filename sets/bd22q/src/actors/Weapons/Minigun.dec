		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_Minigun", 1, "Reload")	// posefix rsr: the magazine is empty
		CHAF C 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM | FBF_USEAMMO)
		HBUS A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
