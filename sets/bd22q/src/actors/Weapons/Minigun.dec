		CHAG A 0 A_ReFire("HoldSpin")
		Goto Ready2

	AltFire:
		CHAG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		//CHAG A 0 A_JumpIfNoAmmo("Ready")
		CHAE A 0 A_JumpIfNoAmmo(2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("Spin",1,"StopAlt")
		"####" A 0 A_GiveInventory ("Spin",1)
		"####" A 0 A_PlaySound("Chaingun/Start", 5)
		"####" ABCDEF 1
		Goto Ready2

	StopAlt:
		"####" A 0
		"####" A 0 A_TakeInventory ("Spin",1)
		"####" A 0 A_PlaySound("Chaingun/Stop", 5)
		"####" ACDEACDEF 1
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 2 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCD 3 A_WeaponReady(WRF_ALLOWZOOM)
		"####" EF 4 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready
	}
}

ACTOR PuristMinigun : Minigun { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }

// 2.0 (owner 2026-10-28): the Minigun's own ammo pool. Reserve 400 (the magazine of 200 sits ON TOP, counters.zs RealTick),
// 800 with a backpack (BD22's x2 rule). The rifle-family guns keep BD22's Clip2 (200 / 400). Pickups: this box, put
// beside map-placed bullet pickups by RSQ_Roster (roster.zs: every bullet box, 1 in 4 clips), 50 rounds each (= BD22's
// ClipBox2); a backpack gives 50; picking up the Minigun gives 200 (Weapon.AmmoGive above).
ACTOR RSQ_MinigunAmmo : Ammo
{
	Inventory.Amount 50
	Inventory.MaxAmount 400
	Ammo.BackpackAmount 50
	Ammo.BackpackMaxAmount 800
	Inventory.PickupMessage "Picked up a box of Minigun ammo."
	Inventory.PickupSound "CBOXPICK"	// BD22's bullet box sound
	Inventory.Icon "AMMOA0"
	Tag "Minigun ammo"
	Scale 0.9
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		AMMO A -1	// BD22's bullet box art (ClipBox2)
		Stop
	}
}
