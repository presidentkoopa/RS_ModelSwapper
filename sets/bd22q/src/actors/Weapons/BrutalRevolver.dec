// BrutalRevolver (r5, owner 2026-10-27): the Moonlight six-shooter, shown as "Revolver".
// BD22's own `Revolver` class is the shotgun-shell revolver (the Shotvolver) and keeps its mesh.
//
// FIRING, BD21's revolver rules (Revolver2.dec, parsed): one round per chamber, a 6-round
// cylinder, 100 damage a shot (A_FireBullets 1, 1, 1, 100, "ShotgunPuff2", FBF_NORANDOM).
// Owner: ONE SHOT PER TRIGGER PULL (RSQ_SemiLock, zscript/rsq/semiauto.zs) and at most 5-6 shots
// a second: the fire cycle is 7 tics (35 / 7 = 5 a second). No recoil here: recoil is being
// designed with the owner (RECOIL_DESIGN.md). Revolver2's shotgun-pellet particles are left out:
// this fires one round.
//
// AMMO (owner 2026-10-28 06:46, from the headset: "Change Moonlight to take BrutalPistol ammo, consume 3 ammo
// per shot, reloads after 18 ammo consumption"): the reserve is BD22's Brutal Pistol's own, Clip1 (brutal22test6
// actors/Weapons/Pistol.dec:3 Weapon.AmmoType1 "Clip1"; this pack's copy src/actors/Weapons/Pistol.dec:4; the class
// is brutal22test6 actors/MISC/Ammo.dec:50, cap 100 / 200 with a backpack). BrutalRevolverCylinder counts SHOTS in
// the gun (0-6). Loading one chamber takes 3 Clip1, so a full cylinder is 18 pistol rounds and a shot spends 3 of
// them. With fewer than 3 in the reserve a chamber cannot be loaded. The Moonlight's own rounds item (its ring
// pickup, its map spawns beside bullet pickups, its 36 / 72 cap) is gone.
// On maps (roster.zs, option "Moonlight Replaces Pistol", rsq_moonlight_pistol, owner 20:45): the gun takes the
// Brutal Pistol's place (start, map pistols, the pistol zombie's drop).
// (Revolver2.dec, quoted above for the firing rules, was removed 2026-10-27; it is in git history.)
// DUAL (owner 2026-10-27 19:40, "Dual Revolvers, of course"): RSQ_Off_BrutalRevolver at the end of this
// file is the off-hand copy (dual.zs / dualtable.zs index 10), written by hand on the pattern of
// DECORATE.rsqdual's generated copies: its own cylinder (BrutalRevolverCylinderOff), the shared reserve,
// one shot per pull of the OFF trigger (RSQ_SemiLockOff, roster.zs), and the flick reload (flick.zs),
// which plays the mesh's own reload animation. Both cylinders load from the one shared Clip1 reserve.
//
// RELOAD (r5, stock): the mesh's own animation (reference/moonlight/README.md, measured): break-top
// open (frames 16-19), the six rounds out (20-29), the speedloader in (21-30) and away (31-38),
// shut (30-36). The speedloader fills the cylinder from the reserve, up to 6 shots (3 Clip1 each), in one go.
// moon-reload: in VR with Real reload on, Reload goes to RSB_Start: the hand-driven break-open
// (rsb_guns.zs rows 10 speedloader / 11 a round at a time, rev_rsb.md3); the stock animation is RSB_Stock.
//
// Sprites RVMA A-Z = rev.md3 frames 0-25, RVMB A-O = frames 26-40 (MODELDEF.rsqmoon).

ACTOR BrutalRevolverCylinder : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 6
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 6
	+INVENTORY.IGNORESKILL
}

ACTOR BrutalRevolver : BrutalWeapon
{
	Weapon.SelectionOrder 1350
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 18		// 2026-10-28: a full cylinder's worth of pistol rounds (was 6 of its own rounds = 6 shots)
	Weapon.AmmoGive2 0
	Weapon.AmmoType1 "Clip1"	// BD22's Brutal Pistol's reserve (header)
	Weapon.AmmoType2 "BrutalRevolverCylinder"
	Inventory.PickupMessage "You got the Moonlight Revolver!"
	Inventory.PickupSound "Revolver/Hammer"
	Obituary "$OBBD_REVOLVER"
	AttackSound "None"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	+INVENTORY.ALWAYSPICKUP		// a second Revolver is taken even with the pistol reserve full, so dual.zs can make it the off-hand copy
	Scale 0.9
	Tag "Revolver"
	States
	{
	Spawn:
		RVMP A -1				// 2026-10-27: the Moonlight's own world model (MODELDEF.rsqmoonammo, rev.md3 frame 0 on its side); RVMPA0.png = BD22's REVPA0 for 2D
		Stop

	Select:
		RVMA A 0 A_Giveinventory("GoSpecial",1)
		RVMA A 0 A_Takeinventory("FistsSelected",1)
		RVMA A 0 A_Takeinventory("SawSelected",1)
		RVMA A 0 A_Takeinventory("ShotgunSelected",1)
		RVMA A 0 A_Takeinventory("SSGSelected",1)
		RVMA A 0 A_Takeinventory("MinigunSelected",1)
		RVMA A 0 A_Takeinventory("PlasmaGunSelected",1)
		RVMA A 0 A_Takeinventory("RocketLauncherSelected",1)
		RVMA A 0 A_Takeinventory("GrenadeLauncherSelected",1)
		RVMA A 0 A_Takeinventory("BFGSelected",1)
		RVMA A 0 A_Takeinventory("BFG10kSelected",1)
		RVMA A 0 A_Takeinventory("RailGunSelected",1)
		RVMA A 0 A_Takeinventory("SMGSelected",1)
		RVMA A 0 A_Takeinventory("RevenantLauncherSelected",1)
		RVMA A 0 A_Takeinventory("LostSoulSelected",1)
		RVMA A 0 A_Takeinventory("FlameCannonSelected",1)
		RVMA A 0 A_Takeinventory("HasBarrel",1)
		RVMA A 0 A_TakeInventory("TossGrenade", 1)
		RVMA AAAAAA 1 A_Raise
		Wait

	Deselect:
		RVMA A 0 A_Takeinventory("Zoomed",1)
		RVMA A 0 A_TakeInventory("TossGrenade", 1)
		RVMA A 0 A_ZoomFactor(1.0)
		RVMA A 1 A_Lower
		Wait

	Ready3:
	Ready:
		RVMA A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RVMA A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RVMA A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RVMA A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RVMA A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RVMA A 0 A_JumpIfInventory("FiredPrimary",1,"Fire")
		RVMA A 1 A_WeaponReady(WRF_ALLOWRELOAD)
		RVMA A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		Loop

	RSQ_SemiWait:	// the trigger is still held from the last shot: one shot per pull
		RVMA A 1 A_WeaponReady(WRF_ALLOWRELOAD)
		RVMA A 0 A_JumpIfInventory("RSQ_SemiLock", 1, "RSQ_SemiWait")
		Goto Ready

	Fire:
		RVMA A 0 A_JumpIfInventory("RSQ_SemiLock", 1, "RSQ_SemiWait")
		RVMA A 0 A_Takeinventory("Reloading",1)
		RVMA A 0 A_JumpIfInventory("BrutalRevolverCylinder",1,1)
		Goto NoAmmo
		RVMA A 0 A_GiveInventory("RSQ_SemiLock", 1)
		RVMA A 0 A_AlertMonsters
		RVMA A 0 A_PlaySound("Revolver/Fire", 1)
		RVMA A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		RVMA A 0 A_FireCustomMissile("DecorativeTracer", 0, 0, 0, -12, 0, 0)
		RVMA A 0 A_Takeinventory("BrutalRevolverCylinder",1)
		RVMA A 0 A_FireBullets (1, 1, 1, 100, "ShotgunPuff2", FBF_NORANDOM)	// BD21 Revolver2: 1 round, 100
		// the mesh's own shot, frames 1-14, played over the 7-tic cycle (5 shots a second at most)
		RVMA B 1 BRIGHT
		RVMA D 1 BRIGHT
		RVMA F 1
		RVMA H 1
		RVMA J 1
		RVMA L 1
		RVMA N 1
		Goto Ready

	NoAmmo:
		RVMA A 0 A_PlaySound("Weapon/Empty", 4)
		RVMA A 0 A_JumpIfInventory("Clip1",3,"Reload")
	NoAmmo2:
		RVMA A 5 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOFIRE)
		RVMA A 0 A_JumpIfInventory("Reloading",1,"Reload")
		RVMA A 0 A_JumpIfInventory("FiredPrimary",1,"NoAmmo2")
		Goto Ready

	Reload:
		RVMA A 0 A_TakeInventory("Reloading", 1)
		RVMA A 0 A_JumpIfInventory("BrutalRevolverCylinder",6,"Ready")
		RVMA A 0 A_JumpIfInventory("Clip1",3,1)
		Goto Ready
		RVMA A 0		// (a state for the jump above to land on)
		Goto RSB_Start	// moon-reload: the hand-driven VR reload (zscript/rsr/rsr_break.zs, rsb_guns.zs rows 10/11)
	RSB_Stock:		// not in VR, or Real reload off: the mesh's own animation
		RVMA A 0 A_GiveInventory("Pumping", 1)
		// break-top open (mesh frames 16-19)
		RVMA QRS 1
		RVMA A 0 A_PlaySound("Revolver/Open", 5)
		RVMA T 2
		// the rounds out, the speedloader in (20-30)
		RVMA UVWXYZ 2
		RVMB ABCD 2
		RVMB E 2 A_PlaySound("Revolver/Reload", 5)
	Fill:		// the speedloader: up to 6 shots from the reserve, 3 Clip1 a shot
		RVMB E 0 A_JumpIfInventory("BrutalRevolverCylinder",6,"Shut")
		RVMB E 0 A_JumpIfInventory("Clip1",3,1)
		Goto Shut
		RVMB E 0 A_GiveInventory("BrutalRevolverCylinder",1)
		RVMB E 0 A_TakeInventory("Clip1",3,TIF_NOTAKEINFINITE)
		Loop
	Shut:		// shut, the speedloader away (31-40)
		RVMB FGH 2
		RVMB I 1 A_PlaySound("Revolver/Hammer", 4)
		RVMB JKLMNO 1
		RVMA A 0 A_TakeInventory("Reloading", 1)
		Goto Ready

	// moon-reload: RSR-BREAK, as BD22's Revolver.dec (its RSB_* states), on BrutalRevolver's own ammo.
	// Not in VR, or with Real reload off, RSB_Start goes straight on into RSB_Stock.
	RSB_Start:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_GiveInventory("RSB_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_Go", 1, "RSB_Open")
		Goto RSB_Stock
	RSB_Open:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_GiveInventory("Pumping", 1)
	RSB_Wait:		// the gun as the script shows it; the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSB_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_EjectT", 1, "RSB_Eject")
		"####" "#" 0 A_JumpIfInventory("RSB_LoadT", 1, "RSB_Load")
		"####" "#" 0 A_JumpIfInventory("RSB_TopUpT", 1, "RSB_TopUp")
		"####" "#" 0 A_JumpIfInventory("RSB_Done", 1, "RSB_Done")
		Goto RSB_Wait
	RSB_Eject:		// the script throws the mesh's own rounds itself (WorldEject): nothing to spawn
		"####" "#" 0 A_TakeInventory("RSB_EjectT", 8)
		Goto RSB_Wait
	RSB_Load:		// speedloader home: fill the cylinder to 6 shots; a round at a time (rsb_revolver_feed 1): one. 3 Clip1 a shot
		"####" "#" 0 A_TakeInventory("RSB_LoadT", 1)
		"####" "#" 0 A_JumpIf(GetCVar("rsb_revolver_feed") != 0, "RSB_LoadOne")
	RSB_TopUp1:
		"####" "#" 0 A_JumpIfInventory("BrutalRevolverCylinder", 6, "RSB_Wait")
		"####" "#" 0 A_JumpIfInventory("Clip1", 3, 1)
		Goto RSB_Wait
		"####" "#" 0 A_GiveInventory("BrutalRevolverCylinder", 1)
		"####" "#" 0 A_TakeInventory("Clip1", 3, TIF_NOTAKEINFINITE)
		Goto RSB_TopUp1
	RSB_LoadOne:
		"####" "#" 0 A_JumpIfInventory("BrutalRevolverCylinder", 6, "RSB_Wait")
		"####" "#" 0 A_JumpIfInventory("Clip1", 3, 1)
		Goto RSB_Wait
		"####" "#" 0 A_GiveInventory("BrutalRevolverCylinder", 1)
		"####" "#" 0 A_TakeInventory("Clip1", 3, TIF_NOTAKEINFINITE)
		Goto RSB_Wait
	RSB_TopUp:		// not used by rows 10/11 (Cap 6 = chambers x per load); kept for the protocol
		"####" "#" 0 A_TakeInventory("RSB_TopUpT", 1)
		Goto RSB_Wait
	RSB_Done:		// shut
		RVMA A 0 A_TakeInventory("RSB_Done", 1)
		RVMA A 0 A_TakeInventory("Reloading", 1)
		Goto Ready
	}
}

// ---- dual wield: the off-hand Moonlight (2026-10-27, owner 19:40) ----------------------------------------------
ACTOR BrutalRevolverCylinderOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 6
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 6
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_BrutalRevolver : BrutalRevolver
{
	Tag "Off-hand Revolver"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON
	-INVENTORY.ALWAYSPICKUP
	Weapon.AmmoType1 "Clip1"
	Weapon.AmmoType2 "BrutalRevolverCylinderOff"
	States
	{
	// the engine fires the off-hand weapon on BT_OFFHANDATTACK through A_WeaponReady (as RSQ_Off_Revolver);
	// BD22's FiredPrimary / Reloading tokens are the MAIN hand's, so they are not read here
	Ready3:
	Ready:
		RVMA A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RVMA A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RVMA A 1 A_WeaponReady
		Loop

	RSQ_SemiWait:	// the off trigger is still held from the last shot: one shot per pull
		RVMA A 1 A_WeaponReady(WRF_NOFIRE)
		RVMA A 0 A_JumpIfInventory("RSQ_SemiLockOff", 1, "RSQ_SemiWait")
		Goto Ready

	Fire:
		RVMA A 0 A_JumpIfInventory("RSQ_SemiLockOff", 1, "RSQ_SemiWait")
		RVMA A 0 A_JumpIfInventory("BrutalRevolverCylinderOff",1,1)
		Goto NoAmmo
		RVMA A 0 A_GiveInventory("RSQ_SemiLockOff", 1)
		RVMA A 0 A_AlertMonsters
		RVMA A 0 A_PlaySound("Revolver/Fire", 1)
		RVMA A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		RVMA A 0 A_FireCustomMissile("DecorativeTracer", 0, 0, 0, -12, 0, 0)
		RVMA A 0 A_Takeinventory("BrutalRevolverCylinderOff",1)
		RVMA A 0 A_FireBullets (1, 1, 1, 100, "ShotgunPuff2", FBF_NORANDOM)	// as the main gun
		RVMA B 1 BRIGHT
		RVMA D 1 BRIGHT
		RVMA F 1
		RVMA H 1
		RVMA J 1
		RVMA L 1
		RVMA N 1
		Goto Ready

	NoAmmo:
		RVMA A 0 A_PlaySound("Weapon/Empty", 4)
	NoAmmo2:
		RVMA A 5 A_WeaponReady(WRF_NOFIRE)
		Goto Ready

	Reload:		// the flick (flick.zs) sets this state on the off hand
		RVMA A 0 A_JumpIfInventory("BrutalRevolverCylinderOff",6,"Ready")
		RVMA A 0 A_JumpIfInventory("Clip1",3,1)
		Goto Ready
		RVMA A 0
		Goto RSB_Stock	// the mesh's own reload (the hand-driven break-open is the main hand's; RSB_Start is never given from here)
	RSB_Stock:
		RVMA QRS 1
		RVMA A 0 A_PlaySound("Revolver/Open", 5)
		RVMA T 2
		RVMA UVWXYZ 2
		RVMB ABCD 2
		RVMB E 2 A_PlaySound("Revolver/Reload", 5)
	Fill:
		RVMB E 0 A_JumpIfInventory("BrutalRevolverCylinderOff",6,"Shut")
		RVMB E 0 A_JumpIfInventory("Clip1",3,1)
		Goto Shut
		RVMB E 0 A_GiveInventory("BrutalRevolverCylinderOff",1)
		RVMB E 0 A_TakeInventory("Clip1",3,TIF_NOTAKEINFINITE)
		Loop
	Shut:
		RVMB FGH 2
		RVMB I 1 A_PlaySound("Revolver/Hammer", 4)
		RVMB JKLMNO 1
		Goto Ready
	}
}
