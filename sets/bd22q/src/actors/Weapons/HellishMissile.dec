// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes ("rsr": real VR reload).
ACTOR HellishMissileLauncher : BrutalWeapon
{
	Weapon.AmmoUse 1
	Weapon.AmmoType "MiniHellRocketAmmo"
	Weapon.SelectionOrder 3200
	-WEAPON.AMMO_CHECKBOTH
	+WEAPON.EXPLOSIVE
	-WEAPON.NOAUTOFIRE
	+WEAPON.ALT_USES_BOTH
	-INVENTORY.UNDROPPABLE
	Inventory.PickupMessage "$GOTREVMISSILE"
	Inventory.PickupSound "RevLaunch/Draw"
	Tag "$TAGBD_REVMISSILE"
	Obituary "$OBBD_REVMISSILE"
	States
	{
	// posefix rsr (1.97): real VR reload (zscript/rsr/vreload.zs) on a gun Brutal Doom never reloads.
	// The magazine is a COUNTER over BD22's own ammo (zscript/rsq/counters.zs, capacity 6 -- the owner's
	// REMA number; BD22 has none): firing and the reserve are BD22's, untouched. With VR reloading
	// off (rsr_reload 0, or not in VR) the counter is idle and nothing below changes the gun.
	Reload:
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_NoMag_HellishMissileLauncher", 1, "RSR_Start")	// r5 lane rev-unmaker (owner 20:47, ammo "on top"): a REAL magazine now (counters.zs REAL[]); out: put it back
		"####" "#" 0 A_JumpIfInventory("RSQ_Mag_HellishMissileLauncher", 0, "Ready")	// full
		"####" "#" 0 A_JumpIfInventory("RSQ_Pouch_HellishMissileLauncher", 1, "RSR_Start")	// rounds in the pouch (counters.zs)
		Goto Ready	// nothing in the pouch
	RSR_Start:
		"####" "#" 0 A_TakeInventory("RSR_Go", 1)
		"####" "#" 0 A_GiveInventory("RSR_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto Ready	// RSR_Stock: BD22 has no reload for this gun
	RSR_Out:
		"####" "#" 0 A_TakeInventory("RSR_Go", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_NoMag_HellishMissileLauncher", 1, "RSR_Wait")	// already out
		"####" "#" 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine comes off (its own sound)
		"####" "#" 0 A_GiveInventory("RSQ_NoMag_HellishMissileLauncher", 1)
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// seated: the counter takes the reserve's count, up to its capacity (counters.zs)
		"####" "#" 0 A_TakeInventory("RSR_Seated", 1)
		"####" "#" 0 A_TakeInventory("RSQ_NoMag_HellishMissileLauncher", 1)
		"####" "#" 0 A_GiveInventory("RSQ_Fill_HellishMissileLauncher", 1)
		"####" "#" 0 A_GiveInventory("RSR_Filled", 1)
		Goto RSR_Wait
	RSR_Done:
		"####" "#" 0 A_TakeInventory("RSR_Done", 1)
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	SlideFlash:
		RVCG A 20 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
	KickFlash:
		RVCG A 9 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
	SlideFlashEnd:
		RVCG A 3 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
	SlideFlashEndEarly:
		RVCG A 6 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		stop

	ForceBobbing:
		TNT1 A 10 A_WeaponReady(WRF_NOFIRE)
		loop

	Select:
		RVCG A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 16) )
		TNT1 A 0 A_GunFlash
	SelectAnimation:
		TNT1 A 0 A_JumpIfInventory("RevenantLauncherCheck", 1, "Ready3")
		TNT1 A 1
		RVCG A 0 A_Giveinventory("RevenantLauncherSelected",1)
		RVCG A 0 A_PlaySound("RevLaunch/Draw", 5)
		RVCG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "SelectPurist")
		RVCG QPON 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
		RVCG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RVCG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RVCG A 1 A_WeaponReady(WRF_ALLOWZOOM)
		RVCG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RVCG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RVCG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RVCG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RVCG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RVCG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIfInventory("Reloading", 1, "Reload")	// posefix rsr: the reload key
		Goto Ready3
	
	/*SelectPurist:
		"####" "#" 0 A_JumpIfInventory("RevenantLauncherCheck", 1, "Ready3")
        "####" "#" 0 A_JumpIfInventory("PuristHellishMissileLauncher", 1,3)    
        "####" "#" 0 A_Giveinventory("PuristHellishMissileLauncher",1)
        "####" "#" 0 A_SelectWeapon("PuristHellishMissileLauncher")
        "####" "####" 0 A_Raise
        "####" "#" 1 A_Raise
        "####" "#" 0 A_Takeinventory("HellishMissileLauncher",1)
        Goto SelectPurist+1*/

	StartSprint:
		RVCG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		RVCG A 1 A_WeaponReady(WRF_NOFIRE)
		RVCG A 0 A_ZoomFactor(1.0)
	Sprinting:
		RVCG A 0 offset(-9,32)
		RVCG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		RVCG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		RVCG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		RVCG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		RVCG A 0 offset(-9,32)
		RVCG A 1 offset(-9,34) A_SetPitch(pitch -0.5)
		RVCG A 1 offset(-6,36) A_SetPitch(pitch -0.5)
		RVCG A 1 offset(-3,38) A_SetPitch(pitch -0.5)
		RVCG A 1 offset(0,38) A_SetPitch(pitch -0.5)
		RVCG A 1 offset(3,36) A_SetPitch(pitch -0.5)
		RVCG A 1 offset(6,34) A_SetPitch(pitch -0.5)
		RVCG A 1 offset(9,32) A_SetPitch(pitch -0.5)
		RVCG A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		RVCG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RVCG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RVCG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		RVCG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		RVCG A 1 offset(9,34) A_SetPitch(pitch +0.5)
		RVCG A 1 offset(6,36) A_SetPitch(pitch +0.5)
		RVCG A 1 offset(3,38) A_SetPitch(pitch +0.5)
		RVCG A 1 offset(0,38) A_SetPitch(pitch +0.5)
		RVCG A 1 offset(-3,36) A_SetPitch(pitch +0.5)
		RVCG A 1 offset(-6,34) A_SetPitch(pitch +0.5)
		RVCG A 1 offset(-9,32) A_SetPitch(pitch +0.5)
		RVCG A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		RVCG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		RVCG A 1
		RVCG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		TNT1 A 0 A_TakeInventory("IsAlreadyTaunting",1)
		TNT1 A 0 A_TakeInventory("Taunting",1)
		PIST F 0 A_TakeInventory("TossGrenade", 1)
		PIST F 0 A_Lower
		RVCG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "DeselectPurist")
		RVCG NOPQ 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Spawn:
		FATB D -1
		Loop

	NoAmmo:
		"####" A 5
		Goto Ready3


	Fire:
	AltFire:
		RVCG A 0 A_JumpIfNoAmmo("NoAmmo")	
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_HellishMissileLauncher", 1, "Reload")	// posefix rsr: the magazine is empty
		PVCG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 2)
		RVCG A 0
		"####" A 0 A_PlaySOund("Incendiary/Fire", 1)
		"####" A 0 A_AlertMonsters
		"####" A 0 A_ZoomFactor(0.98)
		"####" "#" 0 A_Quake(2,3,0,12,"")
		"####" A 0 A_JumpIfInventory("RevenantRocketFire1823", 1, "OpenFire2")
		"####" A 0 A_GiveInventory("RevenantRocketFire1823", 1)
		"####" A 0 BRIGHT A_FireCustomMissile("Alerter", 0, 0, -1, 0)
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_HellishMissileLauncher", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" B 0 BRIGHT A_FireCustomMissile("revenantseekermissiles2", 0, 1, -16, 2)
		"####" B 1 BRIGHT A_WeaponReady(WRF_NOFIRE)
		"####" C 0 BRIGHT A_ZoomFactor(1.0)
		"####" C 1 BRIGHT A_WeaponReady(WRF_NOFIRE)
		"####" A 0 A_GunFlash("RecoilLeft", GFF_NOEXTCHANGE)
		"####" DEFG 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWZOOM)
		RVCG A 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto Ready+6

	OpenFire2:
		"####" A 0 A_TakeInventory("RevenantRocketFire1823", 1)
		"####" "#" 0 A_JumpIfInventory("RSQ_Empty_HellishMissileLauncher", 1, "Reload")	// posefix rsr: the magazine is empty
		"####" H 0 BRIGHT A_FireCustomMissile("revenantseekermissiles2", 0, 1, 16, 2)
		"####" H 1 BRIGHT A_WeaponReady(WRF_NOFIRE)
		"####" I 0 BRIGHT A_ZoomFactor(1.0)
		"####" I 1 BRIGHT A_WeaponReady(WRF_NOFIRE)
		"####" A 0 A_GunFlash("RecoilRight", GFF_NOEXTCHANGE)
		"####" JKLM 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWZOOM)
		RVCG A 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto Ready+6
		
	RecoilLeft:
		TNT1 A 1 A_SetAngle(angle-2)
		TNT1 AA 1 A_SetAngle(angle+1)
		stop

	RecoilRight:
		TNT1 A 1 A_SetAngle(angle+2)
		TNT1 AA 1 A_SetAngle(angle-1)
		stop

	Taunt:
		RVCG A 0 A_GunFlash("TauntFlash", GFF_NOEXTCHANGE)
		RVCG A 25 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto Ready

	TauntFlash:
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Taunting",1)
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 ACS_NamedExecuteWithResult("VoiceTaunt",0,0,0,0)
		VUCK A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 2)
		FUCK A 0
		"####" ABC 1
		"####" A 0 A_AlertMonsters
		"####" A 0 BRIGHT A_FireCustomMissile("Taunter", 0, 0, -1, 0)
		"####" A 0 BRIGHT A_FireCustomMissile("Taunter", -9, 0, -1, 0)
		"####" A 0 BRIGHT A_FireCustomMissile("Taunter", 9, 0, -1, 0)
		"####" D 15
		"####" EEFGHI 1
		TNT1 A 2 A_Takeinventory("Taunting",1)
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		stop

	TossGrenade:
		RVCG A 0 A_GunFlash("TossGrenadeFlash")
		RVCG A 0 A_JumpIfInventory("GrenadeAmmo", 1, 1)
		Goto Ready
		RVCG A 25 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto Ready

	TossGrenadeFlash: 
		"####" "#" 0 A_TakeInventory("TossGrenade", 1)
		"####" "#" 0 A_JumpIfInventory("GrenadeAmmo", 1, 4)
		"####" "#" 0 A_Print("$BD_NO_GRENADES")
		stop
		"####" "#####" 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"TossGrenadePurist")		
		"####" "#" 1
		"####" A 0 A_Takeinventory("HasPlasmaWeapon",1)
		TNT1 A 0 A_TakeInventory("HasCutingWeapon",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_Takeinventory("PowerLightAmp",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		GRTH ABCDEF 1
		GRTH A 0 A_GiveInventory("FiredGrenade", 1)
		GRTH A 0 A_Giveinventory("Punching",1)
		GRTH A 0 A_Giveinventory("GoSpecial",1)
		GRTH A 0 A_PLaySound ("Grenade/Pin",0)
		GRTH FGHIJK 1
		TNT1 A 2
		TNT1 A 0 A_PLaySound ("Grenade/Toss",0)
		TNT1 A 0 A_Quake(3,4,0,12,"")
		TNT1 A 0 A_TakeInventory("GrenadeAmmo", 1,TIF_NOTAKEINFINITE)
		TNT1 A 0 A_TakeInventory("FiredGrenade", 1)
		GRTH LM 1
		GRTH A 0 A_ThrowGrenade("HandGrenade",5,45,5,0)
		GRTH NOP 1
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("TossGrenade", 1, "TossGrenade")
		TNT1 A 0 A_TakeInventory("TossGrenade", 1)
		stop	
	}
}

ACTOR PuristHellishMissileLauncher : HellishMissileLauncher { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }

ACTOR revenantseekermissiles2: revenantseekermissiles
{
	Damage (random(50, 50))
	Speed 30
	Radius 2
	Height 2
	+SCREENSEEKER
	-GHOST
	-THRUGHOST
	-SHOOTABLE
	Damagetype "ExplosiveImpact"
	States
	{
	Xdeath:
	Death:
		RVCG A 0
		BFE1 A 0 Bright A_Explode(20, 120, 1)
		Goto Explodez
	}
}

ACTOR revenantseekermissiles3: revenantseekermissiles2
{
	-SCREENSEEKER
	-SEEKERMISSILE
	Damagetype "ExplosiveImpact"
}

ACTOR RevenantMissileFriendAttackSummon
{
	Radius 1
	Height 1
	Speed 0
	Mass 999999999999999999
	Health 1
	gravity 0.5
	Decal "BloodSuper"
	+NOCLIP
	MONSTER
	+FRIENDLY
	+LOOKALLAROUND
	-SHOOTABLE
	+MISSILEMORE
	+MISSILEEVENMORE
	States
	{
	Spawn:
		RVCG A 0 A_Look
		TNT1 AAA 0 A_Chase
		TNT1 AAAAAA 1 A_Chase
		Stop
	Missile:
		TNT1 A 1 A_FaceTarget
		RVCG A 0 A_CustomMissile("revenantseekermissiles2")
		Stop
	}
}