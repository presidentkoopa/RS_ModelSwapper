// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire; "rsr": real VR reload (no gates on this gun)).
Actor RailGun : BrutalWeapon
{
	Weapon.AmmoType1 "AmmoCell"
	Weapon.AmmoType2 "RailgunAmmo"
	Weapon.SelectionOrder 50
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "misc/w_pkup"
	Inventory.Pickupmessage "$GOTRAILGUN"
	Obituary "$OBBD_RAILGUN"
	Tag "$TAGBD_RAILGUN"
	DropItem "RailgunSpawner"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		RAIL A 0 A_TakeInventory("RSR_Go", 1)
		RAIL A 0 A_GiveInventory("RSR_Start", 1)
		RAIL A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		RAIL A 0 A_TakeInventory("RSR_Go", 1)
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun", 1, "RSR_Wait")	// no magazine in the gun
		RAIL A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside; they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		RAIL A 0 A_JumpIfInventory("RailgunAmmo", 1, "RSR_Unload1")
		RAIL A 0 A_GiveInventory("HasUnloadedRailgun", 1)
		Goto RSR_Wait
	RSR_Unload1:
		RAIL A 0 A_TakeInventory("RailgunAmmo", 1)
		RAIL A 0 A_GiveInventory("RSR_Held_RailGun", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		RAIL A 0 A_TakeInventory("RSR_Seated", 1)
		RAIL A 0 A_TakeInventory("HasUnloadedRailgun", 1)
	RSR_Return:		// the held rounds first
		RAIL A 0 A_JumpIfInventory("RSR_Held_RailGun", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		RAIL A 0 A_TakeInventory("RSR_Held_RailGun", 1)
		RAIL A 0 A_GiveInventory("RailgunAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		RAIL A 0 A_JumpIfInventory("RailgunAmmo", 1, "RSR_FillB")	// the gun was not empty: no handle
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		RAIL A 0 A_JumpIfInventory("RailgunAmmo", 0, "RSR_Filled")
		RAIL A 0 A_JumpIfInventory("AmmoCell", 10, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		RAIL A 0 A_GiveInventory("RailgunAmmo", 1)
		RAIL A 0 A_TakeInventory("AmmoCell", 10, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		RAIL A 0 A_JumpIfInventory("RailgunAmmo", 0, "RSR_Filled")
		RAIL A 0 A_JumpIfInventory("AmmoCell", 10, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		RAIL A 0 A_GiveInventory("RailgunAmmo", 1)
		RAIL A 0 A_TakeInventory("AmmoCell", 10, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		RAIL A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		RAIL A 0 A_TakeInventory("RSR_Done", 1)
		RAIL A 0 A_TakeInventory("Reloading", 1)
		Goto RSR_End
	//EMPTY KICKS
	KickFlash: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmo",1,"KickFull")
		RAIL RSTU 1
		RAIL V 10
		RAIL UTSR 1
		stop
	SlideFlash: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmo",1,"SlideFull")
		RAIL RSTU  1
		RAIL V 35
		stop
	SlideFlashEnd: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmo",1,"SlideEndFull")
		RAIL V 6
		RAIL UTSR 1
		stop
	SlideFlashEndEarly: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmo",1,"SlideEndEarlyFull")
		RAIL V 2
		RAIL UTSR 1
		stop
	//FULL KICKS
	KickFull:
		RAIL MNOP 1
		RAIL Q 10
		RAIL PONM 1
		stop
	SlideFull: 
		RAIL MNOP  1
		RAIL Q 35
		stop
	SlideEndFull: 
		RAIL Q 6
		RAIL PONM 1
		stop
	SlideEndEarlyFull: 
		RAIL Q 2
		RAIL PONM 1
		stop

	FirstSelectAnim:
		TNT1 A 0 A_Takeinventory("NeverSelectedRailgun",1)
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAR2 RSTUVW 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR HHIIIII 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR JKLMNO 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIL A 0 A_PlaySound("Railgun/Reload2", 5)
		RAIR OPPPQQRS 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR TTUVWXXXXX 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR YZF 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR "[]" 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAR2 ABCDDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Plasma/Beep", 1)
		RAR2 GHHH 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Railgun/Recharge", 5)
		RAR2 IIIIJKLMNOPQ 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIL A 0 A_Takeinventory("Reloading",1)
		Goto Ready

	Deselect:
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL D 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		RAIL EFGH 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_Giveinventory("RailGunSelected",1)
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
	SelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedRailgun", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedRailgun",1,"FirstSelectAnim")
		RAIL D 0 A_JumpIfInventory("IsPlayingAsPurist",1,8)
		RAIL LKJI 1 A_WeaponReady(WRF_NOFIRE)
		RA1S A 0 A_JumpIfInventory("HasUnloadedRailgun",1,5)
		RA1S A 0 A_JumpIfInventory("NoReloading",1,2)
		RA1S A 0 A_JumpIfInventory("RailgunAmmo",1,2)
		Goto SelectAnimation+11
		RA1S A 0 A_JumpIfInventory("AmmoCell",1,1)
		Goto SelectAnimation+11
		RAIL A 0 A_PlaySound("Railgun/Recharge", 5)
		RAIL D 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		//TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL A 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RAIL A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RAIL A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAIL A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL D 0 A_JumpIfInventory("NoReloading",1,2)
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",1,5)
		Goto Ready+14
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,4)
		RAIZ O 0 A_JumpIfInventory("Zoomed", 1, 2)
		RAIL D 0 
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Goto Ready//ReadyNoAmmo
		TNT1 AAAA 0
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		RAIL ABC 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Goto Ready

	ReadyNoAmmo:
		RAIZ O 0 A_JumpIfInventory("Zoomed", 1, 2)
		RAIL D 0 
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Goto Ready

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RAIL A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL A 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RAIL A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RAIL A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAIL A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RAIZ D 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,3)
		"####" "#" 0 A_JumpIfInventory("RailgunAmmo",1,4)
		RAIZ O 0
		Goto Ready2+15
		"####" "#" 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0
		"####" "#" 0 A_JumpIfInventory("AimMode_Toggle",1,5)
		"####" "#" 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		"####" "###" 0
		"####" "#" 3 BRIGHT A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop


	DontNeedToReload:
		RAIL A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		Goto Ready

	Fire:
		RAIL D 0 A_JumpIfInventory("Zoomed",1,6)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#"  0 A_JumpIfInventory("NoReloading",1,"NoReload")
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",1,2)
		RAIL D 0
		Goto NoAmmo//Reload
		"####" "#"  0 A_Takeinventory("RailgunAmmo",1)
		Goto ResumeFireFrame
		"####" "#"  0 A_JumpIfInventory("NoReloading",1,3)
		RAIZ D 0 A_JumpIfInventory("RailgunAmmo",1,4)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto NoAmmo
		RAIZ D 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+1

	NoReload:
		"####" "#"  0 A_JumpIfInventory("AmmoCell",10,2)
		RAIL D 0
		Goto NoAmmo//DontNeedToReload
		"####" "#"  0 A_Takeinventory("AmmoCell",10,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" "##" 0
		"####" "#"  0 A_PlaySound("Railgun/Fire", 1)
		"####" "#"  0 A_AlertMonsters
		"####" "#" 0 A_Quake(4,4,0,4,"")
		"####" "#"  0 A_FireCustomMissile("RailgunTrailEffectMissile", 0, 0, 0, 0)
		"####" "#"  0 A_FireCustomMissile("RailgunProjectile", 0, 1, 0, 0)
		//"####" "#" 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" "#"  0 A_RailAttack(400, 0, 0, "none", "none", RGF_FULLBRIGHT, 1, "RailgunPuff2")
		"####" "#"  0 A_JumpIfInventory("Zoomed",1,"ZoomedRecoil")
		2AIF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RAIF A 0
		"####" AB 1 BRIGHT
		"####" A 0 A_SetPitch(-8.0 + pitch)
		"####" A 0 A_ZoomFActor(0.7)
		"####" CD 1 A_SetPitch(-0.5 + pitch)
		"####" A 0 A_ZoomFActor(1.0)
		"####" A 0 
		"####" EF 1
		"####" G 1 A_SetPitch(0.5 + pitch)
		RAIF H 1 A_SetPitch(0.5 + pitch)
		RAIF HHHHHHHH 1 A_SetPitch(1.0 + pitch)
		RAIF HHHH 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIF H 0 A_JumpIfInventory("NoReloading",1,2)
		RAIF H 0 A_JumpIfInventory("RailgunAmmo",1,3)
		Goto NoAmmo//Ready+14
		RAIF H 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo//Ready+14
		RAIL AAAA 0 
		RAIL A 0 A_PlaySound("Railgun/Recharge", 5)
		RAIF IJK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIF KKKKKKKKKKKKKKKKKKKK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Plasma/BeepBeep", 6)
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		RAIL A 0 A_Refire
		TNT1 AAAA 0
		Goto Ready3
	
	DM:
		"####" "#"  0 A_RailAttack(400, 0, 0, "none", "none", RGF_FULLBRIGHT, 1, "RailgunPuff2DM")
		Goto ResumeFireFrame+10

	IsHolding:
		RAIZ D 0 A_JumpIfInventory("ZoomHold", 1, 3)
		RAIZ D 0 A_GiveInventory("ZoomHold", 1)
		Goto ZoomedRecoil+11
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RailgunAmmo",5,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim
	ZoomedRecoil:
		RAIZ D 0
		RAIZ EF 1 BRIGHT A_AlertMonsters
		RAIZ D 0 A_SetPitch(-4.0 + pitch)
		RAIZ D 0 A_ZoomFActor(5.1)
		RAIZ GHI 1 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		RAIZ D 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RAIZ D 0 A_JumpIfInventory("ZoomHold", 1, 2)
		RAIZ D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		RAIZ DDD 0
		RAIZ D 0 A_ZoomFActor(5.0)
		RAIZ JKKKKKKK 1 BRIGHT A_SetPitch(0.5 + pitch)
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,3)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmo",1,4)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto Reload//NoAmmo
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto Reload//NoAmmo//Reload
		TNT1 AA 0
		RAIZ D 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		RAIZ D 0 A_JumpIfInventory("ZoomHold",1,"HoldZoomedRecoil")
		RAIZ KKKKKK 1 BRIGHT A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "SuddenStopAim")
		RAIZ D 0 A_PlaySound("Railgun/Recharge", 5)
		RAIZ D 0 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIZ KKKKKKKKKKKKK 2 BRIGHT A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "SuddenStopAim2")
		RAIZ D 0 A_JumpIfInventory("ZoomHold",1,"SuddenStopAim2")
		RAIZ D 0 A_PlaySound("Plasma/BeepBeep", 6)
		"####" "#" 1 A_Refire
		Goto Ready2

	HoldZoomedRecoil:
		RAIZ KKKKKK 1 BRIGHT
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 2)
		Goto SuddenStopAim
		RAIL AA 0
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,2)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmo",1,3)
		Goto HoldZoomedRecoil+12
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ D 0
		Goto NoAmmo//Ready
		RAIL AA 0 
		RAIZ D 0 A_PlaySound("Railgun/Recharge", 5)
		RAIZ D 0 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIZ KKKKKKKKKKKKK 2 BRIGHT
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 2)
		Goto SuddenStopAim2
		RAIZ DD 0
		RAIZ D 0 A_PlaySound("Plasma/BeepBeep", 6)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		"####" "#" 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		"####" "#" 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		"####" "#" 1 A_Refire
		"####" "#" 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		"####" "#" 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		Goto NoAim

	SuddenStopAim:
		RAIL A 0
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIZ BA 1
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,2)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmo",1,3)
		Goto SuddenStopAim+10
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo//Reload
		TNT1 AA 0
		RAIF H 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Railgun/Recharge", 5)
		RAIF IJK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIF KKKKKKKKKKKKKKKKKKKK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Plasma/BeepBeep", 6)
		Goto Ready

	SuddenStopAim2:
		RAIL A 0
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIZ BA 1
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,2)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmo",1,3)
		Goto SuddenStopAim2+10
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo//Reload
		TNT1 AA 0
		RAIF KKKKKKKKK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Plasma/BeepBeep", 6) 
		Goto Ready

	// 2.0 scope-toggle (owner 2026-10-28 01:55): alt fire now TOGGLES THE LIVE SCOPE. The toggle is
	// read off the alt-fire button by RSQ_ScopeReal (zscript/rsq/scope_real.zs); this state still
	// only swallows the press. The note below (2026-10-23) explains why it is a swallow state.
	//
	// 2026-10-23: ALT FIRE ON THE RAILGUN IS DELIBERATELY FREE.
	//
	// Secondary fire used to be the scope zoom. The scope is now the RSQ scope component
	// (zscript/rsq/scope.zs; rsq_scope2_railgun chooses Dot or Real, MENUDEF.rsq "Railgun
	// Scope"), so alt fire no longer zooms -- and NOTHING has replaced it. The owner has not
	// chosen what secondary fire should do on this weapon, so do not invent one here: this
	// state exists to swallow the press and hand the weapon back to Ready.
	//
	// The old zoom entry is kept verbatim immediately below as ZoomAltFire, and every zoom
	// state it leads to (ToggleAim, HoldAim, NoAim, ZoomedRecoil, HoldZoomedRecoil,
	// SuddenStopAim, SuddenStopAim2, UnloadedAltFire, UnloadedToggleAim, UnloadedNoAim,
	// UnloadedToggleNoAim, ToggleNoAim) is untouched, so every label that other states Goto
	// still resolves and every relative jump still counts the same states. Nothing gives the
	// "Zoomed" token from this weapon any more, so that whole subtree is dead at runtime while
	// remaining alive to the parser.
	//
	// The one tic below is not padding: Ready re-tests the secondary button, so a zero-tic
	// return would spin Ready -> AltFire -> Ready with no tic in it while the button is held.
	AltFire:
		RAIL A 0 A_Takeinventory("FiredSecondary",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 1 A_WeaponReady(WRF_NOSECONDARY)
		Goto Ready

	ZoomAltFire:
		RAIL A 0
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_SetCrosshair(41)
		RAIL A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		RAIL A 0 A_Giveinventory("Zoomed",1)
		//RAIL A 0 A_Giveinventory("ADSMode",1)
		RAIL A 0 A_ZoomFActor(5.0)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		TNT1 A 0 A_PlaySoundEx("RAIL_ZM",CHAN_WEAPON)
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun",1,"UnloadedAltFire")
		RAIL A 0 A_JumpIfInventory("NoReloading",1,2)
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",1,2)
		Goto UnloadedAltFire
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,1)
		Goto UnloadedAltFire
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		RAIZ ABC 1 BRIGHT A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		RAIL A 0 A_giveinventory("PowerLightAmp", 1)
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RAIL A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		RAIZ D 5 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RAIZ D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		RAIZ D 4 BRIGHT
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		RAIZ ABC 1 BRIGHT //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		RAIL A 0 A_giveinventory("PowerLightAmp", 1)
		RAIZ D 5 BRIGHT A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		RAIZ D 0
		"####" "#" 0 A_Giveinventory("ZoomHold",1)
		RAIZ O 0 A_JumpIfInventory("HasUnloadedRailgun",1,6)
		RAIZ D 0 A_JumpIfInventory("NoReloading",1,4)
		RAIZ D 0 A_JumpIfInventory("RailgunAmmo",1,2)
		RAIZ O 0
		"####" "#" 0 
		Goto HoldingAim
		RAIZ D 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0
	HoldingAim:
		"####" "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" "#" 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" "#" 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "##" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldingAim")
	NoAim:
		TNT1 A 0 A_PlaySound("RAIL_UZ",CHAN_WEAPON)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		RAIL A 0 A_Light0
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun",1,"UnloadedNoAim")
		RAIL A 0 A_JumpIfInventory("NoReloading",1,2)
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",1,2)
		Goto UnloadedNoAim
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,1)
		Goto UnloadedNoAim
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		RAIZ CBA 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL ABCABC 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		RAIZ CBA 1 BRIGHT //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL ABCABC 1 BRIGHT A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	///////////////////////////////////////////////

	UnloadedAltFire:
		RAIL A 0
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"UnloadedToggleAim")
		RAIZ LMN 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RAIL A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		RAIZ O 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RAIZ D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		RAIZ O 4
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	UnloadedToggleAim:
		RAIZ LMN 1 BRIGHT //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		RAIZ O 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	UnloadedNoAim:
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"UnloadedToggleNoAim")
		RAIZ NML 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL D 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	UnloadedToggleNoAim:
		RAIZ NML 1 BRIGHT 
		RAIL D 0 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready

	Fidget:
		RAIL A 0 A_JumpIfInventory("DoInspect",1,"ContinueFidget")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueFidget")
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL A 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RAIL A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RAIL A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAIL A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RAIL ABCABC 1 A_WeaponReady(WRF_ALLOWZOOM)
		USAS A 0 A_GiveInventory("DoInspect",1)
		RAIL A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RAIL A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueFidget:
		TNT1 AA 0
		RAIL A 0 A_TakeInventory("DoInspect",1)
		RAR2 QPONMLK 1 A_WeaponReady
		TNT1 A 0 A_PlaySound("Plasma/Beep", 5)
		RAR2 JJIIIIIIIIIJKLMNOPQ 1 A_WeaponReady
		RAIL A 0 A_Takeinventory("Reloading",1)
		Goto Ready

	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("RSR_Held_RailGun", 1, 4)	// posefix rsr F11 R3 (RSR_HeldGo): held rounds reload even on an empty reserve; lands where the next line does
		"####" "#" 0 A_JumpIfInventory("AmmoCell",10,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		TNT1 AAAA 0
		RAIL A 0 A_Takeinventory("ADSmode",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",0,"Fidget")
		RAIL A 0 A_JumpIfInventory("TurboReload", 1, "InsertBullets")
		RAIL A 0 A_Takeinventory("ADSmode",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun",1, 3)
		RAIL A 0 A_PlaySound("Railgun/Reload1", 5)
		RAIL A 0 A_FireCustomMissile("PlasmaCaseSpawn",-30,0,-4,-4)
		RAIR ABCDEFGHHIIIIIIIIII 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR JKLMNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_PlaySound("Railgun/Reload2", 5) //8 frames of "build up"
		RAIR OPPPQQRS 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)

	InsertBullets:
		TNT1 AAAA 0
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",0,"FinishReload")
		RAIL A 0 A_JumpIfInventory("AmmoCell",10,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		RAIL A 0 A_Giveinventory("RailgunAmmo",1)
		RAIL A 0 A_Takeinventory("AmmoCell",10,TIF_NOTAKEINFINITE)
		Loop

	FinishReload:
		//TNT1 A 0 A_ClearRefire
		RAIR TTUVWXXXXX 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR YZF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR "[]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAR2 ABCDDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RSR_End:		// posefix rsr: the real VR reload ends here (a label: no state added)
		TNT1 A 0 A_PlaySound("Plasma/Beep", 5)
		RAR2 GHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Railgun/Recharge", 5)
		RAR2 IIIIJKLMNOPQ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_Takeinventory("HasUnloadedRailgun", 1)
		RAIL A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_ReFire
		Goto Ready

	User2:
	Unload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Unloading",1)
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		RAIL A 0 A_JumpIfInventory("NoReloading",1,"Ready")
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",1,2)
		Goto Ready
		TNT1 AA 0
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_Takeinventory("Unloading",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIR ABCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR ZYXXX 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_PlaySound("Railgun/Reload1", 5)
		RAIR VUT 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_Giveinventory("HasUnloadedRailgun",1)
	RemoveBullets:
		TNT1 AAAA 0
		RAIL A 0 A_JumpIfInventory("RailgunAmmo",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		RAIL A 0 A_Takeinventory("RailgunAmmo",1)
		RAIL A 0 A_Giveinventory("AmmoCell",10)
		Goto RemoveBullets
	FinishUnload:
		RAIR SRQPONMLKJIIIIHHGFEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_Takeinventory("Unloading",1)
		Goto Ready

	Spawn:
		SRCG A -1
		Stop

	StartSprint:
		TNT1 A 0 A_Takeinventory("NeverSelectedRailgun",1)
		RAIL A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		RAIL A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmo",1,"StartSprintFull")
		RAIL RST 1 A_WeaponReady(WRF_NOFIRE)
		Goto Sprinting
	StartSprintFull:
		RAIL MNO 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		RAIL A 0 offset(-9,32)
		//RAIL A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		RAIL A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		RAIL A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		RAIL A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RAIL A 0 offset(-9,32)
		RAIL P 0 A_JumpIfInventory("RailgunAmmo",1,2)
		RAIL U 0
		RAIL "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		RAIL "#" 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		RAIL "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL "#" 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RAIL "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		RAIL "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		RAIL "#" 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		RAIL "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		RAIL O 0 A_JumpIfInventory("RailgunAmmo",1,"StopSprintFull")
		RAIL TSR 1
		RAIL A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	StopSprintFull:
		RAIL ONM 1
		RAIL A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	GoTaunt:
		RAIL A 0
		RAIL A 0 A_Light0
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_ZoomFActor(1.0)
		Goto Taunt
	}
}

ACTOR PuristRailGun : RailGun { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }


Actor RailgunProjectile
{
	Radius 2
	Height 2
	Speed 80
	Damage (random(400, 400))
	DamageType Railgun
	Decal "SmallerScorch"
	Projectile
	+RANDOMIZE
	+MISSILE
	+FORCERADIUSDMG
	+THRUActorS
	Species "Marines"
	Scale 1.0
	var int user_railangle;
	RenderStyle "Add"
	alpha 0.90
	Scale 0.10
	DeathSound "weapons/plasmax"
	//SeeSound "Plasma/Fire"
	SeeSound "dsempty"
	Obituary "$OBBD_RAILGUN"
	+BounceOnWalls
	+BounceOnFloors
	+BounceOnCeilings
	BounceFActor 1.0
	+USEBOUNCESTATE
	BounceCOunt 3
	//MissileType "WhiteShockwave"
	States
	{
	DM:
		RAIL A 0
		RAIL A 0 A_ChangeFLag("THRUSPECIES", 0)
		RAIL A 0 A_ChangeFLag("MTHRUSPECIES", 0)
		Goto Spawn1

	Spawn:
		RAIL A 0
		RAIL A 0 A_FaceTarget
		RAIL A 0 A_SetUserVar("user_railangle", angle)
		RAIL A 0 A_SpawnItem("WhiteShockwave")
		RAIL A 0 ACS_NamedExecuteAlways("CheckIfDM", 0, 0, 0, 0)//Check if Coop
		TNT1 C 1 BRIGHT// A_SpawnItem("WhiteShockwave")
	Spawn1:
		TNT1 C 1 BRIGHT //A_SpawnItem("WhiteShockwave")
		RAIL A 0 //A_SpawnItem("WhiteShockwave")
		RAIL A 0 A_CheckFloor("Death")
		RAIL A 0 A_CustomMissile ("OldschoolRocketSmokeTrail2", 2, 0, random (160, 210), 2, random (-30, 30))
		Loop

	Bounce.Wall:
		RAIL A 0
		RAIL A 0 A_SetAngle(user_railangle)
		RAIL A 0 BRIGHT A_CustomMissile("RailgunPenetrator1", 0, 0, 180, 2, momz)
		Goto Death

	Bounce.Floor:
	Bounce.Ceiling:
		TNT1 A 1
		RAIL A 0 A_SetAngle(user_railangle)
		RAIL A 0 BRIGHT A_CustomMissile("RailgunPenetrator1b", 0, 0, 180, 2, -momz)
		Goto Death

	Death:
	Melee:
	Xdeath:
		TNT1 AAAA 0 A_SpawnItemEx("BluePlasmaParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
		TNT1 AA 0 A_SpawnItem("WhiteShockwave")
		RAIL A 0 A_Explode(120,5, 1)
		TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 180))
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleVeryFast", 0, 0, random (0, 360), 2, random (0, 360))
		EXPL AAAAA 0 A_CustomMissile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAA 0 A_CustomMissile ("FireworkSFXType2", 2, 0, random (0, 360), 2, random (10, 80))
		RAIL A 0 A_SpawnItemEx ("DetectFloorCraterSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		RAIL A 0 A_SpawnItemEx ("DetectCeilCraterSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		RAIL A 0 A_CustomMissile ("BluePlasmaFire", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAA 0 A_CustomMissile ("BluePlasmaParticle", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 ABE 0 BRIGHT A_SpawnItem("BlueFlare" ,0)
		Stop
	}
}

