// RSR-PUMP: hand-loaded shells and a hand-worked pump (team/reload_pump/tools/rsr_pump_patch.py); first-pickup skip (tool/weapon_patch.py); no old immersive gates; otherwise BD22's own file.
// posefix: BD22 brutal22test6 file. Lines marked "posefix" are the only changes (gun kept on screen where BD22 blanked it; first-pickup animation skipped; Axe.dec: VR axe throw on alt-fire).
ACTOR Shot_Gun : BrutalWeapon
{
	Game Doom
	SpawnID 27
	Weapon.AmmoType1 "AmmoShell"
	Weapon.AmmoType2 "ShotgunAmmo"
	Weapon.SelectionOrder 1300
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Shotgun/Pump"
	Inventory.PickupMessage "$BDGOTSHOTGUN"
	Obituary "$OBBD_SHOTGUN"
	Tag "$TAGBD_SHOTGUN"
	States
	{
	// RSR-PUMP: hand-loaded shells and a hand-worked pump (zscript/rsr/rsr_pump.zs, tools/rsr_pump_patch.py).
	// Not in VR, with Stock reloading, or with the off hand not on the pump, every hook goes
	// straight on into BD22's own states. The shot itself is never touched.
	RSP_Load:		// ReloadNormally, after BD22's own checks (before its loading animation)
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_LoadStart", 1)
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_LoadGo")
		Goto RSP_LoadStock
	RSP_Load2:		// InsertingShells (after ReloadFromPumping, Pump2 with reload pressed, a kick)
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_LoadStart", 1)
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_LoadGo")
		Goto RSP_InsStock
	RSP_Feed:	// RSR-PUMP: a shell the hand pushed home with the gun simply up (rsr_pump.zs
				// FreeFeed). One pass per credited shell; the set's own items move here.
		SHTN A 0 A_TakeInventory("RSP_ShellIn", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 0, "RSP_FeedEnd")		// the tube is full
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "RSP_Feed1")
		Goto RSP_FeedEnd												// nothing in reserve
	RSP_Feed1:
		SHTN A 0 A_GiveInventory("ShotgunAmmo", 1)
		SHTN A 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_FeedEnd:
		SHTN A 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_Feed")		// more credits queued
		Goto Ready
	RSP_VRIns:	// RSR-PUMP: the VR insert's OWN entry, skipping BD22's Reload chain.
				// BD22 drives reload from a "Reloading" token its ACS sets -- its A_WeaponReady
				// has WRF_ALLOWRELOAD commented out -- and its pump-wait states never look at
				// that token, so a shell could only go in when the gun was empty and took
				// another path. rsr_pump.zs reads the button itself and refuses BEFORE sending
				// us here, so by this point there is reserve ammo and room in the tube: no gate
				// is needed here, and none is wanted. (Owner, 2026-10-13.)
		SHTN A 0 A_TakeInventory("RSP_Insert", 1)
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_TakeInventory("ADSmode", 1)
		SHTN A 0 A_TakeInventory("Zoomed", 1)
		SHTN A 0 A_TakeInventory("ZoomHold", 1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_LoadStart", 1)
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_VRIns1")
		Goto Ready					// not in VR, or Stock reloading: BD22 keeps its own reload
	RSP_VRIns1:
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("Pumping", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 1, "RSP_Next")
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)	// nothing chambered
		Goto RSP_Next
	RSP_LoadGo:
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("Pumping", 1)		// BD22: the player sprite's reload
		SHTN A 0 A_TakeInventory("Reloading", 1)
	RSP_Next:		// BD22's own InsertingShells / CheckIfFinishReload checks: room for another shell?
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "RSP_Next1")
		Goto Pump2				// out of shells: BD22 pumps
	RSP_Next1:
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 8, "RSP_Next8")
		Goto RSP_LoadWait
	RSP_Next8:		// an empty gun stops at 8 (its pump chambers one); a chambered round takes a 9th
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "RSP_LoadEnd")
		Goto RSP_LoadWait
	RSP_LoadWait:	// the hand loads shells (rsr_pump.zs); fire ends the reload, as in BD22's insert frames
		SHTN A 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN A 0 A_GiveInventory("RSP_LTick", 1)
		SHTN A 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_Shell")
		SHTN A 0 A_JumpIfInventory("RSP_Back", 1, "RSP_LBack")
		SHTN A 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_LFwd")
		SHTN A 0 A_JumpIfInventory("Reloading", 1, "RSP_LoadEnd")	// BD22: reload again finishes
		SHTN A 0 A_JumpIfInventory("Kicking", 1, "RSP_Kick")
		SHTN A 0 A_JumpIfInventory("IsRunning", 1, "StartSprint")
		Goto RSP_LoadWait
	RSP_Shell:		// a shell pushed home: BD22's own step, one shell from the reserve into the tube
		SHTN A 0 A_TakeInventory("RSP_ShellIn", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 0, "RSP_LoadEnd")	// 2026-10-16: full -- a credit (rsr_shell_credit) is not a free shell
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, 1)	// 1.12: 1, not 2 -- a Goto is not a state (2 skipped the give and only ate reserve)
		Goto RSP_LoadEnd												// nothing left in reserve
		SHTN A 0 A_Giveinventory("ShotgunAmmo", 1)
		SHTN A 0 A_Takeinventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 0, "RSP_LoadEnd")	// full (InsertShellAnimation's own check)
		Goto RSP_Next
	RSP_LoadEnd:	// FinishedInsertingShells, without its lowering frames (the gun never tilted)
		SHTN A 0 A_TakeInventory("RSP_ShellIn", 999)	// 2026-10-16: credits past a full tube are dropped, never saved for later
		SHTN A 0 A_Takeinventory("Reloading", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		Goto ReadyToFireAgain
	RSP_Kick:		// DoKickReloading, the gun held (the hand keeps what it has)
		SHTN A 0 A_GunFlash("ReloadingKickFlash")
		SHTN AAAAAAAAAAAAAA 1 A_GiveInventory("RSP_LTick", 1)
		Goto RSP_LoadWait
	RSP_LBack:		// the hand has the pump back while loading: a spent shell comes out as in Pump2
		SHTN A 0 A_TakeInventory("RSP_Back", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "RSP_LBack1")
		Goto RSP_LoadWait			// a live round in: BD22's inspect pump, nothing comes out
	RSP_LBack1:
		SHTN A 0 A_JumpIfInventory("HasUnloadedShotgun", 1, "RSP_LoadWait")
		SHTN A 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		Goto RSP_LoadWait
	RSP_LFwd:		// forward again: the reload ends, chambered (Pump2 N)
		SHTN A 0 A_TakeInventory("RSP_Fwd", 1)
		SHTN A 0 A_Takeinventory("Reloading", 1)
		SHTN A 0 A_Takeinventory("ShotgunWasEmpty", 1)
		SHTN A 0 A_Takeinventory("HasUnloadedShotgun", 1)
		Goto ReadyToFireAgain
	RSP_P1:		// Pump1, after a shot, after BD22's own checks
		"####" A 0 A_TakeInventory("RSP_Go", 1)
		"####" A 0 A_GiveInventory("RSP_PumpStart", 20)	// 20: BD22's own tics from here to its refire
		"####" A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_P1Go")
		Goto Pump1+8
	RSP_P1Go:
		"####" "#" 0 A_TakeInventory("RSP_Go", 1)
	RSP_P1Wait:	// the hand works the pump (rsr_pump.zs moves it); switching is allowed, as BD22's pump allows
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		"####" "#" 0 A_GiveInventory("RSP_PTick", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Back", 1, "RSP_P1Back")
		"####" "#" 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_P1Fwd")
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P1Feed")	// 2026-10-16: a shell topped off mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// a shell, mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Auto", 1, "RSP_P1Auto")
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P1Ready")
		Goto RSP_P1Wait
	RSP_P1Feed:	// 2026-10-16: the set's own per-shell step while the gun waits for the pump (as RSP_Feed)
		"####" "#" 0 A_TakeInventory("RSP_ShellIn", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmo", 0, "RSP_P1FeedE")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 1)
		Goto RSP_P1FeedE
		"####" "#" 0 A_GiveInventory("ShotgunAmmo", 1)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_P1FeedE:
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P1Feed")
		Goto RSP_P1Wait
	RSP_P1Back:	// all the way back: BD22's own Pump1 G..J: the spent shell out
		"####" "#" 0 A_TakeInventory("RSP_Back", 1)
		"####" "#" 0 A_Takeinventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		"####" "#" 0 A_Giveinventory("ShotgunWasEmpty", 1)	// (BD22: until the pump is forward again)
		Goto RSP_P1Wait
	RSP_P1Fwd:	// forward again: BD22's own Pump1 N
		"####" "#" 0 A_TakeInventory("RSP_Fwd", 1)
		"####" "#" 0 A_Takeinventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P1Ready")
		Goto RSP_P1Wait	// ready once BD22's own refire time is up (RSP_Ready)
	RSP_P1Ready:
		"####" "#" 0 A_TakeInventory("RSP_Ready", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "RSP_P1R2")	// BD22's own sprite choice
		SHTN A 0
	RSP_P1R2:
		"####" A 0
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")	// as BD22's pump frames do
		Goto Pump1+38
	RSP_P1Auto:	// the hand left the pump before working it: BD22's own pump
		"####" "#" 0 A_TakeInventory("RSP_Auto", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "RSP_P1A2")	// BD22's own sprite choice
		SHTN A 0
	RSP_P1A2:
		"####" A 0
		Goto Pump1+8
	RSP_P2:		// Pump2 (loaded empty, or fired with a spent shell in), after BD22's own checks
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_PumpStart", 17)	// 17: BD22's own tics from here to its refire
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_P2Go")
		Goto Pump2+9
	RSP_P2Go:
		"####" "#" 0 A_TakeInventory("RSP_Go", 1)
	RSP_P2Wait:	// the hand works the pump (rsr_pump.zs moves it); switching is allowed, as BD22's pump allows
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		"####" "#" 0 A_GiveInventory("RSP_PTick", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Back", 1, "RSP_P2Back")
		"####" "#" 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_P2Fwd")
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P2Feed")	// 2026-10-16: a shell topped off mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// a shell, mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Auto", 1, "RSP_P2Auto")
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P2Ready")
		Goto RSP_P2Wait
	RSP_P2Feed:	// 2026-10-16: the set's own per-shell step while the gun waits for the pump (as RSP_Feed)
		"####" "#" 0 A_TakeInventory("RSP_ShellIn", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmo", 0, "RSP_P2FeedE")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 1)
		Goto RSP_P2FeedE
		"####" "#" 0 A_GiveInventory("ShotgunAmmo", 1)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_P2FeedE:
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P2Feed")
		Goto RSP_P2Wait
	RSP_P2Back:	// all the way back: BD22's own Pump2 H..J
		"####" "#" 0 A_TakeInventory("RSP_Back", 1)
		"####" "#" 0 A_JumpIfInventory("HasUnloadedShotgun", 1, "RSP_P2Wait")
		"####" "#" 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		Goto RSP_P2Wait
	RSP_P2Fwd:	// forward again: BD22's own Pump2 N
		"####" "#" 0 A_TakeInventory("RSP_Fwd", 1)
		"####" "#" 0 A_Takeinventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_Takeinventory("HasUnloadedShotgun", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P2Ready")
		Goto RSP_P2Wait	// ready once BD22's own refire time is up (RSP_Ready)
	RSP_P2Ready:
		"####" "#" 0 A_TakeInventory("RSP_Ready", 1)
		SHTN A 0
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")	// as BD22's pump frames do
		Goto Pump2+32
	RSP_P2Auto:	// the hand left the pump before working it: BD22's own pump
		"####" "#" 0 A_TakeInventory("RSP_Auto", 1)
		SHTN A 0
		Goto Pump2+9
	RSP_P3:		// Pump3, after an aimed (zoomed) shot, after BD22's own checks
		SHT8 C 0 A_TakeInventory("RSP_Go", 1)
		SHT8 C 0 A_GiveInventory("RSP_PumpStart", 11)	// 11: BD22's own tics from here to its refire
		SHT8 C 0 A_JumpIfInventory("RSP_Go", 1, "RSP_P3Go")
		Goto Pump3+3
	RSP_P3Go:
		"####" "#" 0 A_TakeInventory("RSP_Go", 1)
	RSP_P3Wait:	// the hand works the pump (rsr_pump.zs moves it); switching is allowed, as BD22's pump allows
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		"####" "#" 0 A_GiveInventory("RSP_PTick", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Back", 1, "RSP_P3Back")
		"####" "#" 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_P3Fwd")
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P3Feed")	// 2026-10-16: a shell topped off mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// a shell, mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Auto", 1, "RSP_P3Auto")
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P3Ready")
		Goto RSP_P3Wait
	RSP_P3Feed:	// 2026-10-16: the set's own per-shell step while the gun waits for the pump (as RSP_Feed)
		"####" "#" 0 A_TakeInventory("RSP_ShellIn", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmo", 0, "RSP_P3FeedE")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 1)
		Goto RSP_P3FeedE
		"####" "#" 0 A_GiveInventory("ShotgunAmmo", 1)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_P3FeedE:
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P3Feed")
		Goto RSP_P3Wait
	RSP_P3Back:	// all the way back: BD22's own Pump3 J
		"####" "#" 0 A_TakeInventory("RSP_Back", 1)
		"####" "#" 0 A_TakeInventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		Goto RSP_P3Wait
	RSP_P3Fwd:	// forward again: BD22's own Pump3 (its frames back)
		"####" "#" 0 A_TakeInventory("RSP_Fwd", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P3Ready")
		Goto RSP_P3Wait	// ready once BD22's own refire time is up (RSP_Ready)
	RSP_P3Ready:
		"####" "#" 0 A_TakeInventory("RSP_Ready", 1)
		SHT8 C 0
		Goto Pump3+20
	RSP_P3Auto:	// the hand left the pump before working it: BD22's own pump
		"####" "#" 0 A_TakeInventory("RSP_Auto", 1)
		SHT8 C 0
		Goto Pump3+3
	Inspect:
		SHTN A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		SHTN A 6 A_WeaponReady(WRF_ALLOWZOOM)
		SHTN A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHTN A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHTN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHTN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHTN A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		SHTN AAA 0
		SHTN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTN A 0 A_GiveInventory("DoInspect",1)
		SHTN A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SHTN A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		SHTN A 0 A_TakeInventory("DoInspect",1)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		SHTN ABCDE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_Giveinventory("IsInspecting",1)
	ContinueInspect2:
		SHTN FG 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		SHT6 ABCDEFFF 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		SHT6 F 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		SHT6 G 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_NOFIRE)
		SHTN H 0 A_PlaySound("Shotgun/Pump2", 5)
		SHT6 HI 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		SHTN FED 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("IsInspecting",1)
		SHTN CBA 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto ReadyToFireAgain

	KickFlash: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		SHTA RSTU 1
		SHTA V 10
		SHTA UTSR 1
		stop
	SlideFlash: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		SHTA RSTU 1
		SHTA V 35
		stop
	SlideFlashEnd: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		SHTA V 5
		SHTA UTSR 1
		stop
	SlideFlashEndEarly: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		SHTA VVUTSR 1
		stop

	Spawn:
		SHTC A -1
		Stop

	FirstSelectAnimation:
		SHTN A 0 A_Takeinventory("NeverSelectedShotgun",1)
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTA MLK 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		SHTN BCDEFG 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		SHTN H 1 A_PlaySound("Shotgun/Pump1", 5)
		SHTN IJJKKLLLLLMMN 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		SHTN H 0 A_PlaySound("Shotgun/Pump2", 5)
		SHTN PQRGGGFFEDCBA 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		Goto Ready3

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		TNT1 A 1
		SHTN A 0 A_Giveinventory("ShotgunSelected",1)
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTN A 0 A_TakeInventory("NeverSelectedShotgun", 1)	// posefix: was SHTN A 0 A_JumpIfInventory("NeverSelectedShotgun", 1, "FirstSelectAnimation")
	SelectAnimation:
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty",1,2)
		SHTN A 0 A_PlaySound("Shotgun/Pump2", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		SHTA MLKJ 1 A_WeaponReady(WRF_NOFIRE)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty",1,"Pump1")
		SHTN A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("RELOADING",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHTN A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHTN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHTN A 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_Feed")	// RSR-PUMP: a shell, no button
		SHTN A 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// RSR-PUMP: the hand insert
		SHTN A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHTN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT8 C 0 A_JumpIfInventory("Zoomed",1,"REady2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_JumpIf(OverlayID() == 1000000, 2)	// 1.37 rsa: a slug asked for and never fired is dropped
		SHTN A 0 A_TakeInventory("RSA_Slug", 1)
		SHTN A 0 A_JumpIf(OverlayID() != 1000000, 2)
		SHTN A 0 A_TakeInventory("RSA_SlugOff", 1)
	OkToFire:
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		"####" "###" 0
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_SetCrosshair(0)
		Goto Ready

	Ready2:
		SHT8 C 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHT8 C 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump3")
		SHT8 C 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT8 C 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT8 C 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT8 C 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHT8 C 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHT8 C 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHT8 C 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT8 C 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		//SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		SHT8 C 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SHT8 C 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		"####" "###" 0
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	Deselect:
		SHTN A 0 A_Takeinventory("Zoomed",0)
		SHTN A 0 A_TakeInventory("TossGrenade", 0)
		SHTN A 0 A_Takeinventory("ADSmode",0)
		TNT1 A 0 A_TakeInventory("HoldInspect",0)
		TNT1 A 0 A_TakeInventory("IsInspecting",0)
		SHTN A 0 A_Takeinventory("UseShotgunStrap",0)
		SHTN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		SHTA NOPQ 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		SHT8 C 0 A_JumpIfInventory("Zoomed",1,10)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmo",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("ShotgunAmmo",1)
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmo",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("AmmoShell",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" "#" 0
		2HTA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTA A 0
		"####" A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" "#" 0 A_Quake(4,4,0,12,"")
		"####" A 0 A_AlertMonsters
		"####" A 0 A_PlaySound("Shotgun/Fire", 1)
		"####" A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_GiveInventory("ShotgunWasEmpty",1)
		"####" A 0 A_ZoomFactor(0.97)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" AAAAAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles2", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-3,3), 0, 0, -12, 0, random(-3,3))
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("RSA_Slug") > 0) || (OverlayID() == 1000000 && CountInv("RSA_SlugOff") > 0), "RSA_SlugShot")	// 1.37 rsa
		"####" A 1 BRIGHT A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 1, 4, 13, "ShotgunPuff", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		"####" B 1 BRIGHT A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 2.5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 2.5, 5, 13, "ShotgunPuff2", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 6, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
	RSA_SlugKick:	// 1.37 rsa: the slug's kick and pump are the buckshot's own (a label, no state)
		"####" A 0 A_SetPitch(pitch-10)
		"####" A 0 A_ZoomFactor(1.0)
		"####" C 1 A_SetPitch(-6.0 + pitch)
		"####" DE 1 A_SetPitch(+2.5 + pitch)
		"####" W 1 A_SetPitch(+1.0 + pitch)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 7)//Tactical Mode is slower to pump
		"####" AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 1 A_WeaponReady(WRF_NOPRIMARY)

	Pump1:
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 0
		"####" A 0 A_GiveInventory ("Pumping", 1)
		"####" A 0 A_GiveInventory ("GoSpecial", 1)
		"####" A 0 A_JumpIfInventory("ShotgunAmmo",1,"RSP_P1")	// RSR-PUMP (was: A_JumpIfInventory("ShotgunAmmo",1,3))
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		"####" ABCDEFG 1
		"####" A 0 A_Takeinventory("ShotgunWasEmpty",1)
		"####" A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,-8,-26)
		"####" A 0 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
		"####" H 1 A_PlaySound("Shotgun/Pump1", 5)
		"####" IJ 1
		"####" A 0 A_Giveinventory("ShotgunWasEmpty",1)
		"####" AA 0
		"####" KLMN 1
		"####" A 0 A_Takeinventory("ShotgunWasEmpty",1)
		"####" H 0 A_PlaySound("Shotgun/Pump2", 5)
		"####" A 0 A_JumpIfInventory("NoReloading",1,13)
		"####" A 0 A_JumpIfInventory("ShotgunAmmo",0,12)
		"####" PQ 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		"####" FEDCB 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		"####" A 0 A_JumpIfInventory("ShotgunAmmo",1,2)
		"####" A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		"####" A 0
		Goto ReadyToFireAgain
		"####" AA 0
		"####" PQFEDCB 1 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain
	
	DM:
		"####" A 1 BRIGHT A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 1, 4, 13, "ShotgunPuffDM", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		"####" B 1 BRIGHT A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 2.5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 2.5, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 6, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 3, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		"####" A 0 A_SetPitch(pitch-10)
		"####" A 0 A_ZoomFactor(1.0)
		"####" C 1 A_SetPitch(-6.0 + pitch)
		"####" DE 1 A_SetPitch(+2.5 + pitch)
		"####" W 1 A_SetPitch(+1.0 + pitch)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 7)//Tactical Mode is slower to pump
		"####" AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 1 A_WeaponReady(WRF_NOPRIMARY)
		Goto Pump1

	Pump2:
		SHTN A 0
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SHTN A 0 A_GiveInventory ("GoSpecial", 1)
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("ShotgunAmmo",1,"RSP_P2")	// RSR-PUMP (was: A_JumpIfInventory("ShotgunAmmo",1,3))
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		SHTN TSFG 1
		SHTN H 1 A_PlaySound("Shotgun/Pump1", 5)
		SHTN IJ 1
		SHTN A 0 A_JumpIfInventory("HasUnloadedShotgun",1,2)
		SHTN A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,-8,-26)
		SHTN KLMN 1
		SHTN A 0 A_Takeinventory("ShotgunWasEmpty",1)
		SHTN A 0 A_Takeinventory("HasUnloadedShotgun",1)		
		SHTN H 0 A_PlaySound("Shotgun/Pump2", 5)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo",0,18)
		SHTN PQ 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		SHTN FEDCB 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,2)
		Goto ReadyToFireAgain
		SHTN AA 0
		SHTN A 0 A_JumpIfInventory("Reloading",1,"InsertingShells")
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo",1,2)
		SHTN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		SHTN A 0
		Goto ReadyToFireAgain
		SHTN AA 0
		SHTN PQFEDCB 1 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain

	ReadyToFireAgain:
		2HTA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTA A 0
		"####" FGHI 1 A_WeaponReady(1)
		"####" A 0 //A_Refire
		Goto Ready3

	IsHolding:
		SHT8 C 0 A_JumpIfInventory("ZoomHold", 1, 4)
		SHT8 C 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+21
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		//"####" "#" 0 A_TakeInventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmo",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		//"####" "#" 0 A_TakeInventory("ShotgunWasEmpty", 1)
		Goto HoldAim

	Fire2:
		SHTN A 0
		SHTN A 0 A_Takeinventory("Reloading",1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump3")
		SHTN A 0 A_AlertMonsters
		SHTN A 0 A_PlaySound("Shotgun/Fire", 1)
		SHTN A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		RIFF A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, 0, 0, random(-5,5))
		"####" "#" 0 A_Quake(4,4,0,12,"")
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		SHT8 D 1 BRIGHT A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 1, 4, 13, "ShotgunPuff", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		SHTN A 0 A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 2.5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 2.5, 5, 13, "ShotgunPuff2", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		SHTN A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 6, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		SHTN A 0 A_SetPitch(pitch-10)
		SHT8 E 1 A_SetPitch(-8.0 + pitch)
		SHT8 F 1 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SHTN AAA 0
		SHT8 GC 1 A_SetPitch(+2.0 + pitch)
		SHT8 C 0 A_WeaponReady (WRF_NOFIRE)
	Pump3:
		SHT8 C 0
		SHT8 C 0 A_JumpIfInventory("ShotgunAmmo", 1, "RSP_P3")	// RSR-PUMP (was: A_JumpIfInventory("ShotgunAmmo", 1, 2))
		//SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 1)
		Goto NoAmmo//NoAmmo3
		SHT8 C 0 
		SHT8 C 0 A_GiveInventory ("Pumping", 1)
		SHT8 C 0 A_PlaySound("Shotgun/Pump1", 5)
		SHT8 GHIIJJ 1
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, 1)
		SHTN A 0 A_TakeInventory("ShotgunWasEmpty", 1)
		SHTN A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,14,0)
		SHTN A 0 A_PlaySound("Shotgun/Pump2", 5)
		SHT8 IHHGG 1
		SHT8 C 0
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		SHTN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 AAA 0
		SHTN A 0 A_REfire
		SHTN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SHTN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2
	
	DM2:
		SHT8 D 1 BRIGHT A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 1, 4, 13, "ShotgunPuffDM", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		SHTN A 0 A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 2.5, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 2.5, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		SHTN A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (GetCVar("rsq_pump_spread") == 1 ? 3.0 : 6, GetCVar("rsq_pump_spread") == 1 ? 2.5 : 3, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)	// BD 2.0 "Pump Shotgun Spread": Enhanced = Dakka 30_shotgun.dec (3, 2.5)
		SHTN A 0 A_SetPitch(pitch-10)
		SHT8 E 1 A_SetPitch(-8.0 + pitch)
		SHT8 F 1 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SHTN AAA 0
		SHT8 GC 1 A_SetPitch(+2.0 + pitch)
		SHT8 C 0 A_WeaponReady (WRF_NOFIRE)
		Goto Pump3

	AltFire:
		"####" "#" 0 A_JumpIfInventory("RSA_Opt_Slug", 1, "RSA_SlugGo")	// 1.37 rsa: secondary fires a slug (option)
		SHTN A 0
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SHTN A 0 A_Giveinventory("GoSpecial",1)
		SHTN A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		SHTN A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_SetCrosshair(41)
		SHTN A 0 A_ZoomFactor(1.2)
		SHTN A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		SHT8 AB 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlayWeaponSound("Shotgun/Fire/move")
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		SHT8 C 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		SHT8 C 4
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	// 1.37 rsa (owner): secondary fire is a slug: the same shell, one heavy round on one point (more
	// than the buckshot's whole load), then the pump as after any shot
	RSA_SlugGo:
		"####" "#" 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" "#" 0 A_GiveInventory("RSA_Slug", 1)
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" "#" 0 A_GiveInventory("RSA_SlugOff", 1)
		Goto Fire
	RSA_SlugShot:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_Slug", 1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_SlugOff", 1)
		"####" A 1 BRIGHT A_FireBullets (0, 0, 1, 150, "ShotgunPuff", FBF_NORANDOM)
		"####" B 1 BRIGHT
		Goto RSA_SlugKick
	ToggleAim:
		SHT8 AB 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		SHT8 C 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		SHT8 CC 0
		SHT8 C 0 A_GiveInventory("ZoomHold",1)
		SHT8 C 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump3")
		SHT8 C 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT8 C 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT8 C 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHT8 C 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHT8 C 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT8 C 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT8 C 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHT8 C 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		TNT1 AAAAAA 0
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		SHT8 BA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHTN A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		SHT8 BA 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHTN A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	StartSprint:
		SHTN A 0 A_Takeinventory("NeverSelectedShotgun",1)
		SHTN A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		SHTN A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		SHTA RST 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		SHTA R 0 offset(-9,32)
		//SHTN A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		SHTN A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		SHTN A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		SHTN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		SHTN A 0 offset(-9,32)
		SHTA U 1 offset(-9,34) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(-6,36) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(-3,38) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(0,38) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(3,36) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(6,34) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(9,32) A_SetPitch(pitch -0.5)
		SHTN A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		SHTN A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHTN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHTN A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHTN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		SHTN A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		SHTA U 1 offset(9,34) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(6,36) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(3,38) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(0,38) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(-3,36) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(-6,34) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(-9,32) A_SetPitch(pitch +0.5)
		SHTN A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		SHTN A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		SHTA TSR 1
		SHTN A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	ReloadFromPumping:
		SHTN A 0 A_Takeinventory("Reloading",1)
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmo",0,"Pump2")
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, 2)
		Goto Pump2+38
		SHTN AA 0
		SHTN ST 1
		Goto InsertingShells

	ReloadWithNoAmmoLeft:
	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		SHTN AA 0
		SHTN AA 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		SHTN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		SHTN A 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		SHTN A 0 A_JumpIfInventory("IsInspecting",1,"ContinueInspect2")
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo",0,"Inspect")
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 1, "ReloadNormally")//Check if there is a shell in the chamber
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)//This means there is no shell in the chamber
	ReloadNormally:
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,2)//If there is no reserve ammo, don't reload, go back to Ready
		Goto Ready
		SHTN AAA 0
		SHTN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		Goto RSP_Load	// RSR-PUMP: hand-loaded shells (zscript/rsr/rsr_pump.zs)
	RSP_LoadStock:
		SHTN A 1 A_GiveInventory ("Pumping", 1)
		SHTN BCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN ST 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	InsertingShells:
		SHTN A 0
		Goto RSP_Load2	// RSR-PUMP
	RSP_InsStock:
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,2)//if there are no more reserve shells, finish reload.
		Goto Pump2
		SHTN AAA 0
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SSHR AA 0 A_TakeInventory("Reloading", 1)
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmo",0,"CheckIfFinishReload")
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmo",8,"CheckIfFinishReload")
		SHTN A 0 A_Giveinventory("ShotgunAmmo",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
	InsertShellAnimation:
		SHTN A 0
		SHTN UUUVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload",5)
		SHTN X 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN YZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN "[]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN AA 0 A_JumpIfInventory("Reloading", 1, "FinishedInsertingShells")
		SHTN AA 0 A_JumpIfInventory("Kicking",1,"DoKickReloading")// Too inconsistent and unpolished for this beta,you'll work on this later!
		SHTN AA 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmo",0,"FinishedInsertingShells")//If there are 8+1 shells, stop it immediately
		Goto InsertingShells

	CheckIfFinishReload:
		//SSHR A 1
		SHTN AA 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "FinishedInsertingShells")//If shotgun was empty,
		//Play the insert shell animation again, and insert the 9th shell
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,1)//if there are no more reserve shells, finish reload.
		Goto Pump2
		SHTN A 0 A_Giveinventory("ShotgunAmmo",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto InsertShellAnimation

	FinishedInsertingShells:
		SHTN AA 0 A_Takeinventory("Reloading",1)
		SHTN AA 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		SHTN TS 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN FEDCB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN AA 0 A_Takeinventory("Reloading",1)
		Goto ReadyToFireAgain

	TurboReload:
		SHSS BC 0
	TurboBullets:
		SHTN A 0
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmo",0,"FinishTurboReload")
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto FinishTurboReload
		TNT1 AAAA 0
		SHTN A 0 A_Giveinventory("ShotgunAmmo",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets
	FinishTurboReload:
		SHTN A 1
		SHTN A 1 A_Refire
		Goto Ready3

	TurboReload2:
		SHSS BC 0
	TurboBullets2:
		SHTN A 0
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmo",0,"FinishTurboReload")
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto FinishTurboReload2
		TNT1 AAAA 0
		SHTN A 0 A_Giveinventory("ShotgunAmmo",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets2

	FinishTurboReload2:
		SHT8 C 1 A_Refire
		Goto Ready2

	User2:
	Unload:
		//SHTN A 1
		2HTN A 0 A_ZoomFactor(1.0)
		2HTN A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		2HTN A 0 A_Takeinventory("Unloading",1)
		2HTN A 0 A_Takeinventory("ADSmode",1)
		2HTN A 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SHTN AA 0 A_JumpIfInventory("NoReloading",1,"OkToFire")
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)
		SHTN A 0 A_GiveInventory("HasUnloadedShotgun",1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo",1,3)
		Goto OkToFire
		TNT1 AAA 0
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SHTN A 0 A_Takeinventory("Unloading",1)
		SHTN ABCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RemoveBullets:
		TNT1 AAAA 0
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo",1,3)
		SHTN A 0 A_Giveinventory("ShotgunWasEmpty",1)
		Goto FinishUnload
		TNT1 AAAAAA 0
		SHTN A 0 A_Takeinventory("ShotgunAmmo",1)
		SHTN A 0 A_Giveinventory("AmmoShell",1)

		SHTN G 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		SHTN H 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN IJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN KLKJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump2", 5)
		SHTN IH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN GF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("Unloading", 1,"FinishUnload")
		"####" "#" 0 A_JumpIfInventory("Reloading", 1,"FinishUnload")
		Goto RemoveBullets

	FInishUnload:
		SHTN EDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN A 0 A_Takeinventory("Unloading",1)
		Goto ReadyToFireAgain

	ReloadingKickFlash://DoKickReloading:
		//TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		TNT1 A 0 A_PlaySound("Kick/Swing", 5)
		TNT1 A 0 SetPlayerProperty(0,1,0)
		KICK ABC 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_Quake(2,2,0,12,"")
		KICK D 1 A_FireCustomMissile("KickAttack", 0, 0, 0, -7)
		KICK A 0 A_Takeinventory("Kicking",1)
		KICK EEEEFGHIJKLM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 SetPlayerProperty(0,0,0)
		RIBA A 0 A_Takeinventory("Kicking",1)
		Stop//Goto InsertingShells

	DoKickReloading://ReloadingKickFlash:
		//NULL A 0 A_JumpIf (momZ > 0, "AirKick")
		//NULL A 0 A_JumpIf (momZ < 0, "AirKick")
		TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		SHTN "[]" 1 Offset(0, 34)
		SHTN "[]" 1 Offset(0, 38)
		SHTN "[]" 1 Offset(0, 42)
		SHTN "[]" 4 Offset(0, 50)
		SHTN "[]" 1 Offset(0, 42)
		SHTN "[]" 1 Offset(0, 38)
		SHTN "[]" 1 Offset(0, 34)
		SHTN "[]" 4
		Goto InsertingShells//Stop

	Steady:
		TNT1 A 1
		Goto Ready

	NoAmmo3:
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT8 C 4 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload2")
		TNT1 A 0 A_JumpIfInventory("NoAutoReload", 1, "NoAmmo3")
		RIFG A 0 A_JumpIfInventory("AmmoShell",1,"Reload")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "NoAmmo3")
		Goto Ready3
	}
}

ACTOR PuristShot_Gun : Shot_Gun { -WEAPON.NOAUTOAIM +WEAPON.CHEATNOTWEAPON }

ACTOR ShotgunAmmo : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 9
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 9
	Inventory.Icon "SHTCA0"
}