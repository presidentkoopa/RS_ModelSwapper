		TNT1 A 0 A_Explode(128, 1000)
		TNT1 A 32 A_CustomMissile ("NuclearFlames", 0, 0, random (0, 360), 2, random (0, 90))
		TNT1 A 0 A_Explode(128, 1000)
		TNT1 AA 32 A_Explode(128, 1000)
		Stop
	}
}

