// 1.20 GENERATED by gen_dual.py: the off-hand copies of BD22's guns. Do not edit by hand.
// Each copy is its gun, renamed, with its own magazine; it lives in the off hand only.
ACTOR BDPistolAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 16
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 16
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_BrutalPistol : BrutalPistol
{
	Tag "Off-hand Pistol"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "Clip1"
	Weapon.AmmoType2 "BDPistolAmmoOff"
	+WEAPON.WIMPY_WEAPON
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Pistol/Draw"
	Inventory.PickupMessage "$GOTPISTOL"
	Obituary "$OBBD_PISTOL"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		PIST E 0 A_TakeInventory("RSR_Go", 1)
		PIST E 0 A_GiveInventory("RSR_Start", 1)
		PIST E 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		PIST E 0 A_TakeInventory("RSR_Go", 1)
		PIST E 0 A_JumpIfInventory("HasUnloadedPistol", 1, "RSR_Wait")	// no magazine in the gun
		PIST E 0 A_JumpIfInventory("RSR_Charge", 1, "RSR_Filled")	// a magazine in, the handle still to pull
		PIST E 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff", 2, "RSR_Unload1")
		PIST E 0 A_GiveInventory("HasUnloadedPistol", 1)
		PIST E 0 A_GiveInventory("HasUnloadedDualPistols", 1)
		Goto RSR_Wait
	RSR_Unload1:
		PIST E 0 A_TakeInventory("BDPistolAmmoOff", 1)
		PIST E 0 A_TakeInventory("BDDualPistolAmmo", 1)
		PIST E 0 A_GiveInventory("RSR_Held_BrutalPistol", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		PIST E 0 A_TakeInventory("RSR_Seated", 1)
		PIST E 0 A_TakeInventory("HasUnloadedPistol", 1)
		PIST E 0 A_TakeInventory("HasUnloadedDualPistols", 1)
	RSR_Return:		// the held rounds first
		PIST E 0 A_JumpIfInventory("RSR_Held_BrutalPistol", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		PIST E 0 A_TakeInventory("RSR_Held_BrutalPistol", 1)
		PIST E 0 A_GiveInventory("BDPistolAmmoOff", 1)
		PIST E 0 A_GiveInventory("BDDualPistolAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff", 1, "RSR_FillB")	// a round chambered: BD22's second loop, to the maximum
		PIST E 0 A_GiveInventory("RSR_Charge", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff", 15, "RSR_Filled")
		PIST E 0 A_JumpIfInventory("Clip1", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		PIST E 0 A_GiveInventory("BDPistolAmmoOff", 1)
		PIST E 0 A_GiveInventory("BDDualPistolAmmo", 1)
		PIST E 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff", 0, "RSR_Filled")
		PIST E 0 A_JumpIfInventory("Clip1", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		PIST E 0 A_GiveInventory("BDPistolAmmoOff", 1)
		PIST E 0 A_GiveInventory("BDDualPistolAmmo", 1)
		PIST E 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		PIST E 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		PIST E 0 A_TakeInventory("RSR_Done", 1)
		PIST E 0 A_TakeInventory("RSR_Charge", 1)
		PIST E 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	KickFlash: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		PIST J 0 A_JumpIfInventory("BDPistolAmmoOff", 1,"KickFlashLoaded")
		PIST OPQR 1
		PIST S 10
		PIST RQPO 1
		stop
	SlideFlash: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		PIST J 0 A_JumpIfInventory("BDPistolAmmoOff", 1,"SlideFlashLoaded")
		PIST OPQR 1
		PIST S 36
		stop
	SlideFlashEnd: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		PIST J 0 A_JumpIfInventory("BDPistolAmmoOff", 1,"SlideFlashEndLoaded")
		PIST S 5
		PIST RQPO 1
		stop
	SlideFlashEndEarly: 
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		PIST J 0 A_JumpIfInventory("BDPistolAmmoOff", 1,"SlideFlashEndEarlyLoaded")
		PIST S 2
		PIST RQPO 1
		stop
	KickFlashLoaded: 
		PIST JKLM 1
		PIST N 10
		PIST MLKJ 1
		stop
	SlideFlashLoaded:
		PIST JKLM 1
		PIST N 36
		stop
	SlideFlashEndLoaded: 
		PIST N 5
		PIST MLKJ 1
		stop
	SlideFlashEndEarlyLoaded: 
		PIST N 2
		PIST MLKJ 1
		stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		PIST F 0 A_Takeinventory("DualPistols",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 1) )
		PIST E 0 A_GunFlash
		TNT1 A 0 A_GiveInventory("PistolSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		PIST E 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"selectAnimation")
		Goto FirstSelectAnimation
	
	SelectDual:
		TNT1 A 0 A_Takeinventory("SwitchDuals",1)
		TNT1 A 0 A_JumpIfInventory("BDPistolAmmoOff", 1, 1)
		Goto SelectDualEmpty
		PI2G LKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_PlaySound("Pistol/Draw",5)
		PI2G IHG 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("SwitchDuals",1)
		Goto Ready
		
	SelectDualEmpty:
		PI2G XWV 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_PlaySound("Pistol/Draw",5)
		PI2G UTS 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready		

	FirstSelectAnimation:
		TNT1 A 1
		TNT1 A 0 A_TakeInventory("NeverSelectedPistol", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedPistol", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 0 A_TakeInventory("NeverSelectedPistol",1)
		PIST E 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 3
		PISS ABC 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR ABCDEFGG 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR HIJKKLLL 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR MNO 1 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_PlaySound("Pistol/Reload2", 5)
		PISR PQRSTTT 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI QRSTUU 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI EE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Pistol/slide", 5)
		PISI FG 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI H 4 A_WeaponReady(WRF_ALLOWZOOM)
		PISI H 0 A_PlaySound("pistol/slide2", 5)
		PISI IJKLLL 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI MMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR BA 1 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectAnimation:
		PIST E 0 A_PlaySound("Pistol/Draw", 5)
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")		
		PISS A 0 A_JumpIfInventory("BDPistolAmmoOff", 1, 2)
		Goto SelectAnimationEmpty
		TNT1 AA 0
		PISS ABC 1 A_WeaponReady(WRF_NOFIRE)
		PIST E 0 A_Takeinventory("StartDualWield",1)
		Goto Ready
	
	/*SelectPurist:
        "####" "#" 0 A_JumpIfInventory("PuristPistol", 1,3)    
        "####" "#" 0 A_Giveinventory("PuristPistol",1)
        "####" "#" 0 A_SelectWeapon("PuristPistol")
        "####" "####" 0 A_Raise
        "####" "#" 1 A_Raise
        "####" "#" 0 A_Takeinventory("BrutalPistol",1)
        Goto SelectPurist+1*/

	SelectAnimationEmpty:
		PISS GHI 1 A_WeaponReady(WRF_NOFIRE)
		PIST E 0 A_Takeinventory("StartDualWield",1)
	Ready3:
	Ready:
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,3)
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",1,2)
		PIST I 0	
		"####" "#" 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" "#" 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" "#" 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_Takeinventory("PistolFireAnimation1",1)
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(0, "DualWield")
		Loop

	StartSprint:
		"####" "#" 0 A_TakeInventory("NeverSelectedPistol",1)
		"####" "#" 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		PIST J 0 A_JumpIfInventory("BDPistolAmmoOff", 1,"StartSprintLoaded")
		PIST OPQ 1 A_WeaponReady(WRF_NOFIRE)
		Goto Sprinting
	StartSprintLoaded:
		PIST JKL 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		PISP A 0 offset(-9,32)
		//PIST E 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		PIST E 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		PIST E 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		PIST E 0 offset(-9,32) A_GiveInventory("UsedStamina", 2)
		PIST E 0 offset(-9,32)
		PIST N 0 A_JumpIfInventory("BDPistolAmmoOff", 1,2)
		PIST S 0
		PIST "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		PIST "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		PIST "#" 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		PIST "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PIST "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PIST "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PIST "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 3)
		PIST "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		PIST "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		PIST "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		PIST "#" 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		PIST "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint
		
	StopSprint:
		PIST J 0 A_JumpIfInventory("BDPistolAmmoOff", 1,"StopSprintLoaded")
		PIST QPO 1
		PIST E 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	StopSprintLoaded:
		PIST LKJ 1
		PIST E 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		PIST E 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IST E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		PISS E 0 A_JumpIfInventory("BDPistolAmmoOff", 1, 1)
		Goto DeselectEmpty
		PISS E 0
	DeselectContinue:
		"####" DEF 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	DeselectEmpty:
		PISS JKL 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("BDPistolAmmoOff",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("BDPistolAmmoOff",1)
		"####" "#" 0 A_Takeinventory("BDDualPistolAmmo",1)
		"####" "#" 0 A_JumpIfInventory("BDPistolAmmoOff",6,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame

	NoReload:
		"####" "#" 0 A_JumpIfInventory("Clip1",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		"####" "###" 0
	ResumeFireFrame:
		"####" A 0
		2IST A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		PIST E 0
		"####" E 0 A_AlertMonsters
		"####" E 0 A_PlaySound("FARSHT", 6)
		"####" E 0 A_PlaySound("Pistol/Fire", 1)
		"####" E 0 A_ZoomFactor(0.98)
		"####" E 0 A_SpawnItemEx("PlayerMuzzle1",35,5,50)		
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 1 BRIGHT A_FireBullets (1, 1, -1, 14, "WeakPuff", FBF_NORANDOM)
		"####" E 0 A_ZoomFactor(1.0)
		"####" E 0 A_JumpIFInventory("PistolBurstFire", 1, "Fire2")			
		"####" "#" 0 A_Quake(1,2,0,12,"")
		"####" B 1 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		"####" C 1
		"####" I 0 A_JumpIfInventory("BDPistolAmmoOff",1,1)
		Goto NoAmmo+2
		"####" EF 0
		"####" E 0 A_JumpIfInventory("RSA_Opt_Semi", 1, "RSA_SemiEnd")	// 1.41 option: semi auto
		"####" E 0 A_JumpIfInventory("IsTacticalClass", 1, "FireEndTactical")
		"####" D 1
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 3 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 3 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_REfire
		Goto Ready
	
	RSA_SemiEnd:	// 1.41 "Pistol Semi Auto": one shot per pull, each hand its own trigger
		"####" D 1
	RSA_SemiHold:
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB | WRF_ALLOWRELOAD)
		"####" E 0 A_JumpIf((OverlayID() != 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 1) != 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "RSA_SemiHold")
		Goto Ready

	DM:
		"####" A 1 BRIGHT A_FireBullets (1, 1, -1, 14, "WeakPuffDM", FBF_NORANDOM)
		Goto ResumeFireFrame+12

	Fire2:
		"####" A 0
		"####" E 0 A_GiveInventory("BurstCounter",1)
		"####" B 1
		"####" E 0 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		"####" I 0 A_JumpIfInventory("BDPistolAmmoOff",1,1)
		Goto NoAmmo+2
		"####" E 0 A_JumpIfInventory("BurstCounter",3,2)
		Goto Fire
		"####" AAA 0
		"####" EF 0
		"####" C 1 A_TakeInventory("BurstCounter",0)
		"####" DE 1	
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" E 2 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		Goto Ready

	FireEndTactical:
		PIST E 0
		PIST E 0 A_JumpIfInventory("IsRunning", 1, "FireEndTactical2")
		PIST E 1 A_WeaponReady(1)
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		PIST E 7 A_WeaponReady(1)
		Goto Ready

	FireEndTactical2:
		PLAY A 0 ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		PIST E 0 A_GiveInventory("UsedStamina", 4)
		PIST E 1 A_WeaponReady(1)
		PIST E 5 A_WeaponReady(1)
		Goto Sprinting

	Inspect:
		PIST E 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		PIST E 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		PIST E 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		PIST E 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PIST E 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PIST E 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PIST E 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PIST E 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PIST E 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PIST E 0 A_JumpIfInventory("Unloading",1,"Unload")
		PIST E 0 A_Takeinventory("PistolFireAnimation1",1)
		PIST E 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PIST E 0 A_JumpIf(0, "DualWield")
		PIST E 6 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_GiveInventory("DoInspect",1)
		PIST E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PIST E 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		PIST E 0 A_TakeInventory("DoInspect",1)
		PISR AB 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI ABCDEEEEE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Pistol/slide", 5)
		PISI FGHH 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		PISI H 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		PISI H 0 A_PlaySound("pistol/slide2", 5)
		PISI IJKLLL 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISI MMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		PISR BA 1 A_WeaponReady(WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("Reloading",1)
		Goto Ready

	Reload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",0,"Inspect")
		PIST E 0 A_JumpIfInventory("Clip1",1,3)
		Goto Ready
		TNT1 AAA 0
		PIST E 0 A_Takeinventory("Zoomed",1)
		PIST E 0 A_ZoomFactor(1.0)
		PIST E 0 A_GiveInventory ("Pumping", 1)
		PIST E 0 A_Takeinventory("Reloading",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		PIST E 0 A_JumpIfInventory("HasUnloadedPistol", 1, 3)
		RIFR C 0 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
		PIST E 0 A_PlaySound("Pistol/Reload1", 5)
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",1,"Reload2")//15+1 effect
		TNT1 AA 0
		2ISR ABCDEFGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR HIJKKLLL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR MNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR F 0 A_PlaySound("Pistol/Reload2", 5)
	InsertBullets:
		TNT1 AAAA 0		
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",15,15)
		PIST E 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		PIST E 0 A_Giveinventory("BDPistolAmmoOff",1)
		PIST E 0 A_Giveinventory("BDDualPistolAmmo",1)
		PIST E 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload
		TNT1 AAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload

	FinishReload:
		2ISR PQRSS 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2ISR T 1 A_PlaySound("pistol/slide2", 5)
		2ISR UV 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR TTUVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR DCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("HasUnloadedPistol",1)
		PIST E 0 A_Takeinventory("HasUnloadedDualPistols",1)
		Goto Ready

	Reload2: //empty
		TNT1 AA 0
		PISR ABCDEFGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR HIJKKLLL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR MNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PIST E 0 A_PlaySound("Pistol/Reload2", 5)
	InsertBullets2:
		TNT1 AAAA 0
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",0,15)
		PIST E 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload2
		TNT1 AAAAAA 0
		PIST E 0 A_Giveinventory("BDPistolAmmoOff",1)
		PIST E 0 A_Giveinventory("BDDualPistolAmmo",1)
		PIST E 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload2
		TNT1 AAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto FinishReload2

	FinishReload2:
		PISR PQRSTT 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR UVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PISR DCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PIST E 0 A_Takeinventory("HasUnloadedPistol",1)
		PIST E 0 A_Takeinventory("HasUnloadedDualPistols",1)
		"####" "#" 0 A_ReFire
		Goto Ready

	Spawn:
		PIST A 0
		P3ST K -1
		Stop

	AltFire:
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_PlaySound("Weapon/Empty", 5)
		TNT1 A 0 A_JumpIFInventory("PistolBurstFire", 1, 3)
		TNT1 A 0 A_GiveInventory("PistolBurstFire", 1)
		TNT1 A 0 A_Print("$BD_PISTOL_BURST_MODE",0.5)
		Goto Altfire+7
		TNT1 A 0 A_TakeInventory("PistolBurstFire", 1)
		TNT1 A 0 A_Print("$BD_PISTOL_SINGLE_MODE",0.5)
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",1,2)
		PIST I 0
		PIST "#" 1 offset(0,34)
		PIST "#" 1 offset(0,33)
		Goto Ready3

	Steady:
		TNT1 A 1
		Goto Ready

	User2:
	Unload:
		"####" "#" 1 A_WeaponReady
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("BDPistolAmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		PIST E 0 A_Takeinventory("Zoomed",1)
		PIST E 0 A_ZoomFactor(1.0)
		PIST E 0 A_GiveInventory ("Pumping", 1)
		PIST E 0 A_Takeinventory("Reloading",1)
		PISR ABCDWVUTSS 1
		PIST E 0 A_PlaySound("Pistol/Reload1", 5)
		2ISR SONMKJIIHG 1
		2ISR FEDCBA 1
		PIST E 0 A_Giveinventory("HasUnloadedPistol",1)
		PIST E 0 A_Giveinventory("HasUnloadedDualPistols",1)
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",1,"RemoveBullets")
	RemoveBullets:
		TNT1 AAAA 0
		PIST E 0 A_JumpIfInventory("BDPistolAmmoOff",1,3)
		Goto Ready
		TNT1 AAAAAA 0
		PIST E 0 A_Takeinventory("BDPistolAmmoOff",1)
		PIST E 0 A_Takeinventory("BDDualPistolAmmo",1)
		PIST E 0 A_Giveinventory("Clip1",1)
		Goto RemoveBullets
		TNT1 AAAAAAAAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto Ready
		TNT1 AAAA 0
		PIST E 0 A_Takeinventory("Reloading",1)
		PIST E 0 //A_Refire
		Goto Ready

	User3:
	DualWield:
		"####" "#" 0 A_Takeinventory("StartDualWield",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		PIST "#" 0 A_JumpIfInventory("HasDualPistol", 1, "GetDual")
		PIST "#" 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		PIST E 0
		PIST E 0 A_Takeinventory("Zoomed",1)
		PIST E 0 A_Takeinventory("ADSmode",1)
		PIST E 0 A_TakeInventory("TossGrenade", 1)
		PIST E 0 A_TakeInventory("Kicking",1)
		PIST E 0 A_TakeInventory("Taunting",1)
		PIST E 0 A_TakeInventory("Reloading",1)
		PIST E 0 A_TakeInventory("Unloading",1)
		PIST E 0 A_TakeInventory("Salute1", 1)
		PIST E 0 A_TakeInventory("Salute2", 1)
		PIST E 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("SwitchDuals",1)
		PIST F 0 A_GiveInventory("DualPistols",1)
		PIST E 0 A_SelectWEapon("DualPistols")
		Goto Ready
	}
}

ACTOR RevolverAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 6
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 6
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_Revolver : Revolver
{
	Tag "Off-hand Revolver"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	//$category "Weapons"
	Weapon.AmmoType1 "AmmoShell"
	Weapon.AmmoType2 "RevolverAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Revolver/Hammer"
	Inventory.PickupMessage "$GOTREVOLVER"
	Obituary "$OBBD_REVOLVER"
	States
	{
	// RSR-BREAK: real VR reload, break-open / revolver (zscript/rsr/rsr_break.zs, team/reload_break/tools/rsb_patch.py).
	// Not in VR, or with Real reload off, RSB_Start goes straight on into the set's own reload.
	RSB_Start:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_GiveInventory("RSB_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_Go", 1, "RSB_Open")
		Goto RSB_Stock
	RSB_Open:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_GiveInventory("Pumping", 1)		// as BD22's reload
	RSB_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSB_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_EjectT", 1, "RSB_Eject")
		"####" "#" 0 A_JumpIfInventory("RSB_LoadT", 1, "RSB_Load")
		"####" "#" 0 A_JumpIfInventory("RSB_TopUpT", 1, "RSB_TopUp")
		"####" "#" 0 A_JumpIfInventory("RSB_Done", 1, "RSB_Done")
		Goto RSB_Wait
	RSB_Eject:		// BD22's own casings: one SSGCaseSpawner per spent round (its InsertingShells)
		"####" "#" 0 A_TakeInventory("RSB_EjectT", 1)
		"####" "#" 0 A_FireCustomMissile("SSGCaseSpawner",0,0,-10, -20)
		"####" "#" 0 A_JumpIfInventory("RSB_EjectT", 1, "RSB_Eject")
		Goto RSB_Wait
	RSB_Load:		// the speedloader home: it fills the whole cylinder, so run BD22's own
					// loop (RSB_TopUp1) rather than its one-round pass. Patched 2026-10-13.
		"####" "#" 0 A_TakeInventory("RSB_LoadT", 1)
		Goto RSB_TopUp1
	RSB_TopUp:		// every chamber loaded: BD22's own InsertBullets to its 6 (its cylinder mesh has 5 chambers)
		"####" "#" 0 A_TakeInventory("RSB_TopUpT", 1)
	RSB_TopUp1:
		"####" "#" 0 A_JumpIfInventory("RevolverAmmoOff",0,"RSB_Wait")
		"####" "#" 0 A_JumpIfInventory("AmmoShell",1,1)
		Goto RSB_Wait
		"####" "#" 0 A_Giveinventory("RevolverAmmoOff",1)
		"####" "#" 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto RSB_TopUp1
	RSB_Done:		// shut (Revolver/Close): BD22's own end of a reload (its FinishedInsertingShells)
		REVO A 0 A_TakeInventory("RSB_Done", 1)
		REVO A 0 A_JumpIfInventory("NeedToHammer",1,"Hammering")
		Goto Ready
	Inspect:
		REVO A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		REVO A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		REVO A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		REVO A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		REVO A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		REVO A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		REVO A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		REVO A 0 A_JumpIfInventory("Unloading",1,"Unload")
		REVO A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		REVO A 6 A_WeaponReady(WRF_ALLOWZOOM)
		REVO A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		REVO A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		REVO A 0 A_GiveInventory("DoInspect",1)
		REVO A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		REVO A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		REVO A 0 A_TakeInventory("DoInspect",1)
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("Reloading",1)
		REVR ABCDEF 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Open", 5)
		REVR GHIJ 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM|WRF_NOFIRE)
		REVR K 3 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		REVR K 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		REVR JIH 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PLaySound("Revolver/Close", 5)
		REVR GFEDCBA 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto Ready

	KickFlash:
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		R3VO A 0 A_JumpIfInventory("NeedToHammer",1,"KickFlashHammering")		
		REVO XYZ 1
		REVO "[" 1
		REVO "\" 10
		REVO "[" 1
		REVO ZYX 1
		stop
	SlideFlash:
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		R3VO A 0 A_JumpIfInventory("NeedToHammer",1,"SlideFlashHammering")	
		REVO XYZ 1
		REVO "\" 35
		stop
	SlideFlashEnd: 
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		R3VO A 0 A_JumpIfInventory("NeedToHammer",1,"SlideFlashEndHammering")
		REVO "\" 6
		REVO "[" 1
		REVO ZYX 1
		stop
	SlideFlashEndEarly: 
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		R3VO A 0 A_JumpIfInventory("NeedToHammer",1,"SlideFlashEndEarlyHammering")
		REVO "\" 2
		REVO "[" 1
		REVO ZYX 1
		stop

	KickFlashHammering:
		R3VO ABCD 1
		R3VO E 10
		R3VO DCBA 1
		stop

	SlideFlashHammering:
		R3VO ABCD 1
		R3VO E 35
		stop
	SlideFlashEndHammering: 
		R3VO E 6
		R3VO DCBA 1
		stop
	SlideFlashEndEarlyHammering: 
		R3VO E 2
		R3VO DCBA 1
		stop		

	Spawn:
		REVP A -1
		Stop

	Deselect:
		REVO A 0
		REVO A 0 A_Takeinventory("Zoomed",1)
		REVO A 0 A_TakeInventory("TossGrenade", 1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		REVO A 0 A_Takeinventory("ADSmode",1)
		REVO A 0 A_Takeinventory("UseShotgunStrap",1)
		TNT1 A 0 A_TakeInventory("RevolverIsReloading",1)
		REVO A 0 A_ZoomFactor(1.0)
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		REVS EFGH 1
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	FirstSelectAnimation:
		REVO A 0 A_Takeinventory("NeverSelectedRevolver",1)
		REVO A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		REVO A 1 Offset(15, 50)
		REVO A 1 Offset(10, 45)
		REVO A 1 Offset(5, 35)
		REVO A 1 Offset(2, 33)
		REVO A 1 Offset(0, 32) A_WEAPONREADY(WRF_ALLOWZOOM)
		REVR ABCDEFF 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Open", 5)
		REVU ABCDEEFGHIJKKKKKKKK 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		REVU LMN 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload", 5)
		REVU OOPPPPPPPQQR 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		REVR QPONMLKJIH 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Close", 5)
		REVR GFEEDCBA 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		REVO LMNOP 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Revolver/Hammer", 5)
		REVO QRSTUVW 1 A_WEAPONREADY(WRF_ALLOWZOOM)
		Goto Ready3

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 20) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_Giveinventory("PistolSelected",1)
		SHTN A 0 A_TakeInventory("NeverSelectedRevolver", 1)	// posefix: was SHTN A 0 A_JumpIfInventory("NeverSelectedRevolver", 1, "FirstSelectAnimation")
	SelectAnimation:
		TNT1 A 0 A_JumpIfInventory("NeedToHammer",1,"SelectHammering")
		TNT1 A 0 A_PlaySound("Revolver/Hammer", 5)
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		REVS ABCD 1 A_WeaponReady(WRF_NOFIRE)
		DEAG A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto Ready3

	SelectHammering:
		TNT1 A 0 A_PlaySound("Revolver/Hammer", 5)
		TNT1 A 0 A_TakeInventory("NeedToHammer",1)
		2EVS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectHammeringPurist")
		REVS IJKL 1 A_WeaponReady(WRF_NOFIRE)
		DEAG A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto Ready3

	SelectHammeringPurist:
		TNT1 AAAAAAAA 0 A_Raise
		2EVO STUV 1 A_Raise
		Goto SelectHammeringPurist+1

	Ready3:
	Ready:
		REVO A 0 A_JumpIf(OverlayID() == 1000000, 2)	// 1.37 rsa: a slug asked for and never fired is dropped
		REVO A 0 A_TakeInventory("RSA_Magnum", 1)
		REVO A 0 A_JumpIf(OverlayID() != 1000000, 2)
		REVO A 0 A_TakeInventory("RSA_MagnumOff", 1)
		REVO A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		REVO A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		REVO A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		REVO A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		REVO A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		REVO A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		REVO A 0 A_JumpIfInventory("Unloading",1,"Unload")
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,3)
		REVO K 0 A_JumpIfInventory("NeedToHammer",1,2)
		REVO A 0
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		"####" "#" 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		Loop


	Fire:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("RevolverIsReloading", 1,"FinishedInsertingShells")
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("RevolverAmmoOff",1,1)
		Goto NoAmmo
		"####" "#" 0 A_JumpIfInventory("NeedToHammer",1,"Hammering")
		"####" "#" 0 A_Takeinventory("RevolverAmmoOff",1)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("RSA_Magnum") > 0) || (OverlayID() == 1000000 && CountInv("RSA_MagnumOff") > 0), "RSA_MagnumShot")	// 1.37 rsa: the slug
		Goto ResumeFireFrame

	NoReload:
		"####" "#" 0 A_JumpIfInventory("AmmoShell",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" AAAA 0
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		REVO A 0
		"####" "#" 0 A_ZoomFactor(0.9)
		"####" "#" 0 A_AlertMonsters
		"####" "#" 0 A_PlaySound("Revolver/Fire", 1)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" AAAAAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles2", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-3,3), 0, 0, -12, 0, random(-3,3))
		//SHO9 A 0 A_firebullets (0,0,1,40,"ShotgunPuff",FBF_NORANDOM,300)
		//REVO A 0 A_FireBullets (20, 7, 7, 22, "ShotgunPuff", FBF_NORANDOM)  //Revopuff is the og
		//REVO A 0 A_FireBullets (3, 3, 2, 22, "ShotgunPuff", FBF_NORANDOM)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" B 1 BRIGHT A_FireBullets (20, 7, 7, 22, "ShotgunPuff", FBF_NORANDOM)  //Revopuff is the og
		"####" C 1 BRIGHT A_FireBullets (3, 3, 2, 22, "ShotgunPuff", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (12, 3, 5, 22, "ShotgunPuff2", FBF_NORANDOM)
	RSA_MagnumKick:	// 1.37 rsa: the slug's kick and hammer are the shotvolver's own (a label, no state)
		"####" A 0 A_SetPitch(pitch-10)
		//REVO BC 1 BRIGHT
		"####" A 0 A_SetPitch(-6.0 + pitch)
		"####" A 0 A_ZoomFactor(1.00)
		"####" D 1 A_SetPitch(+1.0 + pitch)
		"####" EF 1 A_SetPitch(+1.0 + pitch)
		"####" G 1 A_SetPitch(+0.5 + pitch)
		"####" HIJ 1 A_SetPitch(pitch+0.5)
		"####" K 1 A_GiveInventory("NeedToHammer",1)
		"####" K 2 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		"####" A 0 A_JumpIfInventory("RevolverAmmoOff",1,2)
		Goto Ready3
	// 2026-10-27 (2.0 integration): Hammering MUST follow here, as in Revolver.dec since 1.92. The jump above is
	// BD22's numeric "+2" into Hammering's second frame; with the slug in between, every off-hand shot fell into
	// RSA_MagnumShot and re-fired forever (rig: off hand B..K every 12 tics, trigger up), NeedToHammer was never
	// taken, and the main Shotvolver then waited at its hammer frame and never fired again.
	Hammering:
		"####" LMNOP 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
		"####" A 0 A_PlaySound("Revolver/Hammer", 5)
		"####" QRSTUVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" A 0 A_Takeinventory("NeedToHammer",1)
		"####" A 0 A_JumpIf(((OverlayID() != 1000000 && CountInv("RSA_Magnum") > 0) || (OverlayID() == 1000000 && CountInv("RSA_MagnumOff") > 0)) && ((OverlayID() != 1000000 && ((GetPlayerInput(INPUT_BUTTONS) & 32) != 0 || CountInv("FiredSecondary") > 0)) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0)), "Fire")	// 1.37 rsa: cocked for the slug, secondary still held: fire it
		"####" A 0 A_Refire
		Goto Ready3

	// 1.37 rsa (owner: "a Dirty Harry"): secondary fire is a slug: one heavy round where the
	// shotvolver throws its pellets, the same cartridge (its pellets' whole damage, on one point)
	RSA_MagnumShot:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_Magnum", 1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_MagnumOff", 1)
		"####" AAAA 0
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		REVO A 0
		"####" "#" 0 A_ZoomFactor(0.9)
		"####" "#" 0 A_AlertMonsters
		"####" "#" 0 A_PlaySound("Revolver/Fire", 1)
		"####" "#" 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" AAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-4,4), 0, -1, 0, 0, random(-3,3))
		"####" A 0 A_FireCustomMissile("DecorativeTracer", 0, 0, 0, -12, 0, 0)
		"####" B 1 BRIGHT A_FireBullets (0, 0, 1, 200, "ShotgunPuff", FBF_NORANDOM)
		"####" C 1 BRIGHT
		Goto RSA_MagnumKick
	AltFire:	// 1.37 rsa: BD22's revolver has no secondary fire; with the option, it fires a slug
		"####" "#" 0 A_JumpIfInventory("RSA_Opt_Rev", 1, 1)
		Goto Ready3
		// 2.0 int r2: named jumps. The numeric "+2" past the off hand's give ran off the end of this block
		// into DM: on the MAIN hand, so every slug was preceded by a free 7 + 2 pellet shot (rig trace).
		"####" "#" 0 A_JumpIf(OverlayID() == 1000000, "RSA_AltOff")
		"####" "#" 0 A_GiveInventory("RSA_Magnum", 1)
		Goto Fire
	RSA_AltOff:
		"####" "#" 0 A_GiveInventory("RSA_MagnumOff", 1)
		Goto Fire
	
	DM:
		"####" B 1 BRIGHT A_FireBullets (20, 7, 7, 22, "ShotgunPuffDM", FBF_NORANDOM)  //Revopuff is the og
		"####" C 1 BRIGHT A_FireBullets (3, 3, 2, 22, "ShotgunPuffDM", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (12, 3, 5, 22, "ShotgunPuff2DM", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-10)
		//REVO BC 1 BRIGHT
		"####" A 0 A_SetPitch(-6.0 + pitch)
		"####" A 0 
		Goto ResumeFireFrame+45

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedRevolver",1)
		REVO A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		REVO XYZ 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		REVP B 0 offset(-9,32)
		//REVO A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		REVO A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		REVO A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		REVO A 0 offset(-9,32) A_GiveInventory("UsedStamina", 3)
		REVO A 0 offset(-9,32)
		REVO "[" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		REVO "[" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		REVO "[" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		REVO "[" 1 offset(0,38) A_SetPitch(pitch -0.5)
		REVO "[" 1 offset(3,36) A_SetPitch(pitch -0.5)
		REVO "[" 1 offset(6,34) A_SetPitch(pitch -0.5)
		REVO "[" 1 offset(9,32) A_SetPitch(pitch -0.5)
		REVO A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		REVO A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		REVO A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		REVO A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		REVO A 0 offset(-9,32) A_GiveInventory("UsedStamina", 3)
		REVO A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		REVO "[" 1 offset(9,34) A_SetPitch(pitch +0.5)
		REVO "[" 1 offset(6,36) A_SetPitch(pitch +0.5)
		REVO "[" 1 offset(3,38) A_SetPitch(pitch +0.5)
		REVO "[" 1 offset(0,38) A_SetPitch(pitch +0.5)
		REVO "[" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		REVO "[" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		REVO "[" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		REVO A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		REVO A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		REVO ZYX 1
		REVO A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	ReloadEmpty:
		REVU ST 1
		REVU KKKKKK 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVU LMMN 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload", 5)
		Goto InsertBullets

	ReloadWithNoAmmoLeft:
	Reload:
		"####" "#" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarningManual")
		REVO A 0 A_JumpIfInventory("AmmoShell", 1, 2)
		Goto Ready
		REVO A 0
		REVO A 0 A_Takeinventory("Zoomed",1)
		REVO A 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",0,"Inspect")
		Goto RSB_Start	// RSR-BREAK: real VR reload (zscript/rsr/rsr_break.zs)
	RSB_Stock:
		REVO A 0 A_JumpIfInventory("HasUnloadedRevolver", 1, "ReloadUnloaded")
		REVO A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		REVR B 0 A_GiveInventory ("Pumping", 1)
		REVR ABCDEFF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Open", 5)
		REVR GHIJKKK 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVR LMNOP 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVR Q 0 A_GiveInventory("RevolverIsReloading",1)
		REVR Q 2 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	InsertingShells:
		REVO A 0
		REVO A 0 A_JumpIfInventory("AmmoShell",1,2)//if there are no more reserve shells, finish reload.
		Goto FinishedInsertingShells
		REVO A 0
		REVO A 0 A_GiveInventory ("Pumping", 1)
		SSHR A 0 A_TakeInventory("Reloading", 1)
		TNT1 A 0 A_JumpIfInventory("HasUnloadedRevolver",1,3)
		TNT1 A 0 A_FireCustomMissile("SSGCaseSpawner",0,0,-10, -20)
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",0,"FinishedInsertingShells")
		REVO A 0 A_Giveinventory("RevolverAmmoOff",1)
		REVO A 0 A_JumpIfInventory("NoReloading",1,2)
		REVO A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
	InsertShellAnimation:
		REVO A 0
		REVR Z 2
		REVR RS 1
		TNT1 A 0 A_PlaySound("Shotgun/Reload", 5)
		REVR TT 1
		REVR UVWXY 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SSHR A 0 A_JumpIfInventory("Reloading", 1, "FinishedInsertingShells")
		REVO A 0 A_JumpIfInventory("Kicking",1,"DoKick")  //A_JumpIfInventory("Kicking",1,"DoKickReloading") Too inconsistent and unpolished for this beta,you'll work on this later!
		REVO A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",0,"FinishedInsertingShells")//If there are 8+1 shells, stop it immediately
		Goto InsertingShells

	FinishedInsertingShells:
		REVO A 0 A_Takeinventory("Reloading",1)
		TNT1 A 0 A_TakeInventory("HasUnloadedRevolver", 1)
		TNT1 A 0 A_TakeInventory("RevolverIsReloading",1)
		REVR QPONMLKJIH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Close", 5)
		REVR GFEEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVO A 0 A_Takeinventory("Reloading",1)
		REVO A 0 A_JumpIfInventory("NeedToHammer",1,"hammering")
		"####" "#" 0 A_ReFire
		Goto Ready

	TurboReload:
		SHSS BC 0
	TurboBullets:
		REVO A 0
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",0,"FinishTurboReload")
		REVO A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto FinishTurboReload
		TNT1 AAAA 0
		REVO A 0 A_Giveinventory("RevolverAmmoOff",1)
		REVO A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets

	FinishTurboReload:
		REVO A 1 A_Refire
		Goto Ready3

	ReloadUnloaded:
		REVR ABCDEFF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Open", 5)
		REVU ABCDEEFGHIJKKKKKKKK 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVU LMN 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload", 5)
	InsertBullets:
		TNT1 AAAA 0
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",0,"FinishUnloadedReload")
		REVO A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto FinishUnloadedReload
		TNT1 AAAAAA 0
		REVO A 0 A_Giveinventory("RevolverAmmoOff",1)
		REVO A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets

	FinishUnloadedReload:
		REVU OOPPPPPPPQQR 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto FinishedInsertingShells

	User2:
	Unload:
		REVO A 0 A_ZoomFactor(1.0)
		REVO A 0 A_Takeinventory("Unloading",1)
		REVO A 0 A_Takeinventory("ADSmode",1)
		REVO A 0 A_Takeinventory("Zoomed",1)
		2EVO A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		REVO A 0 A_JumpIfInventory("NoReloading",1,"Ready")
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		REVO A 0 A_Takeinventory("Zoomed",1)
		REVO A 0 A_GiveInventory ("Pumping", 1)
		REVO A 0 A_Takeinventory("Unloading",1)
		REVR ABCDEFF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PLaySound("Revolver/Unload", 5)
		REVR GHIJKKK 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVR LMNOP 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVR Q 2 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RemoveBullets:
		TNT1 AAAA 0
		REVO A 0 A_JumpIfInventory("RevolverAmmoOff",1,1)
		Goto FinishUnload
		TNT1 AAAAAA 0
		REVO A 0 A_Takeinventory("RevolverAmmoOff",1)
		REVO A 0 A_JumpIfInventory("NoReloading",1,2)
		REVO A 0 A_Giveinventory("AmmoShell",1)
		Goto RemoveBullets

	FinishUnload:
		REVO A 0 A_Giveinventory("NeedToHammer",1)
		REVO A 0 A_Giveinventory("HasUnloadedRevolver",1)
		REVU STKKKKKKJIHGFEDCB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVU A 1 A_PLaySound("Revolver/Close", 5)
		REVR GFEEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		REVO A 0 A_Takeinventory("Unloading",1)
		Goto Ready

	Steady:
		TNT1 A 1
		Goto Ready
	}
}

ACTOR BDSMGAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 41
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 41
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_BrutalSMG : BrutalSMG
{
	Tag "Off-hand SMG"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "Clip1"
	Weapon.AmmoType2 "BDSMGAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "$GOTSMG"
	Obituary "$OBBD_SMG"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		SMGR A 0 A_TakeInventory("RSR_Go", 1)
		SMGR A 0 A_GiveInventory("RSR_Start", 1)
		SMGR A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		SMGR A 0 A_TakeInventory("RSR_Go", 1)
		SMGR A 0 A_JumpIfInventory("HasUnloadedSMG", 1, "RSR_Wait")	// no magazine in the gun
		SMGR A 0 A_JumpIfInventory("RSR_Charge", 1, "RSR_Filled")	// a magazine in, the handle still to pull
		SMGR A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff", 2, "RSR_Unload1")
		SMGR A 0 A_GiveInventory("HasUnloadedSMG", 1)
		SMGR A 0 A_GiveInventory("HasUnloadedDualSMG", 1)
		Goto RSR_Wait
	RSR_Unload1:
		SMGR A 0 A_TakeInventory("BDSMGAmmoOff", 1)
		SMGR A 0 A_TakeInventory("BDDualSMGAmmo", 1)
		SMGR A 0 A_GiveInventory("RSR_Held_BrutalSMG", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		SMGR A 0 A_TakeInventory("RSR_Seated", 1)
		SMGR A 0 A_TakeInventory("HasUnloadedSMG", 1)
		SMGR A 0 A_TakeInventory("HasUnloadedDualSMG", 1)
	RSR_Return:		// the held rounds first
		SMGR A 0 A_JumpIfInventory("RSR_Held_BrutalSMG", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		SMGR A 0 A_TakeInventory("RSR_Held_BrutalSMG", 1)
		SMGR A 0 A_GiveInventory("BDSMGAmmoOff", 1)
		SMGR A 0 A_GiveInventory("BDDualSMGAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff", 1, "RSR_FillB")	// a round chambered: BD22's second loop, to the maximum
		SMGR A 0 A_GiveInventory("RSR_Charge", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		SMGR A 0 A_GiveInventory("RSR_Charge", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillB1
	RSR_FillA:
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff", 40, "RSR_Filled")
		SMGR A 0 A_JumpIfInventory("Clip1", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		SMGR A 0 A_GiveInventory("BDSMGAmmoOff", 1)
		SMGR A 0 A_GiveInventory("BDDualSMGAmmo", 1)
		SMGR A 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff", 0, "RSR_Filled")
		SMGR A 0 A_JumpIfInventory("Clip1", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		SMGR A 0 A_GiveInventory("BDSMGAmmoOff", 1)
		SMGR A 0 A_GiveInventory("BDDualSMGAmmo", 1)
		SMGR A 0 A_TakeInventory("Clip1", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		SMGR A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		SMGR A 0 A_TakeInventory("RSR_Done", 1)
		SMGR A 0 A_TakeInventory("RSR_Charge", 1)
		SMGR A 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready
	KickFlash: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		SMGF DEFGH 1
		SMGF H 8
		SMGF HGFED 1
		stop
	SlideFlash: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		SMGF DEFGH 1
		SMGF H 35
		stop
	SlideFlashEnd: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		SMGF H 4
		SMGF HGFED 1
		stop
	SlideFlashEndEarly: 
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		SMGF H 1
		SMGF HGFED 1
		stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")	
		SMGG A 0 A_TakeInventory("DualSMG",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_GunFlash
		TNT1 A 0 A_GiveInventory("SMGSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")	
		TNT1 A 1
		SMGR A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_TakeInventory("NeverSelectedSMG", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedSMG", 1, "FirstSelectAnimation")
		SMGR A 0 A_PlaySound("Rifle/Select", 5)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "SelectPurist")
		Goto SelectAnimation

	SelectDual:
		TNT1 A 0 A_TakeInventory("SwitchDuals",1)
		TNT1 A 0 A_JumpIfInventory("HasUnloadedSMG", 1, "SelectDualUnloaded")
		SM2S QPON 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		SM2S MLKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready
	SelectDualUnloaded:
		SM2S WVUT 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		SM2S SRKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready

	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedSMG",1)
		SMGR A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		3MGR KJIHGF 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR OOPPPQRSTUUUUV 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR A 0 A_PlaySound("SMG/Reload2", 5)
		SMGR XWXYZZ 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR "[\]" 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SMGR DCB 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimation:
		SMGS HGFE 1  A_WeaponReady(WRF_NOFIRE)
		SMGR A 0 A_Takeinventory("StartDualWield",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		TNT1 A 0 //ACS_NamedExecuteAlways("AimMode")
		SMGR A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SMGR A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGR A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGR A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGR A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SMGR A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SMGR A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGR A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SMGR A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGR A 0 A_JumpIf(0, "DualWield")
		SMGZ F 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGR A 0
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Ready2:
		SMGZ F 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SMGZ F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGZ F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGZ F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SMGZ F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SMGZ F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGZ F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SMGZ F 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGZ F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SMGZ F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGZ F 0 A_JumpIf(0, "DualWield")
		SMGZ F 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		SMGZ F 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SMGZ F 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		TNT1 AAA 0
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	AltFire:
		"####" "#" 0 A_Jump(256, "RSA_SMGToggle")	// 1.39 rsa (owner): secondary toggles full auto / 3-round burst (was BD22's zoom)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_SetCrosshair(41)
		SMGR A 0 A_Giveinventory("GoSpecial",1)
		SMGR A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		SMGR A 0 A_Giveinventory("Zoomed",1)
		SMGR A 0 A_ZoomFactor(1.3)
		SMGR A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		SMGZ CDE 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SMGR A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SMGR A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		SMGZ F 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready2
		TNT1 AAA 0
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		SMGZ F 4
		SMGR A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		SMGZ CDE 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		SMGZ F 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready2

	HoldAim:
		SMGZ F 0
		SMGZ F 0 A_Giveinventory("ZoomHold",1)
		SMGZ F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGZ F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGZ F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SMGZ F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SMGZ F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGZ F 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGZ F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SMGZ F 0 A_JumpIf(0, "DualWield")
		SMGZ F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ A 0 A_TakeInventory("FireFrameCount", 1)
		SMGZ FF 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_Giveinventory("GoSpecial",1)
		SMGR A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		SMGZ EDC 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGR A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		SMGZ EDC 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SMGR A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedSMG",1)
		SMGR A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		SMGR A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		SMGF DEF 1 A_WeaponReady(WRF_NOFIRE)		
	Sprinting:
		SMSP A 0 offset(-9,32)
		//SMGR A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		SMGR A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		SMGR A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		SMGR A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		SMGR A 0 offset(-9,32)
		SMGF G 1 offset(-9,34) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(-6,36) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(-3,38) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(0,38) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(3,36) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(6,34) A_SetPitch(pitch -0.5)
		SMGF G 1 offset(9,32) A_SetPitch(pitch -0.5)
		SMGR A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		SMGR A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SMGR A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SMGR A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SMGR A 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		SMGR A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		SMGF G 1 offset(9,34) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(6,36) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(3,38) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(0,38) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(-3,36) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(-6,34) A_SetPitch(pitch +0.5)
		SMGF G 1 offset(-9,32) A_SetPitch(pitch +0.5)
		SMGR A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		SMGR A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		SMGF FED 1
		SMGR A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		SMGR A 0 A_TakeInventory("TossGrenade", 1)
		SMGR A 0 A_TakeInventory("Zoomed", 1)
		SMGR A 0 A_TakeInventory("ADSMode", 1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		SMGS ABCD 1
		TNT1 AAAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		SMGZ F 0 A_JumpIfInventory("Zoomed",1,16)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGR A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("BDSMGAmmoOff",1)
		"####" "#" 0 A_Takeinventory("BDDualSMGAmmo",1)
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmoOff",9,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFire
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4
	NoReload:
		"####" "#" 0 A_JumpIfInventory("Clip1",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		"####" "###" 0
	ResumeFire:
		"####" "####" 0
		"####" "#" 0 A_ALertMonsters
		"####" "#" 0 A_Quake(1,3,0,4,"")	
		2MGF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGF A 0
		"####" A 0 A_PlaySound("FARSHT", 6)
		"####" A 0 A_PlaySound("SMG/Fire", 1)
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")		
		"####" A 0 A_ZoomFactor(0.99)
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)			
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 1 BRIGHT A_FireBullets (6, 3, 1, 12, "WeakPuff", FBF_NORANDOM)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		"####" A 0 A_SetPitch(pitch-1.0)
		"####" B 1 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" C 1
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SMGR A 0 //needed for new NoAmmo stuff
		"####" A 0 A_JumpIfInventory("RSA_BurstSMG", 1, "RSA_BurstStep")	// 1.37 rsa: 3-round burst
		"####" A 0 A_ReFire
		Goto Ready3
	// 1.37 rsa (owner): the SMG's burst. Three rounds a pull (the trigger need not be held), then
	// it waits for the trigger to be let go. Each hand counts its own.
	RSA_BurstStep:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, "RSA_BurstStepOff")
		"####" A 0 A_GiveInventory("RSA_BurstCnt", 1)
		"####" A 0 A_JumpIfInventory("RSA_BurstCnt", 3, "RSA_BurstEnd")
		"####" A 0 A_JumpIfInventory("BDSMGAmmoOff", 1, "Fire")
		Goto RSA_BurstEnd
	RSA_BurstStepOff:
		"####" A 0 A_GiveInventory("RSA_BurstCntOff", 1)
		"####" A 0 A_JumpIfInventory("RSA_BurstCntOff", 3, "RSA_BurstEnd")
		"####" A 0 A_JumpIfInventory("BDSMGAmmoOff", 1, "Fire")
	RSA_BurstEnd:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_BurstCnt", 99)
		"####" A 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_BurstCntOff", 99)
	RSA_BurstWait:
		"####" A 1
		"####" A 0 A_JumpIf((OverlayID() != 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 1) != 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "RSA_BurstWait")
		Goto Ready3
	RSA_SMGToggle:
		"####" "#" 0 A_StartSound("Weapon/Empty", CHAN_AUTO)
		"####" "#" 0 A_JumpIfInventory("RSA_BurstSMG", 1, 3)
		"####" "#" 0 A_GiveInventory("RSA_BurstSMG", 1)
		"####" "#" 0 A_Print("SMG: 3-round burst", 0.8)
		Goto RSA_AltWait
		"####" "#" 0 A_TakeInventory("RSA_BurstSMG", 1)
		"####" "#" 0 A_Print("SMG: full auto", 0.8)
	RSA_AltWait:
		"####" "#" 1
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && ((GetPlayerInput(INPUT_BUTTONS) & 32) != 0 || CountInv("FiredSecondary") > 0)) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "RSA_AltWait")
		Goto Ready3
	
	DM:
		"####" "#" 0 A_JumpIfInventory("FireFrameCount", 1, 2)
		"####" "#" 1 BRIGHT A_FireBullets (6, 3, 1, 12, "WeakPuffDM", FBF_NORANDOM)
		Goto ResumeFire+17
		"####" "#" 1 BRIGHT A_FireBullets (3, 2, -1, 12, "WeakPuffDM", FBF_NORANDOM)
		Goto Fire2+7

	FiredZoom:
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		SMGZ G 1 BRIGHT A_FireBullets (3, 2, -1, 12, "WeakPuff", FBF_NORANDOM)
		Goto Fire2+7
	IsHolding:
		SMGZ F 0 A_JumpIfInventory("ZoomHold", 1, 4)
		SMGZ F 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+16
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmoOff",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim
	Fire2:
		SMGR A 0
		SMGR A 0 A_ZoomFactor(1.33)
		SMGZ A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)		
		SMGZ A 0 A_JumpIfInventory("FireFrameCount", 1, "FiredZoom")
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		SMGZ G 1 BRIGHT A_FireBullets (3, 2, 1, 12, "WeakPuff", FBF_NORANDOM)
		SMGR A 0 A_ZoomFactor(1.3)
		RIFF A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		RIFG A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		RIFG A 0 A_SetPitch(pitch-0.5)
		SMGZ H 1 A_FireCustomMissile("PistolCaseSpawn",5,0,0,-9)
		SMGR A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SMGR A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SMGR A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SMGR AAA 0
		SMGR A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		SMGZ I 1
		SMGZ F 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		SMGZ F 0 A_GiveInventory("FireFrameCount", 1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		SMGZ F 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		SMGZ F 0 A_ReFire
		SMGZ F 7 A_WeaponReady(1)
		SMGZ F 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SMGZ F 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SMGZ F 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2
	
	DM2:
		SMGZ G 1 BRIGHT A_FireBullets (3, 2, 1, 12, "WeakPuffDM", FBF_NORANDOM)
		Goto Fire2+7

	ReloadEmpty:
		SMGR B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2MGR EDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ContinueReload
	Reload:
		"####" "#" 0 
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("Clip1",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		TNT1 AAA 0
		SMGR A 0 A_Takeinventory("ADSmode",1)
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_Takeinventory("ZoomHold",1)
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff",0,"Ready")
		SMGR A 0 A_Takeinventory("ADSmode",1)
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_Takeinventory("ZoomHold",1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_GiveInventory ("Pumping", 1)
		SMGR A 0 A_Takeinventory("Reloading",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		SMGR A 0 A_JumpIfInventory("HasUnloadedSMG", 1, "ReloadEmpty")
		SMGR BCDEFGGHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_PlaySound("SMG/Reload1", 5)
		SMGR IJKLMNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR O 1 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
	ContinueReload:
		SMGR PPPQRSTUUUUV 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff",1,"InsertBullets2")//40+1 effect

	InsertBullets:
		TNT1 AAAA 0
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff",40,15)
		SMGR A 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		SMGR A 0 A_Giveinventory("BDSMGAmmoOff",1)
		SMGR A 0 A_Giveinventory("BDDualSMGAmmo",1)
		SMGR A 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets

		TNT1 AAAAAAAAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)

		SMGR A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReload
		TNT1 AAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)

		SMGR A 0 //A_Refire
		Goto FinishReload

	FinishReload:
		SMGR A 0 A_PlaySound("SMG/Reload2", 5)
		SMGR XWXYZZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR "[\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR DCB 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_Takeinventory("HasUnloadedSMG",1)
		SMGR A 0 A_Takeinventory("HasUnloadedDualSMG",1)	
		"####" "#" 0 A_ReFire	
		Goto Ready

	InsertBullets2:
		TNT1 AAAA 0
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff",0,15)
		SMGR A 0 A_JumpIfInventory("Clip1",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		SMGR A 0 A_Giveinventory("BDSMGAmmoOff",1)
		SMGR A 0 A_Giveinventory("BDDualSMGAmmo",1)
		SMGR A 0 A_Takeinventory("Clip1",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2

		TNT1 AAAAAAAAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR A 0 //A_Refire
		Goto FinishReload
		TNT1 AAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)

		SMGR A 0 //A_Refire
		Goto FinishReload

	User2:
	Unload:
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("BDSMGAmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 2) )
		SMGR A 0 A_GiveInventory ("Pumping", 1)
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR BCDEFGGHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR A 0 A_PlaySound("SMG/Reload1", 5)

	RemoveBullets:
		TNT1 AAAA 0
		SMGR A 0 A_JumpIfInventory("BDSMGAmmoOff",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		SMGR A 0 A_Takeinventory("BDSMGAmmoOff",1)
		SMGR A 0 A_Takeinventory("BDDualSMGAmmo",1)
		SMGR A 0 A_Giveinventory("HasUnloadedSMG",1)
		SMGR A 0 A_Giveinventory("HasUnloadedDualSMG",1)		
		SMGR A 0 A_Giveinventory("Clip1",1)
		Goto RemoveBullets
		TNT1 AAAAAAAAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR A 0 //A_Refire
		Goto FinishUnload
		TNT1 AAAA 0
		SMGR A 0 A_Takeinventory("Reloading",1)
		SMGR A 0 //A_Refire
		Goto FinishUnload
	FinishUnload:
		SMGR IJKLMNOO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2MGR ABCDE 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SMGR BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto Ready

	Spawn:
		SMGZ A -1
		Stop

	Steady:
		TNT1 A 1
		Goto Ready

	User3:
	DualWield:
		SMGR A 0 A_Takeinventory("StartDualWield",1)
		VSMG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SMGR A 0 A_JumpIfInventory("IsTacticalClass", 1, "NoDual")
		SMGR A 0 A_JumpIfInventory("HasDualSMG", 1, "GetDual")
		SMGR A 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		SMGR A 0 A_Takeinventory("Zoomed",1)
		SMGR A 0 A_Takeinventory("ADSmode",1)
		SMGR A 0 A_TakeInventory("TossGrenade", 1)
		SMGR A 0 A_TakeInventory("Kicking",1)
		SMGR A 0 A_TakeInventory("Taunting",1)
		SMGR A 0 A_TakeInventory("Reloading",1)
		SMGR A 0 A_TakeInventory("Unloading",1)
		SMGR A 0 A_TakeInventory("Salute1", 1)
		SMGR A 0 A_TakeInventory("Salute2", 1)
		SMGR A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("SwitchDuals", 1)
		SMGG A 0 A_GiveInventory("DualSMG",1)
		SMGR A 0 A_SelectWEapon("DualSMG")
		Goto Ready
	}
}

ACTOR MP40AmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 32
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 32
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_MP40 : MP40
{
	Tag "Off-hand MP40"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType2 "MP40AmmoOff"
	Weapon.AmmoType1 "Mauser9mm"
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "MP40/Draw"
	Inventory.Pickupmessage "$GOTMP40"
	Obituary "$OBBD_MP40"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		MP40 A 0 A_TakeInventory("RSR_Go", 1)
		MP40 A 0 A_GiveInventory("RSR_Start", 1)
		MP40 A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		MP40 A 0 A_TakeInventory("RSR_Go", 1)
		MP40 A 0 A_JumpIfInventory("HasUnloadedMP40", 1, "RSR_Wait")	// no magazine in the gun
		MP40 A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside; they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff", 1, "RSR_Unload1")
		MP40 A 0 A_GiveInventory("HasUnloadedMP40", 1)
		MP40 A 0 A_GiveInventory("HasUnloadedDualMP40", 1)
		Goto RSR_Wait
	RSR_Unload1:
		MP40 A 0 A_TakeInventory("MP40AmmoOff", 1)
		MP40 A 0 A_TakeInventory("DualMP40Ammo", 1)
		MP40 A 0 A_GiveInventory("RSR_Held_MP40", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		MP40 A 0 A_TakeInventory("RSR_Seated", 1)
		MP40 A 0 A_TakeInventory("HasUnloadedMP40", 1)
		MP40 A 0 A_TakeInventory("HasUnloadedDualMP40", 1)
	RSR_Return:		// the held rounds first
		MP40 A 0 A_JumpIfInventory("RSR_Held_MP40", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		MP40 A 0 A_TakeInventory("RSR_Held_MP40", 1)
		MP40 A 0 A_GiveInventory("MP40AmmoOff", 1)
		MP40 A 0 A_GiveInventory("DualMP40Ammo", 1)
		Goto RSR_Return
	RSR_FillGo:
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff", 1, "RSR_FillB")	// the gun was not empty: no handle
		MP40 A 0 A_GiveInventory("MP40ReloadToken", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff", 0, "RSR_Filled")
		MP40 A 0 A_JumpIfInventory("Mauser9mm", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		MP40 A 0 A_GiveInventory("MP40AmmoOff", 1)
		MP40 A 0 A_GiveInventory("DualMP40Ammo", 1)
		MP40 A 0 A_TakeInventory("Mauser9mm", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff", 0, "RSR_Filled")
		MP40 A 0 A_JumpIfInventory("Mauser9mm", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		MP40 A 0 A_GiveInventory("MP40AmmoOff", 1)
		MP40 A 0 A_GiveInventory("DualMP40Ammo", 1)
		MP40 A 0 A_TakeInventory("Mauser9mm", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		MP40 A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		MP40 A 0 A_TakeInventory("RSR_Done", 1)
		MP40 A 0 A_TakeInventory("MP40ReloadToken", 1)
		MP40 A 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_ReFire
		Goto Ready3
	KickFlash:
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		MP40 TUVWX 1
		MP40 X 8
		MP40 XWVUT 1
		stop
	SlideFlash:
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		MP40 TUVWX 1
		MP40 X 35
		stop
	SlideFlashEnd:
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		MP40 X 4
		MP40 XWVUT 1
		stop
	SlideFlashEndEarly: 
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		MP40 X 1
		MP40 XWVUT 1
		stop

	//Let's get the tactical code out of the way first

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedMP40",1)
		MP40 A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		MP40 A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		MP40 TUV 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		MP40 V 0 offset(-9,32)
		//MP40 A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		MP40 A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		MP40 A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		MP40 A 0 offset(-9,32) A_GiveInventory("UsedStamina", 3)
		MP40 A 0 offset(-9,32)
		MP40 W 1 offset(-9,34) A_SetPitch(pitch -0.5)
		MP40 W 1 offset(-6,36) A_SetPitch(pitch -0.5)
		MP40 W 1 offset(-3,38) A_SetPitch(pitch -0.5)
		MP40 W 1 offset(0,38) A_SetPitch(pitch -0.5)
		MP40 W 1 offset(3,36) A_SetPitch(pitch -0.5)
		MP40 W 1 offset(6,34) A_SetPitch(pitch -0.5)
		MP40 W 1 offset(9,32) A_SetPitch(pitch -0.5)
		MP40 A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		MP40 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		MP40 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MP40 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		MP40 A 0 offset(-9,32) A_GiveInventory("UsedStamina", 3)
		MP40 A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		MP40 W 1 offset(9,34) A_SetPitch(pitch +0.5)
		MP40 W 1 offset(6,36) A_SetPitch(pitch +0.5)
		MP40 W 1 offset(3,38) A_SetPitch(pitch +0.5)
		MP40 W 1 offset(0,38) A_SetPitch(pitch +0.5)
		MP40 W 1 offset(-3,36) A_SetPitch(pitch +0.5)
		MP40 W 1 offset(-6,34) A_SetPitch(pitch +0.5)
		MP40 W 1 offset(-9,32) A_SetPitch(pitch +0.5)
		MP40 A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		MP40 A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		MP40 VUT 1
		MP40 A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP40 A 0 A_TakeInventory("TossGrenade", 1)
		MP40 A 0 A_TakeInventory("Kicking",1)
		MP40 A 0 A_TakeInventory("Taunting",1)
		MP40 A 0 A_TakeInventory("Reloading",1)
		MP40 A 0 A_TakeInventory("Unloading",1)
		MP40 A 0 A_TakeInventory("Salute1", 1)
		MP40 A 0 A_TakeInventory("Salute2", 1)
		MP40 A 0 A_Takeinventory("RifleSelected",1)
		MP40 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		MP40 JKLM 1
		TNT1 AAAAAAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 0 A_Lower
		Wait

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		MP40 A 0 A_TakeInventory("DualMP40",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 0 A_GunFlash
		TNT1 A 0 A_GiveInventory("MP40Selected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		MP40 A 0 A_JumpIfInventory("RememberDualMP40", 1, "DualWield")
		MP40 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_TakeInventory("NeverSelectedMP40", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedMP40", 1, "FirstSelectAnimation")
		MP40 A 0 A_PlaySound("MP40/Draw", 5)
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
		Goto SelectAnimation

	SelectDual:
		TNT1 A 0 A_Takeinventory("SwitchDuals",1)
		MP42 VUTS 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("MP40/Draw",5)
		MP42 RQPO 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready3	
	
	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedMP40",1)
		MP40 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		3P4R UV 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		5P4R EFGH 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		3P4R EEEEEEFGHIIJJJJJJJ 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		MP40 A 0 A_PlaySound("MP40/Reload2", 5)
		3P4R KLMNNOOOOOPP 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		2P4R UTRQPO 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		MP4R BA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimation:
		MP40 IHGF 1 A_WeaponReady(WRF_NOFIRE)
		MP40 A 0 A_jUMPiFiNVENTORY("MP40ReloadToken",1,"Bolt")
		MP40 A 0 A_Takeinventory("StartDualWield",1)
	Ready:
	Ready3:
		TNT1 A 0 //ACS_NamedExecuteAlways("AimMode")
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		//MP40 A 0 A_JumpIfInventory("JustLanded",1,"Pinch")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		MP40 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MP40 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		MP40 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		MP40 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		MP40 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MP40 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MP40 A 0 A_JumpIf(0, "DualWield")
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist",1,2)
		MP40 A 0
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		//MP40 A 0 A_JumpIfInventory("JustLanded",1,"Pinch")
		Goto Ready3

	AltFire:
		MP40 A 0
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		MP40 A 0 A_Giveinventory("GoSpecial",1)
		MP40 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		MP40 A 0 A_Giveinventory("Zoomed",1)
		MP40 A 0 A_ZoomFactor(1.3)
		MP40 A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_SetCrosshair(41)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		MP40 NOP 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		MP40 A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		MP40 P 3 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		MP40 P 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		MP40 P 4
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		MP40 NOP 1
		MP40 P 3 A_WeaponReady(1)
		Goto Ready2

	HoldAim:
		MP40 A 0 A_Giveinventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		MP40 P 0 A_JumpIf(0, "DualWield")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		MP40 P 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		MP40 P 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		MP40 P 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		MP40 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		MP40 PON 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		MP40 A 3 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3//+6

	ToggleNoAim:
		MP40 PON 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		MP40 A 3 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3//+6

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		MP40 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_SetCrosshair(41)
		MP40 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MP40 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		MP40 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		MP40 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		MP40 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MP40 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		MP40 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MP40 A 0 A_JumpIf(0, "DualWield")
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,5)
		MP40 A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		MP40 A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		MP40 A 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		TNT1 AAA 0
		MP40 P 1 A_WeaponReady(WRF_ALLOWRELOAD)
		//MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		Loop

	Fire:
		MP40 P 0 A_JumpIfInventory("Zoomed",1,15)
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		MP40 A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("MP40AmmoOff",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("MP40AmmoOff",1)
		"####" "#" 0 A_Takeinventory("DualMP40Ammo",1)
		"####" "#" 0 A_JumpIfInventory("MP40AmmoOff",9,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("MP40AmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_JumpIfInventory("Mauser9mm",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("Mauser9mm",1,TIF_NOTAKEINFINITE)
		"####" "###" 0
	ResumeFireFrame:
		"####" "#" 0 A_Quake(1,3,0,4,"")
		"####" "#" 0 A_PlaySound("MP40/Fire", 1)
		"####" "#" 0 A_PlaySound("FARSHT", 6)
		"####" "#" 0 A_AlertMonsters
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		PP40 A 0 A_JumpIfInventory("IsPlayingAsPurist",1,2)
		MP40 A 0
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)		
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" B 1 BRIGHT A_FireBullets (3, 1.5, -1, 18, "WeakPuff", FBF_NORANDOM)
		"####" "#" 0 A_ZoomFactor(0.99)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		"####" A 0 A_SetPitch(pitch-1.2)
		"####" D 1 A_FireCustomMissile("PistolCaseSpawn",-5,0,8,-4)
		"####" E 1 A_ZoomFactor(1.0)
		"####" A 1
		"####" A 0 A_Refire
		Goto Ready3//+6
	
	DM:
		"####" B 1 BRIGHT A_FireBullets (3, 1.5, -1, 18, "WeakPuffDM", FBF_NORANDOM)
		Goto ResumeFireFrame+12

	IsHolding:
		MP40 P 0 A_JumpIfInventory("ZoomHold", 1, 4)
		MP40 P 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+16
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("MP40AmmoOff",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim

	Fire2:
		MP40 A 0
		MP40 A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)		
		MP40 A 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, 0)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		MP40 Q 1 BRIGHT A_FireBullets (1.5, 1.5, -1, 18, "WeakPuff", FBF_NORANDOM)
		TNT1 A 0 A_ZoomFactor(1.28) 
		MP40 A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		MP40 A 0 A_SetPitch(pitch-0.8)
		MP40 A 0
		MP40 R 1 A_FireCustomMissile("PistolCaseSpawn",-5,0,8,-4)
		MP40 S 1 A_ZoomFactor(1.3)
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		MP40 A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		MP40 AAA 0
		MP40 A 0
		MP40 P 1 
		MP40 P 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		MP40 A 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		TNT1 AAA 0
		MP40 P 1 A_Refire
		MP40 P 5 A_WeaponReady(1)
		MP40 A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		MP40 A 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		Goto Ready2
	
	DM2:
		MP40 Q 1 BRIGHT A_FireBullets (1.5, 1.5, -1, 18, "WeakPuffDM", FBF_NORANDOM)
		Goto Fire2+6

	ReloadAfterUnload:
		MP4R AB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		3P4R QRST 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadAfterUnload2

	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("Mauser9mm",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready//NoAmmo
		TNT1 AAA 0
		MP40 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 1 A_WeaponReady(WRF_NOFIRE)
		MP40 A 0 A_Takeinventory("Reloading",1)
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_JumpIfinventory("MP40ReloadToken",1,"Fidget")
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff",0,"Fidget")
		
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_GiveInventory ("Pumping", 1)
		MP40 A 0 A_Takeinventory("Reloading",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		MP40 A 0 A_JumpIfInventory("HasUnloadedMP40", 1, "ReloadAfterUnload")
		MP40 A 0
		RIFG A 0 A_JumpIfInventory("MP40AmmoOff",1,"ReloadNotEmpty")//30+1 effect
		MP4R ABCDEFFGGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("MP40/Bolt1", 5)
		MP4R HIIJKKKKLLMNOOPQ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("Weapon/Empty", 5)
		MP4R QQRSTUUVVV 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_PlaySound("MP40/Reload1", 5)
		MP4R WWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
		MP4R "[\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2P4R AB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	ReloadAfterUnload2:
		2P4R CCCCCCDEFGHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_GiveInventory("MP40ReloadToken",1)
		MP40 A 0 A_PlaySound("MP40/Reload2", 5)
		Goto InsertBullets
	FullReload:
		2P4R IJKL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_Takeinventory("HasUnloadedMP40",1)
		MP40 A 0 A_TakeInventory("HasUnloadedDualMP40",1)
		MP4R VVVVVVU 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2P4R N 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP4R POONMLLKKKK 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_PlaySound("MP40/Bolt2", 5)
		TNT1 A 0 A_TakeInventory("MP40ReloadToken",1)
		MP4R JIIHGGGFFEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 0 A_ReFire
		Goto Ready3//+6

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	ReloadNotEmpty:
		MP4R AB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2P4R OPQRR 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("Weapon/Empty", 5)
		2P4R SSSTUVWXXXY 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_PlaySound("MP40/Reload1", 5)
		2P4R Z 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2P4R "[\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_FireCustomMissile("EmptyClip2Spawn",-5,0,8,-4)
		3P4R ABCDEEEEEEEFGHIIJJJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_PlaySound("MP40/Reload2", 5)
	InsertBullets:
		TNT1 AAAA 0
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff",0,15)
		MP40 A 0 A_JumpIfInventory("Mauser9mm",1,4)
		MP40 A 0 A_JumpIfInventory("MP40ReloadToken",1,"FullReload")
		Goto ContinueReloading
		TNT1 AAAAAA 0
		MP40 A 0 A_Giveinventory("MP40AmmoOff",1)
		MP40 A 0 A_Giveinventory("DualMP40Ammo",1)
		MP40 A 0 A_Takeinventory("HasUnloadedMP40",1)
		MP40 A 0 A_TakeInventory("HasUnloadedDualMP40",1)
		MP40 A 0 A_Takeinventory("Mauser9mm",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		MP40 A 0 A_Takeinventory("Reloading",1)
		MP40 A 0 A_JumpIfInventory("MP40ReloadToken",1,"FullReload")
		Goto ContinueReloading
		TNT1 AAAA 0
		MP40 A 0 A_Takeinventory("Reloading",1)
		MP40 A 0 A_JumpIfInventory("MP40ReloadToken",1,"FullReload")
		Goto ContinueReloading
	ContinueReloading:
		3P4R KLMNNOOOOP 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2P4R UTRQPO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP4R BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 0 A_ReFire
		Goto Ready3//+6

	Fidget:
		MP40 A 0 A_JumpIfInventory("DoInspect",1,"ContinueFidget")
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueFidget")
		MP40 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		MP40 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		MP40 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		MP40 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		MP40 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		MP40 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		MP40 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		MP40 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		MP40 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		MP40 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		MP40 A 0 A_JumpIf(0, "DualWield")
		MP40 A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		MP40 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		MP40 AAA 0
		MP40 A 6 A_WeaponReady(WRF_ALLOWZOOM)
		MP40 A 0 A_GiveInventory("DoInspect",1)
		MP40 A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		MP40 A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueFidget:
		TNT1 AA 0
		RIFG A 0 A_TakeInventory("DoInspect",1)
		MP40 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP4R ABCDEFFGGG 1 A_WeaponReady(WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("MP40/Bolt1", 5)
		MP4R HIIJKKKKK 1 A_WeaponReady(WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("MP40/Bolt2", 5)
		MP4R JIIHGGGFFEDCBA 1 A_WeaponReady(WRF_ALLOWZOOM)
		MP40 A 0 A_Takeinventory("IsInspecting",1)
		MP40 A 0 A_Takeinventory("Reloading",1)
		Goto Ready3

	Bolt:
		MP40 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 0 A_Takeinventory("ZoomHold",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP4R ABCDEFFGGG 1 A_WeaponReady(WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("MP40/Bolt1", 5)
		MP4R HIIJKKKKK 1 A_WeaponReady(WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("MP40/Bolt2", 5)
		MP40 A 0 A_TakeInventory("MP40ReloadToken",1)
		MP4R JIIHGGGFFEDCBA 1 A_WeaponReady(WRF_ALLOWZOOM)
		MP40 A 0 A_Takeinventory("IsInspecting",1)
		MP40 A 0 A_Takeinventory("Reloading",1)
		Goto Ready3

	User2:
	Unload:
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpifInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("MP40AmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		MP40 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 0 A_Takeinventory("Unloading",1)
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP4R ABCDEFFGGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("MP40/Bolt1", 5)
		MP4R HIIJKKKKLLMNOOPQ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SOUN D 0 A_PlaySound("Weapon/Empty", 5)
		MP4R QQRSTUUVVV 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_PlaySound("MP40/Reload1", 5)
		MP40 A 0 A_GiveInventory ("Pumping", 1)
		MP40 A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		MP40 A 0 A_JumpIfInventory("MP40AmmoOff",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		MP40 A 0 A_Takeinventory("MP40AmmoOff",1)
		MP40 A 0 A_Takeinventory("DualMP40Ammo",1)
		MP40 A 0 A_GiveInventory("HasUnloadedMP40", 1)
		MP40 A 0 A_GiveInventory("HasUnloadedDualMP40", 1)
		MP40 A 0 A_Giveinventory("Mauser9mm",1)
		Goto RemoveBullets
	FinishUnload:
		MP4R WWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP4R "[\]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2P4R ABBBBB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		3P4R TTSRQ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP4R BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		MP40 A 0 A_Takeinventory("Unloading",1)
		Goto Ready3//+6

	User3:
	DualWield:
		MP40 A 0 A_Takeinventory("StartDualWield",1)
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		MP40 A 0 A_JumpIfInventory("IsTacticalClass", 1, "NoDual")
		MP40 A 0 A_JumpIfInventory("HasDualMP40", 1, "GetDual")
		MP40 A 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		MP40 A 0
		MP40 A 0 A_Takeinventory("Zoomed",1)
		MP40 A 0 A_Takeinventory("ADSmode",1)
		MP40 A 0 A_TakeInventory("TossGrenade", 1)
		MP40 A 0 A_TakeInventory("Kicking",1)
		MP40 A 0 A_TakeInventory("Taunting",1)
		MP40 A 0 A_TakeInventory("Reloading",1)
		MP40 A 0 A_TakeInventory("Unloading",1)
		MP40 A 0 A_TakeInventory("Salute1", 1)
		MP40 A 0 A_TakeInventory("Salute2", 1)
		MP40 A 0 A_ZoomFactor(1.0)
		MP40 A 0 A_Giveinventory("SwitchDuals",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 17) )
		MP40 A 0 A_Giveinventory("DualMP40",1)
		MP40 A 0 A_SelectWEapon("DualMP40")
		Goto Ready

	Spawn:
		MP40 Y -1
		Stop
	}
}

ACTOR RifleAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 31
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 31
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_Rifle : Rifle
{
	Tag "Off-hand Rifle"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "Clip2"
	Weapon.AmmoType2 "RifleAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "$GOTRIFLE"
	Obituary "$OBBD_RIFLE"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		RIFG A 0 A_TakeInventory("RSR_Go", 1)
		RIFG A 0 A_GiveInventory("RSR_Start", 1)
		RIFG A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		RIFG A 0 A_TakeInventory("RSR_Go", 1)
		RIFG A 0 A_Takeinventory("Reloading", 1)
		RIFG A 0 A_GiveInventory("Pumping", 1)		// BD22: the player sprite's reload
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle", 1, "RSR_Wait")	// no magazine in the gun
		RIFG A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (Rifle/Reload1)
	RSR_Unload:		// its rounds are held aside (a chambered round stays); they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends (30 + 1), and the reserve's cap loses none
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff", 2, "RSR_Unload1")
		RIFG A 0 A_GiveInventory("HasUnloadedRifle", 1)
		RIFG A 0 A_GiveInventory("HasUnloadedDualRifles", 1)
		Goto RSR_Wait
	RSR_Unload1:
		RIFG A 0 A_TakeInventory("RifleAmmoOff", 1)
		RIFG A 0 A_TakeInventory("DoubleRifleAmmo", 1)
		RIFG A 0 A_GiveInventory("RSR_Held_Rifle", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own InsertBullets / InsertBullets2
		RIFG A 0 A_TakeInventory("RSR_Seated", 1)
		RIFG A 0 A_TakeInventory("HasUnloadedRifle", 1)
		RIFG A 0 A_TakeInventory("HasUnloadedDualRifles", 1)
	RSR_Return:		// the held rounds first
		RIFG A 0 A_JumpIfInventory("RSR_Held_Rifle", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		RIFG A 0 A_TakeInventory("RSR_Held_Rifle", 1)
		RIFG A 0 A_GiveInventory("RifleAmmoOff", 1)
		RIFG A 0 A_GiveInventory("DoubleRifleAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff", 1, "RSR_Fill31")
		RIFG A 0 A_GiveInventory("RifleReloadToken", 1)	// no round chambered: the handle (BD22: FinishReloading)
	RSR_Fill30:
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff", 30, "RSR_Filled")
		RIFG A 0 A_JumpIfInventory("Clip2", 1, "RSR_Fill30a")
		Goto RSR_Filled
	RSR_Fill30a:
		RIFG A 0 A_GiveInventory("RifleAmmoOff", 1)
		RIFG A 0 A_GiveInventory("DoubleRifleAmmo", 1)
		RIFG A 0 A_TakeInventory("Clip2", 1, TIF_NOTAKEINFINITE)
		Goto RSR_Fill30
	RSR_Fill31:
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff", 0, "RSR_Filled")
		RIFG A 0 A_JumpIfInventory("Clip2", 1, "RSR_Fill31a")
		Goto RSR_Filled
	RSR_Fill31a:
		RIFG A 0 A_GiveInventory("RifleAmmoOff", 1)
		RIFG A 0 A_GiveInventory("DoubleRifleAmmo", 1)
		RIFG A 0 A_TakeInventory("Clip2", 1, TIF_NOTAKEINFINITE)
		Goto RSR_Fill31
	RSR_Filled:
		RIFG A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if RifleReloadToken, else done
		Goto RSR_Wait
	RSR_Done:
		RIFG A 0 A_TakeInventory("RSR_Done", 1)
		RIFG A 0 A_TakeInventory("RifleReloadToken", 1)
		RIFG A 0 A_Takeinventory("Reloading", 1)
		Goto ReloadConcluded		// BD22's own end of a reload
	KickFlash: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		RIFG JKLM 1
		RIFG N 10
		RIFG MLKJ 1
		stop
	SlideFlash: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		RIFG JKLM 1
		RIFG N 35
		stop
	SlideFlashEnd: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		RIFG N 5
		RIFG MLKJ 1
		stop
	SlideFlashEndEarly: 
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		RIFG N 2
		RIFG MLKJ 1
		stop

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedRifle",1)
		RIFG A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		RIFG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		RIFG JKL 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		RIFG A 0
		RISP A 0 offset(-9,32)
		//RIFG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		RIFG A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		RIFG A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		RIFG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RIFG A 0 offset(-9,32)
		RIFG M 1 offset(-9,34) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(-6,36) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(-3,38) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(0,38) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(3,36) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(6,34) A_SetPitch(pitch -0.5)
		RIFG M 1 offset(9,32) A_SetPitch(pitch -0.5)
		RIFG A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RIFG A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		RIFG M 1 offset(9,34) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(6,36) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(3,38) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(0,38) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(-3,36) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(-6,34) A_SetPitch(pitch +0.5)
		RIFG M 1 offset(-9,32) A_SetPitch(pitch +0.5)
		RIFG A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		RIFG A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		RIFG LKJ 1
		RIFG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	Select:
		TNT1 A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_TakeInventory("DualRifles", 1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 A_GunFlash
		TNT1 A 0 A_Giveinventory("RifleSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		Goto FirstSelectAnimation

	SelectDual:
		TNT1 A 0 A_Takeinventory("SwitchDuals",1)
		DURR QPON 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		DURR MLKJ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		Goto Ready3

	SelectAnimation:
		/*TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		TNT1 A 0 A_Takeinventory("BDWeaponAction",1)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")*/
		RIFG IHGF 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 a_jumpifinventory("RifleReloadToken",1,"SelectRechamber")
		TNT1 A 0 A_Takeinventory("StartDualWield",1)
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		Goto Ready3

	WarmUp:
		RIFG A 0 A_TakeInventory("JustStartedGame", 1)
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 5 A_WeaponReady(WRF_ALLOWZOOM)
		PUNS ABCD 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFG A 0 A_PlaySound("Melee/Reload", 5)
		PUNS E 7 A_WeaponReady(WRF_ALLOWZOOM)
		PUNS FGFE 3 A_WeaponReady(WRF_ALLOWZOOM)
		PUNS DCB 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto TacticalSelect

	FirstSelectAnimation:
		// A 0 A_TakeInventory("NeverSelectedRifle",1)
		TNT1 A 0 A_TakeInventory("JustStartedGame", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("JustStartedGame",1,"WarmUp")
		TNT1 A 0 A_PlaySound("Rifle/Select", 5)
		TNT1 A 0 A_Takeinventory("BDWeaponAction",1)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("JustStartedGame", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("JustStartedGame", 1,"warmUp")
		TNT1 A 0 A_TakeInventory("NeverSelectedRifle", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedRifle", 1,2)
		Goto SelectAnimation
		tnt1 AA 0
		TNT1 A 4 A_WeaponReady(WRF_ALLOWZOOM)
	Tacticalselect:
		TNT1 A 0 A_TakeInventory("NeverSelectedRifle",1)
		TNT1 A 5 A_WeaponReady(WRF_ALLOWZOOM)
		3IFR ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR GG 1  A_WeaponReady(WRF_ALLOWZOOM)
		RIFR H 2 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR IJKLMNNO 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		RIFR OONPQRSTUU 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR VVVWXYZ 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR "[" 1 A_WeaponReady(WRF_ALLOWZOOM)
		RIFR B 1 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR ABCDEFG 1 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR H 3 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		2IFR IJJJ 1 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		2IFR KKLMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready3

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 //ACS_NamedExecuteAlways("AimMode")
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIf(0, "DualWield")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFG A 0
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RI2G A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RI2G A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_TakeInventory("RFGrenade",1)
		RI2G A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RI2G A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RI2G A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RI2G A 0 A_JumpIf(0, "DualWield")
		//RI2G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		TNT1 AAA 0
		//RIFG A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//RIFG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		RI2G A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RI2G A 0 A_TakeInventory("UsedStamina", 2)
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	Deselect:
		RIFG A 0 A_TakeInventory("BurstCounter", 0x7FFFFFFF)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_TakeInventory("TossGrenade", 1)
		RIFG A 0 A_TakeInventory("Kicking",1)
		RIFG A 0 A_TakeInventory("Taunting",1)
		RIFG A 0 A_TakeInventory("Reloading",1)
		RIFG A 0 A_TakeInventory("Unloading",1)
		RIFG A 0 A_TakeInventory("Salute1", 1)
		RIFG A 0 A_TakeInventory("Salute2", 1)
		RIFG A 0 A_Takeinventory("RifleSelected",1)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		SMGR A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		RIFG EDCB 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		RI2G A 0 A_JumpIfInventory("Zoomed",1,16)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFG A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" A 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("RifleAmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("RifleAmmoOff",1)
		"####" "#" 0 A_Takeinventory("DoubleRifleAmmo",1)
		"####" "#" 0 A_JumpIfInventory("RifleAmmoOff",9,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("RifleAmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("Clip2",1,1)
		Goto NoAmmo
		"####" "###" 0
		"####" "#" 0 A_Takeinventory("Clip2",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" AAAA 0
		2IFF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFF A 0
		"####" A 0 A_AlertMonsters
		"####" A 0 A_FireCustomMissile("DistantFireSoundRifle", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_PlaySound("Rifle/Fire", 1)
		"####" "#" 0 A_Quake(1,3,0,4,"")
		"####" A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" "#" 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" "#" 0 A_FireCustomMissile("DecorativeTracer", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant")
		"####" A 0 A_GiveInventory("PSeq3",1)
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuff", FBF_NORANDOM)
		Goto FinishFire
	SpriteVariant:
		"####" D 0 A_TakeInventory("PSeq3",1)
		"####" D 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuff", FBF_NORANDOM)
	FinishFire:
		"####" B 0 A_FireCustomMissile("RifleCaseSpawn",5,0,6,-14)
		"####" B 0 A_ZoomFactor(0.98)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)//tactical mode has muzzle climb
		"####" A 0 A_SetPitch(pitch-2.0)
		"####" B 1 
		"####" C 1 A_ZoomFactor(1.0)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RIFG A 0
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, "Ready")//Tactical mode skips a frame, fires faster
		"####" A 1 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		"####" A 0 A_Refire
		Goto Ready
	
	DM:
		"####" A 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuffDM", FBF_NORANDOM)
		Goto FinishFire
	SpriteVariant:
		"####" D 0 A_TakeInventory("PSeq3",1)
		"####" D 1 BRIGHT A_FireBullets (1.0, 1.0, -1, 20, "HitPuffDM", FBF_NORANDOM)
		Goto FinishFire

	IsHolding:
		RI2G A 0 A_JumpIfInventory("ZoomHold", 1, 4)
		RIFG A 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+15
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RifleAmmoOff",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim
		
	Fire2:
		RIFG A 0
		//RIFF A 0 A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0)
		RIFG A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		RI2F A 0 BRIGHT A_FireCustomMissile("DecorativeTracer", 0, 0, 0, 0)
		RI2F A 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant2")
		RI2F A 0 A_GiveInventory("PSeq3",1)		
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		RI2F A 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuff", FBF_NORANDOM)
		Goto FinishFire2
	SpriteVariant2:
		RI2F D 0 A_TakeInventory("PSeq3",1)		
		RI2F D 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuff", FBF_NORANDOM)	
	FinishFire2:	
		RIFG A 0 A_ZoomFactor(1.9)
		RIFG A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 2)
		RIFG A 0 A_SetPitch(pitch-1.0)
		RI2F B 1 A_FireCustomMissile("RifleCaseSpawn",1,0,8,0)
		RI2F C 1 A_ZoomFactor(2.0)
		RIFG A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		RI2G A 1
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")//This allows for more responsiveness when AimMode is set to "both"
		RIFG AAA 0
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		RI2F A 0 A_GiveInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		TNT1 AAA 0
		RI2G A 0 A_ReFire
		RI2G A 10 A_WeaponReady(1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RI2G A 0
		Goto Ready2
	
	DM2:
		RI2F A 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuffDM", FBF_NORANDOM)
		Goto FinishFire2
	SpriteVariant2:
		RI2F D 0 A_TakeInventory("PSeq3",1)		
		RI2F D 1 BRIGHT A_FireBullets (0.2, 0.2, -1, 20, "HitPuffDM", FBF_NORANDOM)	
		Goto FinishFire2



	FireGrenade:
		TNT1 A 0 A_JumpIf(OverlayID() == 1000000, "RSM_FireOff")	// 1.30 rsm: the off hand's launcher
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_JumpIfInventory("RFGLoaded", 1, 1)
		Goto RSM_NotLoaded
		TNT1 A 0
		//RIFG A 0 A_JumpIfInventory("AmmoRocket", 1, 1)//check for reserve rocketammo
		//Goto NoAmmoGrenade
		//TNT1 A 0
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_GiveInventory("FiredMGGrenade",1)
		//RIFG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")//check for a spent grenade in chamber
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		TNT1 A 0 A_AlertMonsters
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"FireGrenade2")
		RIFG A 0 A_ZoomFactor(0.98)
		GLAN A 0 A_PlaySound("GrenadeLauncher/Fire", 1)
		//RIFG A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		RIFG A 0 BRIGHT A_FireCustomMissile("ShortGrenade", 0, 0, 0, 0)
		TNT1 A 0 A_GiveInventory("FiredMGGrenade",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFF E 1 BRIGHT
		RIFF FGHI 1
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		//RIFG A 0 A_JumpIfInventory("NoAutoReload",1,"Ready3")
		Goto Ready3//ReloadGrenade

	FireGrenade2:
		TNT1 A 0
		RIFG A 0 A_ZoomFactor(1.98)
		GLAN A 0 A_PlaySound("GrenadeLauncher/Fire", 1)
		//RI2G A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		RI2F A 0 BRIGHT A_FireCustomMissile("ShortGrenade", 0, 0, 0, 0)
		RIFG A 0 A_GiveInventory("FiredMGGrenade", 1)
		RIFG A 0 A_ZoomFactor(2.0)
		RI2F E 1 BRIGHT
		RI2F FGH 1
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_TakeInventory("TossGrenade",1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		//RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,"Ready2")
		//RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		//RIFG A 0 A_JumpIfInventory("ZoomHold", 1, "NoAim")
		RIFG A 0 A_JumpIfInventory("NoAutoReload",1,"HoldAim")
		RIFG AA 0 
		Goto Ready2//ReloadGrenade

	// 1.30 rsm (zscript/rsr/rsr_m203.zs): in VR with real reload the launcher is loaded by hand
	// (the tube slid forward, a round put in, the tube pulled back); empty, its trigger only clicks.
	// The off hand's launcher (dual) fires from its own round (RSM_LoadedOff).
	RSM_NotLoaded:
		TNT1 A 0 A_JumpIfInventory("RSM_VR", 1, "RSM_Dry")
		Goto ReloadGrenade
	RSM_Dry:
		RIFG A 0 A_TakeInventory("RFGrenade", 1)
		RIFG A 0 A_StartSound("Weapon/Empty", CHAN_AUTO)
	RSM_DryHold:	// one click a press: wait for secondary fire to be let go
		RIFG A 1
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("FiredSecondary") > 0, "RSM_DryHold")
		Goto Ready3
	RSM_AltGrenade:
		RIFG A 0 A_JumpIf(OverlayID() == 1000000, "RSM_FireOff")
		RIFG A 0 A_JumpIfInventory("RFGLoaded", 1, "FireGrenade")
		Goto RSM_NotLoaded
	RSM_FireOff:
		TNT1 A 0 A_TakeInventory("RFGrenadeOff", 1)
		TNT1 A 0 A_JumpIfInventory("RSM_LoadedOff", 1, 1)
		Goto RSM_DryOff
		TNT1 A 0 A_TakeInventory("RSM_LoadedOff", 1)
		TNT1 A 0 A_GiveInventory("RSM_FiredOff", 1)
		TNT1 A 0 A_AlertMonsters
		GLAN A 0 A_StartSound("GrenadeLauncher/Fire", CHAN_AUTO)
		RIFG A 0 BRIGHT A_FireCustomMissile("ShortGrenade", 0, 0, 0, 0)
		RIFF E 1 BRIGHT
		RIFF FGHI 1
		Goto Ready3
	RSM_DryOff:
		RIFG A 0 A_StartSound("Weapon/Empty", CHAN_AUTO)
	RSM_DryOffHold:
		RIFG A 1
		RIFG A 0 A_JumpIf(OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0, "RSM_DryOffHold")
		Goto Ready3

	ReloadGrenadeSelect:
		TNT1 A 0
		//TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		RIFG A 0 A_JumpIfInventory("AmmoRocket", 1, 2)//check for reserve rocketammo
		Goto NoAmmoGrenade+2
	ReloadGrenade:
		TNT1 AA 0
		//TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		RIFG A 0 A_JumpIfInventory("AmmoRocket", 1, 1)//check for reserve rocketammo
		Goto NoAmmoGrenade
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIGL ABC 1
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle",1,"ReloadGrenadeUnloaded")
		RIGL DEFGGHH 1
		HBUS A 0 A_PlaySound("Rifle/Grenade1", 5)
		TNT1 A 0 A_SpawnItemEX("GrenadeCasing",2,0,40,0,0,-4,0)//A_CustomMissile("GrenadeCasing",0,30,random(-3,3), 2 ,random(-80,-90))
		RIGL IJJJJKLMNO 1
		RIGL P 4
		RIGL QRSTUUVVV 1
		HBUS A 0 A_PlaySound("GrenadeLauncher/Load", 5)
		TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		RIGL WXYYYYZZ 1
		RIG2 ABCDEE 1
		TNT1 A 0 A_GiveInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		HBUS A 0 A_PlaySound("Rifle/Grenade2", 5)
		RIGL IHHHHGGFEDCBA 1 A_WEaponReady(WRF_NOFIRE)
		RIFG A 0 A_ZoomFactor(1.0)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_TakeInventory("TossGrenade",1)
		Goto Ready3

	ReloadGrenadeUnloaded:
		TNT1 A 0
		1IGL DEFGGHH 1
		HBUS A 0 A_PlaySound("Rifle/Grenade1", 5)
		TNT1 A 0 A_SpawnItemEX("GrenadeCasing",2,0,40,0,0,-4,0)//A_CustomMissile("GrenadeCasing",0,30,random(-3,3), 2 ,random(-80,-90))
		1IGL IJJJJKLMNO 1
		1IGL P 4
		1IGL QRSTUUVVV 1
		HBUS A 0 A_PlaySound("GrenadeLauncher/Load", 5)
		TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		1IGL WXYYYYZZ 1
		1IG2 ABCDEE 1
		TNT1 A 0 A_GiveInventory("RFGLoaded",1)
		RI2G A 0 A_TakeInventory("AmmoRocket",1,TIF_NOTAKEINFINITE)
		HBUS A 0 A_PlaySound("Rifle/Grenade2", 5)
		1IGL IHHHHGGFED 1 A_WEaponReady(WRF_NOFIRE)
		RIGL CBA 1 A_WEaponReady(WRF_NOFIRE)
		RIFG A 0 A_ZoomFactor(1.0)
		RI2G A 0 A_TakeInventory("RFGrenade",1)
		TNT1 A 0 A_TakeInventory("TossGrenade",1)
		Goto Ready3

	NoAmmoGrenade:
		RIFG A 1
		RIFG A 0 A_Print("Out of explosive ammo.")
		TNT1 A 0 A_TakeInventory("RFGrenade",1)
		//TNT1 A 0 A_TakeInventory("FiredMGGrenade",1)
		TNT1 A 0 A_TakeInventory("RFGLoaded",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 1
		Goto Ready3

	AltFire:
		RIFG A 0
		RIFG A 0 A_Jump(256, "RSM_AltGrenade")	// 1.33 rsm (owner): the rifle's secondary fire launches the underbarrel
		2IFG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		RIFG A 0 A_TakeInventory("FiredMGGrenade",1)
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		RIFG A 0 A_Giveinventory("GoSpecial",1)
		RIFG A 0 A_Giveinventory("Zoomed",1)
		//RIFG A 0 A_Takeinventory("IsInspecting",1)
		TNT1 A 0 A_SetCrosshair(41)
		RIFG A 0 A_ZoomFactor(2.0)
		RIFG A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		RIFZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("weapons/rifle/move")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RIFG A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		RI2G A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RI2G A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		RI2G A 4
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		RIFZ ABC 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		RI2G A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		RIFG A 0
		RIFG A 0 A_GiveInventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RI2G A 0 A_JumpIfInventory("TossGrenade",1,"FireGrenade")
		RI2G A 0 A_JumpIf(0, "DualWield")
		//TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2G A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RI2F A 0 A_TakeInventory("FireFrameCount", 1)
		//RIFG A 0 A_JumpIfInventory("NoAutoReload",1,2)
		//RIFG A 0 A_JumpIfInventory("FiredMGGrenade", 1, "ReloadGrenade")
		RIFG AA 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 0
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		RIFZ BA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	ToggleNoAim:
		RIFZ BA 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready3

	//Inspecting anim (also repurposed as rechambering)
	Inspect:
		RIFG A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		TNT1 A 0 A_TakeInventory("RFGrenade", 1)	// 1.33 rsm (owner): BD22's launcher key does nothing; secondary fire is the launcher
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFG A 0 A_JumpIf(0, "DualWield")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RIFG A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		TNT1 AAA 0
		RIFG A 6 A_WeaponReady(WRF_ALLOWZOOM)
		RIFG A 0 A_GiveInventory("DoInspect",1)
		RIFG A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RIFG A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		RIFG A 0 A_TakeInventory("DoInspect",1)
		2IFR POB 1 A_WeaponReady(WRF_ALLOWZOOM)
	Inspect2:
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		2IFR CDEFG 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		2IFR H 5 A_WeaponReady(WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR IIJJ 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		2IFR J 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		2IFR KKLM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR N 4 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOBOB | WRF_ALLOWZOOM| WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR NOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		RIFG A 0 A_TakeInventory("DoInspect",1)
		2IFR POB 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		TNT1 A 0 A_Takeinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		TNT1 A 0 A_Takeinventory("ADSmode",1)
		2IFR CDEFG 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		2IFR H 5 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR IIJJ 1
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		2IFR J 2 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		2IFR KKLM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2IFR N 4 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		2IFR NOP 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready
	FullReload:
		RIFG A 0 A_ClearReFire
		RIFR STUU 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_Takeinventory("HasUnloadedRifle",1)
		RIFG A 0 A_Takeinventory("HasUnloadedDualRifles",1)
		RIFR VVVWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR "[" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR BA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	Reload:
		"####" "#" 0 A_TakeInventory("RifleSpread", 10)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("Clip2",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		TNT1 AAA 0
		"####" "#" 0 A_JumpIfInventory("HoldInspect", 1, "InspectHold")
		"####" "#" 0 A_JumpIfInventory("IsInspecting", 1, "Inspect2")
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff",0,"Inspect")
		RIFG A 0 A_JumpIfInventory("RifleReloadToken",1,"Inspect")
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		//RIFG A 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ZoomHold",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle", 1, 2)
		RIFG A 0 A_PlaySound("Rifle/Reload1", 5)
		RIFG A 0 A_GiveInventory ("Pumping", 1)
		RIFG A 0 A_Takeinventory("Reloading",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RIFR ABCDEFGG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_JumpIfInventory("HasUnloadedRifle", 1, 2)
		RIFR G 0 A_FireCustomMissile("EmptyClipSpawn",-5,0,8,-4)
		RIFR H 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR IJKLMNNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR A 0 A_PlaySound("Rifle/Reload2", 5)
		RIFR OONPQR 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff",1,"InsertBullets2")//30+1 effect
		TNT1 A 0 A_GiveInventory("RifleReloadToken",1)
		Goto InsertBullets

	FinishReloading:
		RIFG A 0 A_ClearReFire
		RIFR STUU 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR VVVWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR "[" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RIFR B 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR ABCDEFG 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR H 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt1", 5)
		2IFR IJJJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2IFR A 0 A_PlaySound("Rifle/Bolt2", 5)
		TNT1 A 0 A_TakeInventory("RifleReloadToken",1)
		2IFR KKLMNOP 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded

	InsertBullets:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff",30,15)
		RIFG A 0 A_JumpIfInventory("Clip2",1,3)
		Goto FinishReloading
		TNT1 AAAAAA 0
		RIFG A 0 A_Giveinventory("RifleAmmoOff",1)
		RIFG A 0 A_Giveinventory("DoubleRifleAmmo",1)
		RIFG A 0 A_Takeinventory("HasUnloadedRifle",1)
		RIFG A 0 A_Takeinventory("HasUnloadedDualRifles",1)		
		RIFG A 0 A_Takeinventory("Clip2",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto FinishReloading
		TNT1 AAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire
		Goto FinishReloading

	InsertBullets2:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff",0,15)
		RIFG A 0 A_JumpIfInventory("Clip2",1,3)
		Goto FullReload
		TNT1 AAAAAA 0
		RIFG A 0 A_Giveinventory("RifleAmmoOff",1)
		RIFG A 0 A_Giveinventory("DoubleRifleAmmo",1)
		RIFG A 0 A_Takeinventory("Clip2",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire
		Goto FullReload
		TNT1 AAAA 0
		RIFG A 0 A_Takeinventory("Reloading",1)
		RIFG A 0 //A_Refire
		Goto FullReload

	ReloadConcluded:
		RIFG A 0
		"####" "#" 0 A_TakeInventory("RifleReloadToken",1)
		RIFG A 0 A_Refire
		Goto Ready3

	User2:
	Unload:
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("RifleAmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		RIFG A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 7) )
		RIFG A 0 A_Takeinventory("Unloading",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFR AB 1
		RIFR "[" 1
		RIFR ZYXWVVV 1
		RIFG A 0 A_PlaySound("Rifle/Reload1", 5)
		RIFG A 0 A_GiveInventory ("Pumping", 1)
		RIFG A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		RIFG A 0 A_JumpIfInventory("RifleAmmoOff",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		RIFG A 0 A_Takeinventory("RifleAmmoOff",1)
		RIFG A 0 A_Takeinventory("DoubleRifleAmmo",1)
		RIFG A 0 A_GiveInventory("HasUnloadedRifle", 1)
		RIFG A 0 A_Giveinventory("HasUnloadedDualRifles",1)		
		RIFG A 0 A_Giveinventory("Clip2",1)
		Goto RemoveBullets
	FInishUnload:
		RIFR QONNMLKJIHGFEDCBA 1
		RIFG A 0 A_Takeinventory("Unloading",1)
		Goto Ready3

	Spawn:
		RIFL A -1
		Stop

	User3:
	DualWield:
		RIFG A 0
		RIFG A 0 A_Takeinventory("StartDualWield",1)
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		RIFG A 0 A_JumpIfInventory("IsTacticalClass", 1, "FireGrenade")//Tactical mode cant dual, but firing grenade
		RIFG A 0 A_JumpIfInventory("HasDualRifle", 1, "GetDual")
		RIFG A 0 A_Print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		RIFG A 0 A_Takeinventory("Zoomed",1)
		RIFG A 0 A_Takeinventory("ADSmode",1)
		RIFG A 0 A_TakeInventory("TossGrenade", 1)
		RIFG A 0 A_TakeInventory("Kicking",1)
		RIFG A 0 A_TakeInventory("Taunting",1)
		RIFG A 0 A_TakeInventory("Reloading",1)
		RIFG A 0 A_TakeInventory("Unloading",1)
		RIFG A 0 A_TakeInventory("Salute1", 1)
		RIFG A 0 A_TakeInventory("Salute2", 1)
		RIFG A 0 A_Giveinventory("DualRifles",1)
		RIFG A 0 A_Giveinventory("SwitchDuals",1)
		RIFG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_SelectWEapon("DualRifles")
		Goto Ready
	}
}

ACTOR PlasmaAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 50
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 50
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_Plasma_Gun : Plasma_Gun
{
	Tag "Off-hand Plasma rifle"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "AmmoCell"
	Weapon.AmmoType2 "PlasmaAmmoOff"
	-WEAPON.NOAUTOFIRE
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Plasma/Draw"
	Inventory.PickupMessage "$GOTPLASMA"
	Obituary "$OBBD_PLASMA"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		PRSG F 0 A_TakeInventory("RSR_Go", 1)
		PRSG F 0 A_GiveInventory("RSR_Start", 1)
		PRSG F 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		PRSG F 0 A_TakeInventory("RSR_Go", 1)
		PRSG F 0 A_JumpIfInventory("HasUnloadedPlasma", 1, "RSR_Wait")	// no magazine in the gun
		PRSG F 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside; they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff", 1, "RSR_Unload1")
		PRSG F 0 A_GiveInventory("HasUnloadedPlasma", 1)
		PRSG F 0 A_GiveInventory("HasUnloadedDualPlasmas", 1)
		Goto RSR_Wait
	RSR_Unload1:
		PRSG F 0 A_TakeInventory("PlasmaAmmoOff", 1)
		PRSG F 0 A_TakeInventory("DoublePlasmaAmmo", 1)
		PRSG F 0 A_GiveInventory("RSR_Held_Plasma_Gun", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		PRSG F 0 A_TakeInventory("RSR_Seated", 1)
		PRSG F 0 A_TakeInventory("HasUnloadedPlasma", 1)
		PRSG F 0 A_TakeInventory("HasUnloadedDualPlasmas", 1)
	RSR_Return:		// the held rounds first
		PRSG F 0 A_JumpIfInventory("RSR_Held_Plasma_Gun", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		PRSG F 0 A_TakeInventory("RSR_Held_Plasma_Gun", 1)
		PRSG F 0 A_GiveInventory("PlasmaAmmoOff", 1)
		PRSG F 0 A_GiveInventory("DoublePlasmaAmmo", 1)
		Goto RSR_Return
	RSR_FillGo:
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff", 1, "RSR_FillB")	// the gun was not empty: no handle
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff", 0, "RSR_Filled")
		PRSG F 0 A_JumpIfInventory("AmmoCell", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		PRSG F 0 A_GiveInventory("PlasmaAmmoOff", 1)
		PRSG F 0 A_GiveInventory("DoublePlasmaAmmo", 1)
		PRSG F 0 A_TakeInventory("AmmoCell", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff", 0, "RSR_Filled")
		PRSG F 0 A_JumpIfInventory("AmmoCell", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		PRSG F 0 A_GiveInventory("PlasmaAmmoOff", 1)
		PRSG F 0 A_GiveInventory("DoublePlasmaAmmo", 1)
		PRSG F 0 A_TakeInventory("AmmoCell", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		PRSG F 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		PRSG F 0 A_TakeInventory("RSR_Done", 1)
		PRSG F 0 A_TakeInventory("Reloading", 1)
		Goto RSR_End
	KickFlash: 
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",31,"KickFlash2") //above 30
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",11,"KickFlash3") //above 10
		PRSK KLMN 1
		PRSK O 10
		PRSK NMLK 1
		stop
	SlideFlash: 
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",31,"SlideFlash2") //above 30
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",11,"SlideFlash3") //above 10
		PRSK KLMN 1
		PRSK O 35
		stop
	SlideFlashEnd: 
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",31,"SlideFlashEnd2") //above 30
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",11,"SlideFlashEnd3") //above 10
		PRSK O 5
		PRSK NMLK 1
		stop
	SlideFlashEndEarly: 
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",31,"SlideFlashEndEarly2") //above 30
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",11,"SlideFlashEndEarly3") //above 10
		PRSK O 3
		PRSK NMLK 1
		stop

	KickFlash2: 
		PRSK ABCD 1
		PRSK E 10
		PRSK DCBA 1
		stop
	SlideFlash2: 
		PRSK ABCD 1
		PRSK E 35
		stop
	SlideFlashEnd2: 
		PRSK E 5
		PRSK DCBA 1
		stop
	SlideFlashEndEarly2: 
		PRSK E 3
		PRSK DCBA 1
		stop

	KickFlash3: 
		PRSK FGHI 1
		PRSK J 10
		PRSK IHGF 1
		stop
	SlideFlash3: 
		PRSK FGHI 1
		PRSK J 35
		stop
	SlideFlashEnd3: 
		PRSK J 5
		PRSK IHGF 1
		stop
	SlideFlashEndEarly3: 
		PRSK J 3
		PRSK IHGF 1
		stop

	Deselect:
		PRSG F 0 A_Takeinventory("Reloading",1)
		PRSG F 0 A_Takeinventory("HasPlasmaWeapon",1)
		PRSG F 0 A_TakeInventory("TossGrenade", 1)
		PRSG F 0 A_PlaySound("Plasma/BeepLow", 5)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "DeselectInstant")
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		PRSG PQRS 1
		TNT1 AAAAAAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	ReadyNormal:
		PRSG F 0 A_Giveinventory("HasPlasmaWeapon",1)
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,4)
		PRSG A 0 A_JumpIfInventory("PlasmaAmmoOff",31,3) //above 30
		PRSG H 0 A_JumpIfInventory("PlasmaAmmoOff",11,2) //above 10
		PRSG F 0
		"####" "#" 0
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 F 0 A_Giveinventory("HasPlasmaWeapon",1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 10) )
		TNT1 A 0 A_TakeInventory("DualPlasmaRifles", 1)
		TNT1 F 0 A_GunFlash
		TNT1 F 0 A_Giveinventory("PlasmaGunSelected",1)
		TNT1 A 0 A_JumpIfInventory("SwitchDuals", 1, "SelectDual")
		TNT1 A 1
		TNT1 F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 F 0 A_JumpIfInventory("RememberDualPlasma", 1, "DualWield")
		TNT1 A 0 A_TakeInventory("NeverSelectedPlasma", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedPlasma", 1, "FirstSelectAnimation")
		TNT1 F 0 A_PlaySound("Plasma/Draw", 5)
	SelectAnimation:
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		PRSG WVUT 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_Takeinventory("StartDualWield",1)
		TNT1 F 0 A_PlaySound("Plasma/Beep", 1)
		Goto Ready
	SelectDual:
		TNT1 A 0 A_Takeinventory("SwitchDuals",1)
		DUPR YXWV 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_PlaySound("Plasma/Draw", 5)
		DUPR UTSR 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 F 0 A_Takeinventory("StartDualWield",1)
		TNT1 F 0 A_PlaySound("Plasma/Beep", 1)
		Goto Ready

	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedPlasma",1)
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 3 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PRR1 ABCDE 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PRSR GHH 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PRSR I 10 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PRSR JKLMNNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		PRSG F 0 A_PlaySound("Plasma/Reload2", 5)
		PRSR OOOOPQRSTTTTUVWXY 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PRSR CZAA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		tnt1 a 0 A_Takeinventory("Reloading",1)
		PRSG IFI 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Ready3:  //im so sorry
	Ready:
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",1,2)
		Goto ReadyNormal
		TNT1 AA 0
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",11,"ReadyNormal")
		PRSG F 0 A_PlaySound("Plasma/BeepQuiet", 5)
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		PRSG G 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		//
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		PRSG G 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		//
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		PRSG G 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		//
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		PRSG F 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		//
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		PRSG F 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		//
		PRSG F 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSG F 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSG F 0 A_JumpIfInventory("Salute1", 1, "Salute")
		PRSG F 0 A_JumpIfInventory("Salute2", 1, "Salute")
		PRSG F 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSG F 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		PRSG F 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		PRSG F 0 A_JumpIfInventory("Unloading",1,"Unload")
		PRSG F 0 A_JumpIf(0, "DualWield")
		PRSG F 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedPlasma",1)
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",31,"StartSprint2") //above 30
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",11,"StartSprint3") //above 10
		PRSG F 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		PRSK KLM 1 A_WeaponReady(WRF_NOFIRE)
		PRSK F 0 A_Takeinventory("Zoomed",1)
		PRSK F 0 A_Takeinventory("ADSmode",1)
		PRSK F 0 A_ZoomFactor(1.0)	
		Goto Sprinting
	StartSprint2:
		PRSG A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		PRSK ABC 1 A_WeaponReady(WRF_NOFIRE)
		PRSK F 0 A_Takeinventory("Zoomed",1)
		PRSK F 0 A_Takeinventory("ADSmode",1)
		PRSK F 0 A_ZoomFactor(1.0)
		Goto Sprinting
	StartSprint3:
		PRSG H 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		PRSK FGH 1 A_WeaponReady(WRF_NOFIRE)
		PRSK F 0 A_Takeinventory("Zoomed",1)
		PRSK F 0 A_Takeinventory("ADSmode",1)
		PRSK F 0 A_ZoomFactor(1.0)		
	Sprinting:
		PRSP A 0 offset(-9,32)
		//PRSG F 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		PRSG F 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes Player faster.
		PRSG F 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		PRSG F 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		PRSG F 0 offset(-9,32)
		PRSK E 0 A_JumpIfInventory("PlasmaAmmoOff",31,3) //above 30
		PRSK I 0 A_JumpIfInventory("PlasmaAmmoOff",11,2) //above 10
		PRSK N 0
		PRSK "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		PRSK "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		PRSK "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		PRSK "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		PRSK "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		PRSK "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		PRSK "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		PRSK "#" 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		PRSK "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PRSK "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		PRSK "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		PRSK "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 4)
		PRSK "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		PRSK "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		PRSK "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		PRSK "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		PRSK "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		PRSK "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		PRSK "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		PRSK "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		PRSK "#" 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		PRSK "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",31,"StopSprint2") //above 30
		TNT1 A 0 A_JumpIfInventory("PlasmaAmmoOff",11,"StopSprint3") //above 10	
		PRSK MLK 1
		PRSG F 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes Player slower.
		Goto Ready

	StopSprint2:
		PRSK CBA 1
		PRSG A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes Player slower.
		Goto Ready

	StopSprint3:
		PRSK HGF 1
		PRSG H 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes Player slower.
		Goto Ready

	Fire:
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		PRSG F 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" F 0 A_JumpIfInventory("PlasmaAmmoOff",1,1)
		Goto NoAmmo
		"####" AAA 0
		"####" F 0 A_Takeinventory("DoublePlasmaAmmo",1)
		"####" F 0 A_Takeinventory("PlasmaAmmoOff",1)
		Goto ResumeFireFrame

	NoReload:
		"####" F 0 A_Takeinventory("Reloading",1)
		"####" F 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo
		"####" AAA 0
		"####" F 0 A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" AAAA 0
		"####" A 0 A_AlertMonsters
		"####" F 0 A_PlaySound("Plasma/Fire", 1)
		"####" F 0 A_ZoomFactor(0.99)
		"####" F 0 A_JumpIfInventory("PSeq3", 1, "SpriteVariant")
		"####" F 0 A_GiveInventory("PSeq3",1)
		"####" B 0 A_JumpIfInventory("DMgame", 1, "FireDM")
		"####" B 1 BRIGHT A_FireCustomMissile("Plasma_Ball", 0, 1, 0, -5)
		Goto FinishFire
	SpriteVariant:
		"####" C 0 A_TakeInventory("PSeq3",1)
		"####" C 0 A_JumpIfInventory("DMgame", 1, "FireDM")
		"####" C 1 BRIGHT A_FireCustomMissile("Plasma_Ball", 0, 1, 0, -5)
		Goto FinishFire
	FireDM:
		"####" "#" 1 BRIGHT A_FireCustomMissile("PlasmaBallDM", 0, 1, 0, -5)
	FinishFire:
		"####" F 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_Quake(1,2,0,12,"")
		"####" DE 1
		"####" F 1 A_Refire
		Goto Ready

	Cooldown:
		PRSA DEFGH 1
		PRSA III 3 A_FireCustomMissile("SmokeSpawner",0,0,10,5)
		PRSA HGFED 1
		Goto Ready


// Charging up secondary ------------------------------------------------------------

	AltFire:
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		PRSG F 0 A_JumpIfInventory("NoReloading",1,"AltNoReload")
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",10,1)
		Goto NoAmmo
		TNT1 AAA 0
		PRSG F 0 A_GiveInventory("PlasmaCharging",1)
		PRSG F 0 A_PlaySound("Plasma/Charge", 5)
		TNT1 A 0 A_AlertMonsters
		PRSG II 4 A_Takeinventory("PlasmaAmmoOff",1)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("PlasmaAmmoOff",1)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG F 0 A_PlaySound("Plasma/FullyCharged", 6, 0.8, 1)
		PRSG F 0 A_ReFire

// Holding Charge ------------------------------------------------------------
	AltHold:
		PRSG F 0 A_PlaySound("Plasma/BeepLow", 5)
		TNT1 A 0 A_AlertMonsters
		PRSG F 0 A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG L 1 BRIGHT offset (0, 32) A_JumpIfInventory("Reloading",1,"Cancel")
		PRSG F 0 A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT offset (0, 33) A_JumpIfInventory("Reloading",1,"Cancel")
		PRSG F 0 A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG N 1 BRIGHT offset (1, 32) A_JumpIfInventory("Reloading",1,"Cancel")
		PRSG F 0 A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT offset (-1, 32) A_JumpIfInventory("Reloading",1,"Cancel")
		PRSG F 0 A_ReFire
		Goto LetFly

// Holding Charge (No Reloading) ------------------------------------------------------------
	AltNoReload:
		PRSG F 0 A_JumpIfInventory("AmmoCell",10,1)
		Goto NoAmmo
		TNT1 AAA 0
		PRSG F 0 A_GiveInventory("PlasmaCharging",1)
		PRSG F 0 A_PlaySound("Plasma/Charge", 5)
		PRSG II 4 A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG F 0 A_PlaySound("Plasma/FullyCharged", 6, 0.8, 1)
		PRSG F 0 A_ReFire("AltHold")

// Let Fly --------------------------------------------------------------------------
	LetFly:
		PRSG F 0 A_TakeInventory("PlasmaCharging",1)
		PRSG F 0 A_StopSound(6)
		PRSG B 1 A_PlaySound("Plasma/AltFire", 1)
		TNT1 A 0 A_AlertMonsters
		PRSG F 0 A_ZoomFactor(0.9)
		PRSG C 1 BRIGHT A_Recoil(3)
		PRSG F 0 A_StopSound(6)
		PRSG F 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_JumpIfInventory("DMGame", 1, "LetFlyDM")
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", -8, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", -6, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", -4, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", -2, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", 0, 0, -1, 0, 0, 0)
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", 1, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", 2, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", 4, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", 6, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBall75", 8, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaFlareSpawn",-5,0,0,0)
		PRSG F 0 A_JumpIfInventory("NoReloading",1,2)
		PRSG F 0 A_Takeinventory("DoublePlasmaAmmo",10)
		PRSA A 1 A_SetPitch(pitch - 6.0)
		PRSA B 1 A_SetPitch(pitch - 2.0)
		PRSA CDEFGH 1
		PRSA I 12
		PRSA IIII 3 A_FireCustomMissile("SmokeSpawner",0,0,10,5)
		PRSA HGFEDD 1
		PRSG F 0 A_PlaySound("Plasma/BeepBeep", 5)
		Goto Ready

	LetFlyDM:
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", -8, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", -6, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", -4, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", -2, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", 0, 0, -1, 0, 0, 0)
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", 1, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", 2, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", 4, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", 6, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaBallDM", 8, 0, -1, 0, 0, random(-2,2))
		PRSG F 0 A_FireCustomMissile("PlasmaFlareSpawn",-5,0,0,0)
		PRSG F 0 A_JumpIfInventory("NoReloading",1,2)
		PRSG F 0 A_Takeinventory("DoublePlasmaAmmo",10)
		PRSA A 1 A_SetPitch(pitch - 6.0)
		PRSA B 1 A_SetPitch(pitch - 2.0)
		PRSA CDEFGH 1
		PRSA I 12
		PRSA IIII 3 A_FireCustomMissile("SmokeSpawner",0,0,10,5)
		PRSA HGFEDD 1
		PRSG F 0 A_PlaySound("Plasma/BeepBeep", 5)
		Goto Ready

// Cancel Charge --------------------------------------------------------------------------------------------
	Cancel:
		PRSG F 0 A_TakeInventory("PlasmaCharging",1)
		PRSG F 0 A_JumpIfInventory("NoReloading",1,"CancelNoReload")
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Giveinventory("PlasmaAmmoOff",2)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT A_PlaySound("Plasma/Cool", 6)
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Giveinventory("PlasmaAmmoOff",2)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Giveinventory("PlasmaAmmoOff",2)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Giveinventory("PlasmaAmmoOff",2)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG I 2 BRIGHT A_Giveinventory("PlasmaAmmoOff",2)
		PRSG F 0 A_TakeInventory("Reloading",1)
		PRSG F 0 A_Giveinventory("DoublePlasmaAmmo",10)
		PRSG F 0 A_PlaySound("Plasma/BeepBeep", 5, 1.2)
		PRSG F 0 A_ClearReFire
		Goto Ready

	CancelNoReload:
		//PRSG F 0 A_StopSound(6)
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Giveinventory("AmmoCell",2)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT A_PlaySound("Plasma/Cool", 6)
		PRSG L 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG M 1 BRIGHT A_Giveinventory("AmmoCell",2)
		PRSG N 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG O 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Giveinventory("AmmoCell",2)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG K 1 BRIGHT A_Giveinventory("AmmoCell",2)
		PRSG J 1 BRIGHT A_FireCustomMissile("PlasmaFlareSpawn",0,0,0,0)
		PRSG I 2 BRIGHT A_Giveinventory("AmmoCell",2)
		PRSG F 0 A_TakeInventory("Reloading",1)
		PRSG F 0 A_PlaySound("Plasma/BeepBeep", 5, 1.2)
		PRSG F 0 A_ClearReFire
		Goto Ready

//  ------------------------------------------------------------------------------

	Spawn:
		PRAS C -1
		Stop

	Reload:
		PRSG F 0 A_Takeinventory("Reloading",1)
		PRSG F 0 A_ClearReFire
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarningManual")		
		PRSG F 0 A_JumpIfInventory("PlasmaCharging",1,"Cancel")
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",0,"Ready")
		PRSG F 0 A_JumpIfInventory("AmmoCell",1,3)
		Goto Ready
		TNT1 AAAA 0
		PRSG F 0 A_JumpIfInventory("TurboReload",1,"TurboReload")
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		TNT1 A 0 A_JumpIfInventory("HasUnloadedPlasma",1,3)
		PRSG F 0 A_PlaySound("Plasma/Reload1", 5)
		PRSG F 0 A_FireCustomMissile("PlasmaCaseSpawn",-210,0,20,-20)
		PRSR AAZBCDEFGHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PRSR I 10 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PRSR JKLMNNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PRSG F 0 A_PlaySound("Plasma/Reload2", 5)
		PRSR OOOO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	ReloadingSequence:
		TNT1 AAAAAAAAAA 0
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",0,15)
		PRSG F 0 A_JumpIfInventory("AmmoCell",1,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		PRSG F 0 A_Giveinventory("PlasmaAmmoOff",1)
		PRSG F 0 A_Giveinventory("DoublePlasmaAmmo",1)
		PRSG F 0 A_Takeinventory("AmmoCell",1,TIF_NOTAKEINFINITE)
		Goto ReloadingSequence
		TNT1 AAAAAAAA 0

	FinishReload:
		PRSR PQRSTTTTUVWXY 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PRSR CZAA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RSR_End:		// posefix rsr: the real VR reload ends here (a label: no state added)
		tnt1 a 0 A_Takeinventory("Reloading",1)
		PRSG IFI 2  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PRSG F 0 A_Takeinventory("HasUnloadedPlasma",1)
		PRSG F 0 A_Takeinventory("HasUnloadedDualPlasmas",1)
		"####" "#" 0 A_ReFire
		Goto Ready

	TurboReload:
		PRSN BCDE 0
		Goto ReloadingSequence

	Unload:
		PRSG F 0 A_Takeinventory("Unloading",1)
		2RSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		PRSG F 0 A_JumpIfInventory("NoReloading",1,"Ready")
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",1,2)
		Goto Ready
		TNT1 AAA 0
		PRSR AAZBCYXWVUTTTT 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		PRSG F 0 A_PlaySound("Plasma/Reload1", 5)
	UnloadingSequence:
		PRSG F 0
		PRSG F 0 A_Takeinventory("Unloading",1)
		PRSG F 0 A_JumpIfInventory("PlasmaAmmoOff",1,3)
		Goto FinishUnload
		TNT1 AAAAAAA 0
		PRSG F 0 A_Takeinventory("PlasmaAmmoOff",1)
		PRSG F 0 A_Takeinventory("DoublePlasmaAmmo",1)
		PRSG F 0 A_Giveinventory("AmmoCell",1)
		Goto UnloadingSequence

	FinishUnload:
		PRSR SPOONMLKJIII 1
		PRSR HGFEDCBZA 1
		PRSG F 0 A_Takeinventory("Unloading",1)
		PRSG F 0 A_Giveinventory("HasUnloadedPlasma",1)
		PRSG F 0 A_Giveinventory("HasUnloadedDualPlasmas",1)
		Goto Ready

	User3:
	DualWield:
		PRSG F 0 A_Takeinventory("StartDualWield",1)
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		PRSG A 0 A_JumpIfInventory("IsTacticalClass", 1, "NoDual")
		PRSG A 0 A_JumpIfInventory("HasDualPlasma", 1, "GetDual")
		PRSG F 0 a_print("$BD_NEED_TWO_IDENTICAL_WEAPONS")
		Goto Ready

	GetDual:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 10) )
		PRSG F 0 A_Takeinventory("Zoomed",1)
		PRSG F 0 A_Takeinventory("ADSmode",1)
		PRSG F 0 A_TakeInventory("TossGrenade", 1)
		PRSG F 0 A_TakeInventory("Kicking",1)
		PRSG F 0 A_TakeInventory("Taunting",1)
		PRSG F 0 A_TakeInventory("Reloading",1)
		PRSG F 0 A_TakeInventory("Unloading",1)
		PRSG F 0 A_TakeInventory("Salute1", 1)
		PRSG F 0 A_TakeInventory("Salute2", 1)
		PRSG F 0 A_ZoomFactor(1.0)
		DUPL A 0 A_GiveInventory("SwitchDuals",1)
		PRSG A 0 A_GiveInventory("DualPlasmaRifles",1)
		PRSG F 0 A_SelectWEapon("DualPlasmaRifles")
		Goto Ready
	}
}

ACTOR ShotgunAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 9
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 9
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_Shot_Gun : Shot_Gun
{
	Tag "Off-hand Shotgun"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Game Doom
	SpawnID 27
	Weapon.AmmoType1 "AmmoShell"
	Weapon.AmmoType2 "ShotgunAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "Shotgun/Pump"
	Inventory.PickupMessage "$BDGOTSHOTGUN"
	Obituary "$OBBD_SHOTGUN"
	States
	{
	// RSR-PUMP: hand-loaded shells and a hand-worked pump (zscript/rsr/rsr_pump.zs, tools/rsr_pump_patch.py).
	// Not in VR, with Stock reloading, or with the off hand not on the pump, every hook goes
	// straight on into BD22's own states. The shot itself is never touched.
	RSP_Load:		// ReloadNormally, after BD22's own checks (before its loading animation)
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_LoadStart", 1)
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_LoadGo")
		Goto RSP_LoadStock
	RSP_Load2:		// InsertingShells (after ReloadFromPumping, Pump2 with reload pressed, a kick)
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_LoadStart", 1)
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_LoadGo")
		Goto RSP_InsStock
	RSP_Feed:	// RSR-PUMP: a shell the hand pushed home with the gun simply up (rsr_pump.zs
				// FreeFeed). One pass per credited shell; the set's own items move here.
		SHTN A 0 A_TakeInventory("RSP_ShellIn", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff", 0, "RSP_FeedEnd")		// the tube is full
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "RSP_Feed1")
		Goto RSP_FeedEnd												// nothing in reserve
	RSP_Feed1:
		SHTN A 0 A_GiveInventory("ShotgunAmmoOff", 1)
		SHTN A 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_FeedEnd:
		SHTN A 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_Feed")		// more credits queued
		Goto Ready
	RSP_VRIns:	// RSR-PUMP: the VR insert's OWN entry, skipping BD22's Reload chain.
				// BD22 drives reload from a "Reloading" token its ACS sets -- its A_WeaponReady
				// has WRF_ALLOWRELOAD commented out -- and its pump-wait states never look at
				// that token, so a shell could only go in when the gun was empty and took
				// another path. rsr_pump.zs reads the button itself and refuses BEFORE sending
				// us here, so by this point there is reserve ammo and room in the tube: no gate
				// is needed here, and none is wanted. (Owner, 2026-10-13.)
		SHTN A 0 A_TakeInventory("RSP_Insert", 1)
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_TakeInventory("ADSmode", 1)
		SHTN A 0 A_TakeInventory("Zoomed", 1)
		SHTN A 0 A_TakeInventory("ZoomHold", 1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_LoadStart", 1)
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_VRIns1")
		Goto Ready					// not in VR, or Stock reloading: BD22 keeps its own reload
	RSP_VRIns1:
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("Pumping", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff", 1, "RSP_Next")
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)	// nothing chambered
		Goto RSP_Next
	RSP_LoadGo:
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("Pumping", 1)		// BD22: the player sprite's reload
		SHTN A 0 A_TakeInventory("Reloading", 1)
	RSP_Next:		// BD22's own InsertingShells / CheckIfFinishReload checks: room for another shell?
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "RSP_Next1")
		Goto Pump2				// out of shells: BD22 pumps
	RSP_Next1:
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff", 8, "RSP_Next8")
		Goto RSP_LoadWait
	RSP_Next8:		// an empty gun stops at 8 (its pump chambers one); a chambered round takes a 9th
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "RSP_LoadEnd")
		Goto RSP_LoadWait
	RSP_LoadWait:	// the hand loads shells (rsr_pump.zs); fire ends the reload, as in BD22's insert frames
		SHTN A 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN A 0 A_GiveInventory("RSP_LTick", 1)
		SHTN A 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_Shell")
		SHTN A 0 A_JumpIfInventory("RSP_Back", 1, "RSP_LBack")
		SHTN A 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_LFwd")
		SHTN A 0 A_JumpIfInventory("Reloading", 1, "RSP_LoadEnd")	// BD22: reload again finishes
		SHTN A 0 A_JumpIfInventory("Kicking", 1, "RSP_Kick")
		SHTN A 0 A_JumpIfInventory("IsRunning", 1, "StartSprint")
		Goto RSP_LoadWait
	RSP_Shell:		// a shell pushed home: BD22's own step, one shell from the reserve into the tube
		SHTN A 0 A_TakeInventory("RSP_ShellIn", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff", 0, "RSP_LoadEnd")	// 2026-10-16: full -- a credit (rsr_shell_credit) is not a free shell
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, 1)	// 1.12: 1, not 2 -- a Goto is not a state (2 skipped the give and only ate reserve)
		Goto RSP_LoadEnd												// nothing left in reserve
		SHTN A 0 A_Giveinventory("ShotgunAmmoOff", 1)
		SHTN A 0 A_Takeinventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff", 0, "RSP_LoadEnd")	// full (InsertShellAnimation's own check)
		Goto RSP_Next
	RSP_LoadEnd:	// FinishedInsertingShells, without its lowering frames (the gun never tilted)
		SHTN A 0 A_TakeInventory("RSP_ShellIn", 999)	// 2026-10-16: credits past a full tube are dropped, never saved for later
		SHTN A 0 A_Takeinventory("Reloading", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		Goto ReadyToFireAgain
	RSP_Kick:		// DoKickReloading, the gun held (the hand keeps what it has)
		SHTN A 0 A_GunFlash("ReloadingKickFlash")
		SHTN AAAAAAAAAAAAAA 1 A_GiveInventory("RSP_LTick", 1)
		Goto RSP_LoadWait
	RSP_LBack:		// the hand has the pump back while loading: a spent shell comes out as in Pump2
		SHTN A 0 A_TakeInventory("RSP_Back", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "RSP_LBack1")
		Goto RSP_LoadWait			// a live round in: BD22's inspect pump, nothing comes out
	RSP_LBack1:
		SHTN A 0 A_JumpIfInventory("HasUnloadedShotgun", 1, "RSP_LoadWait")
		SHTN A 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		Goto RSP_LoadWait
	RSP_LFwd:		// forward again: the reload ends, chambered (Pump2 N)
		SHTN A 0 A_TakeInventory("RSP_Fwd", 1)
		SHTN A 0 A_Takeinventory("Reloading", 1)
		SHTN A 0 A_Takeinventory("ShotgunWasEmpty", 1)
		SHTN A 0 A_Takeinventory("HasUnloadedShotgun", 1)
		Goto ReadyToFireAgain
	RSP_P1:		// Pump1, after a shot, after BD22's own checks
		"####" A 0 A_TakeInventory("RSP_Go", 1)
		"####" A 0 A_GiveInventory("RSP_PumpStart", 20)	// 20: BD22's own tics from here to its refire
		"####" A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_P1Go")
		Goto Pump1+8
	RSP_P1Go:
		"####" "#" 0 A_TakeInventory("RSP_Go", 1)
	RSP_P1Wait:	// the hand works the pump (rsr_pump.zs moves it); switching is allowed, as BD22's pump allows
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		"####" "#" 0 A_GiveInventory("RSP_PTick", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Back", 1, "RSP_P1Back")
		"####" "#" 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_P1Fwd")
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P1Feed")	// 2026-10-16: a shell topped off mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// a shell, mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Auto", 1, "RSP_P1Auto")
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P1Ready")
		Goto RSP_P1Wait
	RSP_P1Feed:	// 2026-10-16: the set's own per-shell step while the gun waits for the pump (as RSP_Feed)
		"####" "#" 0 A_TakeInventory("RSP_ShellIn", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmoOff", 0, "RSP_P1FeedE")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 1)
		Goto RSP_P1FeedE
		"####" "#" 0 A_GiveInventory("ShotgunAmmoOff", 1)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_P1FeedE:
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P1Feed")
		Goto RSP_P1Wait
	RSP_P1Back:	// all the way back: BD22's own Pump1 G..J: the spent shell out
		"####" "#" 0 A_TakeInventory("RSP_Back", 1)
		"####" "#" 0 A_Takeinventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		"####" "#" 0 A_Giveinventory("ShotgunWasEmpty", 1)	// (BD22: until the pump is forward again)
		Goto RSP_P1Wait
	RSP_P1Fwd:	// forward again: BD22's own Pump1 N
		"####" "#" 0 A_TakeInventory("RSP_Fwd", 1)
		"####" "#" 0 A_Takeinventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P1Ready")
		Goto RSP_P1Wait	// ready once BD22's own refire time is up (RSP_Ready)
	RSP_P1Ready:
		"####" "#" 0 A_TakeInventory("RSP_Ready", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "RSP_P1R2")	// BD22's own sprite choice
		SHTN A 0
	RSP_P1R2:
		"####" A 0
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")	// as BD22's pump frames do
		Goto Pump1+38
	RSP_P1Auto:	// the hand left the pump before working it: BD22's own pump
		"####" "#" 0 A_TakeInventory("RSP_Auto", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, "RSP_P1A2")	// BD22's own sprite choice
		SHTN A 0
	RSP_P1A2:
		"####" A 0
		Goto Pump1+8
	RSP_P2:		// Pump2 (loaded empty, or fired with a spent shell in), after BD22's own checks
		SHTN A 0 A_TakeInventory("RSP_Go", 1)
		SHTN A 0 A_GiveInventory("RSP_PumpStart", 17)	// 17: BD22's own tics from here to its refire
		SHTN A 0 A_JumpIfInventory("RSP_Go", 1, "RSP_P2Go")
		Goto Pump2+9
	RSP_P2Go:
		"####" "#" 0 A_TakeInventory("RSP_Go", 1)
	RSP_P2Wait:	// the hand works the pump (rsr_pump.zs moves it); switching is allowed, as BD22's pump allows
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		"####" "#" 0 A_GiveInventory("RSP_PTick", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Back", 1, "RSP_P2Back")
		"####" "#" 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_P2Fwd")
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P2Feed")	// 2026-10-16: a shell topped off mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// a shell, mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Auto", 1, "RSP_P2Auto")
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P2Ready")
		Goto RSP_P2Wait
	RSP_P2Feed:	// 2026-10-16: the set's own per-shell step while the gun waits for the pump (as RSP_Feed)
		"####" "#" 0 A_TakeInventory("RSP_ShellIn", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmoOff", 0, "RSP_P2FeedE")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 1)
		Goto RSP_P2FeedE
		"####" "#" 0 A_GiveInventory("ShotgunAmmoOff", 1)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_P2FeedE:
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P2Feed")
		Goto RSP_P2Wait
	RSP_P2Back:	// all the way back: BD22's own Pump2 H..J
		"####" "#" 0 A_TakeInventory("RSP_Back", 1)
		"####" "#" 0 A_JumpIfInventory("HasUnloadedShotgun", 1, "RSP_P2Wait")
		"####" "#" 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		Goto RSP_P2Wait
	RSP_P2Fwd:	// forward again: BD22's own Pump2 N
		"####" "#" 0 A_TakeInventory("RSP_Fwd", 1)
		"####" "#" 0 A_Takeinventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_Takeinventory("HasUnloadedShotgun", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P2Ready")
		Goto RSP_P2Wait	// ready once BD22's own refire time is up (RSP_Ready)
	RSP_P2Ready:
		"####" "#" 0 A_TakeInventory("RSP_Ready", 1)
		SHTN A 0
		"####" A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")	// as BD22's pump frames do
		Goto Pump2+32
	RSP_P2Auto:	// the hand left the pump before working it: BD22's own pump
		"####" "#" 0 A_TakeInventory("RSP_Auto", 1)
		SHTN A 0
		Goto Pump2+9
	RSP_P3:		// Pump3, after an aimed (zoomed) shot, after BD22's own checks
		SHT8 C 0 A_TakeInventory("RSP_Go", 1)
		SHT8 C 0 A_GiveInventory("RSP_PumpStart", 11)	// 11: BD22's own tics from here to its refire
		SHT8 C 0 A_JumpIfInventory("RSP_Go", 1, "RSP_P3Go")
		Goto Pump3+3
	RSP_P3Go:
		"####" "#" 0 A_TakeInventory("RSP_Go", 1)
	RSP_P3Wait:	// the hand works the pump (rsr_pump.zs moves it); switching is allowed, as BD22's pump allows
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		"####" "#" 0 A_GiveInventory("RSP_PTick", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Back", 1, "RSP_P3Back")
		"####" "#" 0 A_JumpIfInventory("RSP_Fwd", 1, "RSP_P3Fwd")
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P3Feed")	// 2026-10-16: a shell topped off mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// a shell, mid pump wait
		"####" "#" 0 A_JumpIfInventory("RSP_Auto", 1, "RSP_P3Auto")
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P3Ready")
		Goto RSP_P3Wait
	RSP_P3Feed:	// 2026-10-16: the set's own per-shell step while the gun waits for the pump (as RSP_Feed)
		"####" "#" 0 A_TakeInventory("RSP_ShellIn", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmoOff", 0, "RSP_P3FeedE")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 1)
		Goto RSP_P3FeedE
		"####" "#" 0 A_GiveInventory("ShotgunAmmoOff", 1)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
	RSP_P3FeedE:
		"####" "#" 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_P3Feed")
		Goto RSP_P3Wait
	RSP_P3Back:	// all the way back: BD22's own Pump3 J
		"####" "#" 0 A_TakeInventory("RSP_Back", 1)
		"####" "#" 0 A_TakeInventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_GiveInventory("RSP_CaseOut", 1)	// 2026-10-16: out of the ejection port (rsr_pump.zs CaseOut)
		Goto RSP_P3Wait
	RSP_P3Fwd:	// forward again: BD22's own Pump3 (its frames back)
		"####" "#" 0 A_TakeInventory("RSP_Fwd", 1)
		"####" "#" 0 A_JumpIfInventory("RSP_Ready", 1, "RSP_P3Ready")
		Goto RSP_P3Wait	// ready once BD22's own refire time is up (RSP_Ready)
	RSP_P3Ready:
		"####" "#" 0 A_TakeInventory("RSP_Ready", 1)
		SHT8 C 0
		Goto Pump3+20
	RSP_P3Auto:	// the hand left the pump before working it: BD22's own pump
		"####" "#" 0 A_TakeInventory("RSP_Auto", 1)
		SHT8 C 0
		Goto Pump3+3
	Inspect:
		SHTN A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		SHTN A 6 A_WeaponReady(WRF_ALLOWZOOM)
		SHTN A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHTN A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHTN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHTN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHTN A 0 A_JumpIfInventory("Zoomed",1,"REady2")
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		SHTN AAA 0
		SHTN A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTN A 0 A_GiveInventory("DoInspect",1)
		SHTN A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SHTN A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		SHTN A 0 A_TakeInventory("DoInspect",1)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		SHTN ABCDE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_Giveinventory("IsInspecting",1)
	ContinueInspect2:
		SHTN FG 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		SHT6 ABCDEFFF 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		SHT6 F 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		SHT6 G 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_NOFIRE)
		SHTN H 0 A_PlaySound("Shotgun/Pump2", 5)
		SHT6 HI 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		SHTN FED 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("IsInspecting",1)
		SHTN CBA 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_TakeInventory("Reloading",1)
		Goto ReadyToFireAgain

	KickFlash: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		SHTA RSTU 1
		SHTA V 10
		SHTA UTSR 1
		stop
	SlideFlash: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		SHTA RSTU 1
		SHTA V 35
		stop
	SlideFlashEnd: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		SHTA V 5
		SHTA UTSR 1
		stop
	SlideFlashEndEarly: 
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		SHTA VVUTSR 1
		stop

	Spawn:
		SHTC A -1
		Stop

	FirstSelectAnimation:
		SHTN A 0 A_Takeinventory("NeverSelectedShotgun",1)
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTA MLK 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		SHTN BCDEFG 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		SHTN H 1 A_PlaySound("Shotgun/Pump1", 5)
		SHTN IJJKKLLLLLMMN 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		SHTN H 0 A_PlaySound("Shotgun/Pump2", 5)
		SHTN PQRGGGFFEDCBA 1 A_WeaponReady(WRF_ALLOWZOOM/*|WRF_NOFIRE*/)
		Goto Ready3

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		TNT1 A 1
		SHTN A 0 A_Giveinventory("ShotgunSelected",1)
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTN A 0 A_TakeInventory("NeverSelectedShotgun", 1)	// posefix: was SHTN A 0 A_JumpIfInventory("NeverSelectedShotgun", 1, "FirstSelectAnimation")
	SelectAnimation:
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty",1,2)
		SHTN A 0 A_PlaySound("Shotgun/Pump2", 1)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		SHTA MLKJ 1 A_WeaponReady(WRF_NOFIRE)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty",1,"Pump1")
		SHTN A 0 A_GunFlash
		TNT1 A 0 A_TakeInventory("RELOADING",1)
	Ready3:
	Ready:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHTN A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHTN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHTN A 0 A_JumpIfInventory("RSP_ShellIn", 1, "RSP_Feed")	// RSR-PUMP: a shell, no button
		SHTN A 0 A_JumpIfInventory("RSP_Insert", 1, "RSP_VRIns")	// RSR-PUMP: the hand insert
		SHTN A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHTN A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHTN A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT8 C 0 A_JumpIfInventory("Zoomed",1,"REady2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_JumpIf(OverlayID() == 1000000, 2)	// 1.37 rsa: a slug asked for and never fired is dropped
		SHTN A 0 A_TakeInventory("RSA_Slug", 1)
		SHTN A 0 A_JumpIf(OverlayID() != 1000000, 2)
		SHTN A 0 A_TakeInventory("RSA_SlugOff", 1)
	OkToFire:
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		"####" "###" 0
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHTN A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_SetCrosshair(0)
		Goto Ready

	Ready2:
		SHT8 C 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHT8 C 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump3")
		SHT8 C 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT8 C 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT8 C 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT8 C 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHT8 C 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHT8 C 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHT8 C 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT8 C 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		//SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 0 A_JumpIfInventory("AimMode_Toggle",1,4)
		SHT8 C 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SHT8 C 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		"####" "###" 0
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD)
		Loop

	Deselect:
		SHTN A 0 A_Takeinventory("Zoomed",0)
		SHTN A 0 A_TakeInventory("TossGrenade", 0)
		SHTN A 0 A_Takeinventory("ADSmode",0)
		TNT1 A 0 A_TakeInventory("HoldInspect",0)
		TNT1 A 0 A_TakeInventory("IsInspecting",0)
		SHTN A 0 A_Takeinventory("UseShotgunStrap",0)
		SHTN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		SHTA NOPQ 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		SHT8 C 0 A_JumpIfInventory("Zoomed",1,10)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmoOff",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("ShotgunAmmoOff",1)
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("AmmoShell",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" "#" 0
		2HTA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTA A 0
		"####" A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" "#" 0 A_Quake(4,4,0,12,"")
		"####" A 0 A_AlertMonsters
		"####" A 0 A_PlaySound("Shotgun/Fire", 1)
		"####" A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" A 0 A_GiveInventory("ShotgunWasEmpty",1)
		"####" A 0 A_ZoomFactor(0.97)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" AAAAAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles2", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-3,3), 0, 0, -12, 0, random(-3,3))
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("RSA_Slug") > 0) || (OverlayID() == 1000000 && CountInv("RSA_SlugOff") > 0), "RSA_SlugShot")	// 1.37 rsa
		"####" A 1 BRIGHT A_FireBullets (5, 1, 4, 13, "ShotgunPuff", FBF_NORANDOM)
		"####" B 1 BRIGHT A_FireBullets (2.5, 2.5, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
	RSA_SlugKick:	// 1.37 rsa: the slug's kick and pump are the buckshot's own (a label, no state)
		"####" A 0 A_SetPitch(pitch-10)
		"####" A 0 A_ZoomFactor(1.0)
		"####" C 1 A_SetPitch(-6.0 + pitch)
		"####" DE 1 A_SetPitch(+2.5 + pitch)
		"####" W 1 A_SetPitch(+1.0 + pitch)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 7)//Tactical Mode is slower to pump
		"####" AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 1 A_WeaponReady(WRF_NOPRIMARY)

	Pump1:
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 0
		"####" A 0 A_GiveInventory ("Pumping", 1)
		"####" A 0 A_GiveInventory ("GoSpecial", 1)
		"####" A 0 A_JumpIfInventory("ShotgunAmmoOff",1,"RSP_P1")	// RSR-PUMP (was: A_JumpIfInventory("ShotgunAmmoOff",1,3))
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		"####" ABCDEFG 1
		"####" A 0 A_Takeinventory("ShotgunWasEmpty",1)
		"####" A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,-8,-26)
		"####" A 0 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
		"####" H 1 A_PlaySound("Shotgun/Pump1", 5)
		"####" IJ 1
		"####" A 0 A_Giveinventory("ShotgunWasEmpty",1)
		"####" AA 0
		"####" KLMN 1
		"####" A 0 A_Takeinventory("ShotgunWasEmpty",1)
		"####" H 0 A_PlaySound("Shotgun/Pump2", 5)
		"####" A 0 A_JumpIfInventory("NoReloading",1,13)
		"####" A 0 A_JumpIfInventory("ShotgunAmmoOff",0,12)
		"####" PQ 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		"####" FEDCB 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		"####" A 0 A_JumpIfInventory("ShotgunAmmoOff",1,2)
		"####" A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		"####" A 0
		Goto ReadyToFireAgain
		"####" AA 0
		"####" PQFEDCB 1 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain
	
	DM:
		"####" A 1 BRIGHT A_FireBullets (5, 1, 4, 13, "ShotgunPuffDM", FBF_NORANDOM)
		"####" B 1 BRIGHT A_FireBullets (2.5, 2.5, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-10)
		"####" A 0 A_ZoomFactor(1.0)
		"####" C 1 A_SetPitch(-6.0 + pitch)
		"####" DE 1 A_SetPitch(+2.5 + pitch)
		"####" W 1 A_SetPitch(+1.0 + pitch)
		2HTN A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTN A 0
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 7)//Tactical Mode is slower to pump
		"####" AAAAAA 1 A_SetPitch(pitch+0.6)
		"####" A 1 A_WeaponReady(WRF_NOPRIMARY)
		Goto Pump1

	Pump2:
		SHTN A 0
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SHTN A 0 A_GiveInventory ("GoSpecial", 1)
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("ShotgunAmmoOff",1,"RSP_P2")	// RSR-PUMP (was: A_JumpIfInventory("ShotgunAmmoOff",1,3))
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		Goto ReloadNormally
		SHTN TSFG 1
		SHTN H 1 A_PlaySound("Shotgun/Pump1", 5)
		SHTN IJ 1
		SHTN A 0 A_JumpIfInventory("HasUnloadedShotgun",1,2)
		SHTN A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,-8,-26)
		SHTN KLMN 1
		SHTN A 0 A_Takeinventory("ShotgunWasEmpty",1)
		SHTN A 0 A_Takeinventory("HasUnloadedShotgun",1)		
		SHTN H 0 A_PlaySound("Shotgun/Pump2", 5)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff",0,18)
		SHTN PQ 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		SHTN FEDCB 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "ReloadFromPumping")
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,2)
		Goto ReadyToFireAgain
		SHTN AA 0
		SHTN A 0 A_JumpIfInventory("Reloading",1,"InsertingShells")
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff",1,2)
		SHTN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		SHTN A 0
		Goto ReadyToFireAgain
		SHTN AA 0
		SHTN PQFEDCB 1 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB|WRF_ALLOWZOOM)
		Goto ReadyToFireAgain

	ReadyToFireAgain:
		2HTA A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTA A 0
		"####" FGHI 1 A_WeaponReady(1)
		"####" A 0 //A_Refire
		Goto Ready3

	IsHolding:
		SHT8 C 0 A_JumpIfInventory("ZoomHold", 1, 4)
		SHT8 C 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+21
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		//"####" "#" 0 A_TakeInventory("ShotgunWasEmpty", 1)
		"####" "#" 0 A_JumpIfInventory("ShotgunAmmoOff",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		//"####" "#" 0 A_TakeInventory("ShotgunWasEmpty", 1)
		Goto HoldAim

	Fire2:
		SHTN A 0
		SHTN A 0 A_Takeinventory("Reloading",1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump3")
		SHTN A 0 A_AlertMonsters
		SHTN A 0 A_PlaySound("Shotgun/Fire", 1)
		SHTN A 0 A_SpawnItemEx("PlayerMuzzle1",30,0,45)
		RIFF A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, 0, 0, random(-5,5))
		"####" "#" 0 A_Quake(4,4,0,12,"")
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		SHT8 D 1 BRIGHT A_FireBullets (5, 1, 4, 13, "ShotgunPuff", FBF_NORANDOM)
		SHTN A 0 A_FireBullets (2.5, 2.5, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		SHTN A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		SHTN A 0 A_SetPitch(pitch-10)
		SHT8 E 1 A_SetPitch(-8.0 + pitch)
		SHT8 F 1 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SHTN AAA 0
		SHT8 GC 1 A_SetPitch(+2.0 + pitch)
		SHT8 C 0 A_WeaponReady (WRF_NOFIRE)
	Pump3:
		SHT8 C 0
		SHT8 C 0 A_JumpIfInventory("ShotgunAmmoOff", 1, "RSP_P3")	// RSR-PUMP (was: A_JumpIfInventory("ShotgunAmmoOff", 1, 2))
		//SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 1)
		Goto NoAmmo//NoAmmo3
		SHT8 C 0 
		SHT8 C 0 A_GiveInventory ("Pumping", 1)
		SHT8 C 0 A_PlaySound("Shotgun/Pump1", 5)
		SHT8 GHIIJJ 1
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, 1)
		SHTN A 0 A_TakeInventory("ShotgunWasEmpty", 1)
		SHTN A 0 A_FireCustomMissile("ShotCaseSpawn",40,0,14,0)
		SHTN A 0 A_PlaySound("Shotgun/Pump2", 5)
		SHT8 IHHGG 1
		SHT8 C 0
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		SHTN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 AAA 0
		SHTN A 0 A_REfire
		SHTN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SHTN A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		Goto Ready2
	
	DM2:
		SHT8 D 1 BRIGHT A_FireBullets (5, 1, 4, 13, "ShotgunPuffDM", FBF_NORANDOM)
		SHTN A 0 A_FireBullets (2.5, 2.5, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		SHTN A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		SHTN A 0 A_SetPitch(pitch-10)
		SHT8 E 1 A_SetPitch(-8.0 + pitch)
		SHT8 F 1 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_SetPitch(+2.0 + pitch)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		SHTN AAA 0
		SHT8 GC 1 A_SetPitch(+2.0 + pitch)
		SHT8 C 0 A_WeaponReady (WRF_NOFIRE)
		Goto Pump3

	AltFire:
		"####" "#" 0 A_JumpIfInventory("RSA_Opt_Slug", 1, "RSA_SlugGo")	// 1.37 rsa: secondary fires a slug (option)
		SHTN A 0
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SHTN A 0 A_Giveinventory("GoSpecial",1)
		SHTN A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		SHTN A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_SetCrosshair(41)
		SHTN A 0 A_ZoomFactor(1.2)
		SHTN A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		SHT8 AB 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlayWeaponSound("Shotgun/Fire/move")
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		SHTN A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		SHT8 C 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		SHT8 C 4
		SHTN A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	// 1.37 rsa (owner): secondary fire is a slug: the same shell, one heavy round on one point (more
	// than the buckshot's whole load), then the pump as after any shot
	RSA_SlugGo:
		"####" "#" 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" "#" 0 A_GiveInventory("RSA_Slug", 1)
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" "#" 0 A_GiveInventory("RSA_SlugOff", 1)
		Goto Fire
	RSA_SlugShot:
		"####" A 0 A_JumpIf(OverlayID() == 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_Slug", 1)
		"####" A 0 A_JumpIf(OverlayID() != 1000000, 2)
		"####" A 0 A_TakeInventory("RSA_SlugOff", 1)
		"####" A 1 BRIGHT A_FireBullets (0, 0, 1, 150, "ShotgunPuff", FBF_NORANDOM)
		"####" B 1 BRIGHT
		Goto RSA_SlugKick
	ToggleAim:
		SHT8 AB 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		SHT8 C 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		SHT8 CC 0
		SHT8 C 0 A_GiveInventory("ZoomHold",1)
		SHT8 C 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump3")
		SHT8 C 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT8 C 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT8 C 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHT8 C 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHT8 C 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT8 C 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT8 C 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHT8 C 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		SHT8 C 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		TNT1 AAAAAA 0
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		SHTN A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		SHT8 BA 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHTN A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		SHT8 BA 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHTN A 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	StartSprint:
		SHTN A 0 A_Takeinventory("NeverSelectedShotgun",1)
		SHTN A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		SHTN A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		SHTA RST 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		SHTA R 0 offset(-9,32)
		//SHTN A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		SHTN A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		SHTN A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		SHTN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		SHTN A 0 offset(-9,32)
		SHTA U 1 offset(-9,34) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(-6,36) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(-3,38) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(0,38) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(3,36) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(6,34) A_SetPitch(pitch -0.5)
		SHTA U 1 offset(9,32) A_SetPitch(pitch -0.5)
		SHTN A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		SHTN A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHTN A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHTN A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHTN A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		SHTN A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		SHTA U 1 offset(9,34) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(6,36) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(3,38) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(0,38) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(-3,36) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(-6,34) A_SetPitch(pitch +0.5)
		SHTA U 1 offset(-9,32) A_SetPitch(pitch +0.5)
		SHTN A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		SHTN A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		SHTA TSR 1
		SHTN A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	ReloadFromPumping:
		SHTN A 0 A_Takeinventory("Reloading",1)
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmoOff",0,"Pump2")
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, 2)
		Goto Pump2+38
		SHTN AA 0
		SHTN ST 1
		Goto InsertingShells

	ReloadWithNoAmmoLeft:
	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("AmmoShell", 1, 3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		SHTN AA 0
		SHTN AA 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		SHTN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		SHTN A 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		SHTN A 0 A_JumpIfInventory("IsInspecting",1,"ContinueInspect2")
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff",0,"Inspect")
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		SHTN A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff", 1, "ReloadNormally")//Check if there is a shell in the chamber
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)//This means there is no shell in the chamber
	ReloadNormally:
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,2)//If there is no reserve ammo, don't reload, go back to Ready
		Goto Ready
		SHTN AAA 0
		SHTN AA 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")//Check if reloads are disabled.
		SHTN A 0 A_Takeinventory("ADSmode",1)
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_Takeinventory("ZoomHold",1)
		Goto RSP_Load	// RSR-PUMP: hand-loaded shells (zscript/rsr/rsr_pump.zs)
	RSP_LoadStock:
		SHTN A 1 A_GiveInventory ("Pumping", 1)
		SHTN BCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN ST 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	InsertingShells:
		SHTN A 0
		Goto RSP_Load2	// RSR-PUMP
	RSP_InsStock:
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,2)//if there are no more reserve shells, finish reload.
		Goto Pump2
		SHTN AAA 0
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SSHR AA 0 A_TakeInventory("Reloading", 1)
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmoOff",0,"CheckIfFinishReload")
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmoOff",8,"CheckIfFinishReload")
		SHTN A 0 A_Giveinventory("ShotgunAmmoOff",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
	InsertShellAnimation:
		SHTN A 0
		SHTN UUUVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Reload",5)
		SHTN X 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN YZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN "[]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_ALLOWZOOM)
		SHTN AA 0 A_JumpIfInventory("Reloading", 1, "FinishedInsertingShells")
		SHTN AA 0 A_JumpIfInventory("Kicking",1,"DoKickReloading")// Too inconsistent and unpolished for this beta,you'll work on this later!
		SHTN AA 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmoOff",0,"FinishedInsertingShells")//If there are 8+1 shells, stop it immediately
		Goto InsertingShells

	CheckIfFinishReload:
		//SSHR A 1
		SHTN AA 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "FinishedInsertingShells")//If shotgun was empty,
		//Play the insert shell animation again, and insert the 9th shell
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,1)//if there are no more reserve shells, finish reload.
		Goto Pump2
		SHTN A 0 A_Giveinventory("ShotgunAmmoOff",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto InsertShellAnimation

	FinishedInsertingShells:
		SHTN AA 0 A_Takeinventory("Reloading",1)
		SHTN AA 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		SHTN TS 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN FEDCB 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN AA 0 A_Takeinventory("Reloading",1)
		Goto ReadyToFireAgain

	TurboReload:
		SHSS BC 0
	TurboBullets:
		SHTN A 0
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmoOff",0,"FinishTurboReload")
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto FinishTurboReload
		TNT1 AAAA 0
		SHTN A 0 A_Giveinventory("ShotgunAmmoOff",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets
	FinishTurboReload:
		SHTN A 1
		SHTN A 1 A_Refire
		Goto Ready3

	TurboReload2:
		SHSS BC 0
	TurboBullets2:
		SHTN A 0
		SHTN AA 0 A_JumpIfInventory("ShotgunAmmoOff",0,"FinishTurboReload")
		SHTN A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto FinishTurboReload2
		TNT1 AAAA 0
		SHTN A 0 A_Giveinventory("ShotgunAmmoOff",1)
		SHTN A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto TurboBullets2

	FinishTurboReload2:
		SHT8 C 1 A_Refire
		Goto Ready2

	User2:
	Unload:
		//SHTN A 1
		2HTN A 0 A_ZoomFactor(1.0)
		2HTN A 0 A_SetCrosshair( CallACS("GetCrosshair", 5) )
		2HTN A 0 A_Takeinventory("Unloading",1)
		2HTN A 0 A_Takeinventory("ADSmode",1)
		2HTN A 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SHTN AA 0 A_JumpIfInventory("NoReloading",1,"OkToFire")
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)
		SHTN A 0 A_GiveInventory("HasUnloadedShotgun",1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff",1,3)
		Goto OkToFire
		TNT1 AAA 0
		SHTN A 0 A_Takeinventory("Zoomed",1)
		SHTN A 0 A_GiveInventory ("Pumping", 1)
		SHTN A 0 A_Takeinventory("Unloading",1)
		SHTN ABCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RemoveBullets:
		TNT1 AAAA 0
		SHTN A 0 A_JumpIfInventory("ShotgunAmmoOff",1,3)
		SHTN A 0 A_Giveinventory("ShotgunWasEmpty",1)
		Goto FinishUnload
		TNT1 AAAAAA 0
		SHTN A 0 A_Takeinventory("ShotgunAmmoOff",1)
		SHTN A 0 A_Giveinventory("AmmoShell",1)

		SHTN G 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump1", 5)
		SHTN H 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN IJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN KLKJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Shotgun/Pump2", 5)
		SHTN IH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN GF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 0 A_JumpIfInventory("Unloading", 1,"FinishUnload")
		"####" "#" 0 A_JumpIfInventory("Reloading", 1,"FinishUnload")
		Goto RemoveBullets

	FInishUnload:
		SHTN EDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTN A 0 A_Takeinventory("Unloading",1)
		Goto ReadyToFireAgain

	ReloadingKickFlash://DoKickReloading:
		//TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		TNT1 A 0 A_PlaySound("Kick/Swing", 5)
		TNT1 A 0 SetPlayerProperty(0,1,0)
		KICK ABC 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_Quake(2,2,0,12,"")
		KICK D 1 A_FireCustomMissile("KickAttack", 0, 0, 0, -7)
		KICK A 0 A_Takeinventory("Kicking",1)
		KICK EEEEFGHIJKLM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 SetPlayerProperty(0,0,0)
		RIBA A 0 A_Takeinventory("Kicking",1)
		Stop//Goto InsertingShells

	DoKickReloading://ReloadingKickFlash:
		//NULL A 0 A_JumpIf (momZ > 0, "AirKick")
		//NULL A 0 A_JumpIf (momZ < 0, "AirKick")
		TNT1 A 0 A_GunFlash("ReloadingKickFlash")
		SHTN "[]" 1 Offset(0, 34)
		SHTN "[]" 1 Offset(0, 38)
		SHTN "[]" 1 Offset(0, 42)
		SHTN "[]" 4 Offset(0, 50)
		SHTN "[]" 1 Offset(0, 42)
		SHTN "[]" 1 Offset(0, 38)
		SHTN "[]" 1 Offset(0, 34)
		SHTN "[]" 4
		Goto InsertingShells//Stop

	Steady:
		TNT1 A 1
		Goto Ready

	NoAmmo3:
		RIFG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RIFG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		RIFG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RIFG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RIFG A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RIFG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT8 C 4 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOPRIMARY)
		RIFG A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RIFG A 0 A_JumpIfInventory("TurboReload",1,"TurboReload2")
		TNT1 A 0 A_JumpIfInventory("NoAutoReload", 1, "NoAmmo3")
		RIFG A 0 A_JumpIfInventory("AmmoShell",1,"Reload")
		RIFG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "NoAmmo3")
		Goto Ready3
	}
}

ACTOR SSGAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 2
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 2
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_SSG : SSG
{
	Tag "Off-hand Super shotgun"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Game Doom
	SpawnID 33
	Weapon.Kickback 50
	Weapon.AmmoType1 "AmmoShell"
	Weapon.AmmoType2 "SSGAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "SSG/Draw"
	Inventory.PickupMessage "$BDGOTSHOTGUN2"
	Obituary "$OBBD_SHOTGUN2"
	States
	{
	// RSR-BREAK: real VR reload, break-open / revolver (zscript/rsr/rsr_break.zs, team/reload_break/tools/rsb_patch.py).
	// Not in VR, or with Real reload off, RSB_Start goes straight on into the set's own reload.
	RSB_Start:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_GiveInventory("RSB_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_Go", 1, "RSB_Open")
		Goto RSB_Stock
	RSB_Start2:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_GiveInventory("RSB_Start", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_Go", 1, "RSB_Open")
		Goto RSB_Stock2
	RSB_Open:
		"####" "#" 0 A_TakeInventory("RSB_Go", 1)
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_GiveInventory("Pumping", 1)		// BD22: the player sprite's reload
	RSB_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSB_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSB_EjectT", 1, "RSB_Eject")
		"####" "#" 0 A_JumpIfInventory("RSB_LoadT", 1, "RSB_Load")
		"####" "#" 0 A_JumpIfInventory("RSB_Done", 1, "RSB_Done")
		Goto RSB_Wait
	RSB_Eject:		// BD22's own casings: one SSGCaseSpawner per fired barrel (its RaiseReloading / Reload2)
		"####" "#" 0 A_TakeInventory("RSB_EjectT", 1)
		"####" "#" 0 A_FireCustomMissile("SSGCaseSpawner",0,0,-10, -20)
		"####" "#" 0 A_JumpIfInventory("RSB_EjectT", 1, "RSB_Eject")
		Goto RSB_Wait
	RSB_Load:		// one shell pushed home in a barrel: BD22's own step (its Reload2, one shell)
		"####" "#" 0 A_TakeInventory("RSB_LoadT", 1)
		"####" "#" 0 A_TakeInventory("HasUnloadedSSG", 1)
		"####" "#" 0 A_GiveInventory("SSGAmmoOff", 1)
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,2)
		"####" "#" 0 A_TakeInventory("AmmoShell", 1,TIF_NOTAKEINFINITE)
		"####" "#" 0
		Goto RSB_Wait
	RSB_Done:		// shut (weapons/sshotc, SSG/Lever1): BD22's own end of a reload
		SHTZ A 0 A_TakeInventory("RSB_Done", 1)
		Goto Ready
	Inspect:
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarningManual")
		SHT2 A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		SHT2 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		SHT2 A 6 A_WeaponReady(WRF_ALLOWZOOM)
		SHTN A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHT2 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT2 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT2 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHT2 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHT2 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT2 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT2 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		SHT2 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		SHT2 A 0 A_GiveInventory("DoInspect",1)
		SHT2 A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		SHT2 A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		SHT2 A 0 A_PlaySound("SSG/Lever2", 1)
		SHTN A 0 A_TakeInventory("DoInspect",1)
		SHTZ AAB 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		SHZ2 A 0 A_PlaySound("weapons/sshoto", 5)
		SHZ2 KLMN 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		SHZ2 O 3 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	Inspect2:
		SHZ2 O 2 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		SHZ2 A 0 A_PlaySound("weapons/sshotc", 5)
		SHZ2 NMLK 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM|WRF_NOFIRE)
		TNT1 A 0 A_PlaySound("SSG/Lever1", 1)
		SHTZ BAA 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		SHT2 A 0 A_TakeInventory("Reloading",1)
		Goto Ready

	KickFlash: 
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		SHT2 STUV 1
		SHT2 W 10
		SHT2 VUTS 1
		stop
	SlideFlash: 
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		SHT2 STUV 1
		SHT2 W 35
		stop
	SlideFlashEnd: 
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		SHT2 W 5
		SHT2 VUTS 1
		stop
	SlideFlashEndEarly: 
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		SHT2 W 2
		SHT2 VUTS 1
		stop

	Spawn:
		SGN2 A -1
		Stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 4) )
		SHT2 A 0 A_GunFlash
		TNT1 A 1
		SHT2 A 0 A_Giveinventory("SSGSelected",1)
		SHT2 A 0 A_JumpIfInventory("IsRunning", 1, "StartSprint")
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 3)
		TNT1 A 0 A_JumpIfInventory("NoAutoReload", 1, 5)
		SHT2 A 0 A_JumpIfInventory("SSGAmmoOff", 1, 4)
		SHT2 A 0 A_JumpIfInventory("SSGLoaded", 1, 3)
		TNT1 AA 0 A_WeaponReady(WRF_NOFIRE)
		Goto RaiseReloading
		TNT1 AAA 0
	ResumeNormalRaise:
		TNT1 A 0 A_GiveInventory ("Pumping", 1)
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"RaiseNoAmmo")		
		TNT1 A 0 A_JumpIfInventory("SSGAmmoOff",1,1)
		Goto RaiseNoAmmo
		SHZ2 A 1 Offset(25, 56)
		SHZ2 A 1 Offset(2, 33)
		//Goto FinishNormalRaise
		SHT2 A 0 A_PlaySound("weapons/sshotc", 5)
		SHZ2 ABCDGIJ 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		SHZ2 A 0 A_PlaySound("SSG/Lever1", 5)
		SHTZ BA 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		Goto Ready

	RaiseNoAmmo:	
		SHT2 A 0 A_PlaySound("SSG/Draw", 5)
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
		SHT2 KLMN 1 A_WeaponReady(WRF_NOFIRE)
		Goto Ready

	SelectAnimation:
	Ready:
	Ready3:
		SHTN A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		SHT2 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT2 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT2 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		SHT2 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		SHT2 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT2 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		SHT2 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHT2 A 0
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Deselect:
		SHT2 A 0 A_Takeinventory("Zoomed",1)
		SHT2 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_tAKEINVENTORY("HoldInspect",1)
		SHT2 A 0 A_TakeInventory("TossGrenade", 1)
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		SHT2 OPQR 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		VSSG A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHT2 A 0
		"####" A 0 A_TakeInventory("Reloading",1)
		"####" A 0 A_JumpIfInventory("SSGAmmoOff", 2, 3)
		"####" A 0 A_JumpIfInventory("SSGAmmoOff",1,"AltFire")
		"####" A 0 A_JumpIfInventory("SSGAlt",1,"AltFire")
		Goto NoAmmo
		"####" A 0 A_TakeInventory("SSGAmmoOff", 2)
		"####" A 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		Goto ResumeFireFrame

	NoReload:
		"####" A 0 A_JumpIfInventory("AmmoShell", 2, 3)
		"####" A 0 A_JumpIfInventory("AmmoShell", 1, "NoReload2")
		Goto NoAmmo
		"####" AA 0 
		"####" A 0 A_TakeInventory("AmmoShell", 2,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" A 0
		"####" A 0 A_TakeInventory("SSGAlt",1)
		"####" A 0 A_AlertMonsters
		"####" A 0 A_ZoomFactor(1.6)
		"####" A 0 A_JumpIfInventory("PowerStrength", 1, 2)
		"####" A 0 A_Recoil(2)
		"####" A 0
		"####" A 0 A_FireCustomMissile("DistantFireSoundSSG", random(-1,1), 0, 0, -12, 0, random(-1,1))
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" A 0 A_firebullets (0,0,1,40,"shotpuff",FBF_NORANDOM,300)
		"####" A 0 BRIGHT A_playsound("SSG/Fire", 1)
		"####" AAAAAAAAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-10,10), 0, 0, -12, 0, random(-5,5))
		"####" AAAAAAAAAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-19,19), 0, -1, 0, 0, random(-9,9))
		"####" AAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles2", random(-19,19), 0, -1, 0, 0, random(-9,9))
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",30,5,27)
		"####" A 0 A_FireBullets (10, 1, 9, 13, "ShotgunPuff", FBF_NORANDOM)
		"####" A 0 A_FireBullets (6, 3, 9, 13, "ShotgunPuff", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (11, 3, 10, 13, "ShotgunPuff2", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-20)
		"####" AA 0
	DMCont:
		"####" BC 1 BRIGHT A_SetPitch(pitch-0.5)
		"####" "#" 0 A_Quake(4,5,0,12,"")
		"####" A 0 A_SetPitch(pitch-11)
		"####" A 0 A_ZoomFactor(1.00)
		"####" A 0 A_TakeInventory("SSGLoaded",1)
		"####" A 0 A_TakeInventory("Reloading",1)
		"####" DEEF 1 A_SetPitch(pitch+2)
		"####" GHIJ 1 A_SetPitch(pitch+1)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 15)//Tactical Mode takes more time
		"####" AAAAAAAAAA 1 A_SetPitch(pitch+0.5)
		"####" AA 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		"####" AAA 1 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1, 2)
		"####" A 0 A_JumpIfInventory("NoAutoReload", 1, "Ready")
		"####" AA 0
		"####" A 0 A_JumpIfInventory("AmmoShell",1,"Reload")
		Goto Ready
	
	DM:
		"####" A 0 A_firebullets (0,0,1,40,"shotpuffDM",FBF_NORANDOM,300)
		"####" A 0 BRIGHT A_playsound("SSG/Fire", 1)
		"####" AAAAAAAAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-10,10), 0, 0, -12, 0, random(-5,5))
		"####" AAAAAAAAAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-19,19), 0, -1, 0, 0, random(-9,9))
		"####" AAAAAAAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles2", random(-19,19), 0, -1, 0, 0, random(-9,9))
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",30,5,27)
		"####" A 0 A_FireBullets (10, 1, 9, 13, "ShotgunPuffDM", FBF_NORANDOM)
		"####" A 0 A_FireBullets (6, 3, 9, 13, "ShotgunPuffDM", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (11, 3, 10, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-20)
		"####" AA 0
		Goto DMCont

	ReloadSmoke:
		SHZ3 LMNOP 1
		stop

	ReloadSmoke2:
		SHZ3 QRSTU 1
		stop

	AltFire:
		SHT2 A 0 A_TakeInventory("Reloading",1)
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		SHT2 A 0 A_JumpIfInventory("SSGAmmoOff", 1, 2)
		Goto NoAmmo
		SHT2 AA 0 
		SHT2 A 0 A_JumpIfInventory("NoReloading",1,"NoReload2")
		SHT2 A 0 A_JumpIfInventory("SSGAmmoOff",2,"ResumeFire2Frame")
		Goto AltFire2

	NoReload2:
		SHT2 A 0 A_JumpIfInventory("AmmoShell", 1, 2)
		Goto NoAmmo
		SHT2 AA 0 
		SHT2 A 0 A_TakeInventory("AmmoShell", 1,TIF_NOTAKEINFINITE)
	ResumeFire2Frame:
		TNT1 AAAAA 0
		SHT2 A 0 A_JumpIfInventory("SSGAlt",1,"AltFire2")
		SHT2 A 0 A_TakeInventory("SSGAmmoOff", 1)
		SHT2 A 0 A_PlaySound("SSG/AltFire", 1)
		SHT2 A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		SHT2 A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		SHT2 A 0 A_ALertMonsters
		"####" "#" 0 A_Quake(3,4,0,12,"")
		"####" "#" 0 A_JumpIfInventory("DMgame", 1, "DM2")
		"####" "#" 0 A_FireBullets (5, 3, 9, 13, "ShotgunPuff", FBF_NORANDOM)
		SHT2 A 0 A_TakeInventory("SSGLoaded",1)
		
		SHT2 A 0 offset(-1,32) A_GiveInventory("SSGAlt",1)
		TNT1 AAAAAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(1,12), 0, -1, 0, 0, random(-9,9))
		TNT1 AAA 0 A_FireCustomMissile("ShotgunParticles2", random(1,12), 0, -1, 0, 0, random(-9,9))
		SHT2 A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, -12, 0, random(-5,5))
		SHT2 X 1 BRIGHT
		SHT2 A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		SHT2 A 0 A_SetPitch(pitch-7)
		SHT2 A 0
	DM2Cont:
		SHT2 A 0 A_SetPitch(-5.0 + pitch)
		SHT2 GHIJA 1 A_SetPitch(+1.0 + pitch)
		SHT2 A 0
		Goto Ready
	
	DM2:
		"####" "#" 0 A_FireBullets (5, 3, 9, 13, "ShotgunPuffDM", FBF_NORANDOM)
		SHT2 A 0 A_TakeInventory("SSGLoaded",1)		
		SHT2 A 0 offset(-1,32) A_GiveInventory("SSGAlt",1)
		TNT1 AAAAAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(1,12), 0, -1, 0, 0, random(-9,9))
		TNT1 AAA 0 A_FireCustomMissile("ShotgunParticles2", random(1,12), 0, -1, 0, 0, random(-9,9))
		SHT2 A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, -12, 0, random(-5,5))
		SHT2 X 1 BRIGHT
		SHT2 A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		SHT2 A 0 A_SetPitch(pitch-7)
		SHT2 A 0
		Goto DM2Cont
		
		
	AltFire2:
		SHT2 A 0 A_TakeInventory("SSGAmmoOff", 1)
		SHT2 A 0 A_PlaySound("SSG/AltFire", 1)
		SHT2 A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		SHT2 A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		SHT2 A 0 A_ALertMonsters
		"####" "#" 0 A_Quake(3,4,0,12,"")
		"####" "#" 0 A_JumpIfInventory("DMgame", 1, "DM3")
		"####" "#" 0 A_FireBullets (5, 3, 9, 13, "ShotgunPuff", FBF_NORANDOM)
		SHT2 A 0 A_TakeInventory("SSGLoaded",1)
	
		SHT2 A 0 offset(1,32) A_TakeInventory("SSGAlt",1)
		TNT1 AAAAAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-1,-12), 0, -1, 0, 0, random(-9,9))
		TNT1 AAA 0 A_FireCustomMissile("ShotgunParticles2", random(-1,-12), 0, -1, 0, 0, random(-9,9))
		TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, -12, 0, random(-5,5))
		SHT2 Y 1 BRIGHT 
		SHT2 A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		SHT2 A 0 A_SetPitch(pitch-7)
		SHT2 A 0
	DM3Cont:
		SHT2 A 0 A_SetPitch(-5.0 + pitch)
		SHT2 GHIJA 1 A_SetPitch(+1.0 + pitch)
		SHT2 A 0 A_JumpIfInventory("NoAutoReload", 1, 2)
		Goto Reload
		SHT2 AA 0
		Goto NoAmmo//Ready
	
	DM3:
		"####" "#" 0 A_FireBullets (5, 3, 9, 13, "ShotgunPuff", FBF_NORANDOM)
		SHT2 A 0 A_TakeInventory("SSGLoaded",1)	
		SHT2 A 0 offset(1,32) A_TakeInventory("SSGAlt",1)
		TNT1 AAAAAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-1,-12), 0, -1, 0, 0, random(-9,9))
		TNT1 AAA 0 A_FireCustomMissile("ShotgunParticles2", random(-1,-12), 0, -1, 0, 0, random(-9,9))
		TNT1 AAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-5,5), 0, 0, -12, 0, random(-5,5))
		SHT2 Y 1 BRIGHT 
		SHT2 A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (6, 3, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		SHT2 A 0 A_SetPitch(pitch-7)
		SHT2 A 0
		Goto DM3Cont

	StartSprint:
		SHT2 A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		SHT2 STUV 1 A_WeaponReady(WRF_NOFIRE)
		SHT2 A 0 A_Takeinventory("Zoomed",1)
		SHT2 A 0 A_Takeinventory("ADSmode",1)
		SHT2 A 0 A_ZoomFactor(1.0)	
	Sprinting:
		SHT2 V 0 offset(-9,32)
		//SHT2 A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		SHT2 A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		SHT2 A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		SHT2 A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		SHT2 A 0 offset(-9,32)
		SHT2 V 1 offset(-9,34) A_SetPitch(pitch -0.5)
		SHT2 V 1 offset(-6,36) A_SetPitch(pitch -0.5)
		SHT2 V 1 offset(-3,38) A_SetPitch(pitch -0.5)
		SHT2 V 1 offset(0,38) A_SetPitch(pitch -0.5)
		SHT2 V 1 offset(3,36) A_SetPitch(pitch -0.5)
		SHT2 V 1 offset(6,34) A_SetPitch(pitch -0.5)
		SHT2 V 1 offset(9,32) A_SetPitch(pitch -0.5)
		SHT2 A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		SHT2 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		SHT2 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		SHT2 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		SHT2 A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		SHT2 A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		SHT2 V 1 offset(9,34) A_SetPitch(pitch +0.5)
		SHT2 V 1 offset(6,36) A_SetPitch(pitch +0.5)
		SHT2 V 1 offset(3,38) A_SetPitch(pitch +0.5)
		SHT2 V 1 offset(0,38) A_SetPitch(pitch +0.5)
		SHT2 V 1 offset(-3,36) A_SetPitch(pitch +0.5)
		SHT2 V 1 offset(-6,34) A_SetPitch(pitch +0.5)
		SHT2 V 1 offset(-9,32) A_SetPitch(pitch +0.5)
		SHT2 A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		SHT2 A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		SHT2 VUTS 1
		SHT2 A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready
	
	Reload:
		"####" A 0 A_TakeInventory("Reloading",1)
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,3)
		SHTZ A 0 A_JumpIfInventory("HoldInspect",1,"Inspect2")
		"####" A 0 A_JumpIfInventory("SSGAmmoOff", 2, "Inspect")
		"####" A 0 A_JumpIfInventory("SSGLoaded", 1, "Ready")
		"####" A 0 A_JumpIfInventory("AmmoShell", 1, 1)//Check if has any ammo left to reload
		Goto Ready
		//"####" A 0 A_JumpIfInventory("SSGAmmoOff", 1, "Reload2")//Check if still has a shell on left barrel
		"####" A 0 A_Jump(256, "RSB_Start")	// RSR-BREAK: real VR reload (zscript/rsr/rsr_break.zs)
	RSB_Stock:
		"####" A 0 A_JumpIfInventory("SSGAlt", 1, "Reload2")//Check if still has a shell on left barrel
		"####" A 0 A_JumpIfInventory("AmmoShell", 2, 2)//Check if has ammo to reload 2 shells
		Goto Reload2
		//Reload 2 barrels
		SHTZ AA 0
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTZ A 0
		"####" AAB 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" C 1 A_PlaySound("SSG/Lever2", 5)
		"####" DEFGHIIIHJK 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RaiseReloading:
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTZ A 0
		"####" A 0 A_JumpIfInventory("AmmoShell", 1, 1)//Check if has any ammo left to reload
		Goto ResumeNormalRaise
		"####" A 0 A_Jump(256, "RSB_Start2")	// RSR-BREAK
	RSB_Stock2:
		"####" A 0 A_JumpIfInventory("AmmoShell", 2, 1)//Check if has ammo to reload 2 shells
		Goto Reload2
		"####" A 0 A_GiveInventory ("Pumping", 1)
		"####" A 0 A_PlaySound("weapons/sshoto", 5)
		"####" A 0 A_JumpIfInventory("HasUnloadedSSG",1,5)
		"####" A 0 A_JumpIfInventory("SSGReloadToken",1,4)
		"####" AA 0 A_FireCustomMissile("SSGCaseSpawner",0,0,-10, -20)
		"####" A 0 A_GunFlash("ReloadSmoke",GFF_NOEXTCHANGE)
		"####" AA 0 
		"####" A 0 A_GiveInventory("SSGReloadToken", 1)
		"####" LM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "[" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" N 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" OPQSTTU 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)	//removed u frame
		"####" A 0 A_TakeInventory("HasUnloadedSSG", 1)
		"####" A 0 A_playsound("weapons/sshotl", 5)
		"####" A 0 A_GiveInventory("SSGLoaded",1)
		"####" A 0 A_GiveInventory("SSGAmmoOff", 2)
		//"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,3)
		"####" A 0 A_JumpIfInventory("NoReloading",1,2)
		"####" A 0 A_TakeInventory("AmmoShell", 2,TIF_NOTAKEINFINITE)
		"####" A 0 A_TakeInventory("SSGReloadToken", 1)
		"####" VWXY 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" "#" 4 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)	// posefix: was TNT1 A 4 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTZ A 0
		"####" Z 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" A 0 A_PlaySound("weapons/sshotc", 5)
		V5HZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHZ2 A 0
		"####" ABCDEFFGHI 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		"####" J 1 A_PlaySound("SSG/Lever1", 5)
		"####" A 0 A_TakeInventory("Reloading",1)
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		SHTZ A 0
		"####" B 1
		"####" AA 1 A_ReFire
		Goto Ready

	Reload2:
		VSHZ A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"Ready")
		SHT2 A 0 A_TakeInventory("SSGAlt", 1)
		SHTZ AA 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ3 G 1
		SHZ3 H 1 A_PlaySound("SSG/Lever2", 5)
		SHZ3 IJK 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHT2 A 0 A_GiveInventory ("Pumping", 1)
		SHT2 A 0 A_PlaySound("weapons/sshoto", 5)
		SHT2 A 0 A_JumpIfInventory("HasUnloadedSSG", 1, 3)
		SHTZ A 0 A_FireCustomMissile("SSGCaseSpawner",0,0,-10, -20)
		TNT1 A 0 A_GunFlash("ReloadSmoke2",GFF_NOEXTCHANGE)
		SHZ2 PQR 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ2 S 2 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ2 TUVW 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM) //removed u frame
		SHZ2 XXYY 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHT2 A 0 A_TakeInventory("HasUnloadedSSG", 1)
		SHZ2 A 0 A_playsound("weapons/sshotl", 5)
		SHTZ A 0 A_GiveInventory("SSGAmmoOff", 1)
		SHTZ A 0 A_GiveInventory("SSGLoaded",1)
		SHTZ A 0 A_JumpIfInventory("NoReloading",1,2)
		SHTZ A 0 A_TakeInventory("AmmoShell", 1,TIF_NOTAKEINFINITE)
		SHZ2 Z 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ3 ABCDE 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ3 E 3 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)	// posefix: was TNT1 A 3 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTZ Z 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHT2 A 0 A_PlaySound("weapons/sshotc", 5)
		SHZ2 ABCDEFFFGHI 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ2 J 1 A_PlaySound("SSG/Lever1")
		SHTZ A 0 A_TakeInventory("Reloading",1)
		SHTZ B 1
		SHTZ AA 1 A_ReFire
		Goto Ready

	User2:
	Unload:
		SHT2 A 0 A_ZoomFactor(1.0)
		SHT2 A 0 A_Takeinventory("Unloading",1)
		SHT2 A 0 A_Takeinventory("ADSmode",1)
		SHT2 A 0 A_Takeinventory("Zoomed",1)
		SHT2 A 0 A_TakeInventory("SSGAlt",1)
		SHT2 A 0 A_JumpIfInventory("NoReloading",1,"Ready")
		SHT2 A 0 A_JumpIfInventory("SSGAmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		SHT2 A 0 A_Takeinventory("Zoomed",1)
		SHT2 A 0 A_GiveInventory ("Pumping", 1)
		SHT2 A 0 A_Takeinventory("Unloading",1)
		SHTZ AAB 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTZ C 1 A_PlaySound("SSG/Lever2", 5)
		SHTZ DEFGHIIIHJK 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ3 F 1 A_PlaySound("weapons/sshoto", 5)
	RemoveBullets:
		TNT1 AAAA 0
		SHT2 A 0 A_JumpIfInventory("SSGAmmoOff",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		SHT2 A 0 A_Takeinventory("SSGAmmoOff",1)
		SHT2 A 0 A_Takeinventory("SSGAlt",1)
		SHTZ A 0 A_TakeInventory("SSGLoaded",1)
		SHT2 A 0 A_Giveinventory("AmmoShell",1)
		Goto RemoveBullets

	FInishUnload:
		SHT2 A 0 A_GiveInventory("HasUnloadedSSG", 1)
		SHZ3 E 16 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)	// posefix: was TNT1 A 16 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHTZ Z 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHT2 A 0 A_PlaySound("weapons/sshotc", 5)
		SHZ2 ABCDEFFGHI 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		SHZ2 J 1 A_PlaySound("SSG/Lever1", 5)
		SHTZ BAA 1
		SHTZ A 0 A_TakeInventory("Reloading",1)
		SHTZ A 0 A_TakeInventory("Unloading",1)
		Goto Ready
	}
}

ACTOR AssaultShotgunAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 20
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 20
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_AssaultShotgun : AssaultShotgun
{
	Tag "Off-hand Assault shotgun"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "AmmoShell"
	Weapon.AmmoType2 "AssaultShotgunAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.Pickupmessage "$GOTASSAULTSHOTGUN"
	Obituary "$OBBD_ASSAULTSHOTGUN"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		USAS A 0 A_TakeInventory("RSR_Go", 1)
		USAS A 0 A_GiveInventory("RSR_Start", 1)
		USAS A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		USAS A 0 A_TakeInventory("RSR_Go", 1)
		USAS A 0 A_JumpIfInventory("HasUnloadedASG", 1, "RSR_Wait")	// no magazine in the gun
		USAS A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside; they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff", 1, "RSR_Unload1")
		USAS A 0 A_GiveInventory("HasUnloadedASG", 1)
		Goto RSR_Wait
	RSR_Unload1:
		USAS A 0 A_TakeInventory("AssaultShotgunAmmoOff", 1)
		USAS A 0 A_GiveInventory("RSR_Held_AssaultShotgun", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		USAS A 0 A_TakeInventory("RSR_Seated", 1)
		USAS A 0 A_TakeInventory("HasUnloadedASG", 1)
	RSR_Return:		// the held rounds first
		USAS A 0 A_JumpIfInventory("RSR_Held_AssaultShotgun", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		USAS A 0 A_TakeInventory("RSR_Held_AssaultShotgun", 1)
		USAS A 0 A_GiveInventory("AssaultShotgunAmmoOff", 1)
		Goto RSR_Return
	RSR_FillGo:
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff", 1, "RSR_FillB")	// the gun was not empty: no handle
		USAS A 0 A_GiveInventory("ASGReloadToken", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff", 0, "RSR_Filled")
		USAS A 0 A_JumpIfInventory("AmmoShell", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		USAS A 0 A_GiveInventory("AssaultShotgunAmmoOff", 1)
		USAS A 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff", 0, "RSR_Filled")
		USAS A 0 A_JumpIfInventory("AmmoShell", 1, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		USAS A 0 A_GiveInventory("AssaultShotgunAmmoOff", 1)
		USAS A 0 A_TakeInventory("AmmoShell", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		USAS A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		USAS A 0 A_TakeInventory("RSR_Done", 1)
		USAS A 0 A_TakeInventory("ASGReloadToken", 1)
		USAS A 0 A_TakeInventory("Reloading", 1)
		Goto ReloadConcluded
	KickFlash: 
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		3SAR QRSTU 1
		3SAR U 8
		3SAR UTSRQ 1
		stop
	SlideFlash: 
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlash")
		3SAR QRSTU 1
		3SAR U 35
		stop
	SlideFlashEnd: 
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEnd")
		3SAR U 4
		3SAR UTSRQ 1
		stop
	SlideFlashEndEarly: 
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristSlideFlashEndEarly")
		3SAR U 1
		3SAR UTSRQ 1
		stop

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial")
		TNT1 A 0 A_GiveInventory("TokenCleaner")	
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		TNT1 A 0 A_GunFlash
		TNT1 AAAAAAAAAAAAAA 0 A_Raise
		TNT1 A 1 A_Raise
		TNT1 A 0 A_GiveInventory("ASGSelected",1)	
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("HasUnloadedASG", 1, "SelectAnimationUnloaded")
		TNT1 A 0 A_TakeInventory("NeverSelectedASG", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedASG", 1, "FirstSelectAnimation")
		USAS A 0 A_PlaySound("ASG/Draw",5)
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"SelectPurist")
	SelectAnimation:
		USAS TSRQ 1 A_WeaponReady(WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("RELOADING",1)
		TNT1 A 0 A_TakeInventory("IsInspecting",1)
		TNT1 a 0 a_jumpifinventory("ASGReloadToken",1,"SelectRechamber")
		Goto Ready
	
	/*SelectPurist:
        "####" "#" 0 A_JumpIfInventory("PuristAssaultShotgun", 1,3)    
        "####" "#" 0 A_Giveinventory("PuristAssaultShotgun",1)
        "####" "#" 0 A_SelectWeapon("PuristAssaultShotgun")
        "####" "####" 0 A_Raise
        "####" "#" 1 A_Raise
        "####" "#" 0 A_Takeinventory("AssaultShotgun",1)
        Goto SelectPurist+1*/

	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedASG",1)
		USAS A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		3SAR JKLMNOP 1 A_WeaponReady(WRF_ALLOWZOOM)
		USAR NPQRRSSSSSSTUVW 1 A_WeaponReady(WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("ASG/Reload2", 5)
		USAR XXYYZ 1 A_WeaponReady(WRF_ALLOWZOOM)
		2SAR AABCDDDDEFGHIJ 1 A_WeaponReady(WRF_ALLOWZOOM)
		2SAR KL 1 A_WeaponReady(WRF_ALLOWZOOM)
		2SAR M 3 A_WeaponReady(WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("asg/bolt1", 5)		
		2SAR QSRQQPPPPPP 1 A_WeaponReady(WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("asg/bolt2", 5)
		2SAR ONNMMMMMTUVWXYZ 1 A_WeaponReady(WRF_ALLOWZOOM)
		2SAR "[\" 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready

	SelectAnimationUnloaded:
		USAS A 0 A_PlaySound("ASG/Draw",5)
		USAS TSZY 1
		Goto ReadyNoFuckingAmmo

	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		TNT1 A 0 //ACS_NamedExecuteAlways("AimMode")
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		USAS A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		USAS A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		USAS A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		USAS A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		USAS A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		USAS A 0 A_JumpIfInventory("Unloading",1,"Unload")
		USAS A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,3)
		3SAR I 0 A_JumpIfInventory("HasUnloadedASG", 1, 2)
		USAS A 0
		"####" "###" 0
		"####" "#" 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		"####" "###" 0
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		USAS A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		USAS A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		USAS A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		USAS A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		USAS A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		USAS A 0 A_JumpIfInventory("Unloading",1,"Unload")
		USAS A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		USAS A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		//USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,5)
		USAS A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		USAS A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		USAS A 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		TNT1 AAA 0
		USAS J 1 A_WeaponReady//(WRF_ALLOWRELOAD) //KEEP IT TO ONE TO AVOID INPUT DELAY!
		Loop

	ReadyNoFuckingAmmo:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		USAS A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		USAS A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		USAS A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		USAS A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		USAS A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		USAS A 0 A_JumpIfInventory("Unloading",1,"Unload")
		USAS A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		USAS A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		//USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS A 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		3SAR I 1 BRIGHT A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop

	Deselect:
		USAS A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_Takeinventory("ADSmode",1)
		USAS A 0 A_TakeInventory("TossGrenade", 1)
		USAS A 0 A_TakeInventory("IsInspecting",1)
		USAS A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		tnt1 a 0 a_stopsound(5)
		USAS A 0 A_JumpIfInventory("HasUnloadedASG", 1, "DeselectUnloaded")
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"DeselectPurist")
		USAS UVWX 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	DeselectUnloaded:
		USAS "[]" 1
		USAS WX 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Fire:
		USAS J 0 A_JumpIfInventory("Zoomed",1,16)
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		USAS A 0
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"NoReload")
		//"####" "#" 0 A_TakeInventory("IsInspecting",1)
		"####" "#" 0 A_JumpIfInventory("HasUnloadedASG",1,"NoAmmo")
		"####" "#" 0 A_JumpIfInventory("AssaultShotgunAmmoOff",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("AssaultShotgunAmmoOff",1)
		"####" "#" 0 A_JumpIfInventory("AssaultShotgunAmmoOff",6,2)
		"####" "#" 0 A_PlaySound("weapons/lowammo",CHAN_AUTO)
		"####" "###" 0
		Goto ResumeFireFrame
		"####" "#" 0 A_JumpIfInventory("AssaultShotgunAmmoOff",1,1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+4

	NoReload:
		"####" "#" 0 A_JumpIfInventory("AmmoShell",1,1)
		Goto NoAmmo
		"####" "#" 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		"####" "###" 0
	ResumeFireFrame:
		"####" AAAA 0
		2SAS A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		USAS A 0
		"####" A 0 A_PlaySound("ASG/Fire", 1)
		"####" A 0 A_FireCustomMissile("DistantFireSoundShotgun", random(-1,1), 0, 0, -12, 0, random(-1,1))
		"####" AAAAAAAAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" AAA 0 A_FireCustomMissile("ShotgunParticles2", random(-12,12), 0, -1, 0, 0, random(-9,9))
		"####" A 0 A_AlertMonsters
		"####" A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,30)
		"####" AAAAAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-4,4), 0, -1, -12, 0, random(-4,4))
		"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" B 1 BRIGHT A_FireBullets (5, 5, 9, 11, "MachineGunBulletPuff", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (12, 4, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-6)
		"####" A 0
		"####" A 0 A_Quake(3,4,0,4,"")
		"####" AA 0 A_SetANgle(angle+random(-1, 1))
		"####" A 0 A_ZoomFactor(0.9)
		"####" A 0 A_SetPitch(-1.2 + pitch)
		"####" C 1 A_FireCustomMissile("ShotCaseSpawn",5,0,6,-14)
		"####" A 0 A_ZoomFactor(1.0)
		"####" DE 1 A_SetPitch(+0.6 + pitch)
		"####" FA 1
		"####" A 0 A_Refire
		Goto Ready
	
	DM:
		"####" B 1 BRIGHT A_FireBullets (5, 5, 9, 11, "MachineGunBulletPuffDM", FBF_NORANDOM)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		"####" A 0 A_FireBullets (12, 4, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		"####" A 0 A_SetPitch(pitch-6)
		"####" A 0
		"####" A 0 A_Quake(3,4,0,4,"")
		"####" AA 0 A_SetANgle(angle+random(-1, 1))
		"####" A 0 A_ZoomFactor(0.9)
		"####" A 0 A_SetPitch(-1.2 + pitch)
		"####" C 1 A_FireCustomMissile("ShotCaseSpawn",5,0,6,-14)
		"####" A 0 A_ZoomFactor(1.0)
		"####" DE 1 A_SetPitch(+0.6 + pitch)
		"####" FA 1
		"####" A 0 A_Refire
		Goto Ready

	IsHolding:
		USAS J 0 A_JumpIfInventory("ZoomHold", 1, 4)
		USAS J 0 A_GiveInventory("ZoomHold", 1)
		Goto Fire2+29
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("AssaultShotgunAmmoOff",0,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim

	Fire2: //Aiming DOwn the Sights
		USAS A 0
		USAS K 1 BRIGHT A_AlertMonsters
		//RIFF A 0 A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 0, 0, 0)
		USAS A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,45)
		"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		A12F A 0 BRIGHT A_FireBullets (5, 5, 9, 11, "MachineGunBulletPuff", FBF_NORANDOM)
		RIFF AAAAAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-4,4), 0, -1, -12, 0, random(-4,4))
		USAS A 0
		USAS A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (12, 4, 5, 13, "ShotgunPuff2", FBF_NORANDOM)
		USAS A 0 A_SetPitch(pitch-6)
		USAS A 0
		TNT1 AA 0 A_SetANgle(angle+random(-1, 1))
		USAS A 0 A_ZoomFactor(1.2)
		USAS A 0 A_SetPitch(-0.6 + pitch)
		USAS A 0 A_SetPitch(+0.3 + pitch)
		USAS L 1 A_FireCustomMissile("ShotCaseSpawn",5,0,6,0)
		USAS A 0 A_ZoomFactor(1.3)
		USAS M 1 A_SetPitch(+0.3 + pitch)
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		USAS A 0 A_JumpIfInventory("ZoomHold", 1, 2)
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		USAS AAA 0
		USAS NOJ 1
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		USAS A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		TNT1 AAA 0
		SHTZ A 0 A_Refire
		USAS A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		USAS A 0 A_JumpIfInventory("ZoomHold",1,"HoldAim")
		USAS J 5 A_WeaponReady(1)
		USAS A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		Goto Ready2
	
	DM2:
		A12F A 0 BRIGHT A_FireBullets (5, 5, 9, 11, "MachineGunBulletPuffDM", FBF_NORANDOM)
		RIFF AAAAAAAA 0 A_FireCustomMissile("DecorativeTracer", random(-4,4), 0, -1, -12, 0, random(-4,4))
		USAS A 0
		USAS A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//Tactical Mode deals extra damage
		SHTN A 0 A_FireBullets (12, 4, 5, 13, "ShotgunPuff2DM", FBF_NORANDOM)
		USAS A 0 A_SetPitch(pitch-6)
		USAS A 0
		Goto Fire2+18

	AltFire:
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		USAS A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		USAS A 0 A_Giveinventory("GoSpecial",1)
		USAS A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_SetCrosshair(41)
		USAS A 0 A_ZoomFactor(1.3)
		USAS A 0 A_Giveinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		USAS GHI 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		//TNT1 A 0 A_PlayWeaponSound("Shotgun/Fire/move")
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		USAS A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 5)
		USAS J 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		USAS J 4
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		USAS GHI 1 //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		USAS J 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		USAS AA 0
		USAS A 0 A_Giveinventory("ZoomHold",1)
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		TNT1 A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		TNT1 A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		TNT1 A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		TNT1 A 0 A_JumpIfInventory("Unloading",1,"Unload")
		TNT1 A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS J 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS J 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS J 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		USAS AA 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
	NoAim:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		USAS A 0 A_Takeinventory("ZoomHold",1)
		USAS A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_ZoomFactor(1.0)
		USAS A 0 A_Takeinventory("ADSmode",1)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		USAS IHG 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		TNT1 A 0 A_PlaySound("weapons/aim",5)
		3SAR I 0 A_JumpIfInventory("HasUnloadedASG", 1, 2)
		USAS A 0
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		USAS IHG 1// A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		TNT1 A 0 A_PlaySound("weapons/aim",5)
		3SAR I 0 A_JumpIfInventory("HasUnloadedASG", 1, 2)
		USAS A 0
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready


	ReloadEmpty:
		3SAR ABCDEFGH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ContinueReload

	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("AmmoShell",1,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		"####" "###" 0
		"####" "#" 0 a_jumpifinventory("HoldInspect",1,"InspectHold") 
		"####" "#" 0 A_JUMPIFINVENTORY("IsInspecting",1,"Inspect2")
		"####" "#" 0 A_JumpIfInventory("AssaultShotgunAmmoOff",0,"Inspect")
		"####" "#" 0 a_jumpifinventory("ASGReloadToken",1,"Inspect")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_Takeinventory("ADSmode",1)
		"####" "#" 0 A_Takeinventory("Zoomed",1)
		"####" "#" 0 A_Takeinventory("ZoomHold",1)
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		//"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_Takeinventory("ADSmode",1)
		USAS A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_Takeinventory("ZoomHold",1)
		USAS A 0 A_GiveInventory ("Pumping", 1)
		USAS A 0 A_Takeinventory("Reloading",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		USAS A 0 A_JumpIfInventory("TurboReload", 1, "InsertBullets")
		USAS A 0 A_JumpIfInventory("HasUnloadedASG", 1, "ReloadEmpty")
		USAS A 0
		USAR ABCDEFGHIIJJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("ASG/Reload1", 5)
		USAR JJKLMNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_FireCustomMissile("EmptyASGAmmoSpawn",-5,0,8,-4)
		USAS A 0 A_GiveInventory("HasUnloadedASG",1)
	ContinueReload:
		USAR PQRRSSSSSSSS 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAR TUVW 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("ASG/Reload2", 5)
		USAR XXYYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_TakeInventory("HasUnloadedASG",1)
		tnt1 a 0 A_GiveInventory("ASGReloadToken",1)
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff",1,"InsertBullets2")
		Goto InsertBullets

	CR2:
		2SAR A 0 //A_ClearReFire
		2SAR AABCDDDD 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2SAR E 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2SAR FGXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("USASPUL1", 5)
		tnt1 a 0 a_takeinventory("ASGReloadToken")
		USAS A 0 A_Takeinventory("HasUnloadedASG",1)
		2SAR "[\" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		Goto ReloadConcluded//ready

	CR3:
		2SAR A 0 //A_ClearReFire
		2SAR AABCDDDD 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2SAR EFGHIJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2SAR KL 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2SAR M 3 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("asg/bolt1", 5)		
		2SAR QSRQQPPPPPP 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("asg/bolt2", 5)
		2SAR ONNMMMMM 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		tnt1 a 0 a_takeinventory("ASGReloadToken")
		2SAR TUVWXYZ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		2SAR "[\" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_Takeinventory("HasUnloadedASG",1)		
		Goto ReloadConcluded//ready
	
	ReloadConcluded:
		USAS A 0 A_ClearReFire
		USAS A 0 A_Takeinventory("HasUnloadedASG",1)
		"####" "#" 0 A_TakeInventory("ASGReloadToken",1)
		USAS A 0 A_Refire
		Goto Ready3

	InsertBullets:
		TNT1 AAAA 0
		USAS A 0 A_Takeinventory("Reloading",1)
		TNT1 A 0 A_TakeInventory("HasUnloadedASG",1)
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff",0,"CR3")
		USAS A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto CR3
		TNT1 AAAAAA 0
		USAS A 0 A_Giveinventory("AssaultShotgunAmmoOff",1)
		USAS A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets
		TNT1 AAAAAAAAAA 0
		USAS A 0 A_Takeinventory("Reloading",1)
		USAS A 0 //A_Refire //Commented out so that reload animation can finish.
		Goto CR3
		TNT1 AAAA 0
		USAS A 0 A_Takeinventory("Reloading",1)
		USAS A 0 //A_Refire
		Goto CR3

	InsertBullets2:
		TNT1 AAAA 0
		USAS A 0 A_Takeinventory("Reloading",1)
		TNT1 A 0 A_TakeInventory("HasUnloadedASG",1)
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff",0,"CR2")
		USAS A 0 A_JumpIfInventory("AmmoShell",1,3)
		Goto CR2
		TNT1 AAAAAA 0
		USAS A 0 A_Giveinventory("AssaultShotgunAmmoOff",1)
		USAS A 0 A_Takeinventory("AmmoShell",1,TIF_NOTAKEINFINITE)
		Goto InsertBullets2
		TNT1 AAAAAAAAAA 0
		USAS A 0 A_Takeinventory("Reloading",1)
		USAS A 0 //A_Refire
		Goto CR2
		TNT1 AAAA 0
		USAS A 0 A_Takeinventory("Reloading",1)
		USAS A 0 //A_Refire
		Goto CR2

	//Inspect is also being repurposed as the rechambering anim
	Inspect:
		USAS A 0 A_JumpIfInventory("DoInspect",1,"ContinueInspect")
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueInspect")
		USAS A 6 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		USAS A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		USAS A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		USAS A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		USAS A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		USAS A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		USAS A 0 A_JumpIfInventory("Unloading",1,"Unload")
		USAS A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		USAS A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		3SAR I 0 A_JumpIfInventory("HasUnloadedASG", 1, 2)
		USAS A 0
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		USAS A 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		USAS A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		USAS AAA 0
		USAS A 0 A_GiveInventory("DoInspect",1)
		USAS A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		USAS A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueInspect:
		TNT1 AA 0
		"####" "#" 0 A_TakeInventory("ASGReloadToken",1)
		USAS A 0 A_TakeInventory("DoInspect",1)
		USAS A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		2SAR ZYXW 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2SAR VUT 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
	Inspect2:
		USAS A 0 A_Takeinventory("ZoomHold",1)
		USAS A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		USAS A 0 A_Takeinventory("ADSmode",1)
		2SAR M 3 A_WeaponReady(WRF_NOBOB)
		USAS A 0 A_PlaySound("asg/bolt1", 5)
		TNT1 A 0 A_TakeInventory("HasUnloadedASG",1)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		2SAR QSRQQPPP 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
	InspectHold:
		2SAR P 2 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		USAS A 0 A_PlaySound("asg/bolt2", 5)
		2SAR ONNMMMM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("HasUnloadedASG",1)
		TNT1 A 0 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOBOB)
		2SAR TUVWXYZ 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2SAR "[\" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	SelectRechamber:
		TNT1 AA 0
		"####" "#" 0 A_TakeInventory("ASGReloadToken",1)
		USAS A 0 A_TakeInventory("DoInspect",1)
		USAS A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		2SAR ZYXW 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2SAR VUT 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		USAS A 0 A_Takeinventory("ZoomHold",1)
		USAS A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_ZoomFactor(1.0)
		SMGR A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		USAS A 0 A_Takeinventory("ADSmode",1)
		2SAR M 3 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		USAS A 0 A_PlaySound("asg/bolt1", 5)
		TNT1 A 0 A_TakeInventory("HasUnloadedASG",1)
		"####" "#" 0 A_Giveinventory("IsInspecting",1)
		2SAR QSRQQPPP 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_GiveInventory("HoldInspect",1)
		2SAR P 2 A_WeaponReady(WRF_ALLOWRELOAD | WRF_NOFIRE)
		TNT1 A 0 A_TakeInventory("HoldInspect",1)
		USAS A 0 A_PlaySound("asg/bolt2", 5)
		2SAR ONNMMMM 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		TNT1 A 0 A_Takeinventory("HasUnloadedASG",1)
		2SAR TUVWXYZ 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		2SAR "[\" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_Takeinventory("IsInspecting",1)
		"####" "#" 0 A_Takeinventory("Reloading",1)
		Goto Ready

	User2:
	Unload:
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Unloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,"Ready")
		"####" "#" 0 A_JumpIfInventory("AssaultShotgunAmmoOff",1,3)
		Goto Ready
		TNT1 AAA 0
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_SetCrosshair( CallACS("GetCrosshair", 3) )
		"####" A 0 A_Takeinventory("Unloading",1)
		"####" A 0 A_Takeinventory("ADSmode",1)
		"####" A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_Takeinventory("Zoomed",1)
		USAS A 0 A_GiveInventory ("Pumping", 1)
		USAS A 0 A_Takeinventory("Reloading",1)
		3SAR I 0 A_JumpIfInventory("HasUnloadedASG", 1, "RemoveBullets2")
		USAS A 0 A_JumpIfInventory("TurboReload", 1, "InsertBullets")
		USAS A 0
		USAR ABCDEFGHIIJJ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_PlaySound("ASG/Reload1", 5)
		USAS A 0 A_Giveinventory("HasUnloadedASG",1)
		USAS A 0 A_GiveInventory ("Pumping", 1)
		USAS A 0 A_Takeinventory("Unloading",1)
	RemoveBullets:
		TNT1 AAAA 0
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff",1,1)
		Goto FinishUnload
		TNT1 AAAAAA 0
		USAS A 0 A_Takeinventory("AssaultShotgunAmmoOff",1)
		USAS A 0 A_Giveinventory("AmmoShell",1)
		Goto RemoveBullets

	FinishUnload:
		USAS A 0
		USAR JJKLMNOOOO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		3SAR HGFEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		USAS A 0 A_Giveinventory("HasUnloadedASG", 1)
		USAS A 0 A_Takeinventory("Unloading",1)
		Goto Ready//NoFuckingAMmo

	RemoveBullets2:
		TNT1 AAAA 0
		USAS A 0 A_JumpIfInventory("AssaultShotgunAmmoOff",1,1)
		Goto Ready
		TNT1 AAAAAA 0
		USAS A 0 A_Takeinventory("AssaultShotgunAmmoOff",1)
		USAS A 0 A_Giveinventory("AmmoShell",1)
		Goto RemoveBullets

	StartSprint:
		TNT1 A 0 A_TakeInventory("NeverSelectedASG",1)
		USAS A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		USAS A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		3SAR QRS 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		USAS P 0 offset(-9,32)
		//USAS A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		USAS A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprintTired")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		USAS A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		USAS A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		USAS A 0 offset(-9,32)
		3SAR T 1 offset(-9,34) A_SetPitch(pitch -0.5)
		3SAR T 1 offset(-6,36) A_SetPitch(pitch -0.5)
		3SAR T 1 offset(-3,38) A_SetPitch(pitch -0.5)
		3SAR T 1 offset(0,38) A_SetPitch(pitch -0.5)
		3SAR T 1 offset(3,36) A_SetPitch(pitch -0.5)
		3SAR T 1 offset(6,34) A_SetPitch(pitch -0.5)
		3SAR T 1 offset(9,32) A_SetPitch(pitch -0.5)
		USAS A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		USAS A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		USAS A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		USAS A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		USAS A 0 offset(-9,32) A_GiveInventory("UsedStamina", 6)
		USAS A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		3SAR T 1 offset(9,34) A_SetPitch(pitch +0.5)
		3SAR T 1 offset(6,36) A_SetPitch(pitch +0.5)
		3SAR T 1 offset(3,38) A_SetPitch(pitch +0.5)
		3SAR T 1 offset(0,38) A_SetPitch(pitch +0.5)
		3SAR T 1 offset(-3,36) A_SetPitch(pitch +0.5)
		3SAR T 1 offset(-6,34) A_SetPitch(pitch +0.5)
		3SAR T 1 offset(-9,32) A_SetPitch(pitch +0.5)
		USAS A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		USAS A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprintTired:
		3SAR SRQ 1
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		USAS A 0 A_PlaySound("Tired", 2)
		USAS A 0 A_TakeInventory("UsedStamina", 2)
		USAS A 5 A_WeaponReady
		USAS A 0 A_TakeInventory("UsedStamina", 2)
		USAS A 5 A_WeaponReady
		USAS A 0 A_TakeInventory("UsedStamina", 2)
		USAS A 5 A_WeaponReady
		USAS A 0 A_TakeInventory("UsedStamina", 2)
		USAS A 5 A_WeaponReady
		USAS A 0 A_TakeInventory("UsedStamina", 2)
		USAS A 5 A_WeaponReady
		Goto Ready3

	StopSprint:
		USAS A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		3SAR SRQ 1
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	Spawn:
		A12P A -1
		Stop
	}
}

ACTOR RailgunAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 5
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 5
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_Off_RailGun : RailGun
{
	Tag "Off-hand Railgun"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "AmmoCell"
	Weapon.AmmoType2 "RailgunAmmoOff"
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "misc/w_pkup"
	Inventory.Pickupmessage "$GOTRAILGUN"
	Obituary "$OBBD_RAILGUN"
	DropItem "RailgunSpawner"
	States
	{
	// posefix rsr: real VR reload (zscript/rsr/vreload.zs, team/reload/tools/rsr_patch.py BD_GUNS).
	// Not in VR, or with Real reload off, RSR_Start goes straight on into BD22's own reload.
	RSR_Start:
		RAIL A 0 A_TakeInventory("RSR_Go", 1)
		RAIL A 0 A_GiveInventory("RSR_Start", 1)
		RAIL A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto RSR_Stock
	RSR_Out:
		RAIL A 0 A_TakeInventory("RSR_Go", 1)
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun", 1, "RSR_Wait")	// no magazine in the gun
		RAIL A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:		// its rounds are held aside; they come back when a magazine is home,
				// so the count ends where BD22's own top-up reload ends, and the reserve's cap loses none
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff", 1, "RSR_Unload1")
		RAIL A 0 A_GiveInventory("HasUnloadedRailgun", 1)
		Goto RSR_Wait
	RSR_Unload1:
		RAIL A 0 A_TakeInventory("RailgunAmmoOff", 1)
		RAIL A 0 A_GiveInventory("RSR_Held_RailGun", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:		// the magazine is home: BD22's own fill loop (InsertBullets), its own items
		RAIL A 0 A_TakeInventory("RSR_Seated", 1)
		RAIL A 0 A_TakeInventory("HasUnloadedRailgun", 1)
	RSR_Return:		// the held rounds first
		RAIL A 0 A_JumpIfInventory("RSR_Held_RailGun", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		RAIL A 0 A_TakeInventory("RSR_Held_RailGun", 1)
		RAIL A 0 A_GiveInventory("RailgunAmmoOff", 1)
		Goto RSR_Return
	RSR_FillGo:
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff", 1, "RSR_FillB")	// the gun was not empty: no handle
		Goto RSR_FillA
	RSR_FillB:
		Goto RSR_FillB1
	RSR_FillA:
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff", 0, "RSR_Filled")
		RAIL A 0 A_JumpIfInventory("AmmoCell", 10, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		RAIL A 0 A_GiveInventory("RailgunAmmoOff", 1)
		RAIL A 0 A_TakeInventory("AmmoCell", 10, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_FillB1:
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff", 0, "RSR_Filled")
		RAIL A 0 A_JumpIfInventory("AmmoCell", 10, "RSR_FillB1a")
		Goto RSR_Filled
	RSR_FillB1a:
		RAIL A 0 A_GiveInventory("RailgunAmmoOff", 1)
		RAIL A 0 A_TakeInventory("AmmoCell", 10, TIF_NOTAKEINFINITE)
		Goto RSR_FillB1
	RSR_Filled:
		RAIL A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if it is due, else done
		Goto RSR_Wait
	RSR_Done:
		RAIL A 0 A_TakeInventory("RSR_Done", 1)
		RAIL A 0 A_TakeInventory("Reloading", 1)
		Goto RSR_End
	//EMPTY KICKS
	KickFlash: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmoOff",1,"KickFull")
		RAIL RSTU 1
		RAIL V 10
		RAIL UTSR 1
		stop
	SlideFlash: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmoOff",1,"SlideFull")
		RAIL RSTU  1
		RAIL V 35
		stop
	SlideFlashEnd: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmoOff",1,"SlideEndFull")
		RAIL V 6
		RAIL UTSR 1
		stop
	SlideFlashEndEarly: 
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIL D 0 
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist",1,"PuristKickFlash")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmoOff",1,"SlideEndEarlyFull")
		RAIL V 2
		RAIL UTSR 1
		stop
	//FULL KICKS
	KickFull:
		RAIL MNOP 1
		RAIL Q 10
		RAIL PONM 1
		stop
	SlideFull: 
		RAIL MNOP  1
		RAIL Q 35
		stop
	SlideEndFull: 
		RAIL Q 6
		RAIL PONM 1
		stop
	SlideEndEarlyFull: 
		RAIL Q 2
		RAIL PONM 1
		stop

	FirstSelectAnim:
		TNT1 A 0 A_Takeinventory("NeverSelectedRailgun",1)
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAR2 RSTUVW 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR HHIIIII 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR JKLMNO 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIL A 0 A_PlaySound("Railgun/Reload2", 5)
		RAIR OPPPQQRS 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR TTUVWXXXXX 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR YZF 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIR "[]" 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAR2 ABCDDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Plasma/Beep", 1)
		RAR2 GHHH 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Railgun/Recharge", 5)
		RAR2 IIIIJKLMNOPQ 1 A_WeaponReady(WRF_ALLOWZOOM)
		RAIL A 0 A_Takeinventory("Reloading",1)
		Goto Ready

	Deselect:
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL D 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		RAIL EFGH 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_Giveinventory("RailGunSelected",1)
		TNT1 A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
	SelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedRailgun", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedRailgun",1,"FirstSelectAnim")
		RAIL D 0 A_JumpIfInventory("IsPlayingAsPurist",1,8)
		RAIL LKJI 1 A_WeaponReady(WRF_NOFIRE)
		RA1S A 0 A_JumpIfInventory("HasUnloadedRailgun",1,5)
		RA1S A 0 A_JumpIfInventory("NoReloading",1,2)
		RA1S A 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		Goto SelectAnimation+11
		RA1S A 0 A_JumpIfInventory("AmmoCell",1,1)
		Goto SelectAnimation+11
		RAIL A 0 A_PlaySound("Railgun/Recharge", 5)
		RAIL D 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
	Ready:
	Ready3:
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		//TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL A 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RAIL A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RAIL A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAIL A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL D 0 A_JumpIfInventory("NoReloading",1,2)
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",1,5)
		Goto Ready+14
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,4)
		RAIZ O 0 A_JumpIfInventory("Zoomed", 1, 2)
		RAIL D 0 
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Goto Ready//ReadyNoAmmo
		TNT1 AAAA 0
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		RAIL ABC 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Goto Ready

	ReadyNoAmmo:
		RAIZ O 0 A_JumpIfInventory("Zoomed", 1, 2)
		RAIL D 0 
		"####" "#" 1 A_WeaponReady//(WRF_ALLOWRELOAD)
		Goto Ready

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		RAIL A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL A 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RAIL A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RAIL A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAIL A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RAIZ D 0
		"####" "#" 0 A_JumpIfInventory("NoReloading",1,3)
		"####" "#" 0 A_JumpIfInventory("RailgunAmmoOff",1,4)
		RAIZ O 0
		Goto Ready2+15
		"####" "#" 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0
		"####" "#" 0 A_JumpIfInventory("AimMode_Toggle",1,5)
		"####" "#" 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		"####" "###" 0
		"####" "#" 3 BRIGHT A_WeaponReady//(WRF_ALLOWRELOAD)
		Loop


	DontNeedToReload:
		RAIL A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		Goto Ready

	Fire:
		RAIL D 0 A_JumpIfInventory("Zoomed",1,6)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"NoReload")
		"####" "#"  0 A_JumpIfInventory("NoReloading",1,"NoReload")
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		RAIL D 0
		Goto NoAmmo//Reload
		"####" "#"  0 A_Takeinventory("RailgunAmmoOff",1)
		Goto ResumeFireFrame
		"####" "#"  0 A_JumpIfInventory("NoReloading",1,3)
		RAIZ D 0 A_JumpIfInventory("RailgunAmmoOff",1,4)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto NoAmmo
		RAIZ D 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto NoAmmo
		"####" "###" 0
		Goto Fire+1

	NoReload:
		"####" "#"  0 A_JumpIfInventory("AmmoCell",10,2)
		RAIL D 0
		Goto NoAmmo//DontNeedToReload
		"####" "#"  0 A_Takeinventory("AmmoCell",10,TIF_NOTAKEINFINITE)
	ResumeFireFrame:
		"####" "##" 0
		"####" "#"  0 A_PlaySound("Railgun/Fire", 1)
		"####" "#"  0 A_AlertMonsters
		"####" "#" 0 A_Quake(4,4,0,4,"")
		"####" "#"  0 A_FireCustomMissile("RailgunTrailEffectMissile", 0, 0, 0, 0)
		"####" "#"  0 A_FireCustomMissile("RailgunProjectile", 0, 1, 0, 0)
		//"####" "#" 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" "#"  0 A_RailAttack(400, 0, 0, "none", "none", RGF_FULLBRIGHT, 1, "RailgunPuff2")
		"####" "#"  0 A_JumpIfInventory("Zoomed",1,"ZoomedRecoil")
		2AIF A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		RAIF A 0
		"####" AB 1 BRIGHT
		"####" A 0 A_SetPitch(-8.0 + pitch)
		"####" A 0 A_ZoomFActor(0.7)
		"####" CD 1 A_SetPitch(-0.5 + pitch)
		"####" A 0 A_ZoomFActor(1.0)
		"####" A 0 
		"####" EF 1
		"####" G 1 A_SetPitch(0.5 + pitch)
		RAIF H 1 A_SetPitch(0.5 + pitch)
		RAIF HHHHHHHH 1 A_SetPitch(1.0 + pitch)
		RAIF HHHH 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIF H 0 A_JumpIfInventory("NoReloading",1,2)
		RAIF H 0 A_JumpIfInventory("RailgunAmmoOff",1,3)
		Goto NoAmmo//Ready+14
		RAIF H 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo//Ready+14
		RAIL AAAA 0 
		RAIL A 0 A_PlaySound("Railgun/Recharge", 5)
		RAIF IJK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIF KKKKKKKKKKKKKKKKKKKK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Plasma/BeepBeep", 6)
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "AltFire")
		RAIL A 0 A_Refire
		TNT1 AAAA 0
		Goto Ready3
	
	DM:
		"####" "#"  0 A_RailAttack(400, 0, 0, "none", "none", RGF_FULLBRIGHT, 1, "RailgunPuff2DM")
		Goto ResumeFireFrame+10

	IsHolding:
		RAIZ D 0 A_JumpIfInventory("ZoomHold", 1, 3)
		RAIZ D 0 A_GiveInventory("ZoomHold", 1)
		Goto ZoomedRecoil+11
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		"####" "#" 0 A_JumpIfInventory("RailgunAmmoOff",5,3)
		Goto Reload+6//NoAim
		"####" "###" 0
		"####" "#" 0 A_TakeInventory("Reloading", 1)
		Goto HoldAim
	ZoomedRecoil:
		RAIZ D 0
		RAIZ EF 1 BRIGHT A_AlertMonsters
		RAIZ D 0 A_SetPitch(-4.0 + pitch)
		RAIZ D 0 A_ZoomFActor(5.1)
		RAIZ GHI 1 A_FireCustomMissile("SmokeSpawner",0,0,0,5)
		RAIZ D 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RAIZ D 0 A_JumpIfInventory("ZoomHold", 1, 2)
		RAIZ D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "IsHolding")
		RAIZ DDD 0
		RAIZ D 0 A_ZoomFActor(5.0)
		RAIZ JKKKKKKK 1 BRIGHT A_SetPitch(0.5 + pitch)
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,3)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmoOff",1,4)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto Reload//NoAmmo
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0 A_Takeinventory("PowerLightAmp", 1)
		Goto Reload//NoAmmo//Reload
		TNT1 AA 0
		RAIZ D 0 A_JumpIfInventory("AimMode_Toggle",1,2)
		RAIZ D 0 A_JumpIfInventory("ZoomHold",1,"HoldZoomedRecoil")
		RAIZ KKKKKK 1 BRIGHT A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "SuddenStopAim")
		RAIZ D 0 A_PlaySound("Railgun/Recharge", 5)
		RAIZ D 0 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIZ KKKKKKKKKKKKK 2 BRIGHT A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "SuddenStopAim2")
		RAIZ D 0 A_JumpIfInventory("ZoomHold",1,"SuddenStopAim2")
		RAIZ D 0 A_PlaySound("Plasma/BeepBeep", 6)
		"####" "#" 1 A_Refire
		Goto Ready2

	HoldZoomedRecoil:
		RAIZ KKKKKK 1 BRIGHT
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 2)
		Goto SuddenStopAim
		RAIL AA 0
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,2)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmoOff",1,3)
		Goto HoldZoomedRecoil+12
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ D 0
		Goto NoAmmo//Ready
		RAIL AA 0 
		RAIZ D 0 A_PlaySound("Railgun/Recharge", 5)
		RAIZ D 0 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIZ KKKKKKKKKKKKK 2 BRIGHT
		TNT1 A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 2)
		Goto SuddenStopAim2
		RAIZ DD 0
		RAIZ D 0 A_PlaySound("Plasma/BeepBeep", 6)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")//If still pressing alt fire, it means its holding aim
		"####" "#" 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		"####" "#" 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		"####" "#" 1 A_Refire
		"####" "#" 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		"####" "#" 0 A_JumpIfInventory("ZoomHold",1,"NoAim")
		Goto NoAim

	SuddenStopAim:
		RAIL A 0
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIZ BA 1
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,2)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmoOff",1,3)
		Goto SuddenStopAim+10
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo//Reload
		TNT1 AA 0
		RAIF H 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Railgun/Recharge", 5)
		RAIF IJK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIF KKKKKKKKKKKKKKKKKKKK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Plasma/BeepBeep", 6)
		Goto Ready

	SuddenStopAim2:
		RAIL A 0
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIZ BA 1
		RAIZ K 0 A_JumpIfInventory("NoReloading",1,2)
		RAIZ K 0 A_JumpIfInventory("RailgunAmmoOff",1,3)
		Goto SuddenStopAim2+10
		RAIZ K 0 A_JumpIfInventory("AmmoCell",1,2)
		Goto NoAmmo//Reload
		TNT1 AA 0
		RAIF KKKKKKKKK 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		RAIL A 0 A_PlaySound("Plasma/BeepBeep", 6) 
		Goto Ready

	AltFire:
		RAIL A 0
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		TNT1 A 0 A_SetCrosshair(41)
		RAIL A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		RAIL A 0 A_Giveinventory("Zoomed",1)
		//RAIL A 0 A_Giveinventory("ADSMode",1)
		RAIL A 0 A_ZoomFActor(5.0)
		TNT1 A 0 A_PlaySound("ads/in", 5)
		TNT1 A 0 A_PlaySoundEx("RAIL_ZM",CHAN_WEAPON)
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun",1,"UnloadedAltFire")
		RAIL A 0 A_JumpIfInventory("NoReloading",1,2)
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		Goto UnloadedAltFire
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,1)
		Goto UnloadedAltFire
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleAim")
		RAIZ ABC 1 BRIGHT A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		RAIL A 0 A_giveinventory("PowerLightAmp", 1)
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RAIL A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		RAIZ D 5 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RAIZ D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		RAIZ D 4 BRIGHT
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	ToggleAim:
		RAIZ ABC 1 BRIGHT //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		RAIL A 0 A_giveinventory("PowerLightAmp", 1)
		RAIZ D 5 BRIGHT A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	HoldAim:
		RAIZ D 0
		"####" "#" 0 A_Giveinventory("ZoomHold",1)
		RAIZ O 0 A_JumpIfInventory("HasUnloadedRailgun",1,6)
		RAIZ D 0 A_JumpIfInventory("NoReloading",1,4)
		RAIZ D 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		RAIZ O 0
		"####" "#" 0 
		Goto HoldingAim
		RAIZ D 0 A_JumpIfInventory("AmmoCell",1,2)
		RAIZ O 0
	HoldingAim:
		"####" "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" "#" 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" "#" 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" "#" 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		"####" "#" 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "#" 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		"####" "#" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		"####" "##" 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldingAim")
	NoAim:
		TNT1 A 0 A_PlaySound("RAIL_UZ",CHAN_WEAPON)
		TNT1 A 0 A_PlaySound("ads/out", 5)
		RAIL A 0 A_Light0
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun",1,"UnloadedNoAim")
		RAIL A 0 A_JumpIfInventory("NoReloading",1,2)
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		Goto UnloadedNoAim
		RAIL A 0 A_JumpIfInventory("AmmoCell",1,1)
		Goto UnloadedNoAim
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"ToggleNoAim")
		RAIZ CBA 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL ABCABC 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	ToggleNoAim:
		RAIZ CBA 1 BRIGHT //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL ABCABC 1 BRIGHT A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	///////////////////////////////////////////////

	UnloadedAltFire:
		RAIL A 0
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"UnloadedToggleAim")
		RAIZ LMN 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,3)
		RAIL A 0 A_JumpIfInventory("AimMode_Hold",1,"HoldAim")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), 3)
		RAIZ O 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2
		TNT1 AAA 0
		RAIZ D 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "HoldAim")
		RAIZ O 4
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "HoldAim")
		Goto Ready2

	UnloadedToggleAim:
		RAIZ LMN 1 BRIGHT //A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		RAIZ O 5 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready2

	UnloadedNoAim:
		RAIL A 0 A_JumpIfInventory("AimMode_Toggle",1,"UnloadedToggleNoAim")
		RAIZ NML 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		"####" "#" 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		"####" "#" 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL D 1 BRIGHT A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
		Goto Ready

	UnloadedToggleNoAim:
		RAIZ NML 1 BRIGHT 
		RAIL D 0 A_WeaponReady(1)//A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY|WRF_NOBOB)
		Goto Ready

	Fidget:
		RAIL A 0 A_JumpIfInventory("DoInspect",1,"ContinueFidget")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredSecondary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 134217728) != 0), "ContinueFidget")
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
		TNT1 A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL A 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		RAIL A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		RAIL A 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		RAIL A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		RAIL A 0 A_JumpIfInventory("Unloading",1,"Unload")
		RAIL A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		RAIL ABCABC 1 A_WeaponReady(WRF_ALLOWZOOM)
		USAS A 0 A_GiveInventory("DoInspect",1)
		RAIL A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		RAIL A 0 A_TakeInventory("DoInspect",1)
		Goto Ready3

	ContinueFidget:
		TNT1 AA 0
		RAIL A 0 A_TakeInventory("DoInspect",1)
		RAR2 QPONMLK 1 A_WeaponReady
		TNT1 A 0 A_PlaySound("Plasma/Beep", 5)
		RAR2 JJIIIIIIIIIJKLMNOPQ 1 A_WeaponReady
		RAIL A 0 A_Takeinventory("Reloading",1)
		Goto Ready

	Reload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1,"IsHolding")
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		"####" "#" 0 A_JumpIfInventory("NoReloading", 1, "Ready")
		"####" "#" 0 A_JumpIfInventory("AmmoCell",10,3)
		"####" "#" 0 A_JumpIfInventory("ZoomHold", 1, "HoldAim")
		Goto Ready
		TNT1 AAAA 0
		RAIL A 0 A_Takeinventory("ADSmode",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",0,"Fidget")
		RAIL A 0 A_JumpIfInventory("TurboReload", 1, "InsertBullets")
		RAIL A 0 A_Takeinventory("ADSmode",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("ZoomHold",1)
		Goto RSR_Start	// posefix rsr: real VR reload (zscript/rsr/vreload.zs)
	RSR_Stock:
		RAIL A 0 A_JumpIfInventory("HasUnloadedRailgun",1, 3)
		RAIL A 0 A_PlaySound("Railgun/Reload1", 5)
		RAIL A 0 A_FireCustomMissile("PlasmaCaseSpawn",-30,0,-4,-4)
		RAIR ABCDEFGHHIIIIIIIIII 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR JKLMNO 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_PlaySound("Railgun/Reload2", 5) //8 frames of "build up"
		RAIR OPPPQQRS 1  A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)

	InsertBullets:
		TNT1 AAAA 0
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",0,"FinishReload")
		RAIL A 0 A_JumpIfInventory("AmmoCell",10,3)
		Goto FinishReload
		TNT1 AAAAAA 0
		RAIL A 0 A_Giveinventory("RailgunAmmoOff",1)
		RAIL A 0 A_Takeinventory("AmmoCell",10,TIF_NOTAKEINFINITE)
		Loop

	FinishReload:
		//TNT1 A 0 A_ClearRefire
		RAIR TTUVWXXXXX 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR YZF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR "[]" 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAR2 ABCDDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
	RSR_End:		// posefix rsr: the real VR reload ends here (a label: no state added)
		TNT1 A 0 A_PlaySound("Plasma/Beep", 5)
		RAR2 GHHH 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Railgun/Recharge", 5)
		RAR2 IIIIJKLMNOPQ 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_Takeinventory("HasUnloadedRailgun", 1)
		RAIL A 0 A_Takeinventory("Reloading",1)
		"####" "#" 0 A_ReFire
		Goto Ready

	User2:
	Unload:
		"####" "#" 0
		"####" "#" 0 A_JumpIfInventory("Zoomed", 1,"NoAim")
		"####" "#" 0 A_Takeinventory("Unloading",1)
		2HTN E 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristWarning")
		RAIL A 0 A_JumpIfInventory("NoReloading",1,"Ready")
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		Goto Ready
		TNT1 AA 0
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_Takeinventory("Unloading",1)
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_ZoomFActor(1.0)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 11) )
		RAIR ABCDEF 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIR ZYXXX 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_PlaySound("Railgun/Reload1", 5)
		RAIR VUT 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_Giveinventory("HasUnloadedRailgun",1)
	RemoveBullets:
		TNT1 AAAA 0
		RAIL A 0 A_JumpIfInventory("RailgunAmmoOff",1,3)
		Goto FinishUnload
		TNT1 AAAAAA 0
		RAIL A 0 A_Takeinventory("RailgunAmmoOff",1)
		RAIL A 0 A_Giveinventory("AmmoCell",10)
		Goto RemoveBullets
	FinishUnload:
		RAIR SRQPONMLKJIIIIHHGFEDCBA 1 A_WEAPONREADY(WRF_NOBOB|WRF_NOFIRE|WRF_ALLOWZOOM)
		RAIL A 0 A_Takeinventory("Unloading",1)
		Goto Ready

	Spawn:
		SRCG A -1
		Stop

	StartSprint:
		TNT1 A 0 A_Takeinventory("NeverSelectedRailgun",1)
		RAIL A 0 A_JumpIfInventory("Zoomed", 1, "NoAim")
		RAIL A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		TNT1 A 0 A_JumpIfInventory("RailgunAmmoOff",1,"StartSprintFull")
		RAIL RST 1 A_WeaponReady(WRF_NOFIRE)
		Goto Sprinting
	StartSprintFull:
		RAIL MNO 1 A_WeaponReady(WRF_NOFIRE)
	Sprinting:
		RAIL A 0 offset(-9,32)
		//RAIL A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		RAIL A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		PLAY A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		RAIL A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		RAIL A 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RAIL A 0 offset(-9,32)
		RAIL P 0 A_JumpIfInventory("RailgunAmmoOff",1,2)
		RAIL U 0
		RAIL "#" 1 offset(-9,34) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(-6,36) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(-3,38) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(0,38) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(3,36) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(6,34) A_SetPitch(pitch -0.5)
		RAIL "#" 1 offset(9,32) A_SetPitch(pitch -0.5)
		RAIL "#" 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		RAIL "#" 0 A_JumpIfInventory("Kicking",1,"DoKick")
		RAIL "#" 0 A_JumpIfInventory("Taunting",1,"GoTaunt")
		RAIL "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")
		RAIL "#" 0 offset(-9,32) A_GiveInventory("UsedStamina", 5)
		RAIL "#" 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		RAIL "#" 1 offset(9,34) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(6,36) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(3,38) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(0,38) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(-3,36) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(-6,34) A_SetPitch(pitch +0.5)
		RAIL "#" 1 offset(-9,32) A_SetPitch(pitch +0.5)
		RAIL "#" 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		RAIL "#" 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		RAIL O 0 A_JumpIfInventory("RailgunAmmoOff",1,"StopSprintFull")
		RAIL TSR 1
		RAIL A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	StopSprintFull:
		RAIL ONM 1
		RAIL A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		PLAY A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready3

	GoTaunt:
		RAIL A 0
		RAIL A 0 A_Light0
		RAIL A 0 A_Takeinventory("Zoomed",1)
		RAIL A 0 A_Takeinventory("PowerLightAmp", 1)
		RAIL A 0 A_ZoomFActor(1.0)
		Goto Taunt
	}
}

