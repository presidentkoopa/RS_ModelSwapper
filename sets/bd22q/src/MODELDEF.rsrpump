	Scale 0.3468 0.3468 0.3468
	Offset -16.2756 -0.0080 0.0
	ZOffset -0.0527
	USEACTORPITCH
	USEACTORROLL
	FrameIndex RQUW A 0 4
}


// RSR-PUMP: Ermac's one-shell hold (ammo_hand frame 1) without his shell: the gun's own shell is
// drawn in it on layer 2210 (rsr/rsr_pump.zs). ammo_hand.md3 is already in the packs (models/rsq).
Model RSQ_Hands
{
	Path "models/rsq/fbx"
	Model 0 "fbx_oh_hold_R.md3"
	Skin 0 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQUN A 0 23	// off-hand FBX lane: the FBX hand round the shell (RQHF X); was Ermac ammo_hand 1
}
