// RSR-PUMP (zscript/rsr/rsr_pump.zs, tools/gen_pump.py): BD22/Shot_Gun. The gun's own model and
// frames; pieces shown or hidden by a clear skin (every surface has its own SurfaceSkin:
// models_md3.cpp reads SurfaceSkin only when a block has no Skin).

// the gun without its pump and bolt (they are on their own layers while the hand works it)
Model Shot_Gun
{
	Path "models/bd/ShotGun"
	Model 0 "Shotgun.md3"
	SurfaceSkin 0 0 "Shotgun.png"
	SurfaceSkin 0 1 "Shotgun.png"
	SurfaceSkin 0 2 "Shotgun.png"
	SurfaceSkin 0 3 "Shotgun.png"
	SurfaceSkin 0 4 "rsr_clear.png"
	SurfaceSkin 0 5 "rsr_clear.png"
	SurfaceSkin 0 6 "Shotgun.png"
	Scale -1.0000 1.0000 1.0000
	Offset -3.502 -4.257 0.0
	ZOffset -8.973
	AngleOffset 3.854
	PitchOffset 3.363
	RollOffset 10.974	// shotguns (lane B): gun to the FBX hand fitted from 1.92
	NoInterpolation
	FrameIndex RQUG A 0 4
}

// the pump alone (main controller)
Model RSR_GunParts
{
	Path "models/bd/ShotGun"
	Model 0 "Shotgun.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "rsr_clear.png"
	SurfaceSkin 0 2 "rsr_clear.png"
	SurfaceSkin 0 3 "rsr_clear.png"
	SurfaceSkin 0 4 "Shotgun.png"
	SurfaceSkin 0 5 "rsr_clear.png"
	SurfaceSkin 0 6 "rsr_clear.png"
	Scale -1.0000 1.0000 1.0000
	Offset -3.502 -4.257 0.0
	ZOffset -8.973
	AngleOffset 3.854
	PitchOffset 3.363
	RollOffset 10.974	// shotguns (lane B): gun to the FBX hand fitted from 1.92
	NoInterpolation
	FrameIndex RQUP A 0 4
}

