
// RS real VR reload, break-open / revolver (zscript/rsr/rsr_break.zs, tools/gen_rsb.py): BD22/SSG.
// The gun's own model and frames; pieces shown or hidden by a clear skin.

// the gun without its hinged part and rounds (the gun's layer while the action is open)
Model SSG
{
	Path "models/bd/SSG"
	Model 0 "SSG.md3"
	SurfaceSkin 0 0 "rsr_clear.png"
	SurfaceSkin 0 1 "ssg.png"
	SurfaceSkin 0 2 "rsr_clear.png"
	SurfaceSkin 0 3 "rsr_clear.png"
	SurfaceSkin 0 4 "ssg.png"
	SurfaceSkin 0 5 "ssg.png"
	SurfaceSkin 0 6 "ssg.png"
	Scale -1.0000 1.0000 1.0000
	Offset -3.813 -3.959 0.0
	ZOffset -12.773
	AngleOffset 3.854
	PitchOffset 3.363
	RollOffset 10.974	// r11 port (lane B): gun to the FBX hand fitted from 1.92
	NoInterpolation
	FrameIndex RBSG A 0 1
}

