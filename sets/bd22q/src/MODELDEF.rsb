// RSR-BREAK: Ermac's off hand holding one shell (ammo_hand frame 1) and a cell (frame 5), without
// his ammo: the gun's own round / speedloader is drawn in it on layer 2202 (MODELDEF.rsb above)
Model RSQ_Hands
{
	Path "models/rsq/fbx"
	Model 0 "fbx_oh_hold_R.md3"
	Skin 0 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQHN J 0 18	// off-hand FBX lane: was Ermac ammo_hand 1; = the FBX SSG shell hold (RQHF S)
	FrameIndex RQHN L 0 21	// was Ermac ammo_hand 5; = the FBX Moonlight speedloader hold (RQHF V)
}
