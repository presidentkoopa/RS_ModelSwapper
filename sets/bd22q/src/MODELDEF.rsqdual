// RS VR hands for DUAL WIELD (2026-10-16, owner): a gun in the off hand, or both hands holding
// guns, is held by a posed hand on each. The off-hand gun owns its hand layer (only the off-hand
// weapon may draw on the off controller), so the hand is a model of the GUN's class: hand.md3 at
// the gun's own hook from handtable.zs, baked into Offset (no hook rotation on these guns).
// Drawn by RSQ_DualHands (zscript/rsq/dualhands.zs). Generated from handtable.zs + MODELDEF.rsq.

Model AssaultShotgun
{
	Path "models/rsq"
	Model 0 "hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset -0.490 -21.190 -11.840
	FrameIndex RQGT A 0 10
	FrameIndex RQGU A 0 11
}

