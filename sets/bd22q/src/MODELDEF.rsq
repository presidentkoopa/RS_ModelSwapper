// 2026-10-16 (owner): the gun hand's own fist and grenade hold, Ermac's meshes at his own
// placement (no hook): his fist (hand.md3 frame 1, the free hand's fist too), and his
// the VR grenade's hand: the FBX hand (fbx/fbx_nade_R.md3, fit_nade.py), was Ermac's ammo hand (ammo_hand.md3 frame 3)
// off-hand FBX lane (owner 2026-10-28: the fists become FBX, overriding the 2026-10-16 "fists are Ermac's"): the FBX hand's fist
// fitted IN PLACE of Ermac's fist (hand.md3 frame 1, same block, knuckles forward; tools/handfit/offhand/free_oh.py, poses/offhand/free.json).
// One right-hand frame draws both fists, as Ermac's did: the engine mirrors the off controller.
Model RSQ_GunSide
{
	Path "models/rsq/fbx"
	Model 0 "fbx_oh_free_R.md3"
	Skin 0 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQGF A 0 1
}

Model RSQ_GunSide
{
	Path "models/rsq/fbx"
	Model 0 "fbx_nade_R.md3"
	Skin 0 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQGN A 0 0	// grenade hand (lane B): the FBX hand, fit_nade.py (frame baked in place, hook 0)
}

// the free hand (off controller): open, or a fist; and the VR grenade's ring between finger and thumb (ONE block: two blocks
// on the same frame draw only one of them, 1.1).
// off-hand FBX lane (2026-10-28): the FBX RIGHT rig fitted in place of Ermac's own frames (tools/handfit/offhand/free_oh.py,
// poses/offhand/free.json): frame 0 open (hand.md3 0), 1 fist (hand.md3 1), 2 the ring pinch (ammo_hand.md3 1, index and thumb
// pads closed); the ring = rsq_ring.md3 moved 2.05 cm from Ermac's pinch point to the FBX one (rsq_ring_oh.md3). Baked in place.
// Was r12's fbx_r12_free_L.md3: the pistol hand mirrored to L, which the engine's off-controller mirror turned back into a
// RIGHT hand on the left controller (rig frames lane_b_out/offhand_gate/shots/hand0_left*.png).
Model RSQ_Hands
{
	Path "models/rsq/fbx"
	Model 0 "fbx_oh_free_R.md3"
	Skin 0 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQHN A 0 0
	FrameIndex RQHN H 0 1
}

Model RSQ_Hands
{
	Path "models/rsq/fbx"
	// 2.0 int r2: the ring's Model 1 line comes FIRST. build.py moves the FBX hand to Model 7, and QZD sizes a block by its LAST
	// Model line (models.cpp: modelsAmount = index + 1), so "Model 7 ... Model 1" was 2 slots: "Too many models in RSQ_Hands".
	Model 1 "rsq_ring_oh.md3"
	Skin 1 "models/bd/Grenade/nade.png"
	Model 0 "fbx_oh_free_R.md3"
	Skin 0 "fbx_hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQHR A 0 2
	FrameIndex RQHR A 1 0
}

// The VR scope's collimated reticle (zscript/rsq/scope.zs, layer RSQ_ScopeLayers.DOT).
//
// It is a MODEL and not a sprite on purpose. A psprite layer only reaches
// Weapon.ModifyBobLayer3D -- the hook that places a layer in the controller's 3D frame -- when
// it resolves to a model: hw_weapon.cpp:927 does "if (!smf) continue;" in the 3D pass and
// :842 does "if (smf) continue;" in the 2D one. A sprite layer would get only the 2D
// screen-space bob, i.e. a crosshair painted on the screen, which is the parallax-locked thing
// a collimated sight exists to avoid.
//
// AngleOffset 90 (1.99x r6): without it the quad was edge-on to the eye and never seen.
// Offset 0.0 -30.0 -5.0 cancels RenderHUDModel's fixed translate(0, 5, 30) at Scale -1 1 1, so
// the quad's origin sits exactly ON the weapon controller -- the frame RSQ_ScopeTable.Lens is
// measured in. Check: model origin (0,0,0) -> p = (0,-5,-30) -> 0.01*((0,-5,-30)+(0,5,30)) = 0.
Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "rsq_dot.md3"
	Skin 0 "RQRTA0.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -30.0 -5.0
	AngleOffset 90	// 1.99x r6: the quad is authored in the md3's y=0 plane, which the HUD chain turns
					// edge-on to an eye behind the scope; this faces it back (models.cpp:272 rotates
					// about the model origin, after every offset, so the dot does not move)
	FrameIndex RQRT A 0 0
}

Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "rsq_dot.md3"
	Skin 0 "RQRTB0.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -30.0 -5.0
	AngleOffset 90	// 1.99x r6: the quad is authored in the md3's y=0 plane, which the HUD chain turns
					// edge-on to an eye behind the scope; this faces it back (models.cpp:272 rotates
					// about the model origin, after every offset, so the dot does not move)
	FrameIndex RQRT B 0 0
}

