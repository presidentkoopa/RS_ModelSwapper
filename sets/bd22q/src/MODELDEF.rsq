Model HandGrenades
{
   Path "models/bd/Grenade"
   Model 0 "nade.md3"
   Skin 0 "nade.png"
   Scale -0.92 0.92 0.92
   Offset -12.075 -8.898 0.0
   NoInterpolation
   ZOffset 2.326
   AngleOffset -18.317
