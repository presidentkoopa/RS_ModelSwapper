// RSRL HUD follow (RSQ Weapon Depot, step S4): his wrist watch stays on the wrist and his gun ammo display
// stays on the gun while the gun animates.
//
// His watch layers (1050-1059) and gun display layers (1060-1066) are rebuilt every tic by
// DoomWeaponZ.Tick; each draws a sprite whose MODELDEF frame is the Ready pose. When the weapon frame drawn
// is one of the measured off-pose frames (rsrl_hudfollow_table.zs, generated by tools/gen_hudfollow.py),
// Apply() swaps each of those layers' sprites to that pose's copy (Y<pose><base>), whose MODELDEF blocks
// (modeldefs/rsrl_hudfollow.txt) put the watch on the wrist's frame and the panel on the gun's moved body.
// The frame letter (colour, digit) is kept, so his settings and numbers still choose what is shown.

class RSRL_HudFollow play
{
	static void Apply(Weapon w, PlayerInfo p)
	{
		if (!w || !p)
			return;
		let cv = CVar.GetCVar('rsrl_hudfollow', p);
		if (cv && !cv.GetInt())
			return;
		let psw = p.FindPSprite(PSP_WEAPON);
		if (!psw)
			return;
		int v = Pose(w, psw.Sprite, psw.Frame);
		if (v <= 0)
			return;
		for (int l = 1050; l <= 1066; l++)
		{
			let q = p.FindPSprite(l);
			if (!q)
				continue;
			for (int b = 0; b < BASES; b++)
			{
				if (q.Sprite == Actor.GetSpriteIndex(BaseName(b)))
				{
					q.Sprite = Actor.GetSpriteIndex(VarName(v, b));
					break;
				}
			}
		}
	}
}
