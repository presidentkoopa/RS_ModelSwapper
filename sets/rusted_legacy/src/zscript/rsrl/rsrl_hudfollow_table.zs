extend class RSRL_HudFollow
{
	const POSES = 33;
	const BASES = 27;
	static name BaseName(int b)
	{
		switch (b)
		{
		case 0: return 'WH00';
		case 1: return 'WH01';
		case 2: return 'WH02';
		case 3: return 'WH03';
		case 4: return 'WH04';
		case 5: return 'WH05';
		case 6: return 'WH06';
		case 7: return 'WH07';
		case 8: return 'WH08';
		case 9: return 'WH09';
		case 10: return 'WH10';
		case 11: return 'WH11';
		case 12: return 'HH00';
		case 13: return 'HH01';
		case 14: return 'HH02';
		case 15: return 'HH03';
		case 16: return 'HH04';
		case 17: return 'HH05';
		case 18: return 'HH06';
		case 19: return 'HH10';
		case 20: return 'HH11';
		case 21: return 'HH12';
		case 22: return 'HH13';
		case 23: return 'HH14';
		case 24: return 'HH15';
		case 25: return 'HH16';
		case 26: return 'HH20';
		}
		return 'TNT1';
	}

	// pose v's copy of base sprite b: Y<v><W + watch layer | H/I/J + panel layer>
	static name VarName(int v, int b)
	{
		string c = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
		string t;
		switch (b)
		{
		case 0: t = "W0"; break;
		case 1: t = "W1"; break;
		case 2: t = "W2"; break;
		case 3: t = "W3"; break;
		case 4: t = "W4"; break;
		case 5: t = "W5"; break;
		case 6: t = "W6"; break;
		case 7: t = "W7"; break;
		case 8: t = "W8"; break;
		case 9: t = "W9"; break;
		case 10: t = "WA"; break;
		case 11: t = "WB"; break;
		case 12: t = "H0"; break;
		case 13: t = "H1"; break;
		case 14: t = "H2"; break;
		case 15: t = "H3"; break;
		case 16: t = "H4"; break;
		case 17: t = "H5"; break;
		case 18: t = "H6"; break;
		case 19: t = "I0"; break;
		case 20: t = "I1"; break;
		case 21: t = "I2"; break;
		case 22: t = "I3"; break;
		case 23: t = "I4"; break;
		case 24: t = "I5"; break;
		case 25: t = "I6"; break;
		case 26: t = "J0"; break;
		}
		return "Y" .. c.Mid(v, 1) .. t;
	}

	// the pose of the weapon frame drawn (0 = his Ready pose: his blocks as they are)
	static int Pose(Weapon w, SpriteID spr, int frame)
	{
		name c = w.GetClassName();
		if (c == 'RLPistol')
		{
			switch (frame)
			{
			case 4:	// E
				if (spr == Actor.GetSpriteIndex('PISG') || spr == Actor.GetSpriteIndex('PISP') || spr == Actor.GetSpriteIndex('PS2H') || spr == Actor.GetSpriteIndex('PS2P') || spr == Actor.GetSpriteIndex('PSNH') || spr == Actor.GetSpriteIndex('PSNP')) return 1;
				break;
			case 5:	// F
				if (spr == Actor.GetSpriteIndex('PISG') || spr == Actor.GetSpriteIndex('PISP')) return 2;
				if (spr == Actor.GetSpriteIndex('PS2H') || spr == Actor.GetSpriteIndex('PS2P')) return 4;
				if (spr == Actor.GetSpriteIndex('PSNH') || spr == Actor.GetSpriteIndex('PSNP')) return 6;
				break;
			case 6:	// G
				if (spr == Actor.GetSpriteIndex('PISG') || spr == Actor.GetSpriteIndex('PISP')) return 3;
				if (spr == Actor.GetSpriteIndex('PS2H') || spr == Actor.GetSpriteIndex('PS2P')) return 5;
				if (spr == Actor.GetSpriteIndex('PSNH') || spr == Actor.GetSpriteIndex('PSNP')) return 7;
				break;
			}
			return 0;
		}
		if (c == 'RLShotgun')
		{
			switch (frame)
			{
			case 2:	// C
				if (spr == Actor.GetSpriteIndex('SH2H') || spr == Actor.GetSpriteIndex('SH2P') || spr == Actor.GetSpriteIndex('SHTG') || spr == Actor.GetSpriteIndex('SHTP')) return 1;
				if (spr == Actor.GetSpriteIndex('SHNH') || spr == Actor.GetSpriteIndex('SHNP')) return 5;
				break;
			case 3:	// D
				if (spr == Actor.GetSpriteIndex('SH2H') || spr == Actor.GetSpriteIndex('SH2P') || spr == Actor.GetSpriteIndex('SHTG') || spr == Actor.GetSpriteIndex('SHTP')) return 2;
				if (spr == Actor.GetSpriteIndex('SHNH') || spr == Actor.GetSpriteIndex('SHNP')) return 6;
				break;
			case 4:	// E
				if (spr == Actor.GetSpriteIndex('SH2H') || spr == Actor.GetSpriteIndex('SH2P') || spr == Actor.GetSpriteIndex('SHTG') || spr == Actor.GetSpriteIndex('SHTP')) return 3;
				if (spr == Actor.GetSpriteIndex('SHNH') || spr == Actor.GetSpriteIndex('SHNP')) return 7;
				break;
			case 5:	// F
				if (spr == Actor.GetSpriteIndex('SH2H') || spr == Actor.GetSpriteIndex('SH2P') || spr == Actor.GetSpriteIndex('SHTG') || spr == Actor.GetSpriteIndex('SHTP')) return 4;
				if (spr == Actor.GetSpriteIndex('SHNH') || spr == Actor.GetSpriteIndex('SHNP')) return 8;
				break;
			}
			return 0;
		}
		if (c == 'RLSuperShotgun')
		{
			switch (frame)
			{
