# ============================================================================
# WMCARD.07_smg -- the model card library, archetype smg: WM_Tec9, WM_SMG.
# Moved from WMCARD.txt on 2026-09-14 with every line unchanged. Index and order: WMCARD.txt.
# ============================================================================


# ============================================================================
# THE TEC9: an SMG for the off hand, today's pistol grammar.
#
# RS_ModelSwapper's tec9.md3 as tec9_wm.md3 -- its four surfaces were all named
# "Cube" and its magazine was a separate piece inside the body; the copy names them.
# Frame 0 is its only pose: the mesh's 6 frames are all firing, none reloading.
# Every number measured at frame 0 against the body's largest island.
# SMG_CANDIDATES.md.
#
# SCALE: MODELDEF Scale 1.1 x 0.34 = 0.374 map units per model unit.
# ============================================================================


# ============================================================ TEC9 -- OFF HAND
weapon "WM_Tec9"
  hand      = off
  type      = smg
  prop      = "WM_PropTec9"
  model     = "models/vanilla/smgs/Tec9" "tec9_wm.md3"
  skin      = "models/vanilla/smgs/Tec9" "tec9.png"

  # A TEC-DC9's standard magazine: 32 rounds.
  capacity  = 32
  # Its own family: a pistol magazine never seats in it, nor its in a pistol.
  magfamily = "tec9"

  # The barrel shroud's front-most vertices, on the bore (the barrel is z 0.81..3.19).
  muzzle    = 14.44, -0.08, 2.00
  barrel    = 1, 0, 0

  # THE PORT'S SIDE IS MEASURED, ITS POINT IS AN ESTIMATE. The receiver walls over the
  # bolt (x -9..1, z 0.3..3.7) have 73 vertices on -y against 101 on +y, where the bolt
  # handle is: the port is on -y, the right side, as on a real TEC-9.
  ejectport = -3.0, -2.2, 2.5
  ejectdir  = -0.3, -0.9, 0.4

  # The loose magazine: its magazine surface with the three rounds on top, lifted out,
  # re-origined on its centroid and stood upright along its axis.
  magmodel  = "models/vanilla/smgs/Tec9" "wm_tec9_mag.md3"
  magskin   = "models/vanilla/smgs/Tec9" "tec9.png"
  magscale  = 0.374
  magcenter = -1.088, -0.107, -1.181

  # 9mm Parabellum, as the 9mm Handgun's.
  roundmodel = "models/vanilla/pistols" "bullet.md3"
  roundskin  = "models/vanilla/pistols" "bullet.png"
  roundscale = 0.16

  # RS_Main's pool, the same 9mm as the 9mm Handgun: its shot and its handling.
  firesound      = "wm/pistolet/fire"
  drysound       = "wm/dry"
  magoutsound    = "wm/pistolet/magout"
  maginsound     = "wm/pistolet/magin"
  rackapexsound  ="wm/pistolet/slideback"
  rackresetsound ="wm/pistolet/slidefwd"
  magdropsound   = "wm/magdrop"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropTec9 is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = -7.092, -0.078, -2.806
  supportat = -0.848, -0.101, -8.947
  palm = -13.049, -0.101, -5.661
  rake = 27.4
  seat = -6.294, 0.078, 1.988
end

# THE BOLT, pulled by its handle on the left side: 7.091 along -x at frame 3, 0.06
# degrees, fit 0.011 -- the handle and the bolt in the receiver, one surface.
part bolt
  role    = action
  subject = slide
  surface = bolt
  grab       = -0.98, 3.26, 3.40      # the handle's knob
  handseat = -0.98, 1.203, 3.07      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 2.5
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 7.091
    detach   = 0.95
  end
end

# THE MAGAZINE. MEASURED FROM ITS SHAPE, NOT FRAMES: the mesh never reloads, so the
# axis is the magazine body's long axis, (0.013, 0, -1.000) -- a straight box. Distance
# is the magazine with its rounds along that axis.
part magazine
  role    = feed
  subject = magazine
  take    = no
  surface = magazine
  grab       = -0.76, -0.08, -15.64   # the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.013, 0, -1
    distance = 18.3
    detach   = 0.9
  end
end

# 25.11 degrees about the pin at -7.134, -0.381 (frame 3, fit 0.013). Sign checked:
# +25.11 lands its rest centroid within 0.006 of frame 3; -25.11 misses by 2.06.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0, 1, 0
    degrees = 25.11
    pivot   = -7.134, 0, -0.381
  end
end

# ESTIMATE: under the barrel shroud, ahead of the magazine well.
part support
  role    = support
  subject = support
  grab       = 7.0, -0.08, -0.1
  grabradius = 3.0
end

# ============================================================== SMG -- MAIN HAND
# RS_ModelSwapper's SMG (models/hud/SMG, a KRISS Vector's shape) as smg_wm.md3.
# Every number measured at the source's rest frame 3 against the body surface.
# SMG_CANDIDATES.md.
weapon "WM_SMG"
  hand      = main
  type      = smg
  prop      = "WM_PropSMG"
  model     = "models/vanilla/smgs/SMG" "smg_wm.md3"
  skin      = "models/vanilla/smgs/SMG" "smg.png"

  # 35 rounds, the owner's number.
  capacity  = 35
  magfamily = "smg"

  # The body's front-most vertices; the +x end is the barrel (2.0 x 2.0 across
  # there against the stock's 3.1 x 12.9).
  muzzle    = 25.36, -0.16, 1.35
  barrel    = 1, 0, 0

  # THE PORT'S SIDE IS MEASURED, ITS POINT IS AN ESTIMATE. The receiver walls
  # (x -10..8, z -1..4) have 299 vertices on -y against 461 on +y, where the
  # charging handle is: the port is on -y, the side away from the handle.
  ejectport = 0.0, -2.8, 2.5
  ejectdir  = -0.3, -0.9, 0.4

  # The loose magazine: its magazine surface lifted out, re-origined on its
  # centroid and stood upright along its axis.
  magmodel  = "models/vanilla/smgs/SMG" "wm_smg_mag.md3"
  magskin   = "models/vanilla/smgs/SMG" "smg.png"
  magscale  = 0.34
  magcenter = 4.006, -0.182, -8.224

  # .45 ACP, as the M4A3's.
  roundmodel = "models/vanilla/pistols" "bullet.md3"
  roundskin  = "models/vanilla/pistols" "bullet.png"
  roundscale = 0.175

  # RS_Main's combatfx pool: .45 like the M4A3, so its three shots; the long magazine
  # and the charging handle take the rifles' magazine foley and rack pair.
  firesound      = "wm/m4a3/fire"
  drysound       = "wm/dry"
  magoutsound    = "wm/rifle/magout"
  maginsound     = "wm/rifle/magin"
  rackapexsound  ="wm/rifle/rackback"
  rackresetsound ="wm/rifle/rackfwd"
  magdropsound   = "wm/magdrop"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropSMG is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = -6.460, -0.156, 1.336
  supportat = 17.687, 0.375, 1.202
  palm = -11.534, -0.181, -2.058
  rake = 22.1
  seat = -6.888, -0.156, 4.493
end

# THE CHARGING HANDLE: fold it out, then pull it back -- one pull, two stages.
# Stage 1 (dof), measured: 90.00 degrees about (0, 0, 1) through (9.910, -1.183, 0),
# frames 20-25, fit 0.010. Sign checked: +90 lands the rest centroid within 0.003 of
# frame 23; -90 misses by 14.97.
# Stage 2 (dof2), ESTIMATE: the mesh never pulls it back. 5.26 is the rail beside it
# (body island 37, x 7.05..14.91) from its rear end to the handle's rear end
# (x 12.31). Tune it on this card.
# split 0.5: the fold takes the first half of the pull, the slide the second.
part charginghandle
  role    = action
  subject = slide
  surface = charginghandle
  grab       = 20.16, 2.81, 3.65      # the handle's front end, the part you pinch
  handseat = 20.16, 2.656, 3.672      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 2.5
  dof
    kind    = hinge
    axis    = 0, 0, 1
    degrees = 90.0
    pivot   = 9.910, -1.183, 0
  end
  dof2
    kind     = slide
    axis     = -1, 0, 0
    distance = 5.26
    split    = 0.5
  end
end

# Lipas: 16.76 along (-0.298, 0, -0.954) at frame 8, a pure slide (0.02 degrees,
# fit 0.011); the same axis on frames 12 and 16. 26.15 long along it.
part magazine
  role    = feed
  subject = magazine
  take    = no
  surface = magazine
  grab       = 0.94, -0.16, -22.23    # the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.298, 0, -0.954
    distance = 26.15
    detach   = 0.9
  end
end

# A sliding trigger: 0.978 along -x at frame 4, fit 0.008.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 0.978
  end
end

# ESTIMATE: under the fore end (x 14..22 underside centroid).
part support
  role    = support
  subject = support
  grab       = 17.77, -0.15, -1.23
  grabradius = 3.0
end

# THE VERBS, DECLARED. A two-stage part's thresholds read the COMBINED pull, so the
# pistol grammar's synthesised rack (outat 0.6) would count at 20% of the slide,
# just past the fold. Declaring a verb turns synthesis off, so the magazine's swap
# is declared too, with the synthesised swap's own numbers. The stores are still
# the synthesised pair: `mag` and `chamber`.
#
# THE RACK: the pistol slide's synthesised cycle, but counted at 0.85 -- the fold
# and 70% of the slide. auto = onshot, as every self-loading gun here: the shot
# ejects and feeds, and the handle is drawn working on each shot. A real Vector's
# handle does not move when it fires; `none` would make it a rack per shot.
cycle rack
  part     = charginghandle
  outat    = 0.85
  apex     = 0.95
  # homeat 0.10 off: refused on a return = spring cycle, which skipped this whole card (the invisible SMG, 09-14)
  onout    = eject
  from     = chamber
  onhome   = feed
  feed     = mag
  into     = chamber
  return   = spring
  holdopen = whenempty
  auto     = onshot
end

# THE MAGAZINE: the synthesised swap's numbers. seatat unstated reads wm_seat_at
# live; handtake no, as the part's take.
swap magwell
  part     = magazine
  store    = mag
  detachat = 0.9
  pullout  = 0.97
  button   = yes
  handtake = no
end
