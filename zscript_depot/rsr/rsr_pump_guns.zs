// the sprites the card guns' pump layers name (a MODELDEF naming an unknown sprite stops the pk3 loading)
class RSP_Sprites_Cards : Actor
{
	States
	{
	Spawn:
		QP0G A 0;
		QP0P ABC 0;
		QP0W A 0;
		QP1G A 0;
		QP1P ABC 0;
		QP1W A 0;
		QP2G A 0;
