// generated by tools/gen_pump.py (RSR-PUMP) -- do not edit by hand
// Hand-loaded shells and a hand-worked pump: per gun. Positions cm in the weapon controller's
// frame (F, L, U); hooks are ModifyBobLayer3D translations for the gun's own MODELDEF placement.

class RSP_Guns abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		return SlotForDonor(DonorInHand(HandOf(w)));
	}

	clearscope static int HandOf(Weapon w)
	{
		return 0;		// the gun hand; the off hand is 1 when dual wielding lands
	}

	// The donor model worn by this hand, as RS_ForeignModelHandler published it.
	//
	// NOT ServiceIterator. Service.GetString is `play`; this function is `clearscope`,
	// because the pump module calls Index() from Places() / Place(), which the engine
	// reaches through Weapon.ModifyBobLayer3D -- declared `virtual ui`; and the facts
	// themselves live on a StaticEventHandler, which is `native play`. Three scopes,
	// none able to reach the others, and no Service variant bridges them.
	//
	// `struct CVar native` carries no scope qualifier at all, so FindCVar / GetString
	// are callable from every one of the three. Empty when no model is worn, which
	// SlotForDonor answers with 0 -- the stock reload -- so this is inert on a weapon
	// that has none of our models on it.
	clearscope static string DonorInHand(int hand)
	{
		let cv = CVar.FindCVar(hand == 1 ? 'ms_donor_off' : 'ms_donor_main');
		return cv ? cv.GetString() : "";
	}

	clearscope static int SlotForDonor(string donor)
	{
		if (donor.Length() == 0)
			return 0;
		if (donor == "MS_Shotgun")	return 1;
		if (donor == "MS_BD22_Shotgun")	return 2;
		if (donor == "MS_alien_shotgun")	return 3;
		if (donor == "MS_AE_Shotgun")	return 3;
		return 0;
	}

	clearscope static Vector3 Grab(int i)
	{
		switch (i)
		{
		case 1:	return (34.500, -0.000, 1.300);
		case 2:	return (40.100, 0.000, -2.800);
		case 3:	return (41.050, 0.040, -0.410);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Pull(int i)
	{
		switch (i)
		{
		case 1:	return (-1.000, -0.000, 0.002);
		case 2:	return (-1.000, 0.000, -0.002);
		case 3:	return (-1.000, -0.000, -0.000);
		}
		return (0, 0, 0);
	}

	clearscope static double Travel(int i)
	{
		switch (i)
		{
		case 1:	return 10.200;
		case 2:	return 6.400;
		case 3:	return 12.570;
		}
		return 0;
	}

	clearscope static Vector3 PumpHook(int i)
	{
		switch (i)
		{
		case 1:	return (0.000, 0.001, 0.741);
		case 2:	return (0.000, -0.002, 1.000);
		case 3:	return (-0.000, -0.000, 0.909);
		}
		return (0, 0, 0);
	}

	clearscope static double BoltRatio(int i)
	{
		switch (i)
		{
		case 1:	return 0.000;
		case 2:	return 1.000;
		case 3:	return 0.000;
		}
		return 0;
	}

	clearscope static Vector3 SupportHook(int i)
	{
		switch (i)
		{
		case 1:	return (-0.000, 0.002, 1.000);
		case 2:	return (0.000, -0.002, 1.000);
		case 3:	return (-0.000, -0.000, 1.000);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Port(int i)
	{
		switch (i)
		{
		case 1:	return (12.500, -0.500, 3.300);
		case 2:	return (19.000, 0.000, -2.800);
		case 3:	return (12.197, 0.017, -1.559);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Push(int i)
	{
		switch (i)
		{
		case 1:	return (0.892, 0.429, -0.140);
		case 2:	return (1.000, 0.000, 0.000);
		case 3:	return (1.000, 0.000, 0.000);
		}
		return (0, 0, 0);
	}

	clearscope static double Depth(int i)
	{
		switch (i)
		{
		case 1:	return 1.500;
		case 2:	return 6.000;
		case 3:	return 6.00;
		}
		return 0;
	}

	clearscope static Vector3 PortHook(int i)
	{
		switch (i)
		{
		case 1:	return (0.038, -2.397, -30.440);
		case 2:	return (-0.024, -2.986, -1.130);
		case 3:	return (-7.037, -6.696, 2.399);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 ShellInHand(int i)
	{
		switch (i)
		{
		case 1:	return (2.165, 2.823, -1.376);
		case 2:	return (1.489, 2.834, -2.439);
		case 3:	return (1.801, 2.829, -1.948);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 AxisInHand(int i)
	{
		switch (i)
		{
		case 1:	return (0.537, -0.009, 0.844);
		case 2:	return (0.537, -0.009, 0.844);
		case 3:	return (0.537, -0.009, 0.844);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 HandHook(int i)
	{
		switch (i)
		{
		case 1:	return (-0.804, -25.414, -1.151);
		case 2:	return (3.087, -28.047, 33.050);
		case 3:	return (-4.468, -7.762, 12.011);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 HandRot(int i)
	{
		switch (i)
		{
		case 1:	return (-41.862, 66.487, -44.858);
		case 2:	return (0.976, 57.529, 0.536);
		case 3:	return (0.656, 57.6, 0.550);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Scale(int i)
	{
		switch (i)
		{
		case 1:	return (1.350, 1.350, 1.350);
		case 2:	return (-1.000, 1.000, 1.000);
		case 3:	return (-1.100, 1.100, 1.100);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Offset(int i)
	{
		switch (i)
		{
		case 1:	return (0.000, 0.000, 0.000);
		case 2:	return (0.000, 0.000, -5.000);
		case 3:	return (0.000, -30.000, -7.000);
		}
		return (0, 0, 0);
	}

	clearscope static Name SprGun(int i)
	{
		switch (i)
		{
		case 1:	return 'RQUH';
		case 2:	return 'RQUG';
		case 3:	return 'RSHG';
		}
		return 'None';
	}

	clearscope static Name SprPart(int i)
