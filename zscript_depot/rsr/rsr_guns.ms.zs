		if (donor == "MS_BD_Flamethrower")	return 81;
		if (donor == "MS_BD_Buzzsaw")	return 85;
		// ---- END GENERATED
		if (donor == "MS_AE_M260b")	return 90;
		if (donor == "MS_AE_M41a")	return 91;
		if (donor == "MS_AE_M4a3")	return 92;
