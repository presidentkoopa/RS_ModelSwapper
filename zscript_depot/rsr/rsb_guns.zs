		case 33:	return (12.8591, -1.3216, 1.1497);	// Tip, chamber 1 (BD22 1)
		case 40:	return (13.1598, -0.0248, 0.2584);	// Tip, chamber 0 (BD22 3)
		case 41:	return (13.1598, -1.0177, -1.0806);	// Tip, chamber 1 (BD22 3)
		case 42:	return (13.1599, 0.9600, -1.1010);	// Tip, chamber 2 (BD22 3)
