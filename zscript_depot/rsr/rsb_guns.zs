// generated by tools/gen_rsb.py (RSR-BREAK) -- do not edit by hand
// Real VR reload, break-open guns and revolvers: per gun. Positions cm in the weapon
// controller's frame (F, L, U); turns right-handed about the axis, opening positive.

class RSB_Guns abstract
{
	// ModelSwapper's Index(), hand-written -- the generator writes one that matches
	// on the weapon's own class, which is right for a standalone pack where the
	// weapon IS the gun. Here the weapon belongs to whatever mod is loaded and
	// only its MODEL is ours, so the slot comes from the model in hand.
	//
	// Every model that is the same mesh claims the same slot, so the break-open
	// reload works whichever copy the player picks off the shelf.
	clearscope static int Index(Weapon w)
	{
		if (!w) return 0;
		return SlotForDonor(DonorInHand(HandOf(w)));
	}

	clearscope static int HandOf(Weapon w)
	{
		return 0;
	}

	clearscope static string DonorInHand(int hand)
	{
		let it = ServiceIterator.Find("RS_WeaponArchetypeService");
		if (!it) return "";
		let s = it.Next();
		if (!s) return "";
		return s.GetString("weapon.donor", "", hand);
	}

	clearscope static int SlotForDonor(string donor)
	{
		if (donor.Length() == 0) return 0;
		if (donor == "MS_PU_SuperShotgun")	return 1;
		if (donor == "MS_SuperShotgun")	return 1;
		if (donor == "MS_BD_M79")	return 2;
		if (donor == "MS_PU_BD_M79")	return 2;
		if (donor == "MS_brt_M79")	return 2;
		if (donor == "MS_PU_Revolver")	return 3;
		if (donor == "MS_PU_Revolver2")	return 3;
		if (donor == "MS_Revolver")	return 3;
		if (donor == "MS_Revolver2")	return 3;
		if (donor == "MS_qvplus_gats")	return 3;
		if (donor == "MS_vplus_gats")	return 3;
		return 0;
	}

	// a point of the hinge axis
	clearscope static Vector3 Hinge(int i)
	{
		switch (i)
		{
		case 1:	return (-24.4970, 0.0316, -1.5150);
		case 2:	return (1.5251, -0.1270, -36.8235);
		case 3:	return (-25.2517, 0.0000, -1.9720);
		}
		return (0, 0, 0);
	}

	// the hinge axis, opening positive
	clearscope static Vector3 Axis(int i)
	{
		switch (i)
		{
		case 1:	return (0.0000, 1.0000, 0.0000);
		case 2:	return (0.0000, 1.0000, 0.0000);
		case 3:	return (0.0000, 1.0000, 0.0000);
		}
		return (0, 0, 0);
	}

	// how far it opens (the set's own open frame)
	clearscope static double OpenDeg(int i)
	{
		switch (i)
		{
		case 1:	return 58.5600;
		case 2:	return 29.9993;
		case 3:	return 63.0703;
		}
		return 0;
	}

	// chambers (one: a speedloader fills the cylinder)
	clearscope static int Chambers(int i)
	{
		switch (i)
		{
		case 1:	return 2;
		case 2:	return 1;
		case 3:	return 1;
		}
		return 0;
	}

	clearscope static bool Loader(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return true;
		}
		return false;
	}

	// a seated round's base (rim), closed gun
	clearscope static Vector3 Base(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (-31.6567, 1.2745, 1.5390);
		case 9:	return (-31.6567, -1.3340, 1.5390);
		case 16:	return (-3.6599, -0.0036, -26.3627);
		case 24:	return (-35.8849, 0.1391, 1.0310);
		}
		return (0, 0, 0);
	}

	// a seated round's tip, closed gun
	clearscope static Vector3 Tip(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (-26.4284, 1.2745, 1.5390);
		case 9:	return (-26.4284, -1.3340, 1.5390);
		case 16:	return (4.2648, 0.0031, -34.2664);
		case 24:	return (-25.5984, 0.1428, 1.1464);
		}
		return (0, 0, 0);
	}

	// into the chamber, closed gun
	clearscope static Vector3 Bore(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (1.0000, 0.0000, 0.0000);
		case 9:	return (1.0000, 0.0000, 0.0000);
		case 16:	return (0.7080, 0.0006, -0.7062);
		case 24:	return (0.9999, 0.0004, 0.0112);
		}
		return (0, 0, 0);
	}

	// the round's mesh frame -> seated, closed: rows, translation
	clearscope static Vector3 Rest0(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (1.0000, 0.0000, -0.0000);
		case 9:	return (1.0000, 0.0000, -0.0000);
		case 16:	return (1.0000, -0.0000, -0.0000);
		case 24:	return (-0.0864, -0.0000, -0.9963);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Rest1(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (-0.0000, 1.0000, 0.0000);
		case 9:	return (-0.0000, 1.0000, 0.0000);
		case 16:	return (0.0000, 1.0000, 0.0000);
		case 24:	return (0.0000, 1.0000, -0.0000);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Rest2(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (-0.0000, -0.0000, 1.0000);
		case 9:	return (-0.0000, -0.0000, 1.0000);
		case 16:	return (0.0000, 0.0000, 1.0000);
		case 24:	return (0.9963, -0.0000, -0.0864);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 RestT(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (0.0000, -0.0000, -0.0000);
		case 9:	return (0.0000, -0.0000, -0.0000);
		case 16:	return (0.0000, 0.0000, 0.0000);
		case 24:	return (-35.8172, 0.0000, 16.8332);
		}
		return (0, 0, 0);
	}

	// seated round -> off-hand frame (Ermac's hold): rows, translation
	clearscope static Vector3 Hand0(int i)
	{
		switch (i)
		{
		case 1:	return (0.5368, 0.0091, -0.8437);
		case 2:	return (-0.5127, 0.0948, -0.8533);
		case 3:	return (-0.2490, -0.0023, -0.9685);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Hand1(int i)
	{
		switch (i)
		{
		case 1:	return (-0.0091, 0.9999, 0.0050);
		case 2:	return (0.0252, 0.9951, 0.0955);
		case 3:	return (0.0015, 1.0000, -0.0028);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Hand2(int i)
	{
		switch (i)
		{
		case 1:	return (0.8437, 0.0050, 0.5369);
		case 2:	return (0.8582, 0.0274, -0.5125);
		case 3:	return (0.9685, -0.0021, -0.2490);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 HandT(int i)
	{
		switch (i)
		{
		case 1:	return (18.8246, 1.2787, 21.9519);
		case 2:	return (-25.5431, 6.6039, -14.5550);
		case 3:	return (-8.6236, 5.2710, 32.0690);
		}
		return (0, 0, 0);
	}

	// the round in the off hand: base, tip (off-hand frame)
	clearscope static Vector3 HandBase(int i)
	{
		switch (i)
		{
		case 1:	return (0.5445, 2.8505, -3.9229);
		case 2:	return (-1.1709, 3.9914, -4.1840);
		case 3:	return (-0.6871, 5.3538, -2.9426);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 HandTip(int i)
	{
		switch (i)
		{
		case 1:	return (3.3511, 2.8026, 0.4879);
		case 2:	return (1.5116, 3.4432, 6.6684);
		case 3:	return (-3.3601, 5.3726, 6.9911);
		}
		return (0, 0, 0);
	}

	// the free hand's pose holding it (RSQ_Hands state)
	clearscope static String HoldState(int i)
	{
		switch (i)
		{
		case 1:	return "RsbShell";
		case 2:	return "RsrHold";
		case 3:	return "RsbCell";
		}
		return "";
	}

	// MODELDEF Scale, Offset x y + ZOffset of the gun's own block
	clearscope static Vector3 Scale(int i)
	{
		switch (i)
		{
		case 1:	return (-1.3500, 1.3500, 1.3500);
		case 2:	return (-1.0000, 1.0000, 1.0000);
		case 3:	return (-1.3500, 1.3500, 1.3500);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Offset(int i)
	{
		switch (i)
		{
		case 1:	return (0.0000, 0.0000, -5.0000);
		case 2:	return (0.0000, 0.0000, -5.0000);
		case 3:	return (0.0000, 0.0000, -5.0000);
		}
		return (0, 0, 0);
	}

