		case 5:	return true;		// Vanilla VR Plus VR_Revolver: its own speedloader mesh
		case 6:	return true;		// Vanilla VR Plus VR_Revolver2
		}
		return false;
	}

	clearscope static bool ReserveHoldsLoaded(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return false;
		case 4:	return true;
		case 5:	return false;
		case 6:	return false;
		}
		return false;
	}

	// what the off hand's reload button gives (BD22: its ACS reload token)
	clearscope static String ReloadToken(int i)
	{
		switch (i)
		{
		case 1:	return "Reloading";
		case 2:	return "Reloading";
		case 3:	return "Reloading";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		}
		return "";
	}

	// the speedloader's rounds in the cylinder (cm)
	clearscope static double LoaderDepth(int i)
	{
		switch (i)
		{
		case 1:	return 0.0000;
		case 2:	return 0.0000;
		case 3:	return 7.0000;		// BD22 Revolver: of the round's 9.6 cm, what the hand pushes
		case 4:	return 0.0000;
		case 5:	return 6.1658;
		case 6:	return 6.1658;
		}
		return 0;
	}

	// the off hand pushing it shut: angle 0, the hinged part's extent
	clearscope static Vector3 PushRef(int i)
	{
		switch (i)
		{
		case 1:	return (0.9884, 0.0000, 0.1522);
		case 2:	return (0.9762, 0.0000, 0.2169);
		case 3:	return (0.0000, 0.0050, 1.0000);
		case 4:	return (0.9895, 0.0000, 0.1448);
		case 5:	return (0.9667, 0.0000, 0.2559);
		case 6:	return (0.9667, 0.0000, 0.2559);
		}
		return (0, 0, 0);
	}

	clearscope static double PushZ0(int i)
	{
		switch (i)
		{
		case 1:	return -5.7115;
		case 2:	return -5.4859;
		case 3:	return -13.0415;
		case 4:	return -6.4098;
		case 5:	return -4.5635;
		case 6:	return -4.5635;
		}
		return 0;
	}

	clearscope static double PushZ1(int i)
	{
		switch (i)
		{
		case 1:	return 5.7220;
		case 2:	return 5.7416;
		case 3:	return 0.5950;
		case 4:	return 6.4059;
		case 5:	return 4.5619;
		case 6:	return 4.5619;
		}
		return 0;
	}

	clearscope static double PushR0(int i)
	{
		switch (i)
		{
		case 1:	return 8.0000;
		case 2:	return 8.0000;
		case 3:	return 3.0000;
		case 4:	return 8.0000;
		case 5:	return 8.0000;
		case 6:	return 8.0000;
		}
		return 0;
	}

	clearscope static double PushR1(int i)
	{
		switch (i)
		{
		case 1:	return 29.5644;
		case 2:	return 32.0220;
		case 3:	return 9.3192;
		case 4:	return 31.9834;
		case 5:	return 23.2318;
		case 6:	return 23.2318;
		}
		return 0;
	}

	// the hinged part's open-side face (deg about the hinge, closed) at a distance from the axis
	clearscope static double PushEdge(int i, double rho)
	{
		int b = int(rho / 2.0);
		if (b < 0 || b >= 25)
			return -999;
		static const double e[] = {
			-999.0, 19.5, 25.4, 20.6, 15.9, 13.8, 11.8, 10.8, 9.8, 8.9, 8.5, 7.9, 5.1, 3.8, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 28.1, 24.6, 20.6, 18.4, 17.1, 16.5, 15.9, 15.0, 10.1, 8.4, 8.7, 9.2, 9.5, 9.1, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 46.7, 40.3, 14.4, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 39.5, 28.9, 20.5, 16.2, 13.7, 11.8, 10.7, 9.7, 8.5, 4.2, 4.5, 4.7, 4.9, 5.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 8.1, 9.8, 10.4, 12.1, 12.2, 12.9, 13.2, 13.2, 7.0, -3.8, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 8.1, 9.8, 10.4, 12.1, 12.2, 12.9, 13.2, 13.2, 7.0, -3.8, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0
		};
		return i >= 1 && i <= 6 ? e[(i - 1) * 25 + b] : -999;
	}
}

// the rounds the ejector threw that were still live, held until a speedloader is home (the set
// tops up, so the count ends where its own reload ends)
class RSB_Held_VR_Revolver : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }
class RSB_Held_VR_Revolver2 : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }

// every sprite the break reload shows (MODELDEF.rsb), so the engine knows them; never given
class RSB_Sprites : Actor
{
	States
	{
	Spawn:
		RBSG A 0;
		RBSP ABCDEFGHIJ 0;
		RBSW ABC 0;
		RBGG A 0;
		RBGP ABCDEFGHIJ 0;
		RBGW ABC 0;
		RBRG A 0;
		RBRP ABCDEFGHIJ 0;
		RBRW ABC 0;
		RBTG A 0;
		RBTP ABCDEFGHIJ 0;
		RBTW ABC 0;
		RBVG A 0;
		RBVP ABCDEFGHIJ 0;
		RBVW ABC 0;
		RBWG A 0;
		RBWP ABCDEFGHIJ 0;
		RBWW ABC 0;
		RQHN JKL 0;
		Stop;
	}
}
