	clearscope static int Cap(int i)
	{
		switch (i)
		{
		case 1:	return 2;
		case 2:	return 1;
		case 3:	return 6;
		case 4:	return 2;
		case 5:	return 6;
		case 6:	return 1;
		}
		return 0;
	}

	// spent rounds: the set's own casing actors (weapon state RSB_Eject), or the set's own round thrown (RSB_Casing)
	clearscope static bool WorldEject(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return false;
		case 4:	return false;
		case 5:	return false;
		case 6:	return false;
		}
		return false;
	}

	// where the thrown round's centre sits in its chamber
	clearscope static Vector3 Casing(int i)
	{
		switch (i)
		{
		case 1:	return (0.0000, 0.0000, 0.0000);
		case 2:	return (0.0000, 0.0000, 0.0000);
		case 3:	return (0.0000, 0.0000, 0.0000);
		case 4:	return (0.0000, 0.0000, 0.0000);
		case 5:	return (3.5636, -0.0215, 0.2363);
		case 6:	return (0.0000, 0.0000, 0.0000);
		}
		return (0, 0, 0);
	}

	clearscope static Name Cls(int i)
	{
		switch (i)
		{
		case 1:	return 'MS_SuperShotgun';
		case 2:	return 'MS_brt_M79';
		case 3:	return 'MS_Revolver';
		case 4:	return 'MS_BD22_SSG';
		case 5:	return 'MS_BD22_Revolver';
		case 6:	return 'MS_BD22_M79';
		}
		return 'None';
	}

	// the set's "nothing in the chambers" (no casings) item
	clearscope static String Unloaded(int i)
	{
		switch (i)
		{
		case 1:	return "";
		case 2:	return "";
		case 3:	return "";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		}
		return "";
	}

	// the reserve still counts the loaded rounds (V+ super shotgun: firing takes them)
	clearscope static bool ReserveHoldsLoaded(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return false;
		case 4:	return false;
		case 5:	return false;
		case 6:	return false;
		}
		return false;
	}

	// what the off hand's reload button gives (BD22: its ACS reload token)
	clearscope static String ReloadToken(int i)
	{
		switch (i)
		{
		case 1:	return "Reloading";
		case 2:	return "Reloading";
		case 3:	return "Reloading";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		}
		return "";
	}

	// the speedloader's rounds in the cylinder (cm)
	clearscope static double LoaderDepth(int i)
	{
		switch (i)
		{
		case 1:	return 0.0000;
		case 2:	return 0.0000;
		case 3:	return 6.1658;
		case 4:	return 0.0000;
		case 5:	return 7.0000;
		case 6:	return 0.0000;
		}
		return 0;
	}

	// the off hand pushing it shut: angle 0, the hinged part's extent
	clearscope static Vector3 PushRef(int i)
	{
		switch (i)
		{
		case 1:	return (0.9906, 0.0000, 0.1367);
		case 2:	return (0.8432, 0.0000, -0.5376);
		case 3:	return (0.9667, 0.0000, 0.2559);
		case 4:	return (0.9884, 0.0000, 0.1522);
		case 5:	return (0.0000, 0.0050, 1.0000);
		case 6:	return (0.9762, 0.0000, 0.2169);
		}
		return (0, 0, 0);
	}

	clearscope static double PushZ0(int i)
	{
		switch (i)
		{
		case 1:	return -6.4056;
		case 2:	return -5.4868;
		case 3:	return -4.5619;
		case 4:	return -5.7115;
		case 5:	return -13.0415;
		case 6:	return -5.4859;
		}
		return 0;
	}

	clearscope static double PushZ1(int i)
	{
		switch (i)
		{
		case 1:	return 6.4101;
		case 2:	return 5.7407;
		case 3:	return 4.5635;
		case 4:	return 5.7220;
		case 5:	return 0.5950;
		case 6:	return 5.7416;
		}
		return 0;
	}

	clearscope static double PushR0(int i)
	{
		switch (i)
		{
		case 1:	return 8.0000;
		case 2:	return 8.0000;
		case 3:	return 8.0000;
		case 4:	return 8.0000;
		case 5:	return 3.0000;
		case 6:	return 8.0000;
		}
		return 0;
	}

	clearscope static double PushR1(int i)
	{
		switch (i)
		{
		case 1:	return 31.9086;
		case 2:	return 32.0164;
		case 3:	return 23.2318;
		case 4:	return 29.5644;
		case 5:	return 9.3192;
		case 6:	return 32.0220;
		}
		return 0;
	}

	// the hinged part's open-side face (deg about the hinge, closed) at a distance from the axis
	clearscope static double PushEdge(int i, double rho)
	{
		int b = int(rho / 2.0);
		if (b < 0 || b >= 25)
			return -999;
		static const double e[] = {
			-999.0, 44.6, 32.6, 21.8, 17.0, 14.3, 12.3, 10.9, 9.9, 8.6, 4.2, 4.5, 4.7, 4.9, 4.9, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 28.9, 24.7, 20.5, 18.5, 17.4, 16.5, 15.6, 15.0, 10.0, 8.2, 8.6, 9.1, 9.5, 9.1, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 8.1, 9.8, 10.4, 12.1, 12.2, 12.9, 13.2, 13.2, 7.0, -3.8, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 19.5, 25.4, 20.6, 15.9, 13.8, 11.8, 10.8, 9.8, 8.9, 8.5, 7.9, 5.1, 3.8, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 46.7, 40.3, 14.4, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0,
			-999.0, 28.1, 24.6, 20.6, 18.4, 17.1, 16.5, 15.9, 15.0, 10.1, 8.4, 8.7, 9.2, 9.5, 9.1, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0, -999.0};
		return i >= 1 && i <= 6 ? e[(i - 1) * 25 + b] : -999;
	}
}

// the rounds the ejector threw that were still live, held until a speedloader is home (the set
// tops up, so the count ends where its own reload ends)
class RSB_Held_MS_Revolver : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }

// every sprite the break reload shows (MODELDEF.rsb), so the engine knows them; never given
class RSB_Sprites : Actor
{
	States
	{
	Spawn:
		RBMG A 0;
		RBMP ABCDEFGHIJ 0;
		RBMW ABC 0;
		RBNG A 0;
		RBNP ABCDEFGHIJ 0;
		RBNW ABC 0;
		RBOG A 0;
		RBOP ABCDEFGHIJ 0;
		RBOW ABC 0;
		RQHN JKL 0;
		RBSG A 0;	// MS_BD22_SSG (BD22 SSG)
		RBSP ABCDEFGHIJ 0;
		RBSW ABC 0;
		RBRG A 0;	// MS_BD22_Revolver (BD22 Revolver)
		RBRP ABCDEFGHIJ 0;
		RBRW ABC 0;
		RBGG A 0;	// MS_BD22_M79 (BD22 GrenadeLauncher)
		RBGP ABCDEFGHIJ 0;
		RBGW ABC 0;
		Stop;
	}
}
