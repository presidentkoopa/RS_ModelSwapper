// generated by tools/gen_rsb.py (RSR-BREAK) -- do not edit by hand
// Real VR reload, break-open guns and revolvers: per gun. Positions cm in the weapon
// controller's frame (F, L, U); turns right-handed about the axis, opening positive.

class RSB_Guns abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		return SlotForDonor(DonorInHand(HandOf(w)));
	}

	clearscope static int HandOf(Weapon w)
	{
		return 0;		// the gun hand; the off hand is 1 when dual wielding lands
	}

	// The donor model worn by this hand, as RS_ForeignModelHandler published it.
	//
	// NOT ServiceIterator. Service.GetString is `play`; this function is `clearscope`,
	// because the pump module calls Index() from Places() / Place(), which the engine
	// reaches through Weapon.ModifyBobLayer3D -- declared `virtual ui`; and the facts
	// themselves live on a StaticEventHandler, which is `native play`. Three scopes,
	// none able to reach the others, and no Service variant bridges them.
	//
	// `struct CVar native` carries no scope qualifier at all, so FindCVar / GetString
	// are callable from every one of the three. Empty when no model is worn, which
	// SlotForDonor answers with 0 -- the stock reload -- so this is inert on a weapon
	// that has none of our models on it.
	clearscope static string DonorInHand(int hand)
	{
		let cv = CVar.FindCVar(hand == 1 ? 'ms_donor_off' : 'ms_donor_main');
		return cv ? cv.GetString() : "";
	}

	clearscope static int SlotForDonor(string donor)
	{
		if (donor.Length() == 0)
			return 0;
		if (donor == "MS_SuperShotgun")	return 1;
		if (donor == "MS_brt_M79")	return 2;
		if (donor == "MS_Revolver")	return 3;
		if (donor == "MS_BD22_SSG")	return 4;
		if (donor == "MS_BD22_Revolver")	return 5;
		if (donor == "MS_BD22_M79")	return 6;
		return 0;
	}

	// a point of the hinge axis
	clearscope static Vector3 Hinge(int i)
	{
		switch (i)
		{
		case 1:	return (-24.4970, 0.0316, -1.5150);
		case 2:	return (1.5251, -0.1270, -36.8235);
		case 3:	return (-25.2517, 0.0000, -1.9720);
		case 4:	return (10.7185, 0.0346, -2.4812);
		case 5:	return (8.9567, 0.0021, -3.3564);
		case 6:	return (18.3427, -0.1278, -3.7417);
		}
		return (0, 0, 0);
	}

	// the hinge axis, opening positive
	clearscope static Vector3 Axis(int i)
	{
		switch (i)
		{
		case 1:	return (0.0000, 1.0000, 0.0000);
		case 2:	return (0.0000, 1.0000, 0.0000);
		case 3:	return (0.0000, 1.0000, 0.0000);
		case 4:	return (0.0000, 1.0000, 0.0000);
		case 5:	return (-1.0000, 0.0000, 0.0000);
		case 6:	return (0.0000, 1.0000, 0.0000);
		}
		return (0, 0, 0);
	}

	// how far it opens (the set's own open frame)
	clearscope static double OpenDeg(int i)
	{
		switch (i)
		{
		case 1:	return 58.5600;
		case 2:	return 29.9993;
		case 3:	return 63.0703;
		case 4:	return 30.2454;
		case 5:	return 90.0115;
		case 6:	return 29.9743;
		}
		return 0;
	}

	// chambers (one: a speedloader fills the cylinder)
	clearscope static int Chambers(int i)
	{
		switch (i)
		{
		case 1:	return 2;
		case 2:	return 1;
		case 3:	return 1;
		case 4:	return 2;
		case 5:	return 1;
		case 6:	return 1;
		}
		return 0;
	}

	clearscope static bool Loader(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return true;
		case 4:	return false;
		case 5:	return true;
		case 6:	return false;
		}
		return false;
	}

	clearscope static bool LoaderEmptyInHand(int i)
	{
		switch (i)
		{
		case 1:	return false;
		case 2:	return false;
		case 3:	return false;
		}
		return false;
	}

	// a seated round's base (rim), closed gun
	clearscope static Vector3 Base(int i, int k)
	{
		switch (i * 8 + k)
		{
		case 8:	return (-31.6567, 1.2745, 1.5390);
		case 9:	return (-31.6567, -1.3340, 1.5390);
		case 16:	return (-3.6599, -0.0036, -26.3627);
		case 24:	return (-35.8849, 0.1391, 1.0310);
		case 32:	return (7.0673, 1.4341, 1.1531);	// Base, chamber 0 (BD22 1)
		case 33:	return (7.0672, -1.3037, 1.1531);	// Base, chamber 1 (BD22 1)
		case 40:	return (3.5636, -0.0215, 0.2363);	// Base, chamber 0 (BD22 3)
		case 41:	return (3.5636, -1.0194, -1.1022);	// Base, chamber 1 (BD22 3)
		case 42:	return (3.5635, 0.9579, -1.1248);	// Base, chamber 2 (BD22 3)
		case 43:	return (3.5636, 1.5702, 0.7395);	// Base, chamber 3 (BD22 3)
		case 44:	return (3.5636, 0.0045, 1.8846);	// Base, chamber 4 (BD22 3)
		case 48:	return (7.2752, -0.0035, -0.0158);	// Base, chamber 0 (BD22 2)
		}
		return (0, 0, 0);
	}

