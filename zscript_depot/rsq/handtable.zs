// generated by tools_kit/run_handfit.py from the shelf's cards -- do not edit by hand
// Per gun: gun-hand frame (one hand, two hands), its hook and rotation, support frame,
// its hook and rotation (ModifyBobLayer3D units), and where the support hand holds the
// gun (metres in the gun hand's frame: forward, left, up). Ermac's poses, moved onto
// each gun by the kit's ICP anchored on the card's palm / supportat.
//
// Keyed on the MODEL, not the weapon: the weapon belongs to whatever mod is loaded and
// only its model is ours. Same lookup, same cvars, same reason as RSR_Guns.Index.
class RSQ_HandTable abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w) return 0;
		return SlotForDonor(DonorInHand(HandOf(w)));
	}

	clearscope static int HandOf(Weapon w)
	{
		return 0;
	}

	// The donor model worn by this hand, as RS_ForeignModelHandler published it. A cvar
	// because `struct CVar native` carries no scope qualifier and this is clearscope;
	// see the note on RSR_Guns.DonorInHand for why nothing else reaches across.
	clearscope static string DonorInHand(int hand)
	{
		let cv = CVar.FindCVar(hand == 1 ? 'ms_donor_off' : 'ms_donor_main');
		return cv ? cv.GetString() : "";
	}

	clearscope static int SlotForDonor(string donor)
	{
		if (donor.Length() == 0) return 0;
		if (donor == "MS_AE_Flamer")	return 1;
		if (donor == "MS_AE_Pistol")	return 2;
		if (donor == "MS_AE_Shotgun")	return 3;
		if (donor == "MS_BD_AssaultShotgun")	return 4;
		if (donor == "MS_BD_BrutalSMG")	return 5;
		if (donor == "MS_BD_Flamethrower2")	return 6;
		if (donor == "MS_BD_M79")	return 7;
		if (donor == "MS_BD_Machinegun")	return 8;
		if (donor == "MS_BD_RailGun")	return 9;
		if (donor == "MS_BD_Rifle")	return 10;
		if (donor == "MS_BD_Unmaker")	return 11;
		if (donor == "MS_Chaingun")	return 12;
		if (donor == "MS_Chainsaw")	return 13;
		if (donor == "MS_Cola_Revolver")	return 14;
		if (donor == "MS_MG_Bolter")	return 15;
		if (donor == "MS_MG_Tec9")	return 16;
		if (donor == "MS_Pistol")	return 17;
