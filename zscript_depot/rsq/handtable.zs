		if (donor == "MS_alien_rifle")	return 28;
		if (donor == "MS_brt_BrutalPistol")	return 29;
		if (donor == "MS_brt_BrutalSMG")	return 30;
		if (donor == "MS_brt_MP40")	return 31;
		if (donor == "MS_brt_PlasmaGun")	return 32;
