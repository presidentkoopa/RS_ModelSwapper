# ============================================================================
# WMCARD.left -- written from our OWN measurements.
#
# Every number here came out of the gun's own reload animation, measured by
# md3label on the ANIMATED mesh this mod ships. No static _wm world model was
# read at any point, and nothing was carried over from another gun's card.
# ============================================================================

weapon "MS_BD_AssaultShotgun"
  type      = shotgun
  model     = "models/hud/AssaultShotgun" "AssaultShotgun.md3"
  skin      = "models/hud/AssaultShotgun" "AssaultShotgun.png"
  capacity  = 8
  muzzle    = 30.09, 1.16, 2.44
  barrel    = 1, 0, 0
  ejectport = -4.27, 2.59, -0.17
  ejectdir  = 0.0, 1.0, 0.0
  magmodel  = "models/hud/AssaultShotgun" "MS_BD_AssaultShotgun_mag.md3"
  magskin   = "models/hud/AssaultShotgun" "AssaultShotgun.png"
  magscale  = 1.0
  magcenter = -10.06, 0.06, -9.46
end

grip
  triggerat = -21.46, 0.05, -4.54
  palm = -21.62, -0.38, -6.23
  seat = -22.86, 0.47, -3.64
  supportat = 4.79, 0.05, -0.76
  rake = 0
end

# the magazine, measured from the gun's own reload animation  # NOT an animation reading: this gun throws the magazine clear of the screen, so the stroke is the well's own mouth-to-seat distance
part magazine
  role    = feed
  surface = mag
  grab       = -10.06, 0.06, -9.46
  grabradius = 2.5
  dof
    kind     = slide
    axis     = -0.707, 0.000, -0.707
    distance = 7.77
  end
end

part bolt
  role    = action
  subject = slide
  surface = bolt
  grab       = -5.7, 1.39, 0.24
  grabradius = 2.5
  dof
    kind     = slide
    axis     = -1.0, -0.0, -0.001
    distance = 10.00
  end
end

