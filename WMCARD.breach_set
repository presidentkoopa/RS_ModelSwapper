# THE CHARGING HANDLE: joint j_charginghandle, 5.55 straight back along -x on the rig's rack frames 221-243. The grab is its rear T.
part charginghandle
  role    = action
  subject = slide
  # TEST 2026-09-26: was `joint = j_charginghandle`. The engine's joint drive
  # (model_reach.cpp) is no longer in the tree, so a joint part cannot move.
  # This mesh is EXCLUSIVELY the charging handle (3359 verts), so it can be
  # driven as a surface -- the same path every MD3 gun uses. Travel and axis
  # unchanged: both were measured off the rig and are correct.
  surface = charge_ar15_gry.bmp
  grab       = 13.841, 5.024, -3.984
  handseat = 13.841, 5.117, -3.953      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 5.55
    detach   = 0.95
  end
end

# THE MAGAZINE: joint j_mag1. The axis is its own long axis, 6.8 degrees off vertical in the gun's middle plane (a magazine cannot turn in its well), the distance its length along it, 15.31, and a little to clear the well. The grab is the floorplate.
part magazine
  role    = feed
  subject = magazine
  take    = no          # out by its button, in by the hand carrying one
  joint   = j_mag1
  grab       = 25.319, 4.887, -22.071
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.118, -0.000, -0.993
    distance = 15.8
    detach   = 0.9
  end
end

# Not a moving part: where the other hand holds -- Breach's left hand (j_metaindex_le_1,j_metamid_le_1,j_metapinky_le_1), on the centre line.
part support
  role    = support
  subject = support
  grab       = 38.743, 4.934, -13.886
  grabradius = 3.0
end


# ============================================================ BREACH MK18 (SUPPRESSED) -- MAIN HAND

# WHAT THIS GUN ACTUALLY DOES (2026-10-02). Carded like a pistol until now: every
# Breach gun had only `role = action` and `role = feed`, and SynthCycle's defaults
# (verb.zs:326-344) are a pistol's -- holdOpenWhenEmpty and autoOnShot. On a Glock
# or a 1911 that is right. Here it is not.
#
# an AR-15 charging handle is NON-RECIPROCATING: it sits still while
# the bolt carrier cycles inside the receiver.
# AND NO BOLT HOLD-OPEN: nothing in this family locks back on an empty magazine,
# which is exactly why its shooters press the bolt catch by hand.
#
# BOTH VERBS ARE DECLARED, not just the one being changed. SynthesiseVerbs is
# all-or-nothing (card.zs:918), so one declared verb synthesises NONE -- adding an
# open verb to the BD22 machine gun silently took its magazine swap away and only
# the load log caught it. The numbers below are SynthCycle's and SynthSwap's own.
cycle rack
  part     = charginghandle
  outat    = 0.6
  apex     = 0.95
  onout    = eject
  from     = chamber
  onhome   = feed
  feed     = mag
  into     = chamber
  return   = spring
  auto     = onshotstill
  holdopen = never
end

swap magwell
  part     = magazine
  store    = mag
  detachat = 0.9
  pullout  = 0.97
  button   = yes
  handtake = no
end
weapon "MS_BreachMK18S"
  hand      = main
  type      = rifle
  prop      = "WM_PropBreachMK18S"
  model     = "models/breach/mk18" "mk18nosil.iqm"
  # Breach's magazine holds 30 (mk18s.zs:250).
  capacity  = 30
  magfamily = "stanag"

  # BREACH'S VIEW ARMS: the rig's own arms mesh, never drawn in a VR hand.
  hidesurface = v_hands.bmp
  # BREACH'S SECOND MAGAZINE: the reload animation's spare, parked far below the gun on this frame.
  hidejoint   = j_mag2

  # The front-most verts, centred (the silencer's end); the bore points along the barrel.
  muzzle    = 80.534, 4.937, -5.559
  barrel    = 1.000, 0.000, 0.000

  # The right side's surface at the port (Breach's rigs put the right on +y). Brass goes right, up, back.
  ejectport = 24.342, 6.705, -5.694
  ejectdir  = -0.3, 0.9, 0.4

  # THE LOOSE MAGAZINE: the rig's own, cut out at this frame, re-origined on its centroid (magcenter, the gun's space) and turned so it leaves straight down (breach_extract.py); its surfaces carry their own textures, so no magskin. magscale = the gun's 1.145 x 0.34.
  magmodel  = "models/breach/mk18" "wm_breachmk18_mag.md3"
  magscale  = 0.389
  magcenter = 26.044, 4.991, -12.142

  roundmodel = "models/vanilla/pistols" "bullet.md3"
  roundskin  = "models/vanilla/pistols" "bullet.png"
  roundscale = 0.31

  # Breach's own sounds (mk18s.zs): its two fire layers as one, and the rest it plays.
  firesound      = "rsm/breachmk18s/fire"
  drysound       = "rsm/breach/click"
  magoutsound    = "rsm/breach/clipout"
  maginsound     = "rsm/breach/clipin"
  rackapexsound  = "rsm/breach/boltback"
  rackresetsound = "rsm/breach/boltclose"
  magdropsound   = "wm/magdrop"
  casingsound    = "rsm/breachglock/casing"
end

# THE GRIP: placed by the owner on the mesh, as he placed it
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  palm = 14.525, 4.991, -14.140
  rake = 29.3
  supportat = 41.518, 4.630, -10.904
  triggerat = 19.620, 5.088, -11.815
end

# THE CHARGING HANDLE: joint j_charginghandle, 5.55 straight back along -x on the rig's rack frames 221-243. The grab is its rear T.
part charginghandle
  role    = action
  subject = slide
