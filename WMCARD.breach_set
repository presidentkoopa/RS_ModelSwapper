# ============================================================ BREACH BENELLI M4 -- MAIN HAND

# WHAT THIS GUN ACTUALLY DOES (2026-10-02). Carded like a pistol until now: every
# Breach gun had only `role = action` and `role = feed`, and SynthCycle's defaults
# (verb.zs:326-344) are a pistol's -- holdOpenWhenEmpty and autoOnShot. On a Glock
# or a 1911 that is right. Here it is not.
#
# the HK roller-delayed cocking lever rides the bolt carrier and
# RECIPROCATES; its hold-open is the manual notch you slap, not automatic.
# AND NO BOLT HOLD-OPEN: nothing in this family locks back on an empty magazine,
# which is exactly why its shooters press the bolt catch by hand.
#
# BOTH VERBS ARE DECLARED, not just the one being changed. SynthesiseVerbs is
# all-or-nothing (card.zs:918), so one declared verb synthesises NONE -- adding an
# open verb to the BD22 machine gun silently took its magazine swap away and only
# the load log caught it. The numbers below are SynthCycle's and SynthSwap's own.
cycle rack
  part     = charginghandle
  outat    = 0.6
  apex     = 0.95
  onout    = eject
  from     = chamber
  onhome   = feed
  feed     = mag
  into     = chamber
  return   = spring
  auto     = onshot
  holdopen = never
end

swap magwell
  part     = magazine
  store    = mag
  detachat = 0.9
  pullout  = 0.97
  button   = yes
  handtake = no
end
weapon "MS_BreachBenelli"
  hand      = main
  type      = shotgun
  prop      = "WM_PropBreachBenelli"
  model     = "models/breach/benelli" "benelli.iqm"
  # Breach's BenelliMagazine: a 7-shell tube (benelli.zs:6-7).
  capacity  = 7
  magfamily = "12ga"

  # BREACH'S VIEW ARMS: the rig's own arms mesh, never drawn in a VR hand.
  hidesurface = v_hands.bmp
  # THE SHELL BREACH'S LEFT HAND LOADS, parked at the muzzle on this frame.
  hidejoint   = shell

  # The front-most verts, centred; the bore points along the barrel.
  muzzle    = 34.824, 2.039, -3.415
  barrel    = 0.999, -0.054, 0.007

  # The right side's surface at the port (Breach's rigs put the right on +y). Brass goes right, up, back.
  ejectport = 14.573, 4.246, -3.415
  ejectdir  = -0.3, 0.9, 0.4

  roundmodel = "models/shared/shell" "shell.md3"
  roundskin  = "models/shared/shell" "shell.png"
  roundscale = 0.228

  # Breach's own sounds (benelli.zs): its two fire layers as one, and the rest it plays.
  firesound      = "rsm/breachbenelli/fire"
  drysound       = "rsm/breach/click"
  cycleoutsound  = "rsm/breach/pump1"
  cyclehomesound = "rsm/breach/boltclose"
  loadsound      = "rsm/breach/lshell1"
  casingsound    = "rsm/breach/sshell1"
end

# THE GRIP: placed by the owner on the mesh, as he placed it
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  palm = 7.103, 3.530, -6.881
  rake = 18.5
  supportat = 20.686, 2.805, -4.472
  triggerat = 9.042, 3.470, -5.496
end

store tube
  kind     = counted
  capacity = 7
  detach   = no
end

store chamber
  kind  = slotted
  slots = 1
end

# THE BOLT HANDLE: joint bolt, 3.23 back along the gun's own line on the rig's rack frames 153-182. No role: the cycle below names it, which makes it grabbable. The grab is its rear.
part bolt
  subject = slide
  joint   = bolt
  grab       = 12.871, 3.448, -3.154
  handseat = 12.867, 3.326, -3.552      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.999, 0.054, -0.007
    distance = 3.23
    detach   = 0.95
  end
end

# THE TRIGGER: joint trigger, 17.8 degrees about its own pin on the rig's fire frames 22-41 (the pin is the joint's origin). Follows your finger.
part trigger
  role    = trigger
  joint   = trigger
  dof
    kind     = hinge
    axis     = 0, 1, 0
    degrees  = 17.8
    pivot    = 9.151, 3.930, -4.749
  end
end

# Not a moving part: where the other hand holds -- Breach's left hand (ValveBiped.Bip01_L_Hand,ValveBiped.Bip01_L_Finger2,ValveBiped.Bip01_L_Finger4), on the centre line.
part support
  role    = support
  subject = support
  grab       = 18.783, 2.900, -6.819
  grabradius = 3.0
end

# SEMI-AUTO: the shot throws the bolt back and home -- eject the spent shell, feed the next from the tube -- and a hand may rack it the same way. Empty, it locks open.
cycle bolt
  part     = bolt
  outat    = 0.85
  apex     = 0.95
  onout    = eject
  from     = chamber
  onhome   = feed
  feed     = tube
  into     = chamber
  return   = spring
  holdopen = whenempty
  auto     = onshot
end

# THE LOADING GATE, under the receiver where Breach's shutter is (joint shutter, centroid 14.340, 3.149, -5.038): one shell at a time up into the tube.
load gate
  into    = tube
  at      = 14.340, 3.149, -6.038
  size    = 2.5, 2.0, 2.0
  subject = shell
  dir     = 0, 0, 1
end
