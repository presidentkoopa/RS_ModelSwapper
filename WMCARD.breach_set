# ============================================================ BREACH MCX (SUPPRESSED) -- MAIN HAND

# WHAT THIS GUN ACTUALLY DOES (2026-10-02). Carded like a pistol until now: every
# Breach gun had only `role = action` and `role = feed`, and SynthCycle's defaults
# (verb.zs:326-344) are a pistol's -- holdOpenWhenEmpty and autoOnShot. On a Glock
# or a 1911 that is right. Here it is not.
#
# AR-pattern controls on a short-stroke piston: the charging handle
# does not move when it fires.
# AND NO BOLT HOLD-OPEN: nothing in this family locks back on an empty magazine,
# which is exactly why its shooters press the bolt catch by hand.
#
# BOTH VERBS ARE DECLARED, not just the one being changed. SynthesiseVerbs is
# all-or-nothing (card.zs:918), so one declared verb synthesises NONE -- adding an
# open verb to the BD22 machine gun silently took its magazine swap away and only
# the load log caught it. The numbers below are SynthCycle's and SynthSwap's own.
cycle rack
  part     = charginghandle
  outat    = 0.6
  apex     = 0.95
  onout    = eject
  from     = chamber
  onhome   = feed
  feed     = mag
  into     = chamber
  return   = spring
  auto     = onshotstill
  holdopen = never
end

swap magwell
  part     = magazine
  store    = mag
  detachat = 0.9
  pullout  = 0.97
  button   = yes
  handtake = no
end
weapon "MS_BreachMCX"
  hand      = main
  type      = rifle
  prop      = "WM_PropBreachMCX"
  model     = "models/breach/mcx" "mcxrig.iqm"
  # Breach's magazine holds 30 (mcx.zs:248).
  capacity  = 30
  magfamily = "stanag"

  # BREACH'S VIEW ARMS: the rig's own arms mesh, never drawn in a VR hand.
  hidesurface = v_hands.bmp
  # BREACH'S SECOND MAGAZINE: the reload animation's spare, parked far below the gun on this frame.
  hidejoint   = j_mag2

  # The front-most verts, centred; the bore points along the barrel.
  muzzle    = 75.311, 4.896, -6.177
  barrel    = 1.000, 0.000, 0.000

  # The right side's surface at the port (Breach's rigs put the right on +y). Brass goes right, up, back.
  ejectport = 24.342, 6.735, -6.177
  ejectdir  = -0.3, 0.9, 0.4

  # THE LOOSE MAGAZINE: the rig's own, cut out at this frame, re-origined on its centroid (magcenter, the gun's space) and turned so it leaves straight down (breach_extract.py); its surfaces carry their own textures, so no magskin. magscale = the gun's 1.145 x 0.34.
  magmodel  = "models/breach/mcx" "wm_breachmcx_mag.md3"
  magscale  = 0.389
  magcenter = 26.680, 5.200, -10.397

  roundmodel = "models/vanilla/pistols" "bullet.md3"
  roundskin  = "models/vanilla/pistols" "bullet.png"
  roundscale = 0.31

  # Breach's own sounds (mcx.zs): its two fire layers as one, and the rest it plays.
  firesound      = "rsm/breachmcx/fire"
  drysound       = "rsm/breach/click"
  magoutsound    = "rsm/breach/cmagout"
  maginsound     = "rsm/breach/cmagin"
  rackapexsound  = "rsm/breach/boltback"
  rackresetsound = "rsm/breach/boltclose"
  magdropsound   = "wm/magdrop"
  casingsound    = "rsm/breachglock/casing"
end

# THE GRIP: placed by the owner on the mesh, as he placed it
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  palm = 16.904, 5.180, -13.995
  rake = 26.8
  supportat = 39.946, 4.955, -11.454
  triggerat = 21.339, 5.088, -11.536
end

# THE CHARGING HANDLE: joint j_charginghandle, 5.55 straight back along -x on the rig's rack frames 221-243. The grab is its rear T.
part charginghandle
  role    = action
  subject = slide
  joint   = j_charginghandle
  grab       = 16.699, 5.244, -3.760
  handseat = 16.699, 5.264, -4.002      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 5.55
    detach   = 0.95
  end
end

# THE MAGAZINE: joint j_mag1. The axis is its own long axis, 12.7 degrees off vertical in the gun's middle plane (a magazine cannot turn in its well), the distance its length along it, 13.87, and a little to clear the well. The grab is the floorplate.
part magazine
  role    = feed
  subject = magazine
  take    = no          # out by its button, in by the hand carrying one
  joint   = j_mag1
  grab       = 27.972, 5.447, -21.220
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.220, -0.000, -0.976
    distance = 14.4
    detach   = 0.9
  end
end

# Not a moving part: where the other hand holds -- Breach's left hand (j_metaindex_le_1,j_metamid_le_1,j_metapinky_le_1), on the centre line.
part support
  role    = support
  subject = support
  grab       = 38.743, 4.896, -13.886
  grabradius = 3.0
end


