  barrel    = 1.000, 0.000, 0.000

  # The right side's surface at the port (Breach's rigs put the right on +y). Brass goes right, up, back.
  ejectport = 16.000, 4.158, -3.536
  ejectdir  = -0.3, 0.9, 0.4

  # THE LOOSE MAGAZINE: the rig's own, cut out at this frame, re-origined on its centroid (magcenter, the gun's space) and turned so it leaves straight down (breach_extract.py); its surfaces carry their own textures, so no magskin. magscale = the gun's 2.290 x 0.34.
  magmodel  = "models/breach/mp5" "wm_breachmp5_mag.md3"
