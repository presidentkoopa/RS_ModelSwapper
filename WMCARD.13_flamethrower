# Force Unleashed incinerator. Mesh prep (reload lane): the donor's frame 0, its rest (frames 1-5 are its HUD fire kick);
# 15.l split into body and canister, 13.l the trigger, the untextured Cylinder the pilotflame; re-origined on the rest
# centroid, shifted (57.0312, 0.4688, -8.3594) from the donor. Every number below is MEASURED on flamethrower2_wm.md3
# unless it says ESTIMATE.
weapon "MS_BD_Flamethrower2"
  type      = flamethrower     # its hand-seat profile (the key landed in c688186)
  hand      = off
  prop      = "WM_PropFlamethrower"
  model     = "models/vanilla/flamers/Flamethrower2" "flamethrower2_wm.md3"
  skin      = "models/vanilla/flamers/Flamethrower2" "Flamethrower2.png"
  # fires straight from the canister's store.
  firesfrom = magazine
  casing    = none
  # ONE DOOM CELL PACK, as the Flamer's: 100 cells, 5.7 seconds at FireTics 2. ESTIMATE.
  capacity  = 100
  magfamily = "flamethrower"
  # THE MAIN NOZZLE: the shroud's mouth ring at x 53.28 (y -4.70..3.80, z 3.83..7.22), its centre. Level.
