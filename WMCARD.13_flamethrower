  magdropsound = "wm/magdrop"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropFlamethrower is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = -28.430, -0.458, 0.445
  supportat = 0.151, -0.459, -6.187
  palm = -30.186, -0.483, 5.836
  rake = 75.2
  seat = -24.790, -0.460, 7.092
