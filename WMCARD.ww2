# ============================================================================
# WMCARD.ww2 -- the Wolfenstein set, written from our OWN measurements.
#
# Every number here came out of the gun's own reload animation, measured by
# md3label on the ANIMATED mesh this mod ships. No static _wm world model was
# read at any point, and nothing was carried over from another gun's card.
# ============================================================================

weapon "MS_wolf_Kar98"
  type      = rifle
  model     = "models/wolf/KAR98" "Kar98.md3"
  skin      = "models/wolf/KAR98" "kar98.png"
  capacity  = 5
  muzzle    = 116.06, 0.55, 1.89
  barrel    = 1, 0, 0
  ejectport = 42.29, 2.83, 2.43
  ejectdir  = 0.0, 1.0, 0.0
end

grip
  triggerat = 33.07, 0.02, -3.85
  palm = 21.42, 0.0, -7.75
  seat = 28.91, 0.67, -2.89
  supportat = 65.29, 0.03, 1.13
  rake = 0
end

# the magazine, measured from the gun's own reload animation  # stroke taken from the insertion frames; travel_clear said 43.36, which is the part's whole journey from wherever it is parked
part magazine
  role    = feed
  surface = mag
  grab       = 38.73, -0.0, 4.99
  grabradius = 2.5
  dof
    kind     = slide
    axis     = 0.000, -0.000, 1.000
    distance = 7.00
  end
end

part bolt
  role    = action
  subject = slide
  surface = bolt
  grab       = 39.26, -1.56, 1.52
  grabradius = 2.5
  dof
    kind     = slide
    axis     = -0.977, 0.047, 0.208
    distance = 12.07
  end
end

