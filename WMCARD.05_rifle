# ============================================================================
# WMCARD.05_rifle -- the model card library, archetype rifle: WM_Rifle, WM_M16.
# Moved from WMCARD.txt on 2026-09-14 with every line unchanged. Index and order: WMCARD.txt.
# ============================================================================


# ============================================================================
# THE RIFLE: a magazine-fed rifle, one card, today's pistol grammar.
#
# RS_ModelSwapper's rifle mesh, ours as the Rifle. No mechanism line, no verbs: the
# charging handle (role = action) and the magazine (role = feed) give it the same
# synthesised cycle and swap as the pistols, which is what a magazine rifle is.
# Every number is measured at REST FRAME 3 (frames 0-2 are the donor's raise --
# see MODELDEF), rigid fit with Runko's own motion divided out.
# RIFLE_CANDIDATES.md has the measurements.
#
# SCALE: MODELDEF Scale 1.0 x 0.34 = 0.34 map units per model unit.
# ============================================================================


# ============================================================ RIFLE -- MAIN HAND
// DUPLICATE of MS_BD_Rifle -- not kept: fewer surfaces bind
// weapon "WM_Rifle"
//   hand      = main
//   type      = rifle
//   prop      = "WM_PropRifle"
//   model     = "models/vanilla/rifles/Rifle" "Rifle.md3"
//   skin      = "models/vanilla/rifles/Rifle" "Rifle.png"
// 
//   # RS_Main's VR_Rifle magazine (RS_Rifle.zs: "magazine 20").
//   capacity  = 20
// 
//   # Its own family, so a pistol magazine never seats in it, nor its in a pistol.
//   magfamily = "rifle"
// 
//   # Runko's front-most vertices (x within 0.5 of 54.41), centred on the bore. The
//   # +x end is the barrel: 2.2 x 2.1 across there against the stock's 4.3 x 10.8.
//   muzzle    = 54.24, 0.13, 0.20
//   barrel    = 1, 0, 0
// 
//   # THE PORT'S SIDE IS MEASURED, ITS POINT IS AN ESTIMATE. The receiver wall over
//   # the carrier (x -10..2, z -0.5..3) has 80 vertices on -y against 20 on +y -- the
//   # cut and the forward assist -- the same test that put the M4A3's port on -y. The
//   # point is the bolt carrier's middle (x -4.33, z 0.54) moved out to that wall.
//   ejectport = -4.3, -1.3, 0.9
//   ejectdir  = -0.3, -0.9, 0.4
// 
//   # The loose magazine: this gun's own Lipas surface, lifted out at frame 3,
//   # re-origined on its centroid and stood upright along its insert axis.
//   # magcenter is that centroid in the GUN's space at frame 3.
//   magmodel  = "models/vanilla/rifles/Rifle" "wm_rifle_mag.md3"
//   magskin   = "models/vanilla/rifles/Rifle" "Rifle.png"
//   magscale  = 0.34
//   magcenter = 1.343, 0.069, -8.068
// 
//   # A 5.56x45 cartridge is 57mm, against .45 ACP's 32mm at 0.175 on bullet.md3:
//   # 0.175 x 57 / 32 = 0.31.
//   roundmodel = "models/vanilla/pistols" "bullet.md3"
//   roundskin  = "models/vanilla/pistols" "bullet.png"
//   roundscale = 0.31
// 
//   # RS_Main's combatfx pool (SNDINFO wm/rifle/*): the Vanilla+ assault rifle's shots and
//   # magazine foley, and the rack pair for the charging handle.
//   firesound      = "wm/rifle/fire"
//   drysound       = "wm/dry"
//   magoutsound    = "wm/rifle/magout"
//   maginsound     = "wm/rifle/magin"
//   rackapexsound  ="wm/rifle/rackback"
//   rackresetsound ="wm/rifle/rackfwd"
//   magdropsound   = "wm/magdrop"
// end
// 
// # THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
// # Computed 2026-09-29 from where WM_PropRifle is drawn today, so switching to it moves nothing.
// grip
//   # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
//   triggerat = -7.745, 0.132, -7.346
//   supportat = 26.410, 0.141, -0.832
//   palm = -13.426, 0.108, -10.131
//   rake = 33.0
//   seat = -11.016, -0.344, -4.819
// end
// 
// # THE CHARGING HANDLE, and the bolt carrier behind the port with it.
// # liikkuvat (the T-handle, top rear): 7.117 along -1, 0, 0 at frames 5 and 22,
// # 0.04 degrees, fit 0.008. The carrier (the surface the artist named `ejectport`)
// # travels 10.44 on the same frames -- a constant 1.466 x the handle on every one.
// # The parser has no `follows` yet, so both ride this one part at the handle's
// # 7.117, and the carrier falls 3.3 units short behind the port.
// part charginghandle
//   role    = action
//   subject = slide
//   surface = liikkuvat
//   surface = ejectport
//   grab       = -16.48, 0.97, 2.59     # the handle's rear, where you pull it
//   handseat = -16.48, 0.18, 2.602      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
//   grabradius = 3.0
//   dof
//     kind     = slide
//     axis     = -1, 0, 0
//     distance = 7.117
//     detach   = 0.95
//   end
// end
// 
// # Lipas. Axis from the insert frames 12-14, a pure translation (0.01 degrees,
// # fit 0.015); frames 10-11 carry a sideways tilt as it clears the well, and
// # frame 9 is its fall. Distance is the magazine's own length along the axis.
// part magazine
//   role    = feed
//   subject = magazine
//   take    = no          # out by its button, in by the hand carrying one
//   surface = Lipas
//   grab       = 1.21, 0.08, -22.20     # the floorplate
//   grabradius = 3.0
//   dof
//     kind     = slide
//     axis     = -0.025, 0, -1
//     distance = 22.3
//     detach   = 0.9
//   end
// end
// 
// # 16.98 degrees about the pin at -7.155, -5.124 (frame 4, fit 0.009) -- follows
// # your finger.
// part trigger
//   role    = trigger
//   surface = trigger
//   dof
//     kind    = hinge
//     axis    = 0, 1, 0
//     degrees = 16.98
//     pivot   = -7.155, 0, -5.124
//   end
// end
// 
// # THE OTHER HAND ON THE HANDGUARD. ESTIMATE: the mesh has no vertices between x 12
// # and 24 (the handguard is long quads); its underside is z -3.59 at x 8-12 and
// # -3.06 at x 24-28. Well forward of the magazine's front edge (x 7.1).
// part support
//   role    = support
//   subject = support
//   grab       = 18.0, 0.0, -3.3
//   grabradius = 3.0
// end
// 
// 
// # ============================================================================
// # THE M16: a magazine-fed rifle, today's pistol grammar, beside the Rifle.
// #
// # RS_ModelSwapper's m16.md3 as m16_wm.md3 -- rest frame 0 written as its only
// # frame, the charging handle (islands 7 + 8 of weapon.002) split into its own
// # surface and the rest named. Every number measured at frame 0 against
// # weapon.002's largest island. RIFLE_CANDIDATES.md.
// #
// # SCALE: MODELDEF Scale 1.35 x 0.34 = 0.459 map units per model unit.
// # ============================================================================
// 
// 
// # ============================================================= M16 -- MAIN HAND

weapon "MS_Rifle"
  hand      = off
  type      = rifle
  prop      = "WM_PropM16"
  model     = "models/vanilla/rifles/M16" "m16_wm.md3"
  skin      = "models/vanilla/rifles/M16" "WPN-M16-k1.png"

  # As the Rifle's.
  capacity  = 20
  magfamily = "rifle"

  # The body's front-most vertices; the +x end is the barrel (2.9 x 2.8 across
  # there against the stock's 3.0 x 8.9).
  muzzle    = 28.05, -0.12, -0.39
  barrel    = 1, 0, 0

  # ESTIMATE, SIDE AND POINT. The receiver walls around the handle (x -4..2, z 0..3)
  # have 9 vertices on -y and 11 on +y -- too few to tell. -y, the right side, as on
  # a real M16 and the Rifle's card; above the magazine, at the receiver wall.
  ejectport = -3.0, -1.6, 1.0
  ejectdir  = -0.3, -0.9, 0.4

  # The loose magazine: this gun's own magazine surface, lifted out of m16_wm.md3,
  # re-origined on its centroid and stood upright along its insert axis.
  magmodel  = "models/vanilla/rifles/M16" "wm_m16_mag.md3"
  magskin   = "models/vanilla/rifles/M16" "WPN-M16-k1.png"
  magscale  = 0.459
  magcenter = -2.985, -0.125, -5.450

  # 5.56x45, as the Rifle's.
  roundmodel = "models/vanilla/pistols" "bullet.md3"
  roundskin  = "models/vanilla/pistols" "bullet.png"
  roundscale = 0.31

  # The Rifle's sounds (SNDINFO wm/rifle/*).
  firesound      = "wm/rifle/fire"
  drysound       = "wm/dry"
  magoutsound    = "wm/rifle/magout"
  maginsound     = "wm/rifle/magin"
  rackapexsound  ="wm/rifle/rackback"
  rackresetsound ="wm/rifle/rackfwd"
  magdropsound   = "wm/magdrop"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# Computed 2026-09-29 from where WM_PropM16 is drawn today, so switching to it moves nothing.
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  triggerat = -11.371, -0.125, -3.250
  supportat = 11.240, -0.125, -0.541
  palm = -14.669, -0.144, -6.542
  rake = 19.5
  seat = -10.724, 0.125, 0.466
end

# THE CHARGING HANDLE: 5.600 along (-1, 0, -0.023) at frame 37 (the reload's rack, and
# every fire cycle, frames 1-6), 0.13 degrees, fit 0.008. Two islands, 24 verts.
part charginghandle
  role    = action
  subject = slide
  surface = charginghandle
  grab       = -1.72, 2.32, 2.17      # the handle's rear
  handseat = -1.72, 2.188, 2.523      # where the avatar's palm goes on this part, fitted 2026-10-11 to c_doom_marine (reload hands)
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, -0.023
    distance = 5.600
    detach   = 0.95
  end
end

# THE MAGAZINE. Axis from frame 29, its purest insert frame (19.68 along -0.105, 0,
# -0.995, 1.6 degrees of turn; the frames around it rock the magazine in). Distance is
# its own length along that axis.
part magazine
  role    = feed
  subject = magazine
  take    = no
  surface = magazine
  grab       = -3.55, -0.12, -13.09   # the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.105, 0, -0.995
    distance = 11.81
    detach   = 0.9
  end
end

# A sliding trigger: 1.245 along (-0.997, 0, 0.083) at frame 1, fit 0.008.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = slide
    axis     = -0.997, 0, 0.083
    distance = 1.245
  end
end

# The artist's ejected case, collapsed at rest: a real case is thrown on every shot.
part brass
  role    = hidden
  surface = casing
end

# ESTIMATE: under the handguard (x 5..18, underside z -2.00).
part support
  role    = support
  subject = support
  grab       = 10.62, -0.12, -2.00
  grabradius = 3.0
end
