# MS_brt_HitlersBuzzsaw: carried from MS_Buzzsaw (WMCARD.bd22) by port_plus_rows.py.
# models/bd22/bd22/buzzsaw_wm.md3 -> models/bd/HitlersBuzzsaw/HitlersBuzzsaw.md3 frame 0: scale 1.00000, rotation 0.000 deg, t [47.594, 0.953, 3.359], every vertex within 0.0000
weapon "MS_brt_HitlersBuzzsaw"
  hand      = main
  type      = chaingun
  prop      = "BD_PropBuzzsaw"
  model     = "models/bd/HitlersBuzzsaw" "HitlersBuzzsaw.md3"
  skin      = "models/bd22" "buzzsaw.png"
  # FIRES FROM THE MAGAZINE, not through a chamber (owner, 2026-10-02).
  # This gun has a feed part, so it gets a SWAP and the magazine can be changed -- but
  # it has no role = action part, so it gets no CYCLE. Unstated, firesfrom defaults to
  # firing through a CHAMBER (card.zs:916-926) that nothing can ever refill: one shot
  # per magazine. Saying magazine takes the chamber out of the path.
  firesfrom = magazine
  capacity  = 200
  magfamily = "bd_762"

  muzzle    = 127.939, -0.149, 1.809
  barrel    = 1.000, -0.000, -0.000
  # side measured (2589 vertices on -y against 1850 on +y), the emptier wall of the receiver; the point and the direction are estimates
  ejectport = 45.782, 15.906, 2.970
  ejectdir  = -0.291, 0.874, 0.389

  magmodel  = "models/bd22" "buzzsaw_magazine.md3"
  magskin   = "models/bd22" "buzzsaw.png"
  magscale  = 0.340
  magcenter = 43.327, 7.349, 5.290

  magoutsound    = "bd22/generic/magout"
  maginsound     = "bd22/generic/magin"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# 2026-10-01: this gun's own handle on the M4A3's grip (set.py FIRING_LINE "hand").
grip
  # palm, rake, supportat: fitted 2026-10-10 to c_doom_marine's hand (avatar grip review)
  # PLACED BY THE OWNER, 2026-10-03, on a shaded render of this gun's own mesh.
  palm       = 27.512, -0.197, -7.343
  rake      = 27.8
  supportat  = 75.034, -2.189, -0.496
  triggerat  = 34.264, -0.164, -5.255

  seat = 29.240, -0.078, 3.107
end
# WHERE THE OFF HAND GOES. The height is measured -- the underside of the
# body there. The length along the gun is an ESTIMATE: the middle of the
# body's thick run forward of the magazine, since a handguard is thick and
# a barrel is thin. Check it in the headset.
part support
  role    = support
  subject = support
  grab       = 54.582, 0.953, -2.235
  grabradius = 3.000
end

part magazine
  role    = feed
  subject = magazine
  take    = no
  surface = magazine
  grab       = 42.791, 14.741, 4.375
  grabradius = 3.000
  dof
    kind     = slide
    axis     = -0.000, 1.000, 0.000
    distance = 11.438
    detach   = 0.9
  end
end

part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = hinge
    axis     = -0.000, 1.000, 0.000
    degrees  = 20.0
    pivot    = 35.580, 0.953, -2.526
  end
end
